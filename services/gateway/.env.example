# Arcane gateway configuration. Copy to .env (never commit it) or set these in your host's secret manager.
# Every value here is an example. Secrets are read from the environment only.

# --- Server -------------------------------------------------------------------------------------------------------
NODE_ENV=production
# Public https URL of this gateway (no trailing slash). Used for sign-in links and checkout return pages.
PUBLIC_URL=https://gateway.your-domain.example
HOST=0.0.0.0
PORT=8787
# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=1
# SQLite file. Mount a persistent volume here.
DATABASE_FILE=/data/gateway.sqlite
# 32+ random characters. Keys the hashes of tokens, device codes and sign-in links. Rotating it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Exact https origins allowed to call the API from a browser. The desktop app calls from its host process and
# needs none, so leave this empty unless you build a web client.
CORS_ORIGINS=

# --- Hosted diagnostics ------------------------------------------------------------------------------------------
# Enable after managed accounts and an authenticated owner/admin with two-step verification are configured.
# Closed-schema reports only: no chat prompts, raw exceptions, scripts, file paths or attachments.
DIAGNOSTICS_ENABLED=0
DIAGNOSTICS_RETENTION_DAYS=30
DIAGNOSTICS_ACCOUNT_EVENTS=10000
DIAGNOSTICS_MAX_EVENTS=100000
DIAGNOSTICS_PER_MINUTE=60

# --- Accounts ----------------------------------------------------------------------------------------------------
# Required in production. Use the exact Supabase project origin and its publishable key.
# Never use a secret or service-role key for authentication requests.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Separate server-only AES-256-GCM key: 32 random bytes encoded as base64url.
# Generate once, store securely, and keep it stable across restarts and deployments.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCOUNTS_SESSION_KEY=
# Private owner email. Owner access is claimed once, after verified email and an authenticator check.
ADMIN_BOOTSTRAP_EMAIL=
# Enable only providers registered in Supabase. Set empty to offer email/password only.
ACCOUNT_SOCIAL_PROVIDERS=google,apple
# In Supabase, allow <PUBLIC_URL>/account/callback (including the flow query parameter).
# Require email confirmation, configure production SMTP, and enable authenticator MFA.

# --- Payments (test mode first) -----------------------------------------------------------------------------------
# Test keys start with sk_test_ (or a restricted rk_test_ key with Checkout Sessions write access).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at <PUBLIC_URL>/v1/stripe/webhook (starts with whsec_).
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Server-side price map: one price id per offer id from packages/protocol/src/plans.ts.
# Plans need recurring monthly prices; packs and credits need one-time prices. Offers without a price cannot be bought.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK_100=
STRIPE_PRICE_PACK_500=
STRIPE_PRICE_PACK_2000=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_50=
# Optional: a full catalog instead of the defaults above (JSON array of {id, kind, price, credits, actions, actionsPerMonth}).
# CATALOG_FILE=/config/catalog.json
# Optional return pages (default: <PUBLIC_URL>/checkout/done and /checkout/cancelled).
# CHECKOUT_SUCCESS_URL=
# CHECKOUT_CANCEL_URL=

# --- Model providers (server-side keys, never shipped in the app) --------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model table: what the app's model picker shows and how usage is priced.
# inputPerMTok / outputPerMTok are credits per 1,000,000 tokens BEFORE markup (1 credit = 1 cent with the default offers).
# Set them from your provider's current price sheet. "upstream" is the provider's model id.
MODELS_JSON=[{"id":"arcane-default","label":"Arcane default","provider":"anthropic","upstream":"<provider-model-id>","inputPerMTok":300,"outputPerMTok":1500,"maxOutputTokens":8192}]
# MODELS_FILE=/config/models.json
# Markup in basis points: 10000 = at cost, 12000 = +20 %.
MARKUP_BPS=12000
# Credits-equivalent of model usage that one plan/pack action covers for one build turn (turnId).
ACTION_CREDIT_ALLOWANCE=50

# --- Limits -------------------------------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_STREAMS=2
MAX_CHAT_BODY_BYTES=1048576
STREAM_TIMEOUT_MS=300000

# --- Legacy development email links ------------------------------------------------------------------------------
# Managed accounts use Supabase email delivery. These settings only serve the legacy development flow.
# webhook: POST {from,to,subject,text} JSON to MAIL_WEBHOOK_URL (your mail service or relay), signed with
#          X-Arcane-Signature: sha256=<hex HMAC of the body with MAIL_WEBHOOK_SECRET>.
# log:     print links to stdout (local development only; refused when NODE_ENV=production).
# off:     no email, so nobody can sign in.
MAIL_MODE=off
MAIL_WEBHOOK_URL=https://mail-relay.your-domain.example/send
MAIL_WEBHOOK_SECRET=
MAIL_FROM=Arcane <no-reply@your-domain.example>
