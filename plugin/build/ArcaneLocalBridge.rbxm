<Item class="ModuleScript" referent="RBXArcane5">
<Properties>
<string name="Name">Operations</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local V = require(script.Parent.Validation)
local LegacyProperties = require(script.Parent.Properties)
local P = V.geometryProperties(LegacyProperties)
local Registry = require(script.Parent.Registry)
local AssetTransfer = require(script.Parent.AssetTransfer)
local Operations = {}
Operations.__index = Operations
type Operations = any
-- Engine objects never enter command data or public fields. This private owner
-- retains exact meshes until retirement; receiver ownership ends at reconstruct.
local assetOwners: {[any]: any} = setmetatable({}, {__mode = "k"})

local function cleanupFailure(): never
	error(table.freeze({code = "CLEANUP", message = "Owned editable meshes may remain; reconnect cannot establish cleanup.",
		unsafe = true, recovery = table.freeze({partial = true, imported = false, engineVerification = "pending"})}), 0)
end

function Operations.new(pair: any, gameModel: any, http: any, assetProgress: (() -> ())?): Operations
	return setmetatable({registry = Registry.new(pair.sessionId, pair.allowedRoots, gameModel, http),
		gameModel = gameModel, assetTransfers = {}, assetProgress = assetProgress,
		http = http, editor = gameModel:GetService("ScriptEditorService"),
		history = gameModel:GetService("ChangeHistoryService"), selection = gameModel:GetService("Selection"),
		collection = gameModel:GetService("CollectionService"), mutations = {}, restored = {}}, Operations)
end

-- Internal intake is also reached by the fixed host-owned asset.stage_packet
-- queue entry. Generic agent enqueue cannot mint that host admission.
-- No upload, parenting, undo record or engine baseline is created here.
function Operations:receiveAssetPacket(expected: any, packet: string, guard: () -> ()): any
	guard()
	V.fields(expected, {"digest", "payloadDigest", "manifestDigest"}, "asset transfer identity")
	local id = V.string(expected.digest, "transfer digest", 64)
	if #id ~= 64 or not string.match(id, "^[a-f0-9]+$") then V.fail("INPUT", "Expected transfer SHA-256.") end
	local owned = self.assetTransfers[id]
	if not owned then
		local count = 0
		for _ in pairs(self.assetTransfers) do count += 1 end
		if count >= 2 then V.fail("BUSY", "At most two internal asset transfers may be staged.") end
		owned = {guard = guard, expected = V.immutable(expected)}
		owned.receiver = AssetTransfer.new(owned.expected, function(json: string): any
			return self.http:JSONDecode(json)
		end, function(): () owned.guard() end, function(): ()
			task.wait()
			if self.assetProgress then self.assetProgress() end
		end)
		self.assetTransfers[id] = owned
	elseif owned.expected.payloadDigest ~= expected.payloadDigest or owned.expected.manifestDigest ~= expected.manifestDigest then
		V.fail("SCOPE", "Transfer identity changed.")
	end
	owned.guard = guard
	local ok, result = pcall(function(): any
		local output = owned.receiver:accept(packet)
		guard()
		return output
	end)
	if not ok then
		local cleaned = pcall(function() owned.receiver:cancel() end)
		self.assetTransfers[id] = nil
		if not cleaned then V.fail("CLEANUP", "Retired asset staging resources may remain.") end
		error(result, 0)
	end
	return result
end

function Operations:cancelAssetTransfers(): ()
	local failures = 0
	for id, owned in pairs(self.assetTransfers) do
		local ok = pcall(function() owned.receiver:cancel() end)
		self.assetTransfers[id] = nil
		if not ok then failures += 1 end
	end
	local owners = assetOwners[self]
	if owners then
		for id, owner in pairs(owners.resources) do
			owner.retired = true
			for _, resource in ipairs(owner.meshes) do
				if not resource.disposed then
					resource.disposed = true -- Detach BEFORE a reentrant engine callback.
					local mesh = resource.mesh
					resource.mesh = nil
					if not pcall(function() mesh:Destroy() end) then failures += 1 end
				end
			end
			if owner.finished then owners.resources[id] = nil end
		end
	end
	if failures > 0 then self.assetCleanupFailed = true end
	if self.assetCleanupFailed then cleanupFailure() end
end

function Operations:retireAssetContinuity(proof: any): ()
	local retired = false
	local function check(owned: any): ()
		local c = owned.continuity
		if c and (type(proof) ~= "table" or proof.sessionId ~= owned.target.sessionId or proof.mode ~= "Edit"
			or proof.placeId ~= owned.target.placeId or proof.universeId ~= owned.target.universeId
			or proof.connected ~= true or proof.continuitySupported ~= true or proof.clientLifetimeId ~= c.clientLifetimeId
			or proof.pluginArtifactHash ~= c.pluginArtifactHash or proof.playEpoch ~= c.playEpoch) then retired = true end
	end
	for _, owned in pairs(self.assetTransfers) do check(owned) end
	-- Reconstructed meshes no longer hold a staging slot but keep their epoch.
	local owners = assetOwners[self]
	if owners then for _, owner in pairs(owners.resources) do if not owner.retired then check(owner) end end end
	if retired then self:cancelAssetTransfers() end
end

function Operations:assetTargetGuard(target: any, guard: () -> ()): () -> ()
	return function(): ()
		guard()
		if self.assetCleanupFailed then cleanupFailure() end
		local context = self:importContext({})
		local creator: any
		if context.creator.status == "available" then creator = {kind = context.creator.kind, id = tostring(context.creator.id)}
		elseif context.placeId == 0 and context.universeId == 0 and context.creator.id == 0 and context.studioUser.status == "available" then
			creator = {kind = "user", id = tostring(context.studioUser.id)}
		else V.fail("SCOPE", "Observed import creator is unavailable.") end
		local observed = {sessionId = context.sessionId, placeId = context.placeId, universeId = context.universeId,
			root = "Workspace", parentRef = context.parentRef.instanceId, creator = creator}
		if context.mode ~= "Edit" or not V.equal(observed, target) then V.fail("SCOPE", "Import target, creator or Workspace changed.") end
		guard()
	end
end

function Operations:stageAssetPacket(args: any, guard: () -> ()): any
	V.fields(args, {"expected", "packet", "target", "continuity"}, "asset staging arguments")
	local target = V.fields(args.target, {"sessionId", "placeId", "universeId", "root", "parentRef", "creator"}, "asset staging target")
	local current = self:assetTargetGuard(target, guard)
	current()
	local packet = V.string(args.packet, "asset packet", V.ARGUMENT_BYTES)
	local identity = V.fields(args.expected, {"digest", "payloadDigest", "manifestDigest"}, "asset transfer identity")
	local owned = self.assetTransfers[identity.digest]
	if owned then
		if not owned.target or not V.equal(owned.target, target) or not V.equal(owned.continuity, args.continuity) then V.fail("SCOPE", "Staging target or lifetime changed.") end
	else
		local prior = assetOwners[self]
		if prior and prior.resources[identity.digest] then V.fail("STATE", "Transfer was already reconstructed; inspect its original receipt.") end
		local first = V.object(self.http:JSONDecode(packet), "first asset packet")
		if first.kind ~= "begin" or first.ordinal ~= 0 or not V.equal(first.target, target) then V.fail("SCOPE", "Initial packet does not name the observed target.") end
	end
	local result = self:receiveAssetPacket(identity, packet, current)
	self.assetTransfers[identity.digest].target = V.immutable(target)
	self.assetTransfers[identity.digest].continuity = V.immutable(args.continuity)
	return {transferDigest = identity.digest, packetCount = result.packetCount, byteLength = result.byteLength,
		state = result.state, engineVerification = "pending"}
end

-- Fixed host-owned queue operation. It resolves the actual retained receiver;
-- neither the digest, source summary nor JSON runId grants engine ownership.
function Operations:reconstructAsset(args: any, guard: () -> ()): any
	V.fields(args, {"runId", "expected", "packetCount", "byteLength", "objects", "target", "continuity"}, "asset reconstruction")
	local runId = V.string(args.runId, "original stage run", 36)
	local identity = V.fields(args.expected, {"digest", "payloadDigest", "manifestDigest"}, "asset transfer identity")
	local owned = self.assetTransfers[identity.digest]
	local current = self:assetTargetGuard(args.target, guard)
	current()
	local prior = assetOwners[self]
	if not owned and prior and prior.resources[identity.digest] then V.fail("STATE", "Reconstruction was already consumed; inspect its original receipt.") end
	if not owned or not V.equal(owned.expected, identity) or not V.equal(owned.target, args.target)
		or not V.equal(owned.continuity, args.continuity) then V.fail("SCOPE", "Original staged buffers are absent or changed.") end
	local owners = assetOwners[self]
	if not owners then owners = {resources = {}, consumed = {}, count = 0}; assetOwners[self] = owners end
	if owners.consumed[runId] or owners.resources[identity.digest] then V.fail("STATE", "Reconstruction was already consumed; inspect its original receipt.") end
	if owners.count >= 64 then V.fail("CAPACITY", "Reconstruction history is full; no consumed attempt is evicted.") end
	owned.guard = current
	local status = owned.receiver:status()
	if status.state ~= "sealed" or status.packetCount ~= args.packetCount or status.byteLength ~= args.byteLength then V.fail("STATE", "Original sealed packet accounting changed.") end
	local plan = owned.receiver:reconstructionPlan()
	local expectedObjects = V.list(args.objects, 128, "reconstructed sources")
	if #expectedObjects ~= #plan then V.fail("SCOPE", "Reconstruction source count differs from the sealed transfer.") end
	for index, source in ipairs(plan) do
		if not V.equal(source, expectedObjects[index]) then V.fail("SCOPE", "Reconstruction sources differ from the sealed transfer.") end
	end
	current()
	owners.consumed[runId] = true; owners.count += 1 -- BEFORE resolving/allocating an engine service.
	local owner: any = {runId = runId, meshes = {}, retired = false, finished = false, target = owned.target, continuity = owned.continuity}
	owners.resources[identity.digest] = owner
	owned.guard = function(): ()
		current()
		if owner.retired or self.assetTransfers[identity.digest] ~= owned then V.fail("SCOPE", "Reconstruction owner was retired.") end
	end
	local ok, output = pcall(function(): any
		if self.assetProgress then self.assetProgress() end -- Fresh authenticated progress BEFORE allocation.
		local service = self.gameModel:GetService("AssetService")
		owned.guard()
		local entries = owned.receiver:reconstruct(service)
		-- No guard/yield between receiving ownership and registering EVERY mesh.
		for _, entry in ipairs(entries) do owner.meshes[#owner.meshes + 1] = {mesh = entry.mesh.editableMesh, disposed = false} end
		owned.guard()
		local summary = {}
		for _, entry in ipairs(entries) do
			summary[#summary + 1] = {sourceObjectId = entry.object.sourceObjectId, meshExportSha256 = entry.object.meshExportSha256,
				vertexCount = entry.mesh.vertexCount, triangleCount = entry.mesh.triangleCount}
		end
		if owner.retired or not V.equal(summary, plan) then V.fail("SCOPE", "Reconstructed ownership or source accounting changed.") end
		owned.guard()
		owner.finished = true
		local receipt = {runId = runId, transferDigest = identity.digest, state = "reconstructed", objects = V.array(summary), imported = false, engineVerification = "pending"}
		if #V.encode(receipt, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Reconstruction receipt exceeds its bound.") end
		local frozen = V.immutable(receipt)
		owned.guard()
		return frozen
	end)
	if not ok then
		owner.finished = true
		if type(output) == "table" and (output.code == "CLEANUP" or output.cleanupFailed == true) then self.assetCleanupFailed = true end
		self:cancelAssetTransfers()
		error(output, 0)
	end
	-- The emptied receiver no longer owns buffers; release its staging slot so
	-- only in-progress transfers count toward the two-transfer bound.
	if self.assetTransfers[identity.digest] == owned then self.assetTransfers[identity.digest] = nil end
	return output
end

function Operations:source(instance: any): string
	if not instance:IsA("LuaSourceContainer") then V.fail("CLASS", "Reference is not a script.") end
	return V.string(self.editor:GetEditorSource(instance), "script source", V.SOURCE_BYTES, true)
end

function Operations:record(command: any, guard: () -> (), action: (any) -> any): any
	guard()
	local recording = self.history:TryBeginRecording("Arcane." .. command.id, "Arcane " .. command.method)
	if not recording then V.fail("HISTORY", "Cannot begin an undo recording; no change was attempted.") end
	local progress: any = {touched = false}
	local ok, result = pcall(function()
		guard()
		local output = action(progress)
		guard()
		if #V.encode(output, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Mutation receipt exceeds 512 KiB.") end
		return output
	end)
	if ok then
		local committed = pcall(function() self.history:FinishRecording(recording, Enum.FinishRecordingOperation.Commit) end)
		if committed then return result end
		progress.touched = true
		result = {code = "HISTORY", message = "Change applied but its undo recording could not be committed."}
	else
		-- Cancel only an untouched recording. A yielding editor write or partial
		-- property assignment is ambiguous; a broad undo could erase a later edit.
		local finish = if progress.touched then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel
		local finished = pcall(function() self.history:FinishRecording(recording, finish) end)
		if not finished then progress.touched = true end
	end
	if progress.touched then
		local recovery: any = {partial = true, needsReconciliation = true, rollbackVerified = false, commandId = command.id}
		if progress.ref then recovery.ref = progress.ref end
		error({code = "PARTIAL", message = V.safeError(result), recovery = recovery, unsafe = true}, 0)
	end
	error(result, 0)
end

function Operations:children(args: any): any
	V.fields(args, {"root", "ref", "limit"}, "children arguments")
	local root = self.registry:root(args.root)
	local parent = if args.ref then self.registry:resolve(args.ref) else root
	if self.registry:rootOf(parent) ~= args.root then V.fail("GRANT", "Parent is outside the requested root.") end
	local limit = if args.limit == nil then 100 else V.integer(args.limit, 1, 200, "limit")
	local children = parent:GetChildren()
	local items = V.array({})
	for index = 1, math.min(limit, #children) do table.insert(items, self.registry:node(children[index])) end
	return {parentRef = self.registry:ref(parent), items = items, truncated = #children > limit}
end

-- Primary API docs verified 2026-10-14:
-- https://create.roblox.com/docs/reference/engine/classes/DataModel (CreatorType/CreatorId/PlaceId/GameId)
-- https://create.roblox.com/docs/reference/engine/enums/CreatorType
-- https://create.roblox.com/docs/reference/engine/classes/StudioService#GetUserId (anonymous = 0)
-- https://create.roblox.com/docs/reference/engine/classes/StudioTestService#EditModeActive
-- Registry owns the actual granted service and GUID; no caller path or inferred ID.
function Operations:importContext(args: any): any
	V.fields(args, {}, "import-context arguments")
	local workspace = self.registry:root("Workspace")
	local gameModel = self.registry.gameModel
	local function snapshot(): any
		local ok, value = pcall(function(): any
			local creatorType = gameModel.CreatorType
			return {placeId = V.integer(gameModel.PlaceId, 0, 9007199254740991, "place ID"),
				universeId = V.integer(gameModel.GameId, 0, 9007199254740991, "universe ID"),
				creatorId = V.integer(gameModel.CreatorId, 0, 9007199254740991, "creator ID"),
				creatorKind = if creatorType == Enum.CreatorType.User then "user"
					else if creatorType == Enum.CreatorType.Group then "group" else V.NULL,
				edit = V.boolean(gameModel:GetService("StudioTestService").EditModeActive, "Studio edit state")}
		end)
		if not ok then V.fail("CONTEXT_UNAVAILABLE", "Studio import identity or mode could not be observed exactly.") end
		return value
	end
	local before = snapshot()
	local creator: any = {status = "unavailable", kind = V.NULL, id = before.creatorId, provenance = "game.CreatorType/CreatorId"}
	if before.creatorId > 0 and before.creatorKind ~= V.NULL then
		creator.status, creator.kind = "available", before.creatorKind
	end
	local studioUser: any = {status = "not_applicable", id = V.NULL, provenance = "StudioService:GetUserId"}
	-- Even a template/nonzero partial identity must never use the Studio user.
	if before.placeId == 0 and before.universeId == 0 and before.creatorId == 0 then
		studioUser.status = "unavailable"
		local ok, userId = pcall(function(): number
			return V.integer(gameModel:GetService("StudioService"):GetUserId(), 1, 9007199254740991, "Studio user ID")
		end)
		if ok then studioUser.status, studioUser.id = "available", userId end
	end
	local after = snapshot()
	if not V.equal(before, after) then V.fail("CONTEXT_CHANGED", "Studio identity or mode changed during observation; request fresh context.") end
	if workspace.Parent ~= gameModel or workspace.ClassName ~= "Workspace" then V.fail("REF", "The granted Workspace is unavailable.") end
	return {sessionId = self.registry.sessionId, root = "Workspace", parentRef = self.registry:ref(workspace),
		placeId = after.placeId, universeId = after.universeId, mode = if after.edit then "Edit" else "Play",
		modeProvenance = "StudioTestService.EditModeActive", creator = creator, studioUser = studioUser}
end

-- Separate uploader read: published place owner/group is NOT the active Studio
-- account. This observes identity only and never certifies upload permissions.
function Operations:uploadContext(args: any): any
	V.fields(args, {}, "upload-context arguments")
	local before = self:importContext({})
	local function uploader(): any
		local ok, userId = pcall(function(): number
			return V.integer(self.gameModel:GetService("StudioService"):GetUserId(), 1, 9007199254740991, "Studio uploader ID")
		end)
		return if ok then {status = "available", id = userId, provenance = "StudioService:GetUserId"}
			else {status = "unavailable", id = V.NULL, provenance = "StudioService:GetUserId"}
	end
	local first = uploader()
	local after = self:importContext({})
	local second = uploader()
	if not V.equal(before, after) or not V.equal(first, second) then V.fail("CONTEXT_CHANGED", "Place or uploader changed during upload context observation.") end
	after.uploader = second
	return after
end

function Operations:search(args: any): any
	V.fields(args, {"root", "query", "limit"}, "search arguments")
	local root = self.registry:root(args.root)
	local query = string.lower(V.string(args.query, "query", 100))
	local limit = if args.limit == nil then 100 else V.integer(args.limit, 1, 200, "limit")
	local queue: {any} = {root}
	local items = V.array({})
	local head, visited, omitted = 1, 0, false
	while head <= #queue and visited < 5000 do
		local instance = queue[head]
		head += 1
		visited += 1
		if string.find(string.lower(instance.Name), query, 1, true) then
			if #items == limit then return {items = items, truncated = true} end
			table.insert(items, self.registry:node(instance))
		end
		for _, child in ipairs(instance:GetChildren()) do
			if #queue < 5000 then table.insert(queue, child) else omitted = true; break end
		end
	end
	return {items = items, truncated = omitted or head <= #queue}
end

-- Content discovery reads editor text. Matches never authorize an update:
-- script.read must supply its exact current baseline before editing.
function Operations:searchScripts(args: any, guard: () -> ()): any
	V.fields(args, {"root", "ref", "query", "limit", "caseSensitive"}, "script search arguments")
	local root = self.registry:root(args.root)
	local parent = if args.ref ~= nil then self.registry:resolve(args.ref) else root
	local function scope(instance: any): ()
		guard()
		if self.registry:rootOf(parent) ~= args.root or self.registry:rootOf(instance) ~= args.root
			or (instance ~= parent and not instance:IsDescendantOf(parent)) then V.fail("GRANT", "Search scope changed.") end
	end
	scope(parent)
	local query = V.string(args.query, "query", 256)
	if string.find(query, "[%c]") then V.fail("INPUT", "Use a literal single-line query.") end
	if args.caseSensitive ~= nil and type(args.caseSensitive) ~= "boolean" then V.fail("INPUT", "caseSensitive must be a boolean.") end
	local sensitive = args.caseSensitive ~= false
	local needle = if sensitive then query else string.lower(query)
	local limit = if args.limit == nil then 50 else V.integer(args.limit, 1, 100, "limit")
	local items, reasons = V.array({}), V.array({})
	local queue: {any} = {parent}
	local head, nodes, scripts, sourceBytes, skipped, resultBytes = 1, 0, 0, 0, 0, 0
	local function incomplete(reason: string): ()
		if not table.find(reasons, reason) then table.insert(reasons, reason) end
	end
	local stopped = false
	while head <= #queue and not stopped do
		local instance = queue[head]
		head += 1
		scope(instance)
		if nodes == 5000 then incomplete("nodes"); break end
		nodes += 1
		if instance:IsA("LuaSourceContainer") then
			if scripts == 128 then incomplete("scripts"); break end
			scripts += 1
			local ok, source = pcall(function(): string return self:source(instance) end)
			scope(instance) -- Grant loss or reparenting is not an unreadable-source skip.
			if not ok then skipped += 1; incomplete("unreadable-source")
			elseif sourceBytes + #source > 2 * 1024 * 1024 then incomplete("source-bytes"); break
			else
				sourceBytes += #source
				local start, lineNumber = 1, 1
				while start <= #source do
					local newline = string.find(source, "\n", start, true)
					local last = if newline then newline - 1 else #source
					if string.sub(source, last, last) == "\r" then last -= 1 end
					local line = string.sub(source, start, last)
					local column = string.find(if sensitive then line else string.lower(line), needle, 1, true)
					if column then
						if #items == limit then incomplete("matches"); stopped = true; break end
						local first = utf8.offset(line, 0, math.max(1, column - 64)) :: number
						local finish = utf8.offset(line, 0, math.min(#line + 1, first + 512)) :: number
						local item = self.registry:node(instance)
						item.line, item.column = lineNumber, column
						item.excerpt, item.excerptStartColumn = string.sub(line, first, finish - 1), first
						item.excerptTruncated = first > 1 or finish <= #line
						local size = #V.encode(item, self.http)
						if resultBytes + size > 256 * 1024 then incomplete("result-bytes"); stopped = true; break end
						resultBytes += size
						table.insert(items, item)
					end
					if not newline then break end
					start, lineNumber = newline + 1, lineNumber + 1
				end
			end
		end
		if not stopped then
			for _, child in ipairs(instance:GetChildren()) do
				if #queue < 5000 then table.insert(queue, child) else incomplete("nodes"); break end
			end
		end
	end
	scope(parent)
	return {parentRef = self.registry:ref(parent), items = items, truncated = #reasons > 0, reasons = reasons,
		nodesVisited = nodes, scriptsRead = scripts - skipped, skippedScripts = skipped, sourceBytes = sourceBytes,
		literal = true, caseSensitive = sensitive, sourceKind = "editor", columnEncoding = "utf8-bytes", atomicSnapshot = false}
end

function Operations:updateProperties(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"ref", "expected", "properties"}, "update arguments")
	local instance = self.registry:resolve(args.ref)
	local decoded, names = P.validate(instance, args.properties, self.registry:isService(instance))
	if #names == 0 then V.fail("INPUT", "Choose at least one property to update.") end
	P.validate(instance, args.expected, self.registry:isService(instance))
	for key in pairs(args.expected) do if not table.find(names, key) then V.fail("INPUT", "Expected properties must exactly cover the changed properties.") end end
	if not P.compare(instance, args.expected, names) then V.fail("CONFLICT", "Properties differ from the expected baseline.") end
	local ref = self.registry:ref(instance)
	local before = V.immutable(P.snapshot(instance, names))
	return self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(ref)
		if not P.compare(instance, args.expected, names) then V.fail("CONFLICT", "Properties changed before the write.") end
		progress.ref = ref
		local original, observable = {}, P.snapshot(instance)
		for _, name in ipairs(names) do original[name] = instance[name] end
		for _, name in ipairs(names) do
			progress.touched = true
			instance[name] = decoded[name]
		end
		for _, name in ipairs(names) do
			if not P.assignedMatches(instance, name, decoded[name]) then
				-- The engine coerced a value. Synchronously restore the exact engine
				-- baseline; only a fully verified revert is a clean, untouched failure.
				local reverted = pcall(function()
					for _, restoring in ipairs(names) do instance[restoring] = original[restoring] end
				end)
				if reverted then
					local matches = true
					for _, restoring in ipairs(names) do if instance[restoring] ~= original[restoring] then matches = false end end
					if matches and V.equal(P.snapshot(instance), observable) then progress.touched = false end
				end
				V.fail("VERIFY", "Property write did not match the requested value.")
			end
		end
		return {ref = self.registry:ref(instance), mutation = {kind = "scene.update", ref = ref,
			before = {properties = before}, after = {properties = P.snapshot(instance, names)}}}
	end)
end

function Operations:updateSource(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"ref", "expectedSource", "source"}, "source arguments")
	local instance = self.registry:resolve(args.ref)
	local expected = V.string(args.expectedSource, "expected source", V.SOURCE_BYTES, true)
	local source = V.string(args.source, "source", V.SOURCE_BYTES, true)
	if self:source(instance) ~= expected then V.fail("CONFLICT", "Editor source differs from the expected baseline.") end
	local ref = self.registry:ref(instance)
	local proposed = {ref = ref, mutation = {kind = "script.update", ref = ref, before = {source = expected}, after = {source = source}}}
	if #V.encode(proposed, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Source receipt would exceed 512 KiB; no change attempted.") end
	return self:record(command, guard, function(progress: any): any
		local conflict = false
		self.editor:UpdateSourceAsync(instance, function(current: string): string?
			-- Roblox may invoke this callback again. Every invocation fences the
			-- session and compares the exact editor baseline; never yield here.
			guard()
			self.registry:resolve(ref)
			if current ~= expected then conflict = true end
			if conflict then return nil end
			progress.ref = ref
			progress.touched = true
			return source
		end)
		local observed = self:source(instance)
		if conflict then
			-- Once a callback proposed a write, keep the uncertainty flag sticky.
			V.fail("CONFLICT", "Editor changed during the source update.")
		end
		if observed ~= source then V.fail("VERIFY", "Editor source did not match after the update.") end
		return {ref = self.registry:ref(instance), mutation = {kind = "script.update", ref = ref,
			before = {source = expected}, after = {source = observed}}}
	end)
end

function Operations:setEnabled(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"ref", "expectedSource", "expectedEnabled", "enabled"}, "execution-state arguments")
	local instance = self.registry:resolve(args.ref)
	if not instance:IsA("BaseScript") then V.fail("CLASS", "Only Script and LocalScript have an execution state.") end
	local expected = V.string(args.expectedSource, "expected source", V.SOURCE_BYTES, true)
	if type(args.expectedEnabled) ~= "boolean" or type(args.enabled) ~= "boolean" then V.fail("INPUT", "Execution state and baseline must be booleans.") end
	if args.enabled and not string.find(expected, "%S") then V.fail("SOURCE_EMPTY", "An empty placeholder cannot be activated.") end
	local ref = self.registry:ref(instance)
	local function matches(): boolean
		return self:source(instance) == expected and not instance.Disabled == args.expectedEnabled
	end
	if not matches() then V.fail("CONFLICT", "Source or execution state differs from the exact baseline.") end
	-- The host compiles this exact source before delivery. A dirty editor buffer
	-- must not activate a different persisted implementation in the engine.
	if args.enabled and instance.Source ~= expected then V.fail("UNSAVED_SOURCE", "Persisted source differs from the verified editor source. Save the script first.") end
	local proposed = {ref = ref, mutation = {kind = "script.set_enabled", ref = ref,
		before = {source = expected, enabled = args.expectedEnabled}, after = {source = expected, enabled = args.enabled}}}
	if #V.encode(proposed, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Execution-state receipt would exceed 512 KiB; no change attempted.") end
	return self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(ref)
		if not matches() then V.fail("CONFLICT", "Source or execution state changed before activation.") end
		if args.enabled and instance.Source ~= expected then V.fail("UNSAVED_SOURCE", "Persisted source changed before activation.") end
		progress.ref = ref
		progress.touched = true
		instance.Disabled = not args.enabled
		if not instance.Disabled ~= args.enabled or self:source(instance) ~= expected or (args.enabled and instance.Source ~= expected) then V.fail("VERIFY", "Script execution state/source did not match after assignment.") end
		return {ref = self.registry:ref(instance), mutation = {kind = "script.set_enabled", ref = ref,
			before = {source = expected, enabled = args.expectedEnabled}, after = {source = expected, enabled = not instance.Disabled}}}
	end)
end

function Operations:create(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"parent", "className", "name", "properties"}, "create arguments")
	local parent = self.registry:resolve(args.parent)
	if type(args.className) ~= "string" or not table.find(P.CLASSES, args.className) then V.fail("CLASS", "Class is not creatable.") end
	local name = V.string(args.name, "name", 100)
	local properties = if args.properties == nil then {} else args.properties
	if self.registry.count >= V.MAX_REFS then V.fail("CAPACITY", "Reference capacity reached; pair a new session.") end
	-- Decode the complete payload before allocating or parenting an Instance.
	V.object(properties, "properties")
	local decoded: {[string]: any} = {}
	local propertyCount = 0
	for key, value in pairs(properties) do
		propertyCount += 1
		if propertyCount > V.MAX_PROPERTIES then V.fail("INPUT", "Too many properties.") end
		if key == "Name" then V.fail("PROPERTY", "Use the create name field.") end
		decoded[key] = P.decode(key, value, table.find(V.BASE_PART_CLASSES, args.className) ~= nil,
			table.find(V.PART_SHAPE_CLASSES, args.className) ~= nil)
	end
	local instance: any = nil
	local result = self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(args.parent)
		instance = Instance.new(args.className)
		local prepared, prepareError = pcall(function()
			instance.Name = name
			if instance:IsA("BaseScript") then instance.Disabled = true end
			for key, value in pairs(decoded) do instance[key] = value end
			for key, value in pairs(decoded) do if not P.assignedMatches(instance, key, value) then V.fail("VERIFY", "Created property differs from the requested value.") end end
			guard()
		end)
		if not prepared then instance:Destroy(); error(prepareError, 0) end
		progress.touched = true
		instance.Parent = parent
		local ref = self.registry:ref(instance)
		progress.ref = ref
		local snapshot = P.snapshot(instance)
		local source = if instance:IsA("LuaSourceContainer") then self:source(instance) else nil
		self.registry.owned[instance] = {parent = parent, properties = V.immutable(snapshot), source = source,
			enabled = if instance:IsA("BaseScript") then not instance.Disabled else nil,
			attributes = V.immutable(instance:GetAttributes()), tags = V.immutable(self.collection:GetTags(instance))}
		return {ref = ref, mutation = {kind = "scene.create", ref = ref, before = V.NULL, after = {properties = snapshot}}}
	end)
	return result
end

function Operations:restore(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"receiptCommandId", "mutation"}, "restore arguments")
	local receiptId = V.string(args.receiptCommandId, "receipt command ID", 256)
	local original = self.mutations[receiptId]
	if not original or self.restored[receiptId] then V.fail("RECEIPT", "Receipt is unknown or already restored in this session.") end
	-- Do not trust a caller-supplied inverse, even on the paired daemon route.
	if not V.equal(original, args.mutation) then V.fail("RECEIPT", "Restoration payload differs from the immutable local receipt.") end
	local instance = self.registry:resolve(original.ref)
	if self.registry:isService(instance) then V.fail("SERVICE", "Services cannot be restored by mutation.") end
	if original.kind == "scene.create" then
		local owned = self.registry.owned[instance]
		local function matches(): boolean
			return owned ~= nil and instance.Parent == owned.parent and #instance:GetChildren() == 0
				and V.equal(P.snapshot(instance), original.after.properties)
				and V.equal(instance:GetAttributes(), owned.attributes)
				and V.equal(self.collection:GetTags(instance), owned.tags)
				and (owned.source == nil or self:source(instance) == owned.source)
				and (owned.enabled == nil or not instance.Disabled == owned.enabled)
		end
		if not matches() then V.fail("CONFLICT", "Created instance has changed, moved, or gained children; restoration refused.") end
		self:record(command, guard, function(progress: any): any
			guard()
			self.registry:resolve(original.ref)
			if not matches() then V.fail("CONFLICT", "Created instance changed before restoration.") end
			progress.ref = original.ref
			progress.touched = true
			instance:Destroy()
			return {restored = true, ref = original.ref}
		end)
	elseif original.kind == "scene.update" then
		self:updateProperties(command, {ref = original.ref, expected = original.after.properties, properties = original.before.properties}, guard)
	elseif original.kind == "script.update" then
		self:updateSource(command, {ref = original.ref, expectedSource = original.after.source, source = original.before.source}, guard)
	elseif original.kind == "script.set_enabled" then
		self:setEnabled(command, {ref = original.ref, expectedSource = original.after.source, expectedEnabled = original.after.enabled, enabled = original.before.enabled}, guard)
	else V.fail("RECEIPT", "Unsupported mutation receipt.") end
	self.restored[receiptId] = true
	return {restored = true, ref = original.ref}
end

function Operations:execute(command: any, guard: () -> ()): any
	guard()
	local args = V.object(command.args, "arguments")
	local method = command.method
	local result: any
	if method == "scene.children" then result = self:children(args)
	elseif method == "asset.stage_packet" then result = self:stageAssetPacket(args, guard)
	elseif method == "asset.reconstruct" then return self:reconstructAsset(args, guard)
	elseif method == "scene.import_context" then result = self:importContext(args)
	elseif method == "scene.upload_context" then result = self:uploadContext(args)
	elseif method == "scene.search" then result = self:search(args)
	elseif method == "script.search" then result = self:searchScripts(args, guard)
	elseif method == "scene.inspect" then
		V.fields(args, {"ref"}, "inspect arguments")
		local instance = self.registry:resolve(args.ref)
		local node = self.registry:node(instance)
		node.properties = P.snapshot(instance)
		result = node
	elseif method == "selection.read" then
		V.fields(args, {}, "selection arguments")
		local items = V.array({})
		for _, instance in ipairs(self.selection:Get()) do
			if self.registry:rootOf(instance) then
				if #items >= 200 then V.fail("BODY_LIMIT", "Selection exceeds 200 granted instances.") end
				table.insert(items, self.registry:node(instance))
			end
		end
		result = {items = items}
	elseif method == "script.read" then
		V.fields(args, {"ref"}, "read arguments")
		local instance = self.registry:resolve(args.ref)
		result = {ref = self.registry:ref(instance), source = self:source(instance)}
		if instance:IsA("BaseScript") then result.enabled = not instance.Disabled end
	elseif method == "scene.create" then result = self:create(command, args, guard)
	elseif method == "scene.update" then result = self:updateProperties(command, args, guard)
	elseif method == "script.update" then result = self:updateSource(command, args, guard)
	elseif method == "script.set_enabled" then result = self:setEnabled(command, args, guard)
	elseif method == "scene.restore" then result = self:restore(command, args, guard)
	else V.fail("METHOD", "Unsupported Studio method.") end
	if not table.find(V.WRITE_METHODS, method) then guard() end
	if #V.encode(result, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Result exceeds 512 KiB.") end
	result = V.immutable(result)
	if result.mutation then self.mutations[command.id] = result.mutation end
	return result
end

return Operations
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane6">
<Properties>
<string name="Name">Transport</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local V = require(script.Parent.Validation)
local Operations = require(script.Parent.Operations)
local TestProof = require(script.Parent.TestProof)
local Transport = {}
Transport.__index = Transport
Transport.POLL_SECONDS = 2
Transport.MAX_BACKOFF_SECONDS = 30
Transport.MAX_RECOVERY_ATTEMPTS = 8
-- Status is a read-only POST so the exact key never enters a URL. The daemon
-- must authenticate that key and inspect this exact client/identity without
-- creating a session, renewing a lease, dispatching work or returning a bearer.
local ROUTES = table.freeze({connect = "/v1/plugin/connect", status = "/v1/plugin/status", pair = "/v1/plugin/pair", poll = "/v1/plugin/poll", result = "/v1/plugin/result", disconnect = "/v1/plugin/disconnect"})
local IDENTITY_CHANGED = "Place identity changed; this session is fenced. Inspect receipts and explicitly connect again."
local ASSET_CLEANUP_FAILED = "Owned asset staging resources could not all be released. Inspect staging resources before reloading the plugin."
type Transport = any

function Transport.new(gameModel: any, onStatus: (any) -> (), artifactHash: string?): Transport
	local http = gameModel:GetService("HttpService")
	local clientSessionId = http:GenerateGUID(false)
	local proof = if artifactHash then TestProof.new(gameModel, clientSessionId, artifactHash) else nil
	return setmetatable({gameModel = gameModel, http = http, run = gameModel:GetService("RunService"),
		clientSessionId = clientSessionId, testProof = proof, onStatus = onStatus, generation = 0,
		pair = nil, desiredPair = nil, disconnectRequested = false, stopped = false,
		inFlight = false, started = false, failures = 0, cache = {}, cacheCount = 0,
		cacheBytes = 0, highEpoch = 0, pending = nil, blocked = false, identityFence = nil,
		recovery = nil, checkInput = nil, assetCleanupFailed = false}, Transport)
end

function Transport:isEdit(): boolean
	-- Edit RunService remains Stopped while a separate Play DataModel runs.
	-- Use the plugin-facing global lifecycle property for production admission.
	local ok, active = pcall(function(): any return self.gameModel:GetService("StudioTestService").EditModeActive end)
	if ok then return type(active) == "boolean" and active == true end
	return false
end

function Transport:status(state: string, detail: string, commandId: string?)
	if self.stopped then return end
	local changed = self.identityFence and self.identityFence.changed
	if changed and table.find({"connected", "executing", "retrying"}, state) then state, detail = "reconciliation", IDENTITY_CHANGED end
	if self.assetCleanupFailed then state, detail = "reconciliation", "CLEANUP: " .. ASSET_CLEANUP_FAILED end
	local pair = if self.pair and self.generation == self.pair.generation and not self.disconnectRequested and not changed and not self.assetCleanupFailed then self.pair else nil
	self.onStatus({state = state, detail = detail, commandId = commandId,
		sessionId = if pair then pair.sessionId else nil,
		allowedRoots = if pair then table.clone(pair.allowedRoots) else {},
		allowWrites = if pair then pair.allowWrites else false,
		clientSessionId = self.clientSessionId, editMode = self:isEdit()})
end

function Transport:dropIdentityFence(): ()
	local fence = self.identityFence
	self.identityFence = nil
	if fence then for _, connection in ipairs(fence.connections) do connection:Disconnect() end end
end

function Transport:invalidateIdentity(fence: any): ()
	fence.changed = true -- Sticky for this exchange/session, even if values revert.
	if self.identityFence == fence then
		self.blocked = true
	end
end

function Transport:observeIdentity(fence: any): boolean
	if not fence or self.identityFence ~= fence then return false end
	local identity = fence.identity
	local ok, matches = pcall(function(): boolean
		return self.gameModel.PlaceId == identity.placeId and self.gameModel.GameId == identity.universeId
			and self.gameModel.Name == identity.name
	end)
	if not fence.changed and (not ok or not matches) then self:invalidateIdentity(fence) end
	if fence.changed then self.blocked = true end
	return not fence.changed
end

function Transport:watchIdentity(identity: any): any
	self:dropIdentityFence()
	local fence: any = {identity = V.immutable(identity), changed = false, connections = {}}
	self.identityFence = fence
	-- Signals latch changes during yielding HTTP/editor calls, including a change
	-- back to the original value. Synchronous comparisons cover deferred signals.
	for _, property in ipairs({"PlaceId", "GameId", "Name"}) do
		table.insert(fence.connections, self.gameModel:GetPropertyChangedSignal(property):Connect(function()
			self:invalidateIdentity(fence)
			if self.identityFence == fence then self:status("reconciliation", IDENTITY_CHANGED) end
		end))
	end
	return fence
end

function Transport:checkIdentity(pair: any): ()
	if not pair or not self:observeIdentity(pair.identityFence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
end


function Transport:forgetDesired(): ()
	local desired = self.desiredPair
	if desired then desired.code = nil; desired.apiKey = nil end
	self.desiredPair = nil
end

function Transport:forgetRecovery(): ()
	if self.recovery then self.recovery.apiKey = nil end
	self.recovery = nil
end

function Transport:checkAssetCleanup(): ()
	if self.assetCleanupFailed then V.fail("CLEANUP", ASSET_CLEANUP_FAILED) end
end

function Transport:disposeOperations(): ()
	local operations = self.operations
	-- Detach before synchronous cancellation so retirement cannot dispose twice.
	self.operations = nil
	if not operations then return end
	local ok = pcall(function() operations:cancelAssetTransfers() end)
	if not ok then
		-- Cancellation attempts every owned receiver, but cannot prove release on
		-- failure. An empty transfer table or fresh session is not reconciliation.
		self.assetCleanupFailed = true
		self.blocked = true
		self:forgetDesired()
		self:forgetRecovery()
	end
end

function Transport:requestConnect(apiKey: any, automatic: boolean?): ()
	if self.stopped then return end
	self:checkAssetCleanup()
	local origin = V.keyOrigin(apiKey)
	if not automatic and not self:isEdit() then V.fail("PLAY", "Stop playtesting before connecting.") end
	self.generation += 1
	self:forgetDesired()
	self:forgetRecovery()
	local intent = {url = origin, apiKey = apiKey, generation = self.generation,
		needsStatus = automatic == true, attempts = 0, sessionId = nil, fence = nil}
	self.recovery = intent
	if not automatic then self.desiredPair = {url = origin, apiKey = apiKey, generation = self.generation} end
	self.disconnectRequested = true
	self:status("connecting", "Connecting to the Arcane workbench.")
end

-- Compatibility entry point for legacy fixtures; never exposed by Main.
function Transport:requestPair(url: any, code: any): ()
	if self.stopped then return end
	self:checkAssetCleanup()
	local origin = V.url(url)
	local pairingCode = V.string(code, "pairing code", 128)
	if not self:isEdit() then V.fail("PLAY", "Stop playtesting before pairing.") end
	self.generation += 1 -- Immediately fences callbacks already waiting on Studio.
	self:forgetDesired()
	self:forgetRecovery()
	self.desiredPair = {url = origin, code = pairingCode, generation = self.generation}
	self.disconnectRequested = true
	self:status("pairing", "Pairing requested; waiting for the current request to finish.")
end

function Transport:requestDisconnect(): ()
	if self.stopped then return end
	self.generation += 1
	self:forgetDesired()
	self:forgetRecovery()
	self.disconnectRequested = true
	self:status("disconnecting", "Local writes are fenced; disconnecting from the daemon.")
end

function Transport:stop(): ()
	-- Unloading must not yield or launch a second network request. The daemon
	-- observes heartbeat loss; no token or session state is saved anywhere.
	if self.stopped then return end
	self.generation += 1
	self.stopped = true
	self:forgetDesired()
	self:forgetRecovery()
	self:dropIdentityFence()
	if self.testProof then self.testProof:stop() end
	if self.pair then self.pair.token = nil end
	self.pair = nil
	self:disposeOperations()
	self.pending = nil
	self.cache = {}
	self.cacheCount, self.cacheBytes, self.highEpoch = 0, 0, 0
	-- UI callbacks are fenced on unload; report a bounded local diagnostic and
	-- allow the rest of the unloading handler to finish even when release fails.
	if self.assetCleanupFailed then warn("CLEANUP: " .. ASSET_CLEANUP_FAILED) end
end

function Transport:post(url: string, route: string, payload: any, token: string?): any
	V.url(url)
	if not table.find({ROUTES.connect, ROUTES.status, ROUTES.pair, ROUTES.poll, ROUTES.result, ROUTES.disconnect}, route) then V.fail("URL", "Unsupported plugin route.") end
	if self.inFlight then V.fail("FLIGHT", "Another HTTP request is in flight.") end
	if route == ROUTES.poll then self:checkIdentity(self.pair) end
	local headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" }
	if token then headers.Authorization = "Bearer " .. token end
	local body = V.encode(payload, self.http)
	if #body > V.RESULT_BYTES + 4096 then V.fail("BODY_LIMIT", "Request exceeds the transport bound.") end
	self.inFlight = true
	local ok, response = pcall(function()
		return self.http:RequestAsync({Url = url .. route, Method = "POST", Headers = headers, Body = body, Timeout = 10})
	end)
	self.inFlight = false
	if self.checkInput and not self.stopped then self.checkInput() end
	if self.identityFence then self:observeIdentity(self.identityFence) end
	if not ok then V.fail("NETWORK", "Loopback request failed or timed out.") end
	if type(response) ~= "table" or type(response.StatusCode) ~= "number" or type(response.Success) ~= "boolean" then V.fail("PROTOCOL", "Invalid HTTP response.") end
	-- Never inspect/follow Location, and never construct a URL from a response.
	-- RequestAsync documents Timeout, but no redirect-disable option. Native redirect
	-- behavior still needs a disposable-fixture check; see docs/build/PLUGIN.md.
	if response.StatusCode >= 300 and response.StatusCode < 400 then V.fail("REDIRECT", "Daemon returned a redirect; connection refused.") end
	local errorCode = nil
	if not response.Success and type(response.Body) == "string" and #response.Body <= 8192 then
		local decoded, errorBody = pcall(function() return V.decode(response.Body, self.http) end)
		if decoded and type(errorBody) == "table" then errorCode = errorBody.error end
	end
	if response.StatusCode == 401 or response.StatusCode == 403 then
		if route == ROUTES.status and errorCode ~= "KEY_REJECTED" then
			-- Older daemons route unknown plugin POSTs through bearer auth. Their
			-- generic AUTH is not evidence that this saved API key is invalid.
			V.fail("STATUS_UNAVAILABLE", "Daemon could not authenticate safe key status. Click Connect to connect explicitly.")
		end
		if route == ROUTES.connect or route == ROUTES.status then V.fail("KEY_REJECTED", "Arcane API key was rejected. Enter a new API key.") end
		if errorCode == "ORIGIN" or errorCode == "SCOPE" then V.fail("RECONCILE", "Daemon refused the session scope; inspect the connection.") end
		V.fail("REVOKED", "Session expired or was revoked; connect again.")
	end
	if route == ROUTES.status and (response.StatusCode == 400 or response.StatusCode == 404 or response.StatusCode == 405) then
		V.fail("STATUS_UNAVAILABLE", "Daemon does not support safe session status. Click Connect to connect explicitly.")
	end
	if (route == ROUTES.poll or route == ROUTES.result) and (response.StatusCode == 404 or response.StatusCode == 410) then
		V.fail("REVOKED", "Session no longer exists; checking fresh session status.")
	end
	-- The daemon reports restart/revocation as 409, not necessarily 401. Never
	-- mistake an unrelated receipt conflict for definitive session loss, or echo
	-- its untrusted message. Only inspect a bounded JSON error code.
	if (response.StatusCode == 400 or response.StatusCode == 409) and route ~= ROUTES.connect and route ~= ROUTES.pair and route ~= ROUTES.status then
		if table.find({"REVOKED", "EXPIRED", "SESSION"}, errorCode) then
			V.fail("REVOKED", "Session expired or was lost; checking fresh session status.")
		end
	end
	if response.StatusCode == 409 then V.fail("RECONCILE", "Daemon refused the session or receipt; inspect the command and connect again.") end
	-- Any other definitive client error on a receipt (for example RECEIPT) rejects
	-- these exact bytes; resending them is not a loopback retry. Only timeout and
	-- busy statuses remain transient.
	if route == ROUTES.result and response.StatusCode >= 400 and response.StatusCode < 500
		and response.StatusCode ~= 408 and response.StatusCode ~= 429 then
		V.fail("RECONCILE", "Daemon rejected the command receipt (HTTP " .. tostring(response.StatusCode) .. "); inspect the command and connect again.")
	end
	if not response.Success then V.fail("NETWORK", "Daemon request failed (HTTP " .. tostring(response.StatusCode) .. ").") end
	if type(response.Body) ~= "string" or #response.Body > V.RESULT_BYTES + V.ARGUMENT_BYTES + 8192 then V.fail("BODY_LIMIT", "Daemon response exceeds the transport bound.") end
	local decoded, data = pcall(function() return V.decode(response.Body, self.http) end)
	if not decoded then V.fail("PROTOCOL", "Daemon response is not valid JSON.") end
	return V.object(data, "daemon response")
end

function Transport:clearSession(keepIdentity: boolean?): ()
	if self.testProof then self.testProof:disconnect() end
	if not keepIdentity then self:dropIdentityFence() end
	if self.pair then self.pair.token = nil end
	self.pair = nil
	self:disposeOperations()
	self.pending = nil
	self.cache = {}
	self.cacheCount, self.cacheBytes, self.highEpoch = 0, 0, 0
	self.blocked = self.assetCleanupFailed
	if self.assetCleanupFailed then self:status("reconciliation", "CLEANUP: " .. ASSET_CLEANUP_FAILED) end
end

function Transport:exchange(desired: any): ()
	if self.stopped or desired.generation ~= self.generation then desired.code = nil; desired.apiKey = nil; return end
	self:checkAssetCleanup()
	local capabilities = table.clone(V.READ_METHODS)
	for _, method in ipairs(V.WRITE_METHODS) do table.insert(capabilities, method) end
	for _, method in ipairs(V.ASSET_STAGE_METHODS or {}) do table.insert(capabilities, method) end
	local isKey = desired.apiKey ~= nil
	local payload: any = {
		protocolVersion = V.PROTOCOL,
		identity = {clientSessionId = self.clientSessionId, placeId = self.gameModel.PlaceId,
			universeId = self.gameModel.GameId, name = V.string(self.gameModel.Name, "place name", 200), pluginVersion = V.VERSION},
		capabilities = V.array(capabilities),
	}
	if isKey then payload.apiKey = desired.apiKey else payload.code = desired.code end
	local intent = self.recovery
	local fence = if intent and intent.fence then intent.fence else self:watchIdentity(payload.identity)
	if intent then intent.fence = fence; intent.needsStatus = true end
	if not self:observeIdentity(fence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
	-- Recovery keeps the original identity pin, never recaptures another place.
	payload.identity = fence.identity
	desired.apiKey, desired.code = nil, nil
	local ok, result = pcall(function() return self:post(desired.url, if isKey then ROUTES.connect else ROUTES.pair, payload, nil) end)
	payload.apiKey, payload.code = nil, nil
	if not ok then error(result, 0) end
	V.fields(result, {"sessionId", "token", "protocolVersion", "allowedRoots", "allowWrites"}, "pair result")
	if result.protocolVersion ~= V.PROTOCOL then V.fail("PROTOCOL", "Unsupported daemon protocol.") end
	V.string(result.sessionId, "session ID", 256)
	V.string(result.token, "session token", 4096)
	result.allowedRoots = V.roots(result.allowedRoots)
	V.boolean(result.allowWrites, "write grant")
	-- Keep a late pair only long enough to revoke it in the single worker loop.
	result.url = desired.url
	result.generation = desired.generation
	result.identityFence = fence -- Pinned initial payload, never an ACK or later name.
	if self.stopped then result.token = nil; return end
	self.pair = result
	self.failures = 0
	if self.generation ~= desired.generation then self.disconnectRequested = true; return end
	if intent and self.recovery == intent then intent.sessionId = result.sessionId; intent.needsStatus = false; intent.attempts = 0 end
	self:checkIdentity(result) -- Before resolving any roots in the current engine.
	self.operations = Operations.new(result, self.gameModel, self.http, function(): () self:assetProgress() end)
	local editor = self.operations.editor
	-- Fence the yielding editor call's return before Operations can reread source.
	-- Existing operation/callback guards still own lease, baseline and recovery.
	self.operations.editor = {
		GetEditorSource = function(_self: any, instance: any): string
			self:checkIdentity(result)
			return editor:GetEditorSource(instance)
		end,
		UpdateSourceAsync = function(_self: any, instance: any, callback: any): ()
			self:checkIdentity(result)
			editor:UpdateSourceAsync(instance, callback)
			self:checkIdentity(result)
		end,
	}
	self:checkIdentity(result)
	if self.testProof then
		-- The mapping witness is editor metadata, but it is still an Instance.
		-- Read-only or narrower legacy grants must not create it outside scope.
		if result.allowWrites and table.find(result.allowedRoots, "ServerStorage") then self.testProof:bind(result.sessionId, true)
		else self.testProof:disconnect() end
	end
	self:status("connected", "Connected to this Studio window. " .. (if result.allowWrites then "Writes granted." else "Read only."))
end

function Transport:envelope(command: any): ()
	V.object(command, "command")
	local pair = self.pair
	if not pair or command.protocolVersion ~= V.PROTOCOL or command.sessionId ~= pair.sessionId
		or command.clientSessionId ~= self.clientSessionId or command.state ~= "dispatched" then
		V.fail("SESSION", "Command targets another session or has an invalid protocol/state.")
	end
	V.string(command.id, "command ID", 256)
	V.string(command.requestId, "request ID", 256)
	V.integer(command.leaseEpoch, 1, 9007199254740991, "lease epoch")
	local roots = V.roots(command.allowedRoots)
	if #roots ~= #pair.allowedRoots then V.fail("GRANT", "Command root grants differ from pairing.") end
	for _, root in ipairs(roots) do if not table.find(pair.allowedRoots, root) then V.fail("GRANT", "Command root is not granted.") end end
	if command.allowWrites ~= pair.allowWrites then V.fail("GRANT", "Command write grant differs from pairing.") end
	if not table.find(V.READ_METHODS, command.method) and not table.find(V.WRITE_METHODS, command.method)
		and not table.find(V.ASSET_STAGE_METHODS or {}, command.method) then V.fail("METHOD", "Unsupported Studio method.") end
	V.string(command.expiresAt, "command expiry", 64)
	V.object(command.args, "arguments")
	if #V.encode(command.args, self.http) > V.ARGUMENT_BYTES then V.fail("BODY_LIMIT", "Arguments exceed 256 KiB.") end
end

function Transport:guard(command: any, pair: any): ()
	if self.stopped or self.pair ~= pair or self.generation ~= pair.generation
		or self.disconnectRequested then V.fail("SESSION", "Local session was disconnected or replaced.") end
	self:checkIdentity(pair)
	if self.blocked then V.fail("SESSION", "Local session requires reconciliation.") end
	self:envelope(command)
	if command.leaseEpoch ~= self.highEpoch then V.fail("LEASE", "Command lease is stale.") end
	-- DateTime.fromIsoDate accepts UTC RFC3339 daemon timestamps.
	if not string.match(command.expiresAt, "^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%d.*Z$") then V.fail("LEASE", "Expiry must be a UTC timestamp.") end
	local ok, expires = pcall(function() return DateTime.fromIsoDate(command.expiresAt) end)
	if not ok or not expires or expires.UnixTimestampMillis <= DateTime.now().UnixTimestampMillis then V.fail("LEASE", "Command lease has expired.") end
	local staging = table.find(V.ASSET_STAGE_METHODS or {}, command.method) ~= nil
	if not staging and not self:isEdit() then V.fail("PLAY", "Commands are only available in Studio edit mode.") end
	if (table.find(V.WRITE_METHODS, command.method) or staging) and not pair.allowWrites then V.fail("GRANT", "Session is read only.") end
	if staging then
		-- One fresh snapshot per guard binds CPU staging to this exact Edit epoch.
		-- A second snapshot could accidentally mix two play lifetimes.
		local ok, proof = pcall(function(): any return if self.testProof then self.testProof:snapshot() else nil end)
		local continuity = command.args.continuity
		local identity = pair.identityFence.identity
		if not ok or type(proof) ~= "table" or type(continuity) ~= "table"
			or proof.sessionId ~= pair.sessionId or proof.mode ~= "Edit" or proof.connected ~= true or proof.continuitySupported ~= true
			or proof.placeId ~= identity.placeId or proof.universeId ~= identity.universeId
			or proof.clientLifetimeId ~= self.clientSessionId
			or type(proof.clientLifetimeId) ~= "string" or type(proof.pluginArtifactHash) ~= "string" or type(proof.playEpoch) ~= "number"
			or continuity.clientLifetimeId ~= proof.clientLifetimeId or continuity.pluginArtifactHash ~= proof.pluginArtifactHash
			or continuity.playEpoch ~= proof.playEpoch or not self:isEdit() then V.fail("SCOPE", "Asset staging Edit continuity changed or is unavailable.") end
	end
	if command.method == "asset.reconstruct" and self.assetEngineAdmitted then
		local renewal = self.assetRenewal
		local wall, monotonic = DateTime.now().UnixTimestampMillis, os.clock()
		if not renewal or renewal.commandId ~= command.id or renewal.leaseEpoch ~= command.leaseEpoch
			or wall < renewal.observedAt or wall >= renewal.expiresAt or monotonic < renewal.monotonicStartedAt or monotonic >= renewal.monotonicExpiresAt then
			V.fail("SCOPE", "Authenticated reconstruction renewal expired; no further engine work is admitted.")
		end
	end
end

-- The same single worker refreshes only its exact dispatched reconstruction.
-- Called from existing mesh batch yields; no parallel task or lease extension.
function Transport:assetProgress(): ()
	local command, pair = self.executingCommand, self.pair
	if not command or command.method ~= "asset.reconstruct" then return end
	self:guard(command, pair)
	local started = os.clock()
	if self.assetEngineAdmitted and self.assetProgressAt and started >= self.assetProgressAt and started - self.assetProgressAt < 2 then return end
	local proof = if self.testProof then self.testProof:snapshot() else nil
	self:guard(command, pair)
	self.assetProgressAt = started
	local response = self:post(pair.url, ROUTES.poll, {sessionId = pair.sessionId, observation = proof,
		executingCommand = {commandId = command.id, leaseEpoch = command.leaseEpoch}}, pair.token)
	V.fields(response, {"commands", "progress"}, "reconstruction progress")
	if #V.list(response.commands, 1, "progress commands") ~= 0 then V.fail("RECONCILE", "Reconstruction progress cannot dispatch new work.") end
	local progress = V.fields(response.progress, {"commandId", "leaseEpoch", "observedAt", "expiresAt"}, "progress renewal")
	if progress.commandId ~= command.id or progress.leaseEpoch ~= command.leaseEpoch then V.fail("RECONCILE", "Progress renewal belongs to another command or lease.") end
	local function timestamp(value: any): number
		if type(value) ~= "string" or #value > 64 or not string.match(value, "^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%d%.%d%d%dZ$") then V.fail("SCOPE", "Progress renewal requires exact UTC timestamps.") end
		local parsed, result = pcall(function(): any return DateTime.fromIsoDate(value) end)
		if not parsed or not result or type(result.UnixTimestampMillis) ~= "number" then V.fail("SCOPE", "Progress renewal timestamp is unavailable.") end
		return result.UnixTimestampMillis
	end
	local observed, expires = timestamp(progress.observedAt), timestamp(progress.expiresAt)
	local elapsed, received = os.clock() - started, DateTime.now().UnixTimestampMillis
	if elapsed < 0 or elapsed >= 4 or observed > received or expires - observed ~= 6000 or received >= expires then
		V.fail("SCOPE", "Progress acknowledgement is stale or exceeded its bounded wait; no engine work is admitted.")
	end
	-- Candidate is checked BEFORE replacing the prior permit. Every subsequent
	-- reconstruction guard enforces both server UTC and request-start duration.
	self.assetRenewal = {commandId = command.id, leaseEpoch = command.leaseEpoch, observedAt = observed, expiresAt = expires,
		monotonicStartedAt = started, monotonicExpiresAt = started + 6}
	self.assetEngineAdmitted = true
	self:guard(command, pair)
end

function Transport:dispatch(command: any): ()
	self:checkIdentity(self.pair) -- Also fences the cached-receipt fast path.
	self:envelope(command)
	local fingerprint = V.encode(command, self.http)
	local cached = self.cache[command.id]
	if cached then
		if cached.fingerprint ~= fingerprint then V.fail("RECONCILE", "Command ID was reused with a different payload.") end
		self.pending = cached -- Resend the immutable receipt; never execute twice.
		return
	end
	if command.leaseEpoch <= self.highEpoch then V.fail("LEASE", "New command has an old lease epoch.") end
	-- Fail closed without evicting command IDs or unacknowledged receipts.
	if self.cacheCount >= V.MAX_RECEIPTS or self.cacheBytes + #fingerprint + V.RESULT_BYTES + 4096 > V.MAX_CACHE_BYTES then
		V.fail("CAPACITY", "Session receipt capacity reached; inspect receipts and connect again.")
	end
	self.highEpoch = command.leaseEpoch
	local pair = self.pair
	self.executingCommand, self.assetProgressAt, self.assetRenewal, self.assetEngineAdmitted = command, nil, nil, false
	self:status("executing", command.method, command.id)
	local ok, output = pcall(function()
		self:guard(command, pair)
		return self.operations:execute(command, function() self:guard(command, pair) end)
	end)
	self.executingCommand = nil
	if self.stopped then return end
	local unsafe = not ok and type(output) == "table" and output.unsafe == true
	local payload: any = {sessionId = pair.sessionId, commandId = command.id,
		state = if ok then "succeeded" else "failed"}
	if ok then payload.result = output
	else
		payload.error = V.safeError(output)
		if unsafe then payload.result = output.recovery end
	end
	local encoded = V.encode(payload, self.http)
	local entry = {fingerprint = fingerprint, body = V.immutable(payload), unsafe = unsafe, acknowledged = false}
	self.cache[command.id] = entry
	self.cacheCount += 1
	self.cacheBytes += #fingerprint + #encoded
	self.pending = entry
	if unsafe then self.blocked = true end
end

function Transport:recover(): number
	local intent = self.recovery
	if not intent or intent.generation ~= self.generation or self.stopped then return Transport.POLL_SECONDS end
	self:checkAssetCleanup()
	if not self:isEdit() then return Transport.MAX_BACKOFF_SECONDS end
	if intent.attempts >= Transport.MAX_RECOVERY_ATTEMPTS then
		self:forgetRecovery()
		self:status("reconciliation", "Automatic recovery paused after eight attempts. Click Connect to try again.")
		return Transport.MAX_BACKOFF_SECONDS
	end
	if not intent.fence then
		intent.fence = self:watchIdentity({clientSessionId = self.clientSessionId, placeId = self.gameModel.PlaceId,
			universeId = self.gameModel.GameId, name = V.string(self.gameModel.Name, "place name", 200), pluginVersion = V.VERSION})
	end
	if not self:observeIdentity(intent.fence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
	intent.attempts += 1
	local payload = {protocolVersion = V.PROTOCOL, apiKey = intent.apiKey,
		identity = intent.fence.identity, sessionId = intent.sessionId}
	local ok, result = pcall(function() return self:post(intent.url, ROUTES.status, payload, nil) end)
	payload.apiKey = nil
	if self.stopped or self.recovery ~= intent or self.generation ~= intent.generation or self.disconnectRequested then return Transport.POLL_SECONDS end
	if not ok then error(result, 0) end
	if not self:observeIdentity(intent.fence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
	V.fields(result, {"protocolVersion", "identity", "state", "sessionId"}, "session status")
	if result.protocolVersion ~= V.PROTOCOL or not V.equal(result.identity, intent.fence.identity) then
		V.fail("PROTOCOL", "Session status does not match the exact plugin identity.")
	end
	if result.state == "active" then
		V.string(result.sessionId, "session ID", 256)
		-- A lost connect ACK may have created this session. Status must never
		-- reveal its bearer; wait for definitive loss, never supersede it blindly.
		self:status("reconciliation", "A session already exists; checking status before another connection.")
		return math.min(Transport.MAX_BACKOFF_SECONDS, Transport.POLL_SECONDS * 2 ^ intent.attempts)
	end
	if result.state == "reconciliation" then V.fail("RECONCILE", "Daemon requires command reconciliation before connecting.") end
	if result.state == "lost" then
		V.string(result.sessionId, "session ID", 256)
		if intent.sessionId and result.sessionId ~= intent.sessionId then V.fail("PROTOCOL", "Session status targets another session.") end
	elseif result.state == "absent" then
		if result.sessionId ~= nil then V.fail("PROTOCOL", "Absent session status contains a session.") end
	else V.fail("PROTOCOL", "Unsupported session status.") end
	-- This status belongs to the current exact key and epoch, and was just read
	-- by the single worker. No old command, receipt, grant or token is reused.
	self:status("connecting", "Session loss confirmed; reconnecting to Arcane.")
	if self.recovery ~= intent or self.generation ~= intent.generation or self.disconnectRequested or not self:isEdit() then return Transport.POLL_SECONDS end
	self:exchange({url = intent.url, apiKey = intent.apiKey, generation = intent.generation})
	return Transport.POLL_SECONDS
end

function Transport:tick(): number
	if self.stopped then return Transport.POLL_SECONDS end
	if self.checkInput then self.checkInput() end
	if self.assetCleanupFailed then return Transport.MAX_BACKOFF_SECONDS end
	if self.disconnectRequested then
		local old = self.pair
		if old and old.token then
			-- Best effort revoke, never retry a disconnect forever while pairing.
			pcall(function() self:post(old.url, ROUTES.disconnect, {sessionId = old.sessionId}, old.token) end)
		end
		self:clearSession()
		self.disconnectRequested = false
		if not self.desiredPair then self:status("disconnected", "Disconnected. Enter your Arcane API key and click Connect.") end
	end
	if self.assetCleanupFailed then return Transport.MAX_BACKOFF_SECONDS end
	if self.desiredPair then
		local desired = self.desiredPair
		self.desiredPair = nil
		-- An uncertain exchange can only be followed by a fresh read-only status,
		-- never by replaying this handshake.
		local ok, err = pcall(function() self:exchange(desired) end)
		desired.code, desired.apiKey = nil, nil
		if not ok and desired.generation == self.generation then
			if type(err) == "table" and err.code == "KEY_REJECTED" then
				self:clearSession()
				self:forgetRecovery()
				self.generation += 1
				self:status("failed", "Arcane API key was rejected. Enter a new API key.")
			else
				if type(err) ~= "table" or err.code ~= "NETWORK" then self:forgetRecovery() end
				self:status(if type(err) == "table" and err.code == "IDENTITY" then "reconciliation" else "disconnected", V.safeError(err) .. " Click Connect to try again.")
			end
		end
		return if not ok then Transport.MAX_BACKOFF_SECONDS else Transport.POLL_SECONDS
	end
	local pair = self.pair
	if not pair then
		if self.recovery and self.recovery.needsStatus and not self.blocked then return self:recover() end
		return Transport.POLL_SECONDS
	end
	self:observeIdentity(pair.identityFence)
	-- Retained buffers/EditableMeshes belong to one Edit epoch, including while
	-- idle. Retirement is local and never turns a historical receipt into a retry.
	local observed, observation = pcall(function(): any return if self.testProof then self.testProof:snapshot() else nil end)
	if not observed then observation = nil end
	if self.operations and self.operations.retireAssetContinuity then
		local cleaned = pcall(function() self.operations:retireAssetContinuity(observation) end)
		if not cleaned then
			self:disposeOperations()
			self.assetCleanupFailed = true; self.blocked = true
			V.fail("CLEANUP", ASSET_CLEANUP_FAILED)
		end
	end
	if self.pending then
		local receipt = self.pending
		local response = self:post(pair.url, ROUTES.result, receipt.body, pair.token)
		if response.accepted ~= true then V.fail("RECONCILE", "Daemon did not acknowledge the receipt.") end
		receipt.acknowledged = true
		self.pending = nil
		self:status(if self.blocked then "reconciliation" else "connected",
			if self.blocked then "Partial change: inspect the command and place before pairing again." else "Receipt acknowledged.", receipt.body.commandId)
		-- Poll for the next queued command at once; only idle polls wait.
		return if self.blocked then Transport.POLL_SECONDS else 0
	end
	if self.blocked then return Transport.POLL_SECONDS end
	local response = self:post(pair.url, ROUTES.poll, {sessionId = pair.sessionId, observation = observation}, pair.token)
	-- A poll that returns after disconnect/re-pair can never dispatch old work.
	if self.stopped or self.pair ~= pair or self.generation ~= pair.generation or self.disconnectRequested then return Transport.POLL_SECONDS end
	self:checkIdentity(pair)
	V.fields(response, {"commands"}, "poll response")
	local commands = V.list(response.commands, 1, "command queue")
	if #commands == 1 then
		self:dispatch(commands[1])
		return 0 -- Post the receipt on the next tick without an idle sleep.
	end
	self:status("connected", if self:isEdit() then "Connected; waiting for commands." else "Connected; commands are fenced during playtesting.")
	return Transport.POLL_SECONDS
end

function Transport:cycle(): number
	local generation = self.generation
	local ok, delay = pcall(function() return self:tick() end)
	if ok then self.failures = 0; return delay end
	if self.stopped or generation ~= self.generation then return Transport.POLL_SECONDS end
	if type(delay) == "table" and delay.code == "NETWORK" then
		self.failures = math.min(self.failures + 1, 5)
		local backoff = math.min(Transport.MAX_BACKOFF_SECONDS, Transport.POLL_SECONDS * 2 ^ self.failures)
		self:status("retrying", "Loopback unavailable; checking again in " .. tostring(backoff) .. " seconds. Commands are never replayed.")
		return backoff
	end
	local wasBlocked = self.blocked
	self.blocked = true
	if type(delay) == "table" and delay.code == "REVOKED" then
		local intent = self.recovery
		local safe = intent and not wasBlocked and not (self.identityFence and self.identityFence.changed)
			and not (self.pending and self.pending.unsafe)
		-- Loss fences every old callback immediately. Pending receipts stay at the
		-- old daemon for reconciliation and are never sent under replacement auth.
		self:clearSession(safe == true)
		self.generation += 1
		if safe and not self.assetCleanupFailed then intent.generation = self.generation; intent.needsStatus = true; intent.attempts = 0
		else self:forgetRecovery(); self.blocked = wasBlocked or self.assetCleanupFailed end
		self:status(if self.blocked then "reconciliation" else "disconnected", V.safeError(delay))
	elseif type(delay) == "table" and delay.code == "KEY_REJECTED" then
		self:clearSession(); self:forgetRecovery(); self.generation += 1
		self:status("failed", "Arcane API key was rejected. Enter a new API key.")
	else
		self:forgetRecovery()
		self:status("reconciliation", V.safeError(delay))
	end
	return Transport.MAX_BACKOFF_SECONDS
end

function Transport:start(): ()
	if self.started then return end
	self.started = true
	task.spawn(function()
		while not self.stopped do
			local delay = self:cycle()
			if self.stopped then break end
			task.wait(delay)
		end
	end)
end

return Transport
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane7">
<Properties>
<string name="Name">TestProof</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Construct against the plugin's Edit DataModel, before starting a playtest.
-- StudioTestService.EditModeActive is true while Edit is idle, false during a
-- play/Team Test session, and true again on stop (PluginSecurity read):
-- https://create.roblox.com/docs/reference/engine/classes/StudioTestService#EditModeActive
-- https://create.roblox.com/docs/reference/engine/classes/Object#GetPropertyChangedSignal
-- Each EditModeActive notification advances the epoch, including deferred ones.
-- Pause/resume within the same test does not change EditModeActive or the epoch.
-- Edit RunService.RunState stays Stopped during play; it cannot prove continuity.
-- Native notification delivery and Edit DataModel persistence need Studio QA.
-- Runtime ServerStorage receives a CLONE: its attributes are an identity witness,
-- never an authoritative epoch. Use the authenticated plugin HTTP snapshot for that.
local TestProof = {}

export type Snapshot = {
	read sessionId: string, read clientLifetimeId: string, read pluginArtifactHash: string, read markerName: string,
	read placeId: number, read universeId: number, read placeName: string,
	read playEpoch: number, read mode: "Edit" | "Play", read connected: boolean, read continuitySupported: boolean,
}
export type State = {
	bind: (self: State, sessionId: string, allowWrites: boolean) -> Snapshot?,
	snapshot: (self: State) -> Snapshot?,
	disconnect: (self: State) -> (),
	stop: (self: State) -> (),
}
type Attributes = {[string]: string | number | boolean}

local MAX_NAME_ATTEMPTS = 4
local MAX_COUNTER = 9007199254740991 -- Never wrap or lose monotonicity in a double.

local function publicId(value: any): boolean
	return type(value) == "string" and #value > 0 and #value <= 256 and not string.find(value, "%c")
end

function TestProof.new(gameModel: any, clientLifetimeId: string, pluginArtifactHash: string): State
	assert(publicId(clientLifetimeId), "TestProof requires a public client lifetime ID.")
	assert(type(pluginArtifactHash) == "string" and #pluginArtifactHash == 64
		and not string.find(pluginArtifactHash, "[^%x]"), "TestProof requires the loaded artifact SHA-256.")
	-- Keep exact Edit service references; never resolve a runtime copy by name.
	local serviceAvailable, testService = pcall(function(): any return gameModel:GetService("StudioTestService") end)
	if not serviceAvailable then testService = nil end
	local storage = gameModel:GetService("ServerStorage")
	local http = gameModel:GetService("HttpService")
	local sessionId: string? = nil
	local connected, allowWrites, stopped, fenced = false, false, false, false
	local continuitySupported = false
	local playEpoch = 0
	local mode: "Edit" | "Play" = "Edit"
	local observer: any = nil
	local marker: any = nil
	local markerName: string? = nil
	local expected: Attributes? = nil
	local state: State

	local function readMode(): "Edit" | "Play"
		assert(testService ~= nil, "StudioTestService is unavailable.")
		local editModeActive = testService.EditModeActive
		assert(type(editModeActive) == "boolean", "StudioTestService.EditModeActive must be a boolean.")
		return if editModeActive then "Edit" else "Play"
	end

	local function dropObserver(): ()
		continuitySupported, connected = false, false
		local connection = observer
		observer = nil
		if connection then pcall(function(): () connection:Disconnect() end) end
	end

	local function observeMode(): ()
		local ok, value = pcall(readMode)
		if ok then
			mode = value
		else
			dropObserver()
			-- Retain the last known mode only as unavailable metadata. RunService
			-- in the Edit model cannot provide a valid fallback during a test.
		end
		if observer then
			local live, isConnected = pcall(function(): boolean return observer.Connected == true end)
			if not live or not isConnected then dropObserver() end
		end
	end

	local function attributes(): Attributes
		return {
			SessionId = sessionId or "", ClientLifetimeId = clientLifetimeId,
			PluginArtifactHash = pluginArtifactHash, MarkerName = markerName or "", PlaceId = gameModel.PlaceId,
			UniverseId = gameModel.GameId, PlaceName = gameModel.Name,
			PlayEpoch = playEpoch, Mode = mode, Connected = connected,
			ContinuitySupported = continuitySupported,
		}
	end

	local function unchanged(): boolean
		if not marker or not expected then return false end
		local ok, matches = pcall(function(): boolean
			if marker.ClassName ~= "Folder" or marker.Name ~= markerName or marker.Parent ~= storage
				or marker.Archivable ~= true or storage.Parent ~= gameModel
				or marker:FindFirstChildWhichIsA("Instance") ~= nil or #marker:GetTags() ~= 0 then
				return false
			end
			local actual: Attributes = marker:GetAttributes()
			for key, value in pairs(expected :: Attributes) do if actual[key] ~= value then return false end end
			for key in pairs(actual) do if (expected :: Attributes)[key] == nil then return false end end
			return true
		end)
		return ok and matches
	end

	local function invalidate(): ()
		-- Sticky: retain at most one contested marker and never create replacements.
		-- Only these revocation attributes may change after a foreign edit. Everything
		-- else (including foreign children, tags, names and attributes) is preserved.
		fenced, connected, allowWrites = true, false, false
		if marker then
			pcall(function(): () marker:SetAttribute("Connected", false) end)
			pcall(function(): () marker:SetAttribute("Invalid", true) end)
		end
	end

	local function publish(): ()
		if not marker or fenced then return end
		if not unchanged() then invalidate(); return end
		local values = attributes()
		local ownedAttributes = expected :: Attributes
		local ok = pcall(function(): ()
			for key, value in pairs(values) do
				if ownedAttributes[key] ~= value then
					assert(unchanged(), "TestProof witness changed during publication.")
					marker:SetAttribute(key, value)
					ownedAttributes[key] = value
					-- Attribute listeners can edit another field synchronously. Detect
					-- that before a subsequent planned write could overwrite it.
					assert(unchanged(), "TestProof witness changed during publication.")
				end
			end
		end)
		if not ok then invalidate(); return end
		expected = values
		if not unchanged() then invalidate() end
	end

	local function retire(): ()
		if not marker then return end
		if fenced or not unchanged() then invalidate(); return end
		-- Revoke before removal. If any operation/readback fails, keep the witness
		-- invalid rather than deleting a marker whose contents are now uncertain.
		publish()
		if fenced then return end
		local ok = pcall(function(): () marker:Destroy() end)
		if not ok then invalidate(); return end
		marker, markerName, expected = nil, nil, nil
	end

	local function install(): ()
		if marker or fenced then return end
		local chosen: string? = nil
		local ok = pcall(function(): ()
			assert(storage.Parent == gameModel, "Edit ServerStorage is unavailable.")
			for _ = 1, MAX_NAME_ATTEMPTS do
				local guid = http:GenerateGUID(false)
				assert(type(guid) == "string" and #guid == 36 and not string.find(guid, "[^%x%-]"), "Invalid GUID.")
				local name = "ArcaneTestProof_" .. guid
				-- Keep a public candidate even if installation fails, so a bound
				-- unavailable proof still satisfies the host's eleven-field schema.
				markerName = name
				if not storage:FindFirstChild(name) then chosen = name; break end
			end
			assert(chosen ~= nil, "TestProof name capacity reached.")
		end)
		if not ok then invalidate(); return end
		markerName = chosen
		-- A helper loaded during play can report an unavailable witness, but cannot
		-- install into a runtime DataModel and mistake that clone for Edit ownership.
		if mode ~= "Edit" then connected = false; return end
		ok = pcall(function(): ()
			marker = Instance.new("Folder")
			marker.Name = chosen
			marker.Archivable = true -- Allow native runtime identity witnesses to clone.
			expected = attributes()
			for key, value in pairs(expected :: Attributes) do marker:SetAttribute(key, value) end
			marker.Parent = storage
		end)
		if not ok or not unchanged() then invalidate() end
	end

	state = {
		snapshot = function(_self: State): Snapshot?
			observeMode()
			-- Sampling reports the current mode; it NEVER manufactures an epoch.
			publish()
			local boundSessionId, boundMarkerName = sessionId, markerName
			if not boundSessionId or not boundMarkerName then return nil end
			local result: Snapshot = {
				sessionId = boundSessionId, clientLifetimeId = clientLifetimeId, pluginArtifactHash = pluginArtifactHash,
				markerName = boundMarkerName,
				placeId = gameModel.PlaceId, universeId = gameModel.GameId, placeName = gameModel.Name,
				playEpoch = playEpoch, mode = mode, connected = connected,
				continuitySupported = continuitySupported,
			}
			table.freeze(result)
			return result
		end,
		bind = function(_self: State, nextSessionId: string, nextAllowWrites: boolean): Snapshot?
			assert(publicId(nextSessionId), "TestProof requires a public session ID.")
			assert(type(nextAllowWrites) == "boolean", "TestProof requires a boolean write grant.")
			if stopped or fenced then return state:snapshot() end
			observeMode()
			if sessionId ~= nextSessionId or allowWrites ~= nextAllowWrites then
				connected, allowWrites = false, false
				retire()
				if fenced then return state:snapshot() end
				sessionId, connected, allowWrites = nextSessionId, continuitySupported, nextAllowWrites
			end
			-- This bounded internal witness exists for read-only sessions too.
			-- Grant changes replace it; they never authorize writes to game content.
			if not marker and mode == "Edit" then connected = continuitySupported end
			install()
			return state:snapshot()
		end,
		disconnect = function(_self: State): ()
			connected, allowWrites = false, false
			retire()
			sessionId = nil
			-- Keep the one lifetime observer across disconnect/re-pair gaps.
		end,
		stop = function(_self: State): ()
			if stopped then return end
			stopped = true -- Ignore callbacks already queued before Disconnect().
			dropObserver()
			state:disconnect()
		end,
	}

	-- Fail closed if this genuine property observer cannot be installed. One
	-- notification counts even if all deferred callbacks see the same boolean.
	local ok = pcall(function(): ()
		mode = readMode()
		observer = testService:GetPropertyChangedSignal("EditModeActive"):Connect(function(): ()
			if stopped or not continuitySupported then return end
			if playEpoch >= MAX_COUNTER then dropObserver(); invalidate(); return end
			playEpoch += 1
			observeMode()
			publish()
		end)
		assert(observer and observer.Connected == true, "EditModeActive observer is unavailable.")
	end)
	if ok then continuitySupported = true else dropObserver() end
	observeMode()
	return state
end

return TestProof
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane8">
<Properties>
<string name="Name">Sha256</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- SHA-256 over raw string bytes (including UTF-8), per FIPS 180-4.
-- Synchronous and bounded: no services, dependencies, or yielding.

local MAX_BYTES = 512 * 1024
local WORD_MASK = 0xffffffff
local ROUND_CONSTANTS: {number} = table.freeze({
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
})

local band, bxor, bnot = bit32.band, bit32.bxor, bit32.bnot
local lshift, rshift, rrotate = bit32.lshift, bit32.rshift, bit32.rrotate

local function compress(state: {number}, words: {number}, bytes: string, offset: number): ()
	for index = 1, 16 do
		local first = offset + (index - 1) * 4
		local a, b, c, d = string.byte(bytes, first, first + 3)
		words[index] = lshift(a, 24) + lshift(b, 16) + lshift(c, 8) + d
	end
	for index = 17, 64 do
		local previous15, previous2 = words[index - 15], words[index - 2]
		local sigma0 = bxor(rrotate(previous15, 7), rrotate(previous15, 18), rshift(previous15, 3))
		local sigma1 = bxor(rrotate(previous2, 17), rrotate(previous2, 19), rshift(previous2, 10))
		words[index] = band(words[index - 16] + sigma0 + words[index - 7] + sigma1, WORD_MASK)
	end

	local a, b, c, d, e, f, g, h = state[1], state[2], state[3], state[4], state[5], state[6], state[7], state[8]
	for index = 1, 64 do
		local sigma1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
		local choose = bxor(band(e, f), band(bnot(e), g))
		local temporary1 = band(h + sigma1 + choose + ROUND_CONSTANTS[index] + words[index], WORD_MASK)
		local sigma0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
		local majority = bxor(band(a, b), band(a, c), band(b, c))
		local temporary2 = band(sigma0 + majority, WORD_MASK)
		h = g
		g = f
		f = e
		e = band(d + temporary1, WORD_MASK)
		d = c
		c = b
		b = a
		a = band(temporary1 + temporary2, WORD_MASK)
	end
	state[1] = band(state[1] + a, WORD_MASK)
	state[2] = band(state[2] + b, WORD_MASK)
	state[3] = band(state[3] + c, WORD_MASK)
	state[4] = band(state[4] + d, WORD_MASK)
	state[5] = band(state[5] + e, WORD_MASK)
	state[6] = band(state[6] + f, WORD_MASK)
	state[7] = band(state[7] + g, WORD_MASK)
	state[8] = band(state[8] + h, WORD_MASK)
end

local function digest(bytes: string): string
	if type(bytes) ~= "string" then
		error("SHA-256 input must be a string.", 2)
	end
	local length = #bytes
	if length > MAX_BYTES then
		error("SHA-256 input exceeds the 524288-byte limit.", 2)
	end

	-- All mutable working storage belongs to this call; module reuse cannot leak state.
	local state = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	local words: {number} = table.create(64, 0)
	local fullBytes = length - length % 64
	for offset = 1, fullBytes, 64 do
		compress(state, words, bytes, offset)
	end

	-- Actual padding bytes: 0x80, zeroes, then the original 64-bit big-endian bit length.
	-- The input cap keeps that length below 2^32, so its high word is always zero.
	local bitLength = length * 8
	local tail = string.sub(bytes, fullBytes + 1) .. "\128" .. string.rep("\0", (55 - length) % 64)
		.. string.char(0, 0, 0, 0, rshift(bitLength, 24), band(rshift(bitLength, 16), 0xff), band(rshift(bitLength, 8), 0xff), band(bitLength, 0xff))
	for offset = 1, #tail, 64 do
		compress(state, words, tail, offset)
	end

	return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", state[1], state[2], state[3], state[4], state[5], state[6], state[7], state[8])
end

return digest
]]></ProtectedString>
