<Item class="Script" referent="RBXArcane0">
<Properties>
<string name="Name">ArcaneLocalBridge</string>
<bool name="Archivable">true</bool>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Only the user's Arcane local key is remembered in Studio plugin settings.
-- Provider credentials and session bearers are never saved.
local V = require(script.Validation)
local Transport = require(script.Transport)
local Sha256 = require(script.Sha256)
local artifactHash = if typeof(script) == "Instance" and script:IsA("Script") then Sha256(script.Source) else nil
local KEY_SETTING = "Arcane.LocalApiKey.v1"
local STATE_SETTING = "Arcane.LastConnection.v1"
local savedKey: string? = nil
local lastKnownConnected = false
-- Legacy connected=false records describe transient health, not user intent.
-- Only an explicit opt-out in this existing owned record suppresses startup.
local autoConnect = true
local storedOptOut = false
local storageFailed = false
local keyRead, previousKey = pcall(function() return plugin:GetSetting(KEY_SETTING) end)
if keyRead and type(previousKey) == "string" then
	local valid = pcall(function() V.keyOrigin(previousKey) end)
	if valid then savedKey = previousKey end
end
previousKey = nil
local stateRead, previousState = pcall(function() return plugin:GetSetting(STATE_SETTING) end)
if stateRead and type(previousState) == "table" and getmetatable(previousState) == nil then
	local count = 0
	for _ in pairs(previousState) do count += 1 end
	if (count == 1 or (count == 2 and type(previousState.autoConnect) == "boolean"))
		and type(previousState.connected) == "boolean" then
		lastKnownConnected = previousState.connected
		autoConnect = previousState.autoConnect ~= false
		storedOptOut = not autoConnect
	end
end
previousState = nil
local toolbar = plugin:CreateToolbar("Arcane")
local button = toolbar:CreateButton("ArcaneBridge", "Open Arcane", "", "Arcane")
button.ClickableWhenViewportHidden = true
-- A new stable widget identity migrates the old docked layout once. Studio
-- owns floating-window placement; opening the UI never connects a place.
local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, true, true, 260, 184, 230, 176)
local widget = plugin:CreateDockWidgetPluginGuiAsync("ArcaneLocalBridgeFloatingV3", info)
widget.Title = "Arcane"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local colors = {
	body = Color3.fromRGB(20, 20, 22), header = Color3.fromRGB(20, 20, 22),
	input = Color3.fromRGB(27, 27, 30), divider = Color3.fromRGB(52, 52, 58),
	white = Color3.fromRGB(245, 245, 245), muted = Color3.fromRGB(147, 147, 154),
	red = Color3.fromRGB(255, 51, 64),
	green = Color3.fromRGB(71, 203, 133), amber = Color3.fromRGB(225, 166, 68),
}
local panel = Instance.new("Frame")
panel.Name = "ArcanePanel"
panel.Size = UDim2.fromScale(1, 1)
panel.BackgroundColor3 = colors.body
panel.BorderSizePixel = 0
panel.Parent = widget

local function frame(name: string, parent: Instance, position: UDim2, size: UDim2, color: Color3): Frame
	local item = Instance.new("Frame")
	item.Name, item.Position, item.Size = name, position, size
	item.BackgroundColor3 = color
	item.BorderSizePixel = 0
	item.Parent = parent
	return item
end
local function corner(parent: Instance, radius: number): ()
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = parent
end
local function label(name: string, parent: Instance, text: string, position: UDim2, size: UDim2, textSize: number, color: Color3): TextLabel
	local item = Instance.new("TextLabel")
	item.Name, item.Position, item.Size = name, position, size
	item.BackgroundTransparency = 1
	item.Text, item.TextColor3 = text, color
	item.Font = Enum.Font.Gotham
	item.TextSize = textSize
	item.RichText = false
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextYAlignment = Enum.TextYAlignment.Center
	item.Parent = parent
	return item
end

-- Center the visible logo-to-button bounds (8..134) at every widget height.
-- All 152px of content, including bottom padding, fit the 176px minimum.
local content = frame("Content", panel, UDim2.new(0, 0, 0.5, -71), UDim2.new(1, 0, 0, 152), colors.body)
content.BackgroundTransparency = 1
local panelPadding = Instance.new("UIPadding")
panelPadding.PaddingBottom = UDim.new(0, 18)
panelPadding.Parent = content
local header = frame("Header", content, UDim2.new(), UDim2.new(1, 0, 0, 48), colors.header)
local mark = frame("ArcaneMark", header, UDim2.new(0, 14, 0, 8), UDim2.new(0, 32, 0, 32), colors.header)
mark.BackgroundTransparency = 1
-- Exact polygons from the desktop's 64x64 SVG, as bounded native scanlines.
-- No upload, remote logo, or white/orange substitute.
local function polygon(name: string, points: {{number}}, transparency: number): ()
	for row = 0, 63 do
		local scan, crossings = row + 0.5, {}
		for index, a in ipairs(points) do
			local b = points[index % #points + 1]
			if (a[2] <= scan and b[2] > scan) or (b[2] <= scan and a[2] > scan) then
				table.insert(crossings, a[1] + (scan - a[2]) * (b[1] - a[1]) / (b[2] - a[2]))
			end
		end
		table.sort(crossings)
		for index = 1, #crossings - 1, 2 do
			local left, right = crossings[index], crossings[index + 1]
			local strip = frame(name .. tostring(row), mark, UDim2.new(left / 64, 0, row / 64, 0), UDim2.new((right - left) / 64, 0, 1 / 64, 0), colors.red)
			strip.BackgroundTransparency = transparency
		end
	end
end
polygon("LogoLegs", {{32,4},{4,57},{17,57},{32,28},{47,57},{60,57}}, 0)
polygon("LogoCrossbar", {{27,40},{46,53},{40,40}}, 0)
polygon("LogoFacet", {{19,21},{26,26},{32,14},{27,6}}, 0.2)
local brand = label("Brand", header, "Arcane", UDim2.new(0, 57, 0, 10), UDim2.new(1, -73, 0, 28), 20, colors.white)
brand.Font = Enum.Font.GothamBold

local connectButton = Instance.new("TextButton")
connectButton.Name = "Connect"
connectButton.Position = UDim2.new(0, 14, 0, 100)
connectButton.Size = UDim2.new(1, -28, 0, 34)
connectButton.BackgroundColor3 = colors.red
connectButton.BorderSizePixel = 0
connectButton.Text, connectButton.TextColor3 = if savedKey then "Reconnect" else "Connect", colors.white
connectButton.Font = Enum.Font.GothamMedium
connectButton.TextSize = 14
connectButton.RichText = false
connectButton.Parent = content
corner(connectButton, 6)

local inputPanel = frame("KeyInput", content, UDim2.new(0, 14, 0, 54), UDim2.new(1, -28, 0, 36), colors.input)
corner(inputPanel, 5)
local stroke = Instance.new("UIStroke")
stroke.Color, stroke.Thickness = colors.divider, 1
stroke.Parent = inputPanel

-- Keep Studio's ordinary text editing and selection. The user's own saved
-- Arcane key remains visible here, including while connected.
local keyInput = Instance.new("TextBox")
keyInput.Name = "ApiKey"
keyInput.Position = UDim2.new()
keyInput.Size = UDim2.fromScale(1, 1)
keyInput.BackgroundTransparency = 1
keyInput.BorderSizePixel = 0
keyInput.ZIndex = 3
keyInput.Active = true
keyInput.Selectable = true
keyInput.Text = savedKey or ""
keyInput.TextColor3 = colors.white
keyInput.TextTransparency = 0
keyInput.MaxVisibleGraphemes = -1
keyInput.ClearTextOnFocus = false
keyInput.MultiLine = false
keyInput.RichText = false
keyInput.TextEditable = true
keyInput.TextSize = 13
keyInput.Font = Enum.Font.Gotham
keyInput.TextXAlignment = Enum.TextXAlignment.Left
keyInput.Parent = inputPanel
local inputPadding = Instance.new("UIPadding")
inputPadding.PaddingLeft, inputPadding.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
inputPadding.Parent = keyInput
keyInput.PlaceholderColor3 = colors.muted
local hint = "Arcane API key"
local keyFailed = false
local inputText = keyInput.Text
local function refreshHint(): ()
	keyInput.PlaceholderText = hint
end
local function clearInput(): ()
	inputText = "" -- Programmatic cleanup is not a new user edit.
	keyInput.Text = ""
	refreshHint()
end
refreshHint()
local function rememberState(connected: boolean, allowed: boolean?): ()
	if allowed ~= nil then autoConnect = allowed end
	-- Key edits/rejections already remove saved auth. Persist an opt-out only
	-- when a valid saved key remains (an explicit transport disconnect).
	local optOut = not autoConnect and savedKey ~= nil
	if lastKnownConnected == connected and storedOptOut == optOut then return end
	local record: any = {connected = connected}
	if optOut then record.autoConnect = false end
	local ok = pcall(function() plugin:SetSetting(STATE_SETTING, record) end)
	if ok then lastKnownConnected, storedOptOut = connected, optOut else storageFailed = true end
end
local function rejectKey(): ()
	-- A rejected key must not become a persistent reconnect trap. Clearing this
	-- owned setting never revokes a key at the daemon or touches provider logins.
	keyFailed, savedKey, hint = true, nil, "Enter a new API key"
	local ok = pcall(function() plugin:SetSetting(KEY_SETTING, "") end)
	if not ok then storageFailed = true end
	rememberState(false, false)
	connectButton.Text = "Failed"
	connectButton.BackgroundColor3, stroke.Color = colors.red, colors.red
	clearInput()
end
local transport: any
local function invalidateInput(): boolean
	if keyInput.Text == inputText then return false end
	inputText = keyInput.Text
	keyFailed, hint = false, "Arcane API key"
	if savedKey ~= nil then
		savedKey = nil
		local ok = pcall(function() plugin:SetSetting(KEY_SETTING, "") end)
		if not ok then storageFailed = true end
	end
	rememberState(false)
	-- Advance the transport generation on every edit, before another click.
	-- This forgets queued keys and fences yielding polls/editor callbacks.
	transport:requestDisconnect()
	refreshHint()
	return true
end
transport = Transport.new(game, function(status: any)
	-- Studio may defer the Text signal. Inspect the actual field before a late
	-- ACK/rejection or dispatch status can adopt the previous input's outcome.
	if invalidateInput() then return end
	if status.state == "failed" then rejectKey(); return end
	if status.state == "disconnecting" then rememberState(false, false)
	elseif status.state == "connecting" then rememberState(false, true) end
	local live = savedKey ~= nil and keyInput.Text == savedKey and status.sessionId ~= nil
		and (status.state == "connected" or status.state == "executing")
	-- Cached history never establishes a current session or green status.
	connectButton.BackgroundColor3 = if live and not keyFailed then colors.green else colors.red
	connectButton.Text = if keyFailed then "Failed" elseif live then "Connected" elseif savedKey then "Reconnect" else "Connect"
	if live then rememberState(true)
	else rememberState(false) end
	stroke.Color = if storageFailed then colors.amber elseif status.state == "retrying" or status.state == "reconciliation" then colors.red else colors.divider
end, artifactHash)
-- Check deferred text edits before every worker cycle and after every yielding
-- HTTP call, including status recovery that has not yet emitted a UI callback.
transport.checkInput = invalidateInput
-- A deferred Text signal must also be caught inside an already dispatched
-- editor callback. Keep the transport's original lifetime/lease checks intact.
local guard = transport.guard
transport.guard = function(client: any, command: any, pair: any): ()
	invalidateInput()
	guard(client, command, pair)
end
local connections: {RBXScriptConnection} = {}
table.insert(connections, button.Click:Connect(function() widget.Enabled = not widget.Enabled end))
table.insert(connections, widget:GetPropertyChangedSignal("Enabled"):Connect(function() button:SetActive(widget.Enabled) end))
button:SetActive(widget.Enabled)
table.insert(connections, keyInput:GetPropertyChangedSignal("Text"):Connect(function()
	invalidateInput()
end))
table.insert(connections, connectButton.Activated:Connect(function()
	invalidateInput()
	local entered = keyInput.Text -- Deleting the field never falls back to an old key.
	local valid = pcall(function() V.keyOrigin(entered) end)
	if not valid then
		rejectKey()
		-- Explicit failed input also fences any queued or live connection.
		transport:requestDisconnect()
		return
	end
	keyFailed, hint = false, "Arcane API key"
	local value = entered :: string
	local stored = pcall(function() plugin:SetSetting(KEY_SETTING, value) end)
	savedKey, storageFailed = value, not stored
	refreshHint()
	connectButton.Text, connectButton.BackgroundColor3 = "Reconnect", colors.red
	local ok = pcall(function() transport:requestConnect(value) end)
	if not ok then transport:requestDisconnect(); rememberState(false); stroke.Color = colors.red end
	entered, value = nil, ""
end))
table.insert(connections, plugin.Unloading:Connect(function()
	savedKey = nil
	clearInput()
	transport:stop()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	widget:Destroy()
	toolbar:Destroy()
end))
-- Queue safe recovery from any saved key unless the user explicitly opted out.
-- Cached health never proves a connection. Status precedes authentication; no
-- old session token, command, receipt or grant is restored in a new lifetime.
if savedKey ~= nil and autoConnect then
	local ok = pcall(function() transport:requestConnect(savedKey, true) end)
	if not ok then rememberState(false) end
end
transport:start()
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBXArcane1">
<Properties>
<string name="Name">Types</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Wire definitions mirror packages/protocol/src/studio.ts (protocol v1).
export type InstanceRef = {
	instanceId: string, sessionId: string, root: string,
	pathSegments: {string}, className: string,
}
export type PairResult = {
	sessionId: string, token: string, protocolVersion: number,
	allowedRoots: {string}, allowWrites: boolean,
}
export type Command = {
	protocolVersion: number, id: string, requestId: string, sessionId: string,
	clientSessionId: string, method: string, args: {[string]: any},
	allowedRoots: {string}, allowWrites: boolean, leaseEpoch: number,
	expiresAt: string, state: string,
}
export type MutationReceipt = {
	kind: string, ref: InstanceRef, before: any, after: {[string]: any},
}
export type Outcome = {state: string, result: any?, error: string?, unsafe: boolean?}
return {}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane2">
<Properties>
<string name="Name">Validation</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local Validation = {}
Validation.PROTOCOL = 1
Validation.VERSION = "0.1.7"
Validation.ARGUMENT_BYTES = 256 * 1024
Validation.RESULT_BYTES = 512 * 1024
Validation.SOURCE_BYTES = 100 * 1024
Validation.MAX_REFS = 20000
Validation.MAX_RECEIPTS = 1024
Validation.MAX_CACHE_BYTES = 16 * 1024 * 1024
Validation.NULL = table.freeze({})
local ARRAY = table.freeze({})
Validation.ROOTS = table.freeze({"Workspace", "ReplicatedStorage", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPlayer", "Lighting"})
Validation.READ_METHODS = table.freeze({"scene.children", "scene.inspect", "scene.search", "selection.read", "script.read"})
Validation.WRITE_METHODS = table.freeze({"scene.create", "scene.update", "script.update", "script.set_enabled", "scene.restore"})
Validation.CREATE_CLASSES = table.freeze({"Folder", "Model", "Part", "Script", "LocalScript", "ModuleScript", "WedgePart", "CornerWedgePart", "SpawnLocation"})
Validation.BASE_PART_CLASSES = table.freeze({"Part", "FlagStand", "Platform", "Seat", "SkateboardPlatform", "SpawnLocation", "MeshPart", "UnionOperation", "NegateOperation", "IntersectOperation", "WedgePart", "CornerWedgePart", "TrussPart", "VehicleSeat"})
Validation.PART_SHAPE_CLASSES = table.freeze({"Part", "FlagStand", "Platform", "Seat", "SkateboardPlatform", "SpawnLocation"})
Validation.SHAPES = table.freeze({"Block", "Ball", "Cylinder"})
Validation.MAX_PROPERTIES = 12

function Validation.fail(code: string, message: string): never
	error(table.freeze({code = code, message = message}), 0)
end

function Validation.object(value: any, label: string): {[string]: any}
	if type(value) ~= "table" or value == Validation.NULL or getmetatable(value) == ARRAY then
		Validation.fail("INPUT", label .. " must be an object.")
	end
	for key in pairs(value) do
		if type(key) ~= "string" or key == "__proto__" or key == "constructor" or key == "prototype" then
			Validation.fail("INPUT", label .. " contains an invalid key.")
		end
	end
	return value
end

function Validation.fields(value: any, allowed: {string}, label: string): {[string]: any}
	local result = Validation.object(value, label)
	for key in pairs(result) do
		if not table.find(allowed, key) then Validation.fail("INPUT", "Unsupported " .. label .. " field.") end
	end
	return result
end

function Validation.string(value: any, label: string, maximum: number, allowEmpty: boolean?): string
	if type(value) ~= "string" or #value > maximum or (not allowEmpty and #value == 0)
		or string.find(value, "\0", 1, true) or utf8.len(value) == nil then
		Validation.fail("INPUT", "Invalid " .. label .. ".")
	end
	return value
end

function Validation.number(value: any, low: number, high: number, label: string): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge or value < low or value > high then
		Validation.fail("INPUT", "Invalid " .. label .. ".")
	end
	return value
end

function Validation.integer(value: any, low: number, high: number, label: string): number
	local result = Validation.number(value, low, high, label)
	if result % 1 ~= 0 then Validation.fail("INPUT", label .. " must be an integer.") end
	return result
end

function Validation.boolean(value: any, label: string): boolean
	if type(value) ~= "boolean" then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	return value
end

-- Protocol enum names are data. Resolve only a bounded enum and verify the
-- native result before recording, allocating, or assigning any property.
function Validation.enum(value: any, allowed: {string}, category: any, label: string): any
	if type(value) ~= "string" or not table.find(allowed, value) then Validation.fail("PROPERTY", "Unsupported " .. label .. ".") end
	local ok, item = pcall(function() return category[value] end)
	if not ok or typeof(item) ~= "EnumItem" or item.EnumType ~= category or item.Name ~= value then
		Validation.fail("PROPERTY", "Native " .. label .. " enum is unavailable.")
	end
	return item
end

-- Extend the frozen legacy codec without changing its six-class public list.
-- Creation uses reflected class allowlists; existing objects use native IsA.
function Validation.geometryProperties(legacy: any): any
	local codec: any = {CLASSES = Validation.CREATE_CLASSES, MATERIALS = legacy.MATERIALS}
	local fields = table.clone(legacy.PART_FIELDS)
	for _, name in ipairs({"Orientation", "CastShadow", "Reflectance"}) do table.insert(fields, name) end
	codec.PART_FIELDS = table.freeze(fields)
	function codec.decode(name: string, value: any, isBasePart: boolean, isPart: boolean?): any
		if name == "Shape" then
			if not isPart then Validation.fail("PROPERTY", "Shape requires a native Part.") end
			return Validation.enum(value, Validation.SHAPES, Enum.PartType, name)
		end
		if name == "Orientation" or name == "CastShadow" or name == "Reflectance" then
			if not isBasePart then Validation.fail("PROPERTY", "Property requires a native BasePart.") end
			if name == "CastShadow" then return Validation.boolean(value, name) end
			if name == "Reflectance" then return Validation.number(value, 0, 1, name) end
			local tag = Validation.fields(value, {"type", "value"}, "tagged property")
			if tag.type ~= "Vector3" then Validation.fail("PROPERTY", "Incorrect property type tag.") end
			local components = Validation.list(tag.value, 3, "components")
			if #components ~= 3 then Validation.fail("PROPERTY", "Property needs three components.") end
			for _, component in ipairs(components) do Validation.number(component, -360, 360, name) end
			return Vector3.new(components[1], components[2], components[3])
		end
		if name == "Material" then
			if not isBasePart then Validation.fail("PROPERTY", "Property requires a native BasePart.") end
			return Validation.enum(value, legacy.MATERIALS, Enum.Material, name)
		end
		return legacy.decode(name, value, isBasePart)
	end
	function codec.encode(name: string, value: any): any
		if name == "Orientation" then return {type = "Vector3", value = Validation.array({value.X, value.Y, value.Z})} end
		if name == "Shape" then return value.Name end
		return legacy.encode(name, value)
	end
	function codec.validate(instance: any, values: any, service: boolean): ({[string]: any}, {string})
		Validation.object(values, "properties")
		local decoded: {[string]: any}, names: {string} = {}, {}
		for name, value in pairs(values) do
			if service then Validation.fail("SERVICE", "Service properties cannot be changed.") end
			if #names >= Validation.MAX_PROPERTIES then Validation.fail("INPUT", "Too many properties.") end
			decoded[name] = codec.decode(name, value, instance:IsA("BasePart"), instance:IsA("Part"))
			table.insert(names, name)
		end
		table.sort(names)
		return decoded, names
	end
	function codec.snapshot(instance: any, names: {string}?): {[string]: any}
		local selected: {string} = names or {"Name"}
		if not names and instance:IsA("BasePart") then
			selected = table.clone(codec.PART_FIELDS)
			table.insert(selected, "Name")
			if instance:IsA("Part") then table.insert(selected, "Shape") end
		end
		local result: {[string]: any} = {}
		for _, name in ipairs(selected) do result[name] = codec.encode(name, instance[name]) end
		if not names and instance:IsA("BaseScript") then result.Disabled = instance.Disabled end
		return result
	end
	function codec.compare(instance: any, expected: any, names: {string}): boolean
		local decoded = codec.validate(instance, expected, false)
		for _, name in ipairs(names) do
			if expected[name] == nil or instance[name] ~= decoded[name] then return false end
		end
		return true
	end

	function codec.assignedMatches(instance: any, name: string, requested: any): boolean
		if name == "Orientation" then
			-- Euler values wrap and can have equivalent gimbal representations.
			-- Check the actual rotation, not a relaxed expected-baseline match.
			local desired = {CFrame.fromOrientation(math.rad(requested.X), math.rad(requested.Y), math.rad(requested.Z)):GetComponents()}
			local actual = {instance.CFrame:GetComponents()}
			for index = 4, 12 do
				if math.abs(actual[index] - desired[index]) > 0.000001 then return false end
			end
			return true
		end
		return legacy.assignedMatches(instance, name, requested)
	end
	return table.freeze(codec)
end

function Validation.array(value: {any}): {any}
	return setmetatable(value, ARRAY)
end

function Validation.list(value: any, maximum: number, label: string): {any}
	if type(value) ~= "table" or value == Validation.NULL or (#value == 0 and getmetatable(value) ~= ARRAY) or #value > maximum then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	local count = 0
	for key in pairs(value) do
		count += 1
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #value then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	end
	if count ~= #value then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	return value
end

function Validation.roots(value: any): {string}
	local roots = Validation.list(value, #Validation.ROOTS, "roots")
	if #roots == 0 then Validation.fail("INPUT", "At least one root is required.") end
	local seen: {[string]: boolean} = {}
	for _, root in ipairs(roots) do
		if type(root) ~= "string" or not table.find(Validation.ROOTS, root) or seen[root] then Validation.fail("INPUT", "Invalid or duplicate root.") end
		seen[root] = true
	end
	return table.clone(roots)
end

function Validation.url(value: any): string
	local input = Validation.string(value, "daemon URL", 64)
	local portText = string.match(input, "^http://127%.0%.0%.1:([1-9][0-9]*)$")
	if not portText or #portText > 5 then Validation.fail("URL", "Use exactly http://127.0.0.1:PORT.") end
	Validation.integer(tonumber(portText), 1, 65535, "port")
	return input
end


-- The key carries only the literal loopback port. Never extract or display its
-- secret; keep the original key only until the human-triggered exchange starts.
function Validation.keyOrigin(value: any): string
	local input = Validation.string(value, "Arcane API key", 86)
	local port, secret = string.match(input, "^arcane_local_v1_([1-9][0-9]*)_([0-9a-f]+)$")
	if not port or #port > 5 or not secret or #secret ~= 64 then Validation.fail("KEY", "Enter a valid Arcane local API key.") end
	Validation.integer(tonumber(port), 1, 65535, "key port")
	return Validation.url("http://127.0.0.1:" .. port)
end

function Validation.equal(left: any, right: any): boolean
	if left == Validation.NULL or right == Validation.NULL then return left == right end
	if type(left) ~= type(right) then return false end
	if type(left) ~= "table" then return left == right end
	if (getmetatable(left) == ARRAY) ~= (getmetatable(right) == ARRAY) then return false end
	for key, item in pairs(left) do if not Validation.equal(item, right[key]) then return false end end
	for key, item in pairs(right) do if not Validation.equal(item, left[key]) then return false end end
	return true
end

function Validation.immutable(value: any): any
	if type(value) ~= "table" or value == Validation.NULL then return value end
	local copy: any = {}
	for key, item in pairs(value) do copy[key] = Validation.immutable(item) end
	if getmetatable(value) == ARRAY then setmetatable(copy, ARRAY) end
	return table.freeze(copy)
end

-- HttpService encodes {} as [] and drops nil. Preserve protocol objects and null
-- explicitly, and sort keys so identical result retries are byte-for-byte stable.
function Validation.encode(value: any, http: any): string
	local function encode(item: any, depth: number): string
		if depth > 80 then Validation.fail("INPUT", "JSON nesting is too deep.") end
		if item == nil or item == Validation.NULL then return "null" end
		local kind = type(item)
		if kind == "string" then
			if utf8.len(item) == nil then Validation.fail("INPUT", "Invalid UTF-8.") end
			return http:JSONEncode(item)
		end
		if kind == "boolean" then return if item then "true" else "false" end
		if kind == "number" then
			Validation.number(item, -math.huge, math.huge, "JSON number")
			return http:JSONEncode(item)
		end
		if kind ~= "table" then Validation.fail("INPUT", "Non-JSON value.") end
		local array = getmetatable(item) == ARRAY or #item > 0
		local pieces: {string} = {}
		if array then
			Validation.list(item, 20000, "JSON array")
			for _, child in ipairs(item) do table.insert(pieces, encode(child, depth + 1)) end
			return "[" .. table.concat(pieces, ",") .. "]"
		end
		Validation.object(item, "JSON object")
		local keys: {string} = {}
		for key in pairs(item) do table.insert(keys, key) end
		table.sort(keys)
		for _, key in ipairs(keys) do table.insert(pieces, http:JSONEncode(key) .. ":" .. encode(item[key], depth + 1)) end
		return "{" .. table.concat(pieces, ",") .. "}"
	end
	return encode(value, 0)
end


-- Preserve null entries and empty arrays; native JSONDecode erases null fields.
-- Only scalar strings use the engine unescaper. JSON is never executable.
function Validation.decode(text: string, http: any): any
	if type(text) ~= "string" or utf8.len(text) == nil then Validation.fail("PROTOCOL", "Invalid JSON text.") end
	local cursor, length = 1, #text
	local function invalid(): never Validation.fail("PROTOCOL", "Malformed daemon JSON.") end
	local function whitespace(): ()
		while cursor <= length and string.find(" \t\r\n", string.sub(text, cursor, cursor), 1, true) do cursor += 1 end
	end
	local function quoted(): string
		local start = cursor
		cursor += 1
		while cursor <= length do
			local byte = string.byte(text, cursor)
			if byte == 34 then
				cursor += 1
				local ok, value = pcall(function() return http:JSONDecode(string.sub(text, start, cursor - 1)) end)
				if not ok or type(value) ~= "string" or utf8.len(value) == nil then invalid() end
				return value
			elseif byte == 92 then
				cursor += 1
				local escape = string.sub(text, cursor, cursor)
				if escape == "u" then
					if not string.match(string.sub(text, cursor + 1, cursor + 4), "^%x%x%x%x$") then invalid() end
					cursor += 4
				elseif escape == "" or not string.find('"\\/bfnrt', escape, 1, true) then invalid() end
			elseif byte < 32 then invalid() end
			cursor += 1
		end
		return invalid()
	end
	local parse: (number) -> any
	parse = function(depth: number): any
		if depth > 80 then invalid() end
		whitespace()
		local char = string.sub(text, cursor, cursor)
		if char == '"' then return quoted() end
		if char == "{" or char == "[" then
			local object = char == "{"
			local close = if object then "}" else "]"
			local result: any = if object then {} else Validation.array({})
			cursor += 1
			whitespace()
			if string.sub(text, cursor, cursor) == close then cursor += 1; return result end
			while cursor <= length do
				local key: any = #result + 1
				if object then
					if string.sub(text, cursor, cursor) ~= '"' then invalid() end
					key = quoted()
					if result[key] ~= nil or key == "__proto__" or key == "constructor" or key == "prototype" then invalid() end
					whitespace()
					if string.sub(text, cursor, cursor) ~= ":" then invalid() end
					cursor += 1
				end
				result[key] = parse(depth + 1)
				whitespace()
				local separator = string.sub(text, cursor, cursor)
				cursor += 1
				if separator == close then return result end
				if separator ~= "," then invalid() end
				whitespace()
			end
			return invalid()
		end
		for _, literal in ipairs({"true", "false", "null"}) do
			if string.sub(text, cursor, cursor + #literal - 1) == literal then
				cursor += #literal
				return if literal == "null" then Validation.NULL else literal == "true"
			end
		end
		local start = cursor
		if char == "-" then cursor += 1 end
		local function digit(): boolean
			local byte = string.byte(text, cursor)
			return byte ~= nil and byte >= 48 and byte <= 57
		end
		if not digit() then invalid() end
		if string.sub(text, cursor, cursor) == "0" then cursor += 1
		else while digit() do cursor += 1 end end
		if string.sub(text, cursor, cursor) == "." then
			cursor += 1
			if not digit() then invalid() end
			while digit() do cursor += 1 end
		end
		local exponent = string.sub(text, cursor, cursor)
		if exponent == "e" or exponent == "E" then
			cursor += 1
			local sign = string.sub(text, cursor, cursor)
			if sign == "+" or sign == "-" then cursor += 1 end
			if not digit() then invalid() end
			while digit() do cursor += 1 end
		end
		local number = tonumber(string.sub(text, start, cursor - 1))
		if number == nil then invalid() end
		return Validation.number(number, -math.huge, math.huge, "JSON number")
	end
	local result = parse(0)
	whitespace()
	if cursor <= length then invalid() end
	return result
end

function Validation.safeError(value: any): string
	-- Never echo arbitrary engine/HTTP errors (they may contain source or bearer).
	if type(value) == "table" and type(value.code) == "string" and type(value.message) == "string" then
		return string.sub(value.code .. ": " .. value.message, 1, 512)
	end
	return "ENGINE: Operation failed; inspect the place and reconnect if reconciliation is required."
end

return table.freeze(Validation)
]]></ProtectedString>
</Properties>
