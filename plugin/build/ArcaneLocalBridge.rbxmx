<?xml version="1.0" encoding="utf-8"?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4">
<External>null</External>
<External>nil</External>
<Item class="Script" referent="RBXArcane0">
<Properties>
<string name="Name">ArcaneLocalBridge</string>
<bool name="Archivable">true</bool>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Only the user's Arcane local key is remembered in Studio plugin settings.
-- Provider credentials and session bearers are never saved.
local V = require(script.Validation)
local Transport = require(script.Transport)
local Sha256 = require(script.Sha256)
local Diagnostics = require(script.Diagnostics)
-- Identity covers the actual loaded hierarchy, independent of XML serialization.
local ARTIFACT_MODULES = table.freeze({"Types", "Validation", "Registry", "Properties", "Operations", "Transport", "TestProof", "Sha256", "AssetMesh", "Sha256Stream", "AssetTransfer", "AssetMaterials", "AssetUpload", "Diagnostics", "AssetPlacement", "TerrainGen"})
local function loadedArtifactHash(): string?
	if typeof(script) ~= "Instance" or not script:IsA("Script") then return nil end
	local ok, value = pcall(function(): string
		if script.Name ~= "ArcaneLocalBridge" then error("Unexpected plugin root.", 0) end
		local children = script:GetChildren()
		if #children ~= #ARTIFACT_MODULES then error("Unexpected plugin hierarchy.", 0) end
		local modules: {[string]: any} = {}
		for _, child in ipairs(children) do
			if not child:IsA("ModuleScript") or modules[child.Name] ~= nil or #child:GetChildren() ~= 0 then error("Unexpected plugin module.", 0) end
			modules[child.Name] = child
		end
		local function digest(source: string): string
			if string.sub(source, 1, 3) == utf8.char(0xFEFF) then source = string.sub(source, 4) end
			source = string.gsub(string.gsub(source, "\r\n", "\n"), "\r", "\n")
			if string.sub(source, -1) ~= "\n" then source ..= "\n" end
			if #source > 199999 then error("Plugin source exceeds its bound.", 0) end
			return Sha256(source)
		end
		local identities = {"ArcaneLocalBridge\0" .. digest(script.Source)}
		for _, name in ipairs(ARTIFACT_MODULES) do
			local child = modules[name]
			if child == nil then error("Missing plugin module.", 0) end
			table.insert(identities, name .. "\0" .. digest(child.Source))
		end
		return Sha256("arcane-plugin-source-v1\n" .. table.concat(identities, "\n") .. "\n")
	end)
	return if ok then value else nil
end
local artifactHash = loadedArtifactHash()
local KEY_SETTING = "Arcane.LocalApiKey.v1"
local STATE_SETTING = "Arcane.LastConnection.v1"
local savedKey: string? = nil
local lastKnownConnected = false
-- Legacy connected=false records describe transient health, not user intent.
-- Only an explicit opt-out in this existing owned record suppresses startup.
local autoConnect = true
local storedOptOut = false
local storageFailed = false
local keyRead, previousKey = pcall(function() return plugin:GetSetting(KEY_SETTING) end)
if keyRead and type(previousKey) == "string" then
	local valid = pcall(function() V.keyOrigin(previousKey) end)
	if valid then savedKey = previousKey end
end
previousKey = nil
local stateRead, previousState = pcall(function() return plugin:GetSetting(STATE_SETTING) end)
if stateRead and type(previousState) == "table" and getmetatable(previousState) == nil then
	local count = 0
	for _ in pairs(previousState) do count += 1 end
	if (count == 1 or (count == 2 and type(previousState.autoConnect) == "boolean"))
		and type(previousState.connected) == "boolean" then
		lastKnownConnected = previousState.connected
		autoConnect = previousState.autoConnect ~= false
		storedOptOut = not autoConnect
	end
end
previousState = nil
local toolbar = plugin:CreateToolbar("Arcane")
local button = toolbar:CreateButton("ArcaneBridge", "Open Arcane", "", "Arcane")
button.ClickableWhenViewportHidden = true
-- A new stable widget identity migrates the old compact layout once. Studio
-- owns floating-window placement; opening the UI never connects a place.
local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, true, true, 300, 380, 264, 352)
local widget = plugin:CreateDockWidgetPluginGuiAsync("ArcaneLocalBridgeFloatingV4", info)
widget.Title = "Arcane"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Arcane desktop brand: black glass, white text, Arcane red accents. The glass
-- card keeps these colours in both Studio themes; only the surround follows Studio.
local colors = {
	body = Color3.fromRGB(10, 10, 12), glass = Color3.fromRGB(26, 26, 31),
	input = Color3.fromRGB(16, 16, 19), divider = Color3.fromRGB(58, 58, 66),
	white = Color3.fromRGB(245, 245, 245), muted = Color3.fromRGB(166, 166, 174),
	red = Color3.fromRGB(255, 51, 64), idle = Color3.fromRGB(112, 112, 120),
	green = Color3.fromRGB(71, 203, 133), amber = Color3.fromRGB(225, 166, 68),
}
local DOT = " " .. utf8.char(0x00B7) .. " "
local connections: {RBXScriptConnection} = {}
local panel = Instance.new("Frame")
panel.Name = "ArcanePanel"
panel.Size = UDim2.fromScale(1, 1)
panel.BackgroundColor3 = colors.body
panel.BorderSizePixel = 0
panel.Parent = widget

local function frame(name: string, parent: Instance, position: UDim2, size: UDim2, color: Color3): Frame
	local item = Instance.new("Frame")
	item.Name, item.Position, item.Size = name, position, size
	item.BackgroundColor3 = color
	item.BorderSizePixel = 0
	item.Parent = parent
	return item
end
local function corner(parent: Instance, radius: number): ()
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = parent
end
local function outline(parent: Instance, color: Color3, transparency: number): UIStroke
	local item = Instance.new("UIStroke")
	item.Color, item.Thickness, item.Transparency = color, 1, transparency
	item.Parent = parent
	return item
end
local function gradient(parent: Instance, first: Color3, last: Color3, rotation: number): UIGradient
	local item = Instance.new("UIGradient")
	item.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, first), ColorSequenceKeypoint.new(1, last)})
	item.Rotation = rotation
	item.Parent = parent
	return item
end
local function padding(parent: Instance, top: number, right: number, bottom: number, left: number): UIPadding
	local item = Instance.new("UIPadding")
	item.PaddingTop, item.PaddingRight = UDim.new(0, top), UDim.new(0, right)
	item.PaddingBottom, item.PaddingLeft = UDim.new(0, bottom), UDim.new(0, left)
	item.Parent = parent
	return item
end
local function label(name: string, parent: Instance, text: string, position: UDim2, size: UDim2, textSize: number, color: Color3): TextLabel
	local item = Instance.new("TextLabel")
	item.Name, item.Position, item.Size = name, position, size
	item.BackgroundTransparency = 1
	item.Text, item.TextColor3 = text, color
	item.Font = Enum.Font.Gotham
	item.TextSize = textSize
	item.RichText = false
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextYAlignment = Enum.TextYAlignment.Center
	item.TextTruncate = Enum.TextTruncate.AtEnd
	item.Parent = parent
	return item
end
local function section(name: string, parent: Instance, height: number, order: number): Frame
	local item = frame(name, parent, UDim2.new(), UDim2.new(1, 0, 0, height), colors.body)
	item.BackgroundTransparency = 1
	item.LayoutOrder = order
	return item
end

-- Black glass card: a soft vertical sheen over near-black, a hairline edge and a red top accent.
local glass = frame("Glass", panel, UDim2.new(0, 8, 0, 8), UDim2.new(1, -16, 1, -16), Color3.fromRGB(255, 255, 255))
corner(glass, 12)
gradient(glass, colors.glass, colors.body, 90)
outline(glass, colors.white, 0.88)
local accent = frame("Accent", glass, UDim2.new(0, 18, 0, 0), UDim2.new(1, -36, 0, 2), Color3.fromRGB(255, 255, 255))
gradient(accent, Color3.fromRGB(224, 27, 44), Color3.fromRGB(255, 51, 64), 0)
local accentFade = Instance.new("UIGradient")
accentFade.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1)})
accentFade.Parent = accent
accent.ZIndex = 2

local content = frame("Content", glass, UDim2.new(), UDim2.fromScale(1, 1), colors.body)
content.BackgroundTransparency = 1
local panelPadding = padding(content, 16, 16, 18, 16)
local layout = Instance.new("UIListLayout")
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 10)
layout.Parent = content

local header = section("Header", content, 32, 1)
local mark = frame("ArcaneMark", header, UDim2.new(0, 0, 0, 2), UDim2.new(0, 28, 0, 28), colors.body)
mark.BackgroundTransparency = 1
-- Exact polygons from the desktop's 64x64 SVG, as bounded native scanlines.
-- No upload, remote logo, or white/orange substitute.
local function polygon(name: string, points: {{number}}, transparency: number): ()
	for row = 0, 63 do
		local scan, crossings = row + 0.5, {}
		for index, a in ipairs(points) do
			local b = points[index % #points + 1]
			if (a[2] <= scan and b[2] > scan) or (b[2] <= scan and a[2] > scan) then
				table.insert(crossings, a[1] + (scan - a[2]) * (b[1] - a[1]) / (b[2] - a[2]))
			end
		end
		table.sort(crossings)
		for index = 1, #crossings - 1, 2 do
			local left, right = crossings[index], crossings[index + 1]
			local strip = frame(name .. tostring(row), mark, UDim2.new(left / 64, 0, row / 64, 0), UDim2.new((right - left) / 64, 0, 1 / 64, 0), colors.red)
			strip.BackgroundTransparency = transparency
		end
	end
end
polygon("LogoLegs", {{32,4},{4,57},{17,57},{32,28},{47,57},{60,57}}, 0)
polygon("LogoCrossbar", {{27,40},{46,53},{40,40}}, 0)
polygon("LogoFacet", {{19,21},{26,26},{32,14},{27,6}}, 0.2)
local brand = label("Brand", header, "Arcane", UDim2.new(0, 38, 0, 2), UDim2.new(1, -110, 0, 28), 19, colors.white)
brand.Font = Enum.Font.GothamBold
local version = label("Version", header, "Studio" .. DOT .. "v" .. V.VERSION, UDim2.new(1, -96, 0, 2), UDim2.new(0, 96, 0, 28), 12, colors.muted)
version.TextXAlignment = Enum.TextXAlignment.Right

-- Status: one glass tile with a coloured dot, a short state title and one plain sentence.
local statusCard = section("StatusCard", content, 64, 2)
statusCard.BackgroundColor3, statusCard.BackgroundTransparency = colors.white, 0.95
corner(statusCard, 10)
outline(statusCard, colors.white, 0.9)
local statusDot = frame("StatusDot", statusCard, UDim2.new(0, 14, 0, 16), UDim2.new(0, 10, 0, 10), colors.idle)
local dotCorner = Instance.new("UICorner")
dotCorner.CornerRadius = UDim.new(1, 0)
dotCorner.Parent = statusDot
local statusTitle = label("StatusTitle", statusCard, "Not connected", UDim2.new(0, 34, 0, 10), UDim2.new(1, -46, 0, 20), 14, colors.white)
statusTitle.Font = Enum.Font.GothamBold
local statusText = label("StatusText", statusCard, "", UDim2.new(0, 34, 0, 31), UDim2.new(1, -46, 0, 28), 12, colors.muted)
statusText.TextWrapped = true
statusText.TextYAlignment = Enum.TextYAlignment.Top

-- Entry: the 6-digit code shown in Arcane. Pasting a local key is the Advanced fallback.
local entry = section("Entry", content, 62, 3)
local fieldLabel = label("FieldLabel", entry, "Code shown in Arcane", UDim2.new(), UDim2.new(1, 0, 0, 16), 12, colors.muted)
fieldLabel.Font = Enum.Font.GothamMedium
local inputPanel = frame("KeyInput", entry, UDim2.new(0, 0, 0, 22), UDim2.new(1, 0, 0, 40), colors.input)
corner(inputPanel, 8)
local stroke = outline(inputPanel, colors.divider, 0)
local savedRow = section("SavedKey", content, 40, 4)
savedRow.BackgroundColor3, savedRow.BackgroundTransparency = colors.input, 0
corner(savedRow, 8)
outline(savedRow, colors.divider, 0)
local savedLabel = label("SavedKeyLabel", savedRow, "", UDim2.new(0, 12, 0, 0), UDim2.new(1, -96, 1, 0), 13, colors.white)
local replaceButton = Instance.new("TextButton")
replaceButton.Name = "ReplaceKey"
replaceButton.Position, replaceButton.Size = UDim2.new(1, -80, 0, 6), UDim2.new(0, 72, 0, 28)
replaceButton.BackgroundColor3, replaceButton.BackgroundTransparency = colors.white, 0.92
replaceButton.BorderSizePixel = 0
replaceButton.Text, replaceButton.TextColor3 = "Replace", colors.white
replaceButton.Font = Enum.Font.GothamMedium
replaceButton.TextSize = 12
replaceButton.RichText = false
replaceButton.Parent = savedRow
corner(replaceButton, 6)

local connectButton = Instance.new("TextButton")
connectButton.Name = "Connect"
connectButton.LayoutOrder = 5
connectButton.Size = UDim2.new(1, 0, 0, 40)
connectButton.BackgroundColor3 = colors.red
connectButton.BorderSizePixel = 0
connectButton.Text, connectButton.TextColor3 = if savedKey then "Reconnect" else "Connect", colors.white
connectButton.Font = Enum.Font.GothamBold
connectButton.TextSize = 14
connectButton.RichText = false
connectButton.Parent = content
corner(connectButton, 8)
-- UIGradient multiplies the red base: exactly #e01b2c at the top to #c8102e at the bottom.
local buttonGradient = gradient(connectButton, Color3.new(224 / 255, 27 / 51, 44 / 64), Color3.new(200 / 255, 16 / 51, 46 / 64), 90)

local advancedButton = Instance.new("TextButton")
advancedButton.Name = "Advanced"
advancedButton.LayoutOrder = 6
advancedButton.Size = UDim2.new(1, 0, 0, 18)
advancedButton.BackgroundTransparency = 1
advancedButton.BorderSizePixel = 0
advancedButton.Text, advancedButton.TextColor3 = "Advanced: use a local key", colors.muted
advancedButton.Font = Enum.Font.GothamMedium
advancedButton.TextSize = 12
advancedButton.RichText = false
advancedButton.TextXAlignment = Enum.TextXAlignment.Left
advancedButton.Parent = content

local meta = section("Meta", content, 36, 7)
local activityLabel = label("Activity", meta, "No builds yet", UDim2.new(), UDim2.new(1, 0, 0, 16), 12, colors.muted)
local diagnosticsLabel = label("DiagnosticsCount", meta, "Output: idle", UDim2.new(0, 0, 0, 20), UDim2.new(1, 0, 0, 16), 12, colors.muted)

-- Follow the Studio theme only around the card; the brand card stays readable in Light and Dark.
local function applyTheme(): ()
	local ok, color = pcall(function(): any
		return settings().Studio.Theme:GetColor(Enum.StudioStyleGuideColor.MainBackground)
	end)
	panel.BackgroundColor3 = if ok and typeof(color) == "Color3" then color else colors.body
end
applyTheme()
pcall(function()
	table.insert(connections, settings().Studio.ThemeChanged:Connect(applyTheme))
end)

-- Keep Studio's ordinary text editing and selection. A saved Arcane key is never
-- rendered in full: while the field holds it, the field is hidden behind a short
-- masked summary and Replace is the only way to change it.
local keyInput = Instance.new("TextBox")
keyInput.Name = "ApiKey"
keyInput.Position = UDim2.new()
keyInput.Size = UDim2.fromScale(1, 1)
keyInput.BackgroundTransparency = 1
keyInput.BorderSizePixel = 0
keyInput.ZIndex = 3
keyInput.Active = true
keyInput.Selectable = true
keyInput.Text = savedKey or ""
keyInput.TextColor3 = colors.white
keyInput.TextTransparency = 0
keyInput.MaxVisibleGraphemes = -1
keyInput.ClearTextOnFocus = false
keyInput.MultiLine = false
keyInput.RichText = false
keyInput.TextEditable = true
keyInput.TextSize = 15
keyInput.Font = Enum.Font.GothamMedium
keyInput.TextXAlignment = Enum.TextXAlignment.Left
keyInput.Parent = inputPanel
local inputPadding = Instance.new("UIPadding")
inputPadding.PaddingLeft, inputPadding.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
inputPadding.Parent = keyInput
keyInput.PlaceholderColor3 = colors.muted
local DEFAULT_HINT = "6-digit code from Arcane"
local hint = DEFAULT_HINT
local keyFailed = false
local inputText = keyInput.Text
-- Two-sided pairing (docs/studio-pairing.md): the user types the 6-digit code Arcane shows and clicks Connect.
-- Nothing is looked up before that click. Arcane must prove the code before the plugin trusts it, and the
-- connection finishes only after the user clicks Approve in Arcane. The code is never kept or saved here.
local pairingStage: string? = nil
local liveNow = false
local advancedOpen = false
-- Display-only memory of the last status; it never grants access or survives a reload.
local phase, executing, writable, editMode = "idle", false, false, true
local lastActivity: string?, lastActivityAt = nil, 0
local function arcaneCode(text: string): boolean
	return string.match(text, "^%s*%d%d%d[%s%-]?%d%d%d%s*$") ~= nil
end
local function placeName(): string
	local ok, name = pcall(function(): any return game.Name end)
	if not ok or type(name) ~= "string" or name == "" then return "this place" end
	return if #name > 48 then string.sub(name, 1, 45) .. "..." else name
end
local function commas(value: number): string
	local text = tostring(math.floor(value))
	local result = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	return (string.gsub(result, "^,", ""))
end
local function ago(seconds: number): string
	if seconds < 60 then return "just now" end
	if seconds < 3600 then return tostring(math.floor(seconds / 60)) .. " min ago" end
	return tostring(math.floor(seconds / 3600)) .. " h ago"
end
local function statusView(): (string, string, Color3)
	if liveNow and not keyFailed then
		local line = if executing then "Working on a request from Arcane."
			elseif not editMode then "Paused while playtesting."
			elseif writable then "Ready. Arcane can build in this place." else "Ready with read-only access."
		return "Connected to " .. placeName(), line, colors.green
	end
	if pairingStage == "approval" then return "Waiting for Arcane", "Click Approve in the Arcane window to finish.", colors.amber end
	if pairingStage == "connecting" then return "Waiting for Arcane", "Checking the code with Arcane.", colors.amber end
	if phase == "update" then return "Update required", "Update the Studio plugin from Arcane, then restart Studio.", colors.amber end
	if phase == "reconciliation" then return "Reconciliation needed", "Review the last change in Arcane, then click Reconnect.", colors.red end
	if keyFailed then return "Not connected", hint, colors.red end
	local typed = keyInput.Text
	if typed ~= "" and typed ~= savedKey then
		if arcaneCode(typed) then return "Code entry", "Click Connect to pair with Arcane.", colors.red end
		if string.match(typed, "^[%d%s%-]+$") then return "Code entry", "Type all 6 digits, then click Connect.", colors.red end
		return "Code entry", "Click Connect to use this local key.", colors.red
	end
	if phase == "retrying" or phase == "connecting" then return "Waiting for Arcane", "Open Arcane on this computer. Checking again automatically.", colors.amber end
	if savedKey then return "Not connected", "Your saved key is ready. Click Reconnect.", colors.idle end
	return "Not connected", "In Arcane, click Connect Studio, then type the code here.", colors.idle
end
local transport: any
local function diagnosticsText(): string
	if not (liveNow and transport and transport.diagnostics) then return "Output: idle" end
	local errors, warnings = 0, 0
	for _, item in pairs(transport.diagnostics.entries or {}) do
		if item.kind == "error" then errors += item.count else warnings += item.count end
	end
	if errors == 0 and warnings == 0 then return "Output: no errors" end
	return "Output: " .. commas(errors) .. (if errors == 1 then " error" else " errors") .. DOT .. commas(warnings) .. (if warnings == 1 then " warning" else " warnings")
end
-- Presentation only: visibility, colours and copy. It never edits the field text.
local function render(): ()
	local masked = savedKey ~= nil and keyInput.Text == savedKey
	entry.Visible = not masked
	savedRow.Visible = masked and advancedOpen
	if masked then savedLabel.Text = "Local key ending " .. string.sub(savedKey :: string, -4) end
	fieldLabel.Text = if advancedOpen then "Local key (Advanced)" else "Code shown in Arcane"
	advancedButton.Text = if advancedOpen then "Hide advanced" else "Advanced: use a local key"
	local title, line, dot = statusView()
	statusTitle.Text, statusText.Text, statusDot.BackgroundColor3 = title, line, dot
	buttonGradient.Enabled = connectButton.BackgroundColor3 ~= colors.green
	activityLabel.Text = if lastActivity then lastActivity .. DOT .. ago(os.clock() - lastActivityAt) else "No builds yet"
	diagnosticsLabel.Text = diagnosticsText()
end
local function refreshHint(): ()
	keyInput.PlaceholderText = if pairingStage == "approval" then "Click Approve in Arcane"
		elseif advancedOpen and hint == DEFAULT_HINT then "Paste your Arcane local key" else hint
	render()
end
local function buttonText(): string
	if liveNow and not keyFailed then return "Connected" end
	if pairingStage == "approval" then return "Approve in Arcane..." end
	if pairingStage == "connecting" then return "Checking Arcane..." end
	return if keyFailed then "Failed" elseif savedKey then "Reconnect" else "Connect"
end
-- Takes the typed Arcane code out of the field. It is not a key: never kept, saved or shown again.
local function takeCode(): string
	local typed = keyInput.Text
	inputText = "" -- Programmatic cleanup is not a new user edit.
	keyInput.Text = ""
	return typed
end
local function clearInput(): ()
	inputText = "" -- Programmatic cleanup is not a new user edit.
	keyInput.Text = ""
	refreshHint()
end
refreshHint()
local function rememberState(connected: boolean, allowed: boolean?): ()
	if allowed ~= nil then autoConnect = allowed end
	-- Key edits/rejections already remove saved auth. Persist an opt-out only
	-- when a valid saved key remains (an explicit transport disconnect).
	local optOut = not autoConnect and savedKey ~= nil
	if lastKnownConnected == connected and storedOptOut == optOut then return end
	local record: any = {connected = connected}
	if optOut then record.autoConnect = false end
	local ok = pcall(function() plugin:SetSetting(STATE_SETTING, record) end)
	if ok then lastKnownConnected, storedOptOut = connected, optOut else storageFailed = true end
end
local function rejectKey(): ()
	-- A rejected key must not become a persistent reconnect trap. Clearing this
	-- owned setting never revokes a key at the daemon or touches provider logins.
	keyFailed, savedKey, hint = true, nil, "Enter a new API key"
	local ok = pcall(function() plugin:SetSetting(KEY_SETTING, "") end)
	if not ok then storageFailed = true end
	rememberState(false, false)
	connectButton.Text = "Failed"
	connectButton.BackgroundColor3, stroke.Color = colors.red, colors.red
	clearInput()
end
local function invalidateInput(): boolean
	if keyInput.Text == inputText then return false end
	inputText = keyInput.Text
	keyFailed, hint, pairingStage = false, DEFAULT_HINT, nil
	if savedKey ~= nil then
		savedKey = nil
		local ok = pcall(function() plugin:SetSetting(KEY_SETTING, "") end)
		if not ok then storageFailed = true end
	end
	rememberState(false)
	-- Advance the transport generation on every edit, before another click.
	-- This forgets queued keys and fences yielding polls/editor callbacks.
	transport:requestDisconnect()
	refreshHint()
	return true
end
transport = Transport.new(game, function(status: any)
	-- Studio may defer the Text signal. Inspect the actual field before a late
	-- ACK/rejection or dispatch status can adopt the previous input's outcome.
	if invalidateInput() then return end
	if status.state == "failed" then rejectKey(); return end
	if status.state == "disconnecting" then rememberState(false, false)
	elseif status.state == "connecting" then rememberState(false, true) end
	local live = savedKey ~= nil and keyInput.Text == savedKey and status.sessionId ~= nil
		and (status.state == "connected" or status.state == "executing")
	-- Cached history never establishes a current session or green status.
	connectButton.BackgroundColor3 = if live and not keyFailed then colors.green else colors.red
	liveNow = live
	connectButton.Text = buttonText()
	if live then rememberState(true)
	else rememberState(false) end
	stroke.Color = if storageFailed then colors.amber elseif status.state == "retrying" or status.state == "reconciliation" then colors.red else colors.divider
	-- Fixed copy per state: daemon-supplied detail text is never rendered here.
	local detail = if type(status.detail) == "string" then status.detail else ""
	phase = if status.state == "reconciliation" then "reconciliation"
		elseif string.find(detail, "Unsupported", 1, true) or string.find(detail, "UPDATE_REQUIRED", 1, true) then "update"
		else status.state
	executing, writable, editMode = status.state == "executing", status.allowWrites == true, status.editMode ~= false
	render()
end, artifactHash)
-- The pairing proofs (HMAC) use the same bounded SHA-256 module that verifies this artifact.
transport.sha256 = Sha256
-- Check deferred text edits before every worker cycle and after every yielding
-- HTTP call, including status recovery that has not yet emitted a UI callback.
transport.checkInput = invalidateInput
-- Progress of a code attempt the Connect click started: waiting for Approve in Arcane, or why it stopped.
transport.onPairing = function(stage: any, detail: any): ()
	if stage == "approval" then pairingStage = "approval"
	elseif stage == "failed" then
		pairingStage, keyFailed = nil, true
		hint = if type(detail) == "string" and detail ~= "" then string.sub(detail, 1, 160) else DEFAULT_HINT
		stroke.Color = colors.red
	end
	refreshHint()
	connectButton.Text = buttonText()
end
-- A successful claim returns this daemon's local key once. Save it exactly like an entered key so
-- Studio and Arcane restarts reconnect through the existing saved-key recovery.
transport.onPaired = function(apiKey: any): ()
	local valid = pcall(function() V.keyOrigin(apiKey) end)
	if not valid then return end
	keyFailed, hint, pairingStage = false, DEFAULT_HINT, nil
	local stored = pcall(function() plugin:SetSetting(KEY_SETTING, apiKey) end)
	savedKey, storageFailed = apiKey, not stored
	inputText = apiKey -- Programmatic fill is not a new user edit.
	keyInput.Text = apiKey
	advancedOpen = false
	refreshHint()
	rememberState(false, true)
end
-- Completed write work, summarized for the activity line. Method names and counts only.
local ACTIVITY: {[string]: string} = {["scene.create"] = "Created an object", ["environment.apply"] = "Updated lighting",
	["terrain.generate"] = "Generated terrain", ["scene.update"] = "Updated properties", ["script.update"] = "Edited a script",
	["script.set_enabled"] = "Toggled a script", ["scene.restore"] = "Restored a change", ["scene.place_asset"] = "Placed an asset",
	["scene.apply_material"] = "Applied a material"}
transport.onActivity = function(method: any, count: any): ()
	local summary = if method == "scene.build" and type(count) == "number" then "Built " .. commas(count) .. (if count == 1 then " part" else " parts")
		elseif method == "scene.build" then "Built a scene" else ACTIVITY[method]
	if summary == nil then return end
	lastActivity, lastActivityAt = summary, os.clock()
	render()
end
-- Studio errors/warnings are kept only while this window is paired, and only
-- reported on the authenticated poll. Missing engine signals leave it inert.
local diagnostics = Diagnostics.new(game, function(): boolean return transport.pair ~= nil end)
local diagnosticsReady, diagnosticsStarted = pcall(function(): boolean return diagnostics:start() end)
if diagnosticsReady and diagnosticsStarted then transport.diagnostics = diagnostics end
-- A deferred Text signal must also be caught inside an already dispatched
-- editor callback. Keep the transport's original lifetime/lease checks intact.
local guard = transport.guard
transport.guard = function(client: any, command: any, pair: any): ()
	invalidateInput()
	guard(client, command, pair)
end
table.insert(connections, button.Click:Connect(function() widget.Enabled = not widget.Enabled end))
table.insert(connections, widget:GetPropertyChangedSignal("Enabled"):Connect(function() button:SetActive(widget.Enabled) end))
button:SetActive(widget.Enabled)
table.insert(connections, widget:GetPropertyChangedSignal("Enabled"):Connect(render))
table.insert(connections, keyInput:GetPropertyChangedSignal("Text"):Connect(function()
	invalidateInput()
	render()
end))
-- Presentation only: switches the field between the Arcane code and a pasted local key.
table.insert(connections, advancedButton.Activated:Connect(function()
	advancedOpen = not advancedOpen
	refreshHint()
end))
-- Replacing the saved key is an explicit edit: like deleting the field text, it forgets the
-- saved key and fences the current session. No request is made until the next Connect click.
table.insert(connections, replaceButton.Activated:Connect(function()
	keyInput.Text = ""
	invalidateInput()
	refreshHint()
end))
table.insert(connections, connectButton.Activated:Connect(function()
	invalidateInput()
	if keyInput.Text == "" then
		-- Nothing typed: no network, no fallback to a deleted saved key. The code comes from Arcane.
		keyFailed, hint, pairingStage = true, "Enter the 6-digit code shown in Arcane", nil
		refreshHint()
		connectButton.Text = buttonText()
		return
	end
	if arcaneCode(keyInput.Text) then
		-- The code shown in Arcane: this click is the only thing that starts a pairing attempt. The field is
		-- cleared at once, so the code is never saved or shown again.
		local typed = takeCode()
		keyFailed, hint = false, DEFAULT_HINT
		local started = pcall(function() transport:requestArcaneCode(typed) end)
		typed = ""
		pairingStage = if started then "connecting" else nil
		if not started then keyFailed = true; stroke.Color = colors.red end
		refreshHint()
		connectButton.Text = buttonText()
		return
	end
	local entered = keyInput.Text -- Deleting the field never falls back to an old key.
	local valid = pcall(function() V.keyOrigin(entered) end)
	if not valid then
		rejectKey()
		-- Explicit failed input also fences any queued or live connection.
		transport:requestDisconnect()
		return
	end
	keyFailed, hint = false, DEFAULT_HINT
	local value = entered :: string
	local stored = pcall(function() plugin:SetSetting(KEY_SETTING, value) end)
	savedKey, storageFailed = value, not stored
	connectButton.Text, connectButton.BackgroundColor3 = "Reconnect", colors.red
	advancedOpen = false
	refreshHint()
	local ok = pcall(function() transport:requestConnect(value) end)
	if not ok then transport:requestDisconnect(); rememberState(false); stroke.Color = colors.red end
	entered, value = nil, ""
end))
table.insert(connections, plugin.Unloading:Connect(function()
	savedKey = nil
	pairingStage = nil
	clearInput()
	transport:stop()
	diagnostics:stop()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	widget:Destroy()
	toolbar:Destroy()
end))
-- Queue safe recovery from any saved key unless the user explicitly opted out.
-- Cached health never proves a connection. Status precedes authentication; no
-- old session token, command, receipt or grant is restored in a new lifetime.
if savedKey ~= nil and autoConnect then
	local ok = pcall(function() transport:requestConnect(savedKey, true) end)
	if not ok then rememberState(false) end
end
render()
transport:start()
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBXArcane1">
<Properties>
<string name="Name">Types</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Wire definitions mirror packages/protocol/src/studio.ts (protocol v1).
export type InstanceRef = {
	instanceId: string, sessionId: string, root: string,
	pathSegments: {string}, className: string,
}
export type PairResult = {
	sessionId: string, token: string, protocolVersion: number,
	allowedRoots: {string}, allowWrites: boolean,
}
export type Command = {
	protocolVersion: number, id: string, requestId: string, sessionId: string,
	clientSessionId: string, method: string, args: {[string]: any},
	allowedRoots: {string}, allowWrites: boolean, leaseEpoch: number,
	expiresAt: string, state: string,
}
export type MutationReceipt = {
	kind: string, ref: InstanceRef, before: any, after: {[string]: any},
}
-- Observation only; the host ledger selects a target and preserves provenance.
export type StudioPlaceCreatorObservation = {
	status: "available", kind: "user" | "group", id: number,
	provenance: "game.CreatorType/CreatorId",
} | {
	status: "unavailable", kind: nil, id: number,
	provenance: "game.CreatorType/CreatorId",
}
export type StudioUserObservation = {
	status: "available", id: number,
	provenance: "StudioService:GetUserId",
} | {
	status: "unavailable" | "not_applicable", id: nil,
	provenance: "StudioService:GetUserId",
}
export type StudioImportContextObservation = {
	sessionId: string, root: "Workspace", parentRef: InstanceRef,
	placeId: number, universeId: number, mode: "Edit" | "Play",
	modeProvenance: "StudioTestService.EditModeActive",
	creator: StudioPlaceCreatorObservation, studioUser: StudioUserObservation,
}
export type Outcome = {state: string, result: any?, error: string?, unsafe: boolean?}
export type StudioUploadContextObservation = StudioImportContextObservation & {
	uploader: {status: "available", id: number, provenance: "StudioService:GetUserId"}
		| {status: "unavailable", id: nil, provenance: "StudioService:GetUserId"},
}
return {}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane2">
<Properties>
<string name="Name">Validation</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local Validation = {}
Validation.PROTOCOL = 1
Validation.VERSION = "0.2.0"
Validation.ARGUMENT_BYTES = 256 * 1024
Validation.RESULT_BYTES = 512 * 1024
Validation.SOURCE_BYTES = 100 * 1024
Validation.MAX_REFS = 20000
Validation.MAX_RECEIPTS = 1024
Validation.MAX_CACHE_BYTES = 16 * 1024 * 1024
Validation.NULL = table.freeze({})
local ARRAY = table.freeze({})
Validation.ROOTS = table.freeze({"Workspace", "ReplicatedStorage", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPlayer", "Lighting"})
Validation.READ_METHODS = table.freeze({"scene.children", "scene.inspect", "scene.search", "selection.read", "script.read", "script.search", "scene.import_context", "scene.upload_context", "scene.asset_watch", "output.read"})
Validation.WRITE_METHODS = table.freeze({"scene.create", "scene.update", "script.update", "script.set_enabled", "scene.restore", "scene.remove", "scene.build", "environment.apply", "scene.place_asset", "scene.apply_material", "terrain.generate"})
Validation.REMOVE_LIMITS = table.freeze({targets = 64, topLevel = 10000, descendants = 100000})
Validation.BUILD_LIMITS = table.freeze({items = 2000, prototypes = 32, prototypeParts = 64, instances = 4000, keys = 32})
Validation.BUILD_PART_CLASSES = table.freeze({"Part", "WedgePart", "CornerWedgePart", "SpawnLocation"})
Validation.ASSET_STAGE_METHODS = table.freeze({"asset.stage_packet", "asset.reconstruct"})
-- Keep this mesh: host-only upload + swap; advertised only when the Studio upload API probe passes (AssetPlacement.keepSupported).
Validation.MESH_KEEP_METHODS = table.freeze({"asset.keep_mesh"})
-- Non-method feature capabilities (effects classes, environment extras, inspect bounds; GUI classes and ScreenGui builds;
-- character classes: Humanoid, HumanoidDescription, AnimationController, Animator).
Validation.FEATURE_CAPABILITIES = table.freeze({"scene.effects", "scene.gui", "scene.gui.flex", "scene.gui.edit", "scene.characters", "asset.mesh_parts", "scene.search.class"})
Validation.CREATE_CLASSES = table.freeze({"Folder", "Model", "Part", "Script", "LocalScript", "ModuleScript", "WedgePart", "CornerWedgePart", "SpawnLocation"})
Validation.BASE_PART_CLASSES = table.freeze({"Part", "FlagStand", "Platform", "Seat", "SkateboardPlatform", "SpawnLocation", "MeshPart", "UnionOperation", "NegateOperation", "IntersectOperation", "WedgePart", "CornerWedgePart", "TrussPart", "VehicleSeat"})
Validation.PART_SHAPE_CLASSES = table.freeze({"Part", "FlagStand", "Platform", "Seat", "SkateboardPlatform", "SpawnLocation"})
Validation.SHAPES = table.freeze({"Block", "Ball", "Cylinder"})
Validation.MAX_PROPERTIES = 12

function Validation.fail(code: string, message: string): never
	error(table.freeze({code = code, message = message}), 0)
end

function Validation.object(value: any, label: string): {[string]: any}
	if type(value) ~= "table" or value == Validation.NULL or getmetatable(value) == ARRAY then
		Validation.fail("INPUT", label .. " must be an object.")
	end
	for key in pairs(value) do
		if type(key) ~= "string" or key == "__proto__" or key == "constructor" or key == "prototype" then
			Validation.fail("INPUT", label .. " contains an invalid key.")
		end
	end
	return value
end

function Validation.fields(value: any, allowed: {string}, label: string): {[string]: any}
	local result = Validation.object(value, label)
	for key in pairs(result) do
		if not table.find(allowed, key) then Validation.fail("INPUT", "Unsupported " .. label .. " field.") end
	end
	return result
end

function Validation.string(value: any, label: string, maximum: number, allowEmpty: boolean?): string
	if type(value) ~= "string" or #value > maximum or (not allowEmpty and #value == 0)
		or string.find(value, "\0", 1, true) or utf8.len(value) == nil then
		Validation.fail("INPUT", "Invalid " .. label .. ".")
	end
	return value
end

function Validation.number(value: any, low: number, high: number, label: string): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge or value < low or value > high then
		Validation.fail("INPUT", "Invalid " .. label .. ".")
	end
	return value
end

function Validation.integer(value: any, low: number, high: number, label: string): number
	local result = Validation.number(value, low, high, label)
	if result % 1 ~= 0 then Validation.fail("INPUT", label .. " must be an integer.") end
	return result
end

function Validation.boolean(value: any, label: string): boolean
	if type(value) ~= "boolean" then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	return value
end

-- Protocol enum names are data. Resolve only a bounded enum and verify the
-- native result before recording, allocating, or assigning any property.
function Validation.enum(value: any, allowed: {string}, category: any, label: string): any
	if type(value) ~= "string" or not table.find(allowed, value) then Validation.fail("PROPERTY", "Unsupported " .. label .. ".") end
	local ok, item = pcall(function() return category[value] end)
	if not ok or typeof(item) ~= "EnumItem" or item.EnumType ~= category or item.Name ~= value then
		Validation.fail("PROPERTY", "Native " .. label .. " enum is unavailable.")
	end
	return item
end

-- Extend the frozen legacy codec without changing its six-class public list.
-- Creation uses reflected class allowlists; existing objects use native IsA.
function Validation.geometryProperties(legacy: any): any
	local codec: any = {CLASSES = Validation.CREATE_CLASSES, MATERIALS = legacy.MATERIALS}
	local fields = table.clone(legacy.PART_FIELDS)
	for _, name in ipairs({"Orientation", "CastShadow", "Reflectance"}) do table.insert(fields, name) end
	codec.PART_FIELDS = table.freeze(fields)
	function codec.decode(name: string, value: any, isBasePart: boolean, isPart: boolean?): any
		if name == "Shape" then
			if not isPart then Validation.fail("PROPERTY", "Shape requires a native Part.") end
			return Validation.enum(value, Validation.SHAPES, Enum.PartType, name)
		end
		if name == "Orientation" or name == "CastShadow" or name == "Reflectance" then
			if not isBasePart then Validation.fail("PROPERTY", "Property requires a native BasePart.") end
			if name == "CastShadow" then return Validation.boolean(value, name) end
			if name == "Reflectance" then return Validation.number(value, 0, 1, name) end
			local tag = Validation.fields(value, {"type", "value"}, "tagged property")
			if tag.type ~= "Vector3" then Validation.fail("PROPERTY", "Incorrect property type tag.") end
			local components = Validation.list(tag.value, 3, "components")
			if #components ~= 3 then Validation.fail("PROPERTY", "Property needs three components.") end
			for _, component in ipairs(components) do Validation.number(component, -360, 360, name) end
			return Vector3.new(components[1], components[2], components[3])
		end
		if name == "Material" then
			if not isBasePart then Validation.fail("PROPERTY", "Property requires a native BasePart.") end
			return Validation.enum(value, legacy.MATERIALS, Enum.Material, name)
		end
		return legacy.decode(name, value, isBasePart)
	end
	function codec.encode(name: string, value: any): any
		if name == "Orientation" then return {type = "Vector3", value = Validation.array({value.X, value.Y, value.Z})} end
		if name == "Shape" then return value.Name end
		return legacy.encode(name, value)
	end
	function codec.validate(instance: any, values: any, service: boolean): ({[string]: any}, {string})
		Validation.object(values, "properties")
		local decoded: {[string]: any}, names: {string} = {}, {}
		for name, value in pairs(values) do
			if service then Validation.fail("SERVICE", "Service properties cannot be changed.") end
			if #names >= Validation.MAX_PROPERTIES then Validation.fail("INPUT", "Too many properties.") end
			decoded[name] = codec.decode(name, value, instance:IsA("BasePart"), instance:IsA("Part"))
			table.insert(names, name)
		end
		table.sort(names)
		return decoded, names
	end
	function codec.snapshot(instance: any, names: {string}?): {[string]: any}
		local selected: {string} = names or {"Name"}
		if not names and instance:IsA("BasePart") then
			selected = table.clone(codec.PART_FIELDS)
			table.insert(selected, "Name")
			if instance:IsA("Part") then table.insert(selected, "Shape") end
		end
		local result: {[string]: any} = {}
		for _, name in ipairs(selected) do result[name] = codec.encode(name, instance[name]) end
		if not names and instance:IsA("BaseScript") then result.Disabled = instance.Disabled end
		return result
	end
	function codec.compare(instance: any, expected: any, names: {string}): boolean
		local decoded = codec.validate(instance, expected, false)
		for _, name in ipairs(names) do
			if expected[name] == nil or instance[name] ~= decoded[name] then return false end
		end
		return true
	end

	function codec.assignedMatches(instance: any, name: string, requested: any): boolean
		if name == "Orientation" then
			-- Euler values wrap and can have equivalent gimbal representations.
			-- Check the actual rotation, not a relaxed expected-baseline match.
			local desired = {CFrame.fromOrientation(math.rad(requested.X), math.rad(requested.Y), math.rad(requested.Z)):GetComponents()}
			local actual = {instance.CFrame:GetComponents()}
			for index = 4, 12 do
				if math.abs(actual[index] - desired[index]) > 0.000001 then return false end
			end
			return true
		end
		return legacy.assignedMatches(instance, name, requested)
	end
	-- Verification against a value already read back once (scene.build reads each snapshot
	-- field exactly once and verifies from it). An Orientation read back bit-identical to the
	-- request is the same rotation; anything else falls back to the full rotation-matrix check.
	function codec.readMatches(instance: any, name: string, requested: any, actual: any): boolean
		if name == "Orientation" then return actual == requested or codec.assignedMatches(instance, name, requested) end
		return legacy.readMatches(name, requested, actual)
	end
	-- The managed property names retained privately for creation/build ownership checks.
	-- Depends only on the class, so a build computes it once per class.
	function codec.snapshotFields(instance: any): {string}
		local selected: {string} = {"Name"}
		if instance:IsA("BasePart") then
			selected = table.clone(codec.PART_FIELDS)
			table.insert(selected, "Name")
			if instance:IsA("Part") then table.insert(selected, "Shape") end
		end
		if instance:IsA("BaseScript") then table.insert(selected, "Disabled") end
		local specs = legacy.specsOf(instance.ClassName)
		if specs then
			for name in pairs(specs) do if not table.find(selected, name) then table.insert(selected, name) end end
			table.sort(selected)
		end
		return table.freeze(selected)
	end
	-- Ownership baselines are exact. Post-assignment tolerances never authorize deleting a later manual edit.
	local function sameValue(a: any, b: any): boolean
		if a == nil then a = Validation.NULL end
		if b == nil then b = Validation.NULL end
		local kind = typeof(a)
		if kind ~= typeof(b) then return false end
		if kind == "NumberSequence" or kind == "ColorSequence" then
			local first, second = a.Keypoints, b.Keypoints
			if #first ~= #second then return false end
			for index, point in ipairs(first) do
				local other = second[index]
				if point.Time ~= other.Time or not sameValue(point.Value, other.Value) then return false end
				if kind == "NumberSequence" and point.Envelope ~= other.Envelope then return false end
			end
			return true
		elseif kind == "Font" then return a.Family == b.Family and a.Weight == b.Weight and a.Style == b.Style
		elseif kind == "Color3" then return a.R == b.R and a.G == b.G and a.B == b.B
		elseif kind == "Vector2" then return a.X == b.X and a.Y == b.Y
		elseif kind == "Vector3" then return a.X == b.X and a.Y == b.Y and a.Z == b.Z
		elseif kind == "UDim" then return a.Scale == b.Scale and a.Offset == b.Offset
		elseif kind == "UDim2" then return sameValue(a.X, b.X) and sameValue(a.Y, b.Y)
		elseif kind == "NumberRange" then return a.Min == b.Min and a.Max == b.Max
		elseif kind == "CFrame" then
			local first, second = {a:GetComponents()}, {b:GetComponents()}
			for index, value in ipairs(first) do if value ~= second[index] then return false end end
			return true
		end
		return a == b
	end
	local function sameMap(a: any, b: any): boolean
		local count = 0
		for key, value in pairs(a) do if b[key] == nil or not sameValue(value, b[key]) then return false end; count += 1 end
		for _ in pairs(b) do count -= 1 end
		return count == 0
	end
	local function tagsOf(instance: any, collection: any): any
		local result = {}
		for _, tag in ipairs(collection:GetTags(instance)) do result[tag] = true end
		return result
	end
	function codec.captureOwnership(instance: any, collection: any, properties: any?): any
		if properties == nil then
			properties = {}
			for _, name in ipairs(codec.snapshotFields(instance)) do
				local value = instance[name]
				properties[name] = if value == nil then Validation.NULL else value
			end
			properties = table.freeze(properties)
		end
		return table.freeze({properties = properties, attributes = table.freeze(table.clone(instance:GetAttributes())), tags = table.freeze(tagsOf(instance, collection))})
	end
	function codec.ownershipMatches(instance: any, collection: any, owned: any): boolean
		for name, value in pairs(owned.properties) do if not sameValue(instance[name], value) then return false end end
		return sameMap(instance:GetAttributes(), owned.attributes) and sameMap(tagsOf(instance, collection), owned.tags)
	end
	return table.freeze(codec)
end

function Validation.array(value: {any}): {any}
	return setmetatable(value, ARRAY)
end

function Validation.list(value: any, maximum: number, label: string): {any}
	if type(value) ~= "table" or value == Validation.NULL or (#value == 0 and getmetatable(value) ~= ARRAY) or #value > maximum then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	local count = 0
	for key in pairs(value) do
		count += 1
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #value then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	end
	if count ~= #value then Validation.fail("INPUT", "Invalid " .. label .. ".") end
	return value
end

function Validation.roots(value: any): {string}
	local roots = Validation.list(value, #Validation.ROOTS, "roots")
	if #roots == 0 then Validation.fail("INPUT", "At least one root is required.") end
	local seen: {[string]: boolean} = {}
	for _, root in ipairs(roots) do
		if type(root) ~= "string" or not table.find(Validation.ROOTS, root) or seen[root] then Validation.fail("INPUT", "Invalid or duplicate root.") end
		seen[root] = true
	end
	return table.clone(roots)
end

function Validation.url(value: any): string
	local input = Validation.string(value, "daemon URL", 64)
	local portText = string.match(input, "^http://127%.0%.0%.1:([1-9][0-9]*)$")
	if not portText or #portText > 5 then Validation.fail("URL", "Use exactly http://127.0.0.1:PORT.") end
	Validation.integer(tonumber(portText), 1, 65535, "port")
	return input
end


-- The key carries only the literal loopback port. Never extract or display its
-- secret; keep the original key only until the human-triggered exchange starts.
function Validation.keyOrigin(value: any): string
	local input = Validation.string(value, "Arcane API key", 86)
	local port, secret = string.match(input, "^arcane_local_v1_([1-9][0-9]*)_([0-9a-f]+)$")
	if not port or #port > 5 or not secret or #secret ~= 64 then Validation.fail("KEY", "Enter a valid Arcane local API key.") end
	Validation.integer(tonumber(port), 1, 65535, "key port")
	return Validation.url("http://127.0.0.1:" .. port)
end

function Validation.equal(left: any, right: any): boolean
	if left == Validation.NULL or right == Validation.NULL then return left == right end
	if type(left) ~= type(right) then return false end
	if type(left) ~= "table" then return left == right end
	if (getmetatable(left) == ARRAY) ~= (getmetatable(right) == ARRAY) then return false end
	for key, item in pairs(left) do if not Validation.equal(item, right[key]) then return false end end
	for key, item in pairs(right) do if not Validation.equal(item, left[key]) then return false end end
	return true
end

function Validation.immutable(value: any): any
	if type(value) ~= "table" or value == Validation.NULL then return value end
	local copy: any = {}
	for key, item in pairs(value) do copy[key] = Validation.immutable(item) end
	if getmetatable(value) == ARRAY then setmetatable(copy, ARRAY) end
	return table.freeze(copy)
end

-- HttpService encodes {} as [] and drops nil. Preserve protocol objects and null
-- explicitly, and sort keys so identical result retries are byte-for-byte stable.
function Validation.encode(value: any, http: any): string
	local function encode(item: any, depth: number): string
		if depth > 80 then Validation.fail("INPUT", "JSON nesting is too deep.") end
		if item == nil or item == Validation.NULL then return "null" end
		local kind = type(item)
		if kind == "string" then
			-- Printable ASCII without quote, backslash or slash needs no escaping: skip the engine call.
			if not string.find(item, "[^ -~]") and not string.find(item, '["/\\]') then return '"' .. item .. '"' end
			if utf8.len(item) == nil then Validation.fail("INPUT", "Invalid UTF-8.") end
			return http:JSONEncode(item)
		end
		if kind == "boolean" then return if item then "true" else "false" end
		if kind == "number" then
			Validation.number(item, -math.huge, math.huge, "JSON number")
			-- Safe integers print exactly as decimal digits; other numbers keep the engine encoder.
			if item % 1 == 0 and math.abs(item) < 9007199254740992 and not (item == 0 and 1 / item < 0) then return string.format("%d", item) end
			return http:JSONEncode(item)
		end
		if kind ~= "table" then Validation.fail("INPUT", "Non-JSON value.") end
		local array = getmetatable(item) == ARRAY or #item > 0
		local pieces: {string} = {}
		if array then
			Validation.list(item, 20000, "JSON array")
			for _, child in ipairs(item) do table.insert(pieces, encode(child, depth + 1)) end
			return "[" .. table.concat(pieces, ",") .. "]"
		end
		Validation.object(item, "JSON object")
		local keys: {string} = {}
		for key in pairs(item) do table.insert(keys, key) end
		table.sort(keys)
		for _, key in ipairs(keys) do table.insert(pieces, encode(key, depth + 1) .. ":" .. encode(item[key], depth + 1)) end
		return "{" .. table.concat(pieces, ",") .. "}"
	end
	return encode(value, 0)
end


-- Preserve null entries and empty arrays; native JSONDecode erases null fields.
-- Only scalar strings use the engine unescaper. JSON is never executable.
function Validation.decode(text: string, http: any): any
	if type(text) ~= "string" or utf8.len(text) == nil then Validation.fail("PROTOCOL", "Invalid JSON text.") end
	local cursor, length = 1, #text
	local function invalid(): never Validation.fail("PROTOCOL", "Malformed daemon JSON.") end
	local function whitespace(): ()
		while true do
			local byte = string.byte(text, cursor)
			if byte ~= 32 and byte ~= 9 and byte ~= 13 and byte ~= 10 then return end
			cursor += 1
		end
	end
	-- Jumps between quote, backslash and control bytes instead of stepping every byte. A string
	-- with no escape is the raw slice: the whole text already passed utf8.len, and a slice
	-- between two ASCII quotes stays valid UTF-8, so the engine unescaper is only needed (and
	-- only called) for strings that contain an escape.
	local function quoted(): string
		local start = cursor
		cursor += 1
		local escaped = false
		while true do
			local at = string.find(text, '[%c"\\]', cursor)
			if not at then return invalid() end
			local byte = string.byte(text, at)
			if byte == 34 then
				cursor = at + 1
				if not escaped then return string.sub(text, start + 1, at - 1) end
				local ok, value = pcall(function() return http:JSONDecode(string.sub(text, start, at)) end)
				if not ok or type(value) ~= "string" or utf8.len(value) == nil then invalid() end
				return value
			elseif byte == 92 then
				escaped = true
				local escape = string.sub(text, at + 1, at + 1)
				if escape == "u" then
					if not string.match(string.sub(text, at + 2, at + 5), "^%x%x%x%x$") then invalid() end
					cursor = at + 6
				elseif escape == "" or not string.find('"\\/bfnrt', escape, 1, true) then invalid()
				else cursor = at + 2 end
			elseif byte == 127 then
				cursor = at + 1 -- DEL is a legal unescaped JSON string byte.
			else invalid() end
		end
	end
	local parse: (number) -> any
	parse = function(depth: number): any
		if depth > 80 then invalid() end
		whitespace()
		local char = string.sub(text, cursor, cursor)
		if char == '"' then return quoted() end
		if char == "{" or char == "[" then
			local object = char == "{"
			local close = if object then "}" else "]"
			local result: any = if object then {} else Validation.array({})
			cursor += 1
			whitespace()
			if string.sub(text, cursor, cursor) == close then cursor += 1; return result end
			while cursor <= length do
				local key: any = #result + 1
				if object then
					if string.sub(text, cursor, cursor) ~= '"' then invalid() end
					key = quoted()
					if result[key] ~= nil or key == "__proto__" or key == "constructor" or key == "prototype" then invalid() end
					whitespace()
					if string.sub(text, cursor, cursor) ~= ":" then invalid() end
					cursor += 1
				end
				result[key] = parse(depth + 1)
				whitespace()
				local separator = string.sub(text, cursor, cursor)
				cursor += 1
				if separator == close then return result end
				if separator ~= "," then invalid() end
				whitespace()
			end
			return invalid()
		end
		for _, literal in ipairs({"true", "false", "null"}) do
			if string.sub(text, cursor, cursor + #literal - 1) == literal then
				cursor += #literal
				return if literal == "null" then Validation.NULL else literal == "true"
			end
		end
		local start = cursor
		if char == "-" then cursor += 1 end
		local function digit(): boolean
			local byte = string.byte(text, cursor)
			return byte ~= nil and byte >= 48 and byte <= 57
		end
		if not digit() then invalid() end
		if string.sub(text, cursor, cursor) == "0" then cursor += 1
		else while digit() do cursor += 1 end end
		if string.sub(text, cursor, cursor) == "." then
			cursor += 1
			if not digit() then invalid() end
			while digit() do cursor += 1 end
		end
		local exponent = string.sub(text, cursor, cursor)
		if exponent == "e" or exponent == "E" then
			cursor += 1
			local sign = string.sub(text, cursor, cursor)
			if sign == "+" or sign == "-" then cursor += 1 end
			if not digit() then invalid() end
			while digit() do cursor += 1 end
		end
		local number = tonumber(string.sub(text, start, cursor - 1))
		if number == nil then invalid() end
		return Validation.number(number, -math.huge, math.huge, "JSON number")
	end
	local result = parse(0)
	whitespace()
	if cursor <= length then invalid() end
	return result
end

function Validation.safeError(value: any): string
	-- Never echo arbitrary engine/HTTP errors (they may contain source or bearer).
	if type(value) == "table" and type(value.code) == "string" and type(value.message) == "string" then
		return string.sub(value.code .. ": " .. value.message, 1, 512)
	end
	return "ENGINE: Operation failed; inspect the place and reconnect if reconciliation is required."
end

return table.freeze(Validation)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane3">
<Properties>
<string name="Name">Registry</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local V = require(script.Parent.Validation)
local Registry = {}
Registry.__index = Registry
type Registry = any

function Registry.new(sessionId: string, roots: {string}, gameModel: any, http: any): Registry
	local services: {[string]: any} = {}
	for _, root in ipairs(roots) do services[root] = gameModel:GetService(root) end
	return setmetatable({sessionId = sessionId, services = services, gameModel = gameModel, http = http,
		byId = {}, byInstance = {}, owned = {}, count = 0}, Registry)
end

function Registry:rootOf(instance: any): string?
	for root, service in pairs(self.services) do
		if instance == service or instance:IsDescendantOf(service) then return root end
	end
	return nil
end

function Registry:root(name: any): any
	if type(name) ~= "string" or not self.services[name] then V.fail("GRANT", "Root is not granted.") end
	return self.services[name]
end

function Registry:isService(instance: any): boolean
	-- Class tags are not exposed to plugins; IsA(Service) is not a valid test.
	return instance.Parent == self.gameModel or table.find(V.ROOTS, instance.ClassName) ~= nil
end

function Registry:ref(instance: any): any
	local root = self:rootOf(instance)
	if not root then V.fail("REF", "Instance is outside granted roots.") end
	local id = self.byInstance[instance]
	if not id then
		if self.count >= V.MAX_REFS then V.fail("CAPACITY", "Reference capacity reached; pair a new session.") end
		id = self.http:GenerateGUID(false)
		self.byInstance[instance] = id
		self.byId[id] = instance
		self.count += 1
	end
	local path: {string} = {}
	local cursor = instance
	while cursor and cursor ~= self.services[root] do
		if #path >= 63 then V.fail("REF", "Instance hierarchy is too deep.") end
		table.insert(path, 1, V.string(cursor.Name, "instance name", 256, true))
		cursor = cursor.Parent
	end
	-- Root services have an empty display path; descendant paths are relative.
	return {instanceId = id, sessionId = self.sessionId, root = root,
		pathSegments = V.array(path), className = instance.ClassName}
end

function Registry:resolve(value: any): any
	local ref = V.fields(value, {"instanceId", "sessionId", "root", "pathSegments", "className"}, "reference")
	V.string(ref.instanceId, "instance ID", 256)
	V.string(ref.className, "class name", 256)
	local path = V.list(ref.pathSegments, 64, "display path")
	for _, segment in ipairs(path) do V.string(segment, "display path segment", 256, true) end
	if ref.sessionId ~= self.sessionId then V.fail("SESSION", "Reference belongs to another session.") end
	local instance = self.byId[ref.instanceId]
	if not instance or self:rootOf(instance) ~= ref.root or instance.ClassName ~= ref.className then
		V.fail("REF", "Reference is unknown, removed, moved outside its root, or has the wrong class.")
	end
	-- pathSegments are deliberately never used for resolution.
	return instance
end

function Registry:node(instance: any): any
	return {ref = self:ref(instance), name = V.string(instance.Name, "instance name", 256, true),
		className = instance.ClassName, childCount = #instance:GetChildren()}
end

return Registry
]]></ProtectedString>
</Properties>
