<Item class="ModuleScript" referent="RBXArcane12">
<Properties>
<string name="Name">AssetMaterials</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Scalar and privately admitted texture sidecar for the decoder's material manifest (not raw glTF JSON).
-- No services are resolved (only Enum.AlphaMode, read for MASK); only injected factories create resources.
-- Decoded RGBA8 pixels arrive only from a sealed receiver intake; no PNG decoding or uploads.
-- Checked 2026-10-14 against primary docs:
-- https://create.roblox.com/docs/reference/engine/classes/SurfaceAppearance
-- https://create.roblox.com/docs/reference/engine/classes/MeshPart
-- https://create.roblox.com/docs/reference/engine/classes/AssetService#CreateSurfaceAppearanceAsync
-- https://create.roblox.com/docs/reference/engine/classes/EditableImage#WritePixelsBuffer
-- SurfaceAppearance has MAPS, not scalar Metalness/Roughness properties.
-- CreateSurfaceAppearanceAsync consumes a Content map dictionary. Only red is
-- sampled for metalness/roughness. WritePixelsBuffer consumes RGBA bytes with
-- alpha=255 for opaque pixels. Factors are rounded to nearest byte (ties up).
-- Emission is mask-driven and multiplied by albedo; glTF emission is additive.
-- Without verified mask/albedo handling, only zero effective emission is faithful.

export type Emission = {factor: {number}, strength: number, map: any?}
export type Material = {
	baseColor: {number}, metallic: number, roughness: number, alphaMode: string,
	alphaCutoff: number, doubleSided: boolean, normalScale: number,
	colorMap: any?, normalMap: any?, roughnessMap: any?, metalnessMap: any?,
	emission: Emission?, sha256: string?,
}
export type ScalarMap = {
	width: number, height: number, format: "RGBA8", rgba: {number},
	sourceFactor: number, redByte: number, normalizedFactor: number,
	quantizationError: number, rounding: "nearest-half-up", engineVerification: "pending",
}
export type Plan = {
	source: Material, baseColorLinear: {number}, metallic: number, roughness: number,
	constantMaps: {MetalnessMap: ScalarMap, RoughnessMap: ScalarMap},
	doubleSided: boolean, transparency: number, alphaMode: string, emissiveStrength: number?,
	supported: boolean, emissionSupport: "zero-only", limitations: {string},
	requiresSurfaceAppearance: boolean, engineVerification: "pending",
}
-- colorFromLinear is a caller-supplied color-space adapter, NOT a Roblox API.
-- It must encode linear glTF RGB for MeshPart.Color. This module never guesses
-- a renderer's color space or substitutes a built-in material/Reflectance/Neon.
export type Factories = {
	createEditableImage: ({Size: Vector2}) -> EditableImage?,
	createSurfaceAppearanceAsync: ({[string]: Content}) -> SurfaceAppearance?,
	contentFromObject: (EditableImage) -> Content,
	vector2: (number, number) -> Vector2,
	colorFromLinear: (number, number, number) -> Color3,
}
export type Result = {
	surfaceAppearance: SurfaceAppearance,
	editableImages: {[string]: EditableImage},
	meshPartProperties: {Color: Color3, Transparency: number, DoubleSided: boolean},
	plan: Plan, engineVerification: "pending",
}

local MATERIAL_FIELDS = table.freeze({baseColor = true, metallic = true, roughness = true,
	alphaMode = true, alphaCutoff = true, doubleSided = true, normalScale = true,
	colorMap = true, normalMap = true, roughnessMap = true, metalnessMap = true,
	emission = true, sha256 = true})
local EMISSION_FIELDS = table.freeze({factor = true, strength = true, map = true})
local MAP_FIELDS = table.freeze({"colorMap", "normalMap", "roughnessMap", "metalnessMap"})
local LIMITS = table.freeze({editableImages = 2, surfaceAppearances = 1, width = 1, height = 1, pixelBytes = 8})
local EMISSION_LIMITATION = "Nonzero additive glTF emission needs verified emissive mask/albedo mapping; scalar emission is unsupported."
local LIMITATIONS = table.freeze({
	"Metallic and roughness use nearest RGBA8 values; original factors and quantization errors are preserved. Engine rendering is pending.",
	EMISSION_LIMITATION,
	"Texture delivery requires privately admitted RGBA8 maps; only UV0 repeat sampling, opaque alpha and glTF MASK (host-thresholded ColorMap alpha 0/255, AlphaMode Transparency) are supported; BLEND is not. Engine sampling and cutout rendering are pending.",
})
local TEXTURE_LIMITS = table.freeze({width = 1024, height = 1024, maps = 4, bytes = 16 * 1024 * 1024})
local AssetMaterials = {LIMITS = LIMITS, TEXTURE_LIMITS = TEXTURE_LIMITS}
-- This process-local handle never serializes pixel ownership. Raw metadata or a
-- JSON lookalike cannot be passed to plan/create as a verified texture bundle.
local textureHandles: {[any]: any} = setmetatable({}, {__mode = "k"})
local SLOT_FIELDS = table.freeze({ColorMap = "colorMap", NormalMap = "normalMap", RoughnessMap = "roughnessMap", MetalnessMap = "metalnessMap"})
local CHANNELS = table.freeze({ColorMap = "rgba", NormalMap = "rgb", RoughnessMap = "g", MetalnessMap = "b"})
local internalErrors: {[any]: boolean} = setmetatable({}, {__mode = "k"})

local function fail(code: string, field: string, message: string): never
	local value = table.freeze({code = code, field = field, message = message})
	internalErrors[value] = true
	error(value, 0)
end

local function record(value: any, fields: {[string]: boolean}, label: string): any
	if type(value) ~= "table" or getmetatable(value) ~= nil then
		fail("INPUT", label, "Expected a plain material data record.")
	end
	for key in pairs(value) do
		if type(key) ~= "string" or not fields[key] then
			fail("UNSUPPORTED_MATERIAL", label, "Unsupported material field.")
		end
	end
	return value
end

local function scalar(value: any, maximum: number, field: string): number
	if type(value) ~= "number" or value ~= value or value < 0 or value > maximum then
		fail("INPUT", field, "Expected a finite scalar in its supported range.")
	end
	return value
end

local function channels(value: any, count: number, field: string): {number}
	if type(value) ~= "table" or getmetatable(value) ~= nil then
		fail("INPUT", field, "Expected a plain dense color array.")
	end
	local length = 0
	for key in pairs(value) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > count then
			fail("INPUT", field, "Expected an exact color array length.")
		end
		length += 1
	end
	if length ~= count then fail("INPUT", field, "Expected an exact color array length.") end
	local copy: {number} = table.create(count)
	for index = 1, count do copy[index] = scalar(value[index], 1, field) end
	return table.freeze(copy)
end

local function constantMap(factor: number): ScalarMap
	local red = math.floor(factor * 255 + 0.5)
	local normalized = red / 255
	return table.freeze({width = LIMITS.width, height = LIMITS.height, format = "RGBA8",
		rgba = table.freeze({red, red, red, 255}), sourceFactor = factor, redByte = red,
		normalizedFactor = normalized, quantizationError = normalized - factor,
		rounding = "nearest-half-up", engineVerification = "pending"})
end

local function sameData(a: any, b: any, depth: number): boolean
	if type(a) ~= type(b) then return false end
	if type(a) ~= "table" then return a == b end
	if depth > 8 or getmetatable(a) ~= nil or getmetatable(b) ~= nil then return false end
	for key, value in pairs(a) do if not sameData(value, b[key], depth + 1) then return false end end
	for key in pairs(b) do if a[key] == nil then return false end end
	return true
end

-- Pure, bounded validation and detached frozen snapshot. Throws {code,field,
-- message}; never defaults missing decoded fields or clamps unsupported values.
-- A nil material denotes glTF's default metallic=1, roughness=1, white opaque.
-- A valid nonzero emission plan exposes supported=false; create rejects it.
function AssetMaterials.plan(material: Material?, textures: any?): Plan
	local value = record(if material == nil then {baseColor = {1, 1, 1, 1}, metallic = 1, roughness = 1,
		alphaMode = "OPAQUE", alphaCutoff = 0.5, doubleSided = false, normalScale = 1} else material, MATERIAL_FIELDS, "material")
	local bundle = if textures == nil then nil else textureHandles[textures]
	if textures ~= nil and (bundle == nil or bundle.materialSha256 ~= value.sha256) then fail("INPUT", "textures", "Expected an original private texture bundle for this material.") end
	if bundle ~= nil and bundle.source ~= nil and not sameData(value, bundle.source, 0) then fail("INPUT", "textures", "Material data changed after private texture intake.") end
	local sourceMaps = {}
	for slot, field in pairs(SLOT_FIELDS) do
		if value[field] ~= nil then
			if bundle == nil or bundle.maps[slot] == nil then fail("UNSUPPORTED_TEXTURE", field, "Texture mapping requires privately admitted decoded images.") end
			local reference = value[field]
			if type(reference) ~= "table" or getmetatable(reference) ~= nil or reference.sha256 ~= bundle.references[field].sha256
				or reference.channel ~= bundle.references[field].channel or reference.texCoord ~= 0 then fail("INPUT", field, "Material reference changed after texture intake.") end
			for key in pairs(reference) do if key ~= "sha256" and key ~= "channel" and key ~= "texCoord" then fail("INPUT", field, "Unexpected texture reference field.") end end
			sourceMaps[field] = bundle.references[field]
		elseif bundle ~= nil and bundle.maps[slot] ~= nil then fail("INPUT", field, "Unexpected texture map for a scalar material.") end
	end
	local baseColor = channels(value.baseColor, 4, "baseColor")
	local metallic = scalar(value.metallic, 1, "metallic")
	local roughness = scalar(value.roughness, 1, "roughness")
	local cutoff = scalar(value.alphaCutoff, 1, "alphaCutoff")
	-- MASK is a binary cutout already thresholded by the host (alpha >= cutoff
	-- becomes 255, else 0). BLEND and fractional factor alpha are never approximated.
	if (value.alphaMode ~= "OPAQUE" and value.alphaMode ~= "MASK") or baseColor[4] ~= 1 then
		fail("UNSUPPORTED_MATERIAL", "alphaMode", "Only OPAQUE or MASK with alpha=1 is supported; blending is not approximated.")
	end
	local alphaMode: string = value.alphaMode
	if type(value.doubleSided) ~= "boolean" then fail("INPUT", "doubleSided", "Expected a boolean.") end
	-- With no normal map, this factor has no visual effect. Preserve it as data.
	local normalScale = value.normalScale
	if type(normalScale) ~= "number" or normalScale ~= normalScale or math.abs(normalScale) > 1000000 then
		fail("INPUT", "normalScale", "Expected a bounded finite normal scale.")
	end
	if value.sha256 ~= nil and (type(value.sha256) ~= "string" or #value.sha256 ~= 64
		or string.find(value.sha256, "[^0-9a-f]") ~= nil) then
		fail("INPUT", "sha256", "Expected a lowercase SHA-256 digest; a digest grants no authority.")
	end
	local emission: Emission? = nil
	local emissionSupported = true
	if value.emission ~= nil then
		local input = record(value.emission, EMISSION_FIELDS, "emission")
		if input.map ~= nil then fail("UNSUPPORTED_TEXTURE", "emission.map", "Emission textures require decoded images.") end
		local factor = channels(input.factor, 3, "emission.factor")
		local strength = scalar(input.strength, 1000, "emission.strength")
		-- Compare independently rather than multiplying: tiny nonzero emission
		-- must not underflow to zero and pass the unsupported mapping gate.
		emissionSupported = strength == 0 or (factor[1] == 0 and factor[2] == 0 and factor[3] == 0)
		emission = table.freeze({factor = factor, strength = strength})
	end
	local source: Material = table.freeze({baseColor = baseColor, metallic = metallic, roughness = roughness,
		alphaMode = alphaMode, alphaCutoff = cutoff, doubleSided = value.doubleSided,
		normalScale = normalScale, emission = emission, sha256 = value.sha256,
		colorMap = sourceMaps.colorMap, normalMap = sourceMaps.normalMap, roughnessMap = sourceMaps.roughnessMap, metalnessMap = sourceMaps.metalnessMap})
	return table.freeze({source = source, baseColorLinear = if bundle ~= nil and bundle.maps.ColorMap ~= nil then table.freeze({1, 1, 1}) else table.freeze({baseColor[1], baseColor[2], baseColor[3]}),
		constantMaps = table.freeze({MetalnessMap = constantMap(metallic), RoughnessMap = constantMap(roughness)}),
		metallic = metallic, roughness = roughness, doubleSided = source.doubleSided, transparency = 0, alphaMode = alphaMode,
		emissiveStrength = if emissionSupported then 0 else nil, supported = emissionSupported,
		emissionSupport = "zero-only", limitations = LIMITATIONS, requiresSurfaceAppearance = true, engineVerification = "pending"})
end


-- Internal trusted callback for AssetTransfer.reconstruct AFTER exact stream and
-- seal verification. No engine resources are allocated here. Caller conveniences
-- are copied before any later yielding engine callback can observe them.
function AssetMaterials.admitTextures(material: any, maps: any, guard: () -> ()): any
	material = record(material, MATERIAL_FIELDS, "material")
	local materialId = material.sha256
	if type(materialId) ~= "string" or #materialId ~= 64 or string.find(materialId, "[^0-9a-f]") ~= nil then fail("INPUT", "material", "Expected exact material identity.") end
	if type(maps) ~= "table" or getmetatable(maps) ~= nil or type(guard) ~= "function" then fail("INPUT", "textures", "Trusted texture intake requires plain maps and guard.") end
	local function check(): ()
		local ok, result = pcall(guard)
		if not ok or (result ~= nil and result ~= true) then fail("CANCELLED", "guard", "Texture ownership guard revoked.") end
	end
	local owned, references, count, bytes = {}, {}, 0, 0
	local baseColor = channels(material.baseColor, 4, "baseColor")
	local metallic, roughness = scalar(material.metallic, 1, "metallic"), scalar(material.roughness, 1, "roughness")
	check()
	for slot, map in pairs(maps) do
		local field = SLOT_FIELDS[slot]
		if field == nil or type(map) ~= "table" or getmetatable(map) ~= nil then fail("INPUT", "textures", "Unsupported texture slot or data.") end
		local reference = material[field]
		if type(reference) ~= "table" or getmetatable(reference) ~= nil then fail("INPUT", field, "Missing source texture reference.") end
		for key in pairs(reference) do if key ~= "sha256" and key ~= "channel" and key ~= "texCoord" then fail("INPUT", field, "Unexpected source texture field.") end end
		if reference.sha256 ~= map.sourceSha256 or reference.channel ~= CHANNELS[slot] or reference.texCoord ~= 0
			or map.materialSha256 ~= materialId or map.semantic ~= slot or map.channel ~= CHANNELS[slot]
			or map.orientation ~= "top-left" or map.colorSpace ~= (if slot == "ColorMap" then "srgb" else "linear")
			or (slot == "NormalMap" and (map.normalConvention ~= "OpenGL" or material.normalScale ~= 1)) then fail("INPUT", field, "Texture provenance differs from material.") end
		for _, key in ipairs({"imageId", "sourceSha256", "sourceRgbaSha256", "sha256"}) do
			if type(map[key]) ~= "string" or #map[key] ~= 64 or string.find(map[key], "[^0-9a-f]") ~= nil then fail("INPUT", field, "Expected texture digest.") end
		end
		local width, height = map.width, map.height
		if type(width) ~= "number" or type(height) ~= "number" or width % 1 ~= 0 or height % 1 ~= 0 or width < 1 or height < 1
			or width > TEXTURE_LIMITS.width or height > TEXTURE_LIMITS.height or typeof(map.bytes) ~= "buffer"
			or buffer.len(map.bytes) ~= width * height * 4 or map.byteLength ~= width * height * 4 then fail("INPUT", field, "Expected bounded RGBA8 image bytes.") end
		local expected = if slot == "ColorMap" then {baseColor[1], baseColor[2], baseColor[3]}
			elseif slot == "NormalMap" then {material.normalScale} elseif slot == "RoughnessMap" then {roughness} else {metallic}
		if type(map.factors) ~= "table" or getmetatable(map.factors) ~= nil or #map.factors ~= #expected then fail("INPUT", field, "Expected baked material factors.") end
		for index, factor in ipairs(expected) do if map.factors[index] ~= factor then fail("INPUT", field, "Baked factor differs from material.") end end
		count += 1; bytes += width * height * 4
		if count > TEXTURE_LIMITS.maps or bytes > TEXTURE_LIMITS.bytes then fail("INPUT", field, "Texture bundle exceeds bounds.") end
		local copy = buffer.create(width * height * 4)
		buffer.copy(copy, 0, map.bytes, 0, buffer.len(copy))
		-- Only a MASK ColorMap may carry binary cutout coverage; every other map stays opaque.
		local cutout = slot == "ColorMap" and material.alphaMode == "MASK"
		for index = 3, buffer.len(copy) - 1, 4 do
			local alpha = buffer.readu8(copy, index)
			if alpha ~= 255 and not (cutout and alpha == 0) then fail("INPUT", field, "Delivered map pixels require alpha 255 (or 0/255 for a MASK ColorMap).") end
			if index % 16384 == 16383 then check() end
		end
		owned[slot] = table.freeze({width = width, height = height, bytes = copy})
		references[field] = table.freeze({sha256 = reference.sha256, channel = reference.channel, texCoord = 0})
		check()
	end
	for slot, field in pairs(SLOT_FIELDS) do if (material[field] ~= nil) ~= (owned[slot] ~= nil) then fail("INPUT", field, "Texture coverage differs from material.") end end
	if count == 0 then fail("INPUT", "textures", "An empty texture bundle is not ownership.") end
	local handle = table.freeze({kind = "arcane-private-material-textures"})
	textureHandles[handle] = {materialSha256 = materialId, maps = table.freeze(owned), references = table.freeze(references)}
	local ok, plan = pcall(AssetMaterials.plan, material, handle)
	if not ok then textureHandles[handle] = nil; error(plan, 0) end
	textureHandles[handle].source = plan.source
	check()
	return handle
end

-- Adapters wrap CreateEditableImage({Size=...}), Content.fromObject(image),
-- Vector2.new(x,y), and CreateSurfaceAppearanceAsync({MetalnessMap=Content,
-- RoughnessMap=Content}). These are injected callbacks, not live services.
-- Factories must return NEW resources; EditableImage is a non-parentable Object.
-- Ownership of appearance AND ALL IMAGES transfers only on success. Keep the
-- images alive with the appearance; engine packing/lifetime is unverified here.
-- No caller MeshPart is mutated.
-- Main applies meshPartProperties and parents the appearance under its own
-- live authorization/rollback boundary; a plan or hash never authorizes that.
function AssetMaterials.create(material: Material?, factories: Factories, guard: () -> boolean?, textures: any?): Result
	local owned: {any} = {}
	local ok, result = pcall(function(): Result
		if type(guard) ~= "function" or type(factories) ~= "table"
			or type(factories.createEditableImage) ~= "function" or type(factories.createSurfaceAppearanceAsync) ~= "function"
			or type(factories.contentFromObject) ~= "function" or type(factories.vector2) ~= "function"
			or type(factories.colorFromLinear) ~= "function" then
			fail("INPUT", "factories", "Explicit image/appearance/content/vector/color factories and a live guard are required.")
		end
		local function check(): ()
			local alive, allowed = pcall(guard)
			if not alive or (allowed ~= nil and allowed ~= true) then
				fail("CANCELLED", "guard", "Material ownership guard revoked.")
			end
		end
		check()
		local plan = AssetMaterials.plan(material, textures)
		local bundle = if textures == nil then nil else textureHandles[textures]
		if not plan.supported then fail("UNSUPPORTED_MATERIAL", "emission", EMISSION_LIMITATION) end
		-- Snapshot callback references before any callback can yield/change them.
		local makeColor, makeAppearance = factories.colorFromLinear, factories.createSurfaceAppearanceAsync
		local makeImage, makeContent, makeVector = factories.createEditableImage, factories.contentFromObject, factories.vector2
		local function own(resource: any, field: string): any
			if resource ~= nil then
				for _, previous in ipairs(owned) do
					if previous == resource then fail("INPUT", field, "Factory must return a new distinct resource.") end
				end
				owned[#owned + 1] = resource -- BEFORE cancellation checking.
			end
			check()
			if resource == nil then fail("MEMORY", field, "Resource allocation returned nil.") end
			return resource
		end
		check()
		local rgb = plan.baseColorLinear
		local color = makeColor(rgb[1], rgb[2], rgb[3])
		check()
		if color == nil then fail("INPUT", "colorFromLinear", "Color adapter returned nil.") end
		local function image(map: any, field: string): (EditableImage, Content)
			check()
			local size = makeVector(map.width, map.height)
			check()
			local editable = own(makeImage({Size = size}), field) :: EditableImage
			if editable.Size.X ~= map.width or editable.Size.Y ~= map.height then fail("INPUT", field, "Factory image dimensions differ from admitted pixels.") end
			check()
			local pixels = buffer.create(map.width * map.height * 4)
			if map.bytes ~= nil then buffer.copy(pixels, 0, map.bytes, 0, buffer.len(map.bytes))
			else for index = 1, 4 do buffer.writeu8(pixels, index - 1, map.rgba[index]) end end
			local origin = makeVector(0, 0)
			check()
			editable:WritePixelsBuffer(origin, size, pixels)
			check()
			local content = makeContent(editable)
			check()
			if content == nil then fail("INPUT", "contentFromObject", "Content adapter returned nil.") end
			return editable, content
		end
		local images, contents = {}, {}
		for _, slot in ipairs({"MetalnessMap", "RoughnessMap", "ColorMap", "NormalMap"}) do
			local map = if bundle ~= nil and bundle.maps[slot] ~= nil then bundle.maps[slot] else plan.constantMaps[slot]
			if map ~= nil then images[slot], contents[slot] = image(map, slot) end
		end
		check()
		local appearance = own(makeAppearance(contents), "surfaceAppearance") :: SurfaceAppearance
		if not appearance:IsA("SurfaceAppearance") or appearance.Parent ~= nil then
			fail("INPUT", "surfaceAppearance", "Factory must return a new detached SurfaceAppearance.")
		end
		check()
		appearance.EmissiveStrength = plan.emissiveStrength :: number
		if bundle ~= nil and bundle.maps.ColorMap ~= nil then appearance.Color = color end
		-- MASK ColorMap alpha is already binary; Transparency makes it cut out.
		-- Without a ColorMap, factor alpha 1 always passes the cutoff (opaque).
		-- MeshPart.Transparency stays 0. Native cutout rendering is pending.
		if plan.alphaMode == "MASK" and bundle ~= nil and bundle.maps.ColorMap ~= nil then appearance.AlphaMode = (Enum :: any).AlphaMode.Transparency end
		check()
		return table.freeze({surfaceAppearance = appearance,
			editableImages = table.freeze(images),
			meshPartProperties = table.freeze({Color = color, Transparency = plan.transparency, DoubleSided = plan.doubleSided}),
			plan = plan, engineVerification = "pending"})
	end)
	if not ok then
		local cleanupFailed = false
		for index = #owned, 1, -1 do
			local cleaned = pcall(function() owned[index]:Destroy() end)
			if not cleaned then cleanupFailed = true end
		end
		if cleanupFailed then fail("ENGINE", "cleanup", "Material creation failed; owned resource destruction also failed.") end
		if type(result) == "table" and internalErrors[result] then
			error(result, 0)
		end
		-- Do not echo injected/engine errors, which may contain private values.
		fail("ENGINE", "create", "Material creation or injected callback failed.")
	end
	return result :: Result
end

return table.freeze(AssetMaterials)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane13">
<Properties>
<string name="Name">AssetUpload</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Host composition only; deliberately not registered as a plugin command.
-- API checked 2026-10-14:
-- https://create.roblox.com/docs/reference/engine/classes/AssetService#CreateAssetAsync
-- https://create.roblox.com/docs/reference/engine/classes/Object#IsA
-- CreateAssetAsync returns (Enum.CreateAssetResult, assetIdOrError), not a bool.
--
-- Contract for the durable host controller:
--   new(injectedAssetService, injectedEnum, trustedCallbacks): Uploader
--   uploader:upload(frozenTicket, callerOwnedEditableResource): Outcome
--   uploader:status(attemptId): Outcome? -- inspection only, never resumes work
-- Ticket and all nested records must be plain, frozen records with exactly the
-- fields below. They are metadata, NOT native actor identity, consent, ownership
-- or rights. JSON, hashes, creator IDs and booleans cannot establish admission.
-- The host closes over its actual actor/consent/job/session/continuity authority;
-- assertAdmission must check that authority AND the exact borrowed resource.
-- liveGuard must synchronously recheck its continuing validity. Both assertions
-- return NOTHING on admission and throw otherwise; boolean substitutes fail.
-- Assertions must not yield. Journal callbacks may yield. All input metadata,
-- callback references, enum items and the engine method are snapshotted first.
-- The resource reference is borrowed, not copied: the caller must hold its
-- contents stable and retain exclusive lifetime ownership across these yields.
-- This module never destroys, parents, allocates, edits or takes that resource.
--
-- recordIntent(ticket) must durably consume the complete exact ticket before
-- acknowledging {phase="intent", ticket=exactFrozenTicket}. recordResult(ticket,
-- observation) must durably record the observed ID before acknowledging
-- {phase="result", ticket=exactFrozenTicket, assetId=observation.assetId}.
-- ACK matching includes attemptId/source/assetType/creator/uploader/continuity
-- AND name/description. An echo or an ACK alone never establishes admission.
-- Both ACKs are plain frozen records. Their provenance is the trusted callback,
-- not their data shape; this module cannot verify actual durable storage.
-- Result journaling runs BEFORE the final guard after observed success:
-- facts about an already-created asset must survive retirement of admission.
-- Unknown engine outcomes/ACK loss/late scope changes return reconciliation.
-- A known successful asset ID is retained even when its result journal is
-- unknown (resultJournalState="unknown"). Only state="succeeded" allows host continuation, with a fresh guard
-- again at any later import boundary; reconciliation must never continue.
-- Never retry an upload, even after a definitive rejection. An attempt is
-- latched before callbacks run, shared across uploader instances, never evicted.
-- The latch is MODULE-LIFETIME ONLY. The host must enforce durable non-replay
-- across reload/restart and must reconcile incomplete intents, not reissue them
-- under the same or a replacement attempt ID for that logical upload.

export type Creator = {read kind: "user" | "group", read id: number}
-- source.resourceId identifies the particular reconstructed mesh/image, not
-- its display name. The host binds these correlation fields to admitted data.
export type Source = {read jobId: string, read resourceId: string, read sha256: string}
-- This is the separate observed uploader, never inferred from place ownership.
-- Its presence/provenance string is metadata, not verified native identity.
export type UploaderObservation = {read status: "available", read id: number, read provenance: "StudioService:GetUserId"}
export type Continuity = {
	read sessionId: string, read clientLifetimeId: string, read pluginArtifactHash: string,
	read playEpoch: number, read placeId: number, read universeId: number,
}
export type Ticket = {
	read attemptId: string, read assetType: "Mesh" | "Image", read creator: Creator,
	read source: Source, read uploader: UploaderObservation, read continuity: Continuity,
	read name: string, read description: string,
}
export type IntentAck = {read phase: "intent", read ticket: Ticket}
export type ResultAck = {read phase: "result", read ticket: Ticket, read assetId: number}
export type Observation = {read attemptId: string, read assetId: number}
export type Outcome = {
	read attemptId: string, read state: "running" | "succeeded" | "failed" | "reconciliation",
	read phase: string, read reason: string?, read assetId: number?,
	read uploadStarted: boolean, read intentAcknowledged: boolean, read resultAcknowledged: boolean,
	read intentJournalState: "not_started" | "unknown" | "acknowledged",
	read resultJournalState: "not_started" | "unknown" | "acknowledged",
	read scopeLost: boolean, read retryable: false,
}
export type Callbacks = {
	assertAdmission: (Ticket, EditableMesh | EditableImage) -> (),
	liveGuard: (Ticket, EditableMesh | EditableImage) -> (),
	recordIntent: (Ticket) -> IntentAck,
	recordResult: (Ticket, Observation) -> ResultAck,
}
export type EngineEnums = {
	AssetType: any, AssetCreatorType: any, CreateAssetResult: any,
}
export type Uploader = {
	upload: (self: Uploader, Ticket, EditableMesh | EditableImage) -> Outcome,
	status: (self: Uploader, string) -> Outcome?,
}

-- Module bounds, not a statement of Roblox's metadata limits or upload quotas.
local LIMITS = table.freeze({attempts = 256, attemptIdBytes = 128,
	nameBytes = 200, nameCodepoints = 50, descriptionBytes = 4096, descriptionCodepoints = 1000,
	maximumId = 9007199254740991})
local AssetUpload = {LIMITS = LIMITS}
local TICKET_FIELDS = table.freeze({attemptId = true, assetType = true, creator = true, source = true,
	uploader = true, continuity = true, name = true, description = true})
local CREATOR_FIELDS = table.freeze({kind = true, id = true})
local SOURCE_FIELDS = table.freeze({jobId = true, resourceId = true, sha256 = true})
local UPLOADER_FIELDS = table.freeze({status = true, id = true, provenance = true})
local CONTINUITY_FIELDS = table.freeze({sessionId = true, clientLifetimeId = true, pluginArtifactHash = true,
	playEpoch = true, placeId = true, universeId = true})
local CALLBACK_FIELDS = table.freeze({assertAdmission = true, liveGuard = true, recordIntent = true, recordResult = true})
local ENUM_FIELDS = table.freeze({AssetType = true, AssetCreatorType = true, CreateAssetResult = true})
local attempts: {[string]: any} = {}
local attemptCount = 0

local function fail(code: string, message: string): never
	error(table.freeze({code = code, message = message}), 0)
end

local function record(value: any, fields: {[string]: boolean}, frozen: boolean): any
	if type(value) ~= "table" or getmetatable(value) ~= nil or (frozen and not table.isfrozen(value)) then
		fail("INPUT", "Expected a plain host record with the required immutability.")
	end
	for key in pairs(value) do
		if type(key) ~= "string" or not fields[key] then fail("INPUT", "Unsupported host record field.") end
	end
	return value
end

local function validId(value: any): boolean
	return type(value) == "number" and value == value and value >= 1 and value <= LIMITS.maximumId and value % 1 == 0
end

local function identifier(value: any): string
	if type(value) ~= "string" or #value > LIMITS.attemptIdBytes or not string.match(value, "^[A-Za-z0-9][A-Za-z0-9_.:%-]*$") then
		fail("INPUT", "Expected a bounded host correlation identifier.")
	end
	return value
end

local function digest(value: any): string
	if type(value) ~= "string" or #value ~= 64 or not string.match(value, "^[a-f0-9]+$") then fail("INPUT", "Invalid correlation digest.") end
	return value
end

local function natural(value: any): number
	if type(value) ~= "number" or value ~= value or value < 0 or value > LIMITS.maximumId or value % 1 ~= 0 then
		fail("INPUT", "Invalid continuity metadata number.")
	end
	return value
end

local function text(value: any, name: boolean): string
	local bytes = if name then LIMITS.nameBytes else LIMITS.descriptionBytes
	local characters = if name then LIMITS.nameCodepoints else LIMITS.descriptionCodepoints
	if type(value) ~= "string" or #value > bytes then fail("INPUT", "Invalid upload metadata text.") end
	local length = utf8.len(value)
	if not length or length > characters or (name and (length == 0 or not string.find(value, "%S"))) then
		fail("INPUT", "Invalid upload metadata text.")
	end
	for index = 1, #value do
		local byte = string.byte(value, index)
		if byte == 127 or (byte < 32 and (name or (byte ~= 9 and byte ~= 10 and byte ~= 13))) then
			fail("INPUT", "Invalid upload metadata control character.")
		end
	end
	return value
end

local function snapshot(value: any): Ticket
	value = record(value, TICKET_FIELDS, true)
	local id = identifier(value.attemptId)
	if value.assetType ~= "Mesh" and value.assetType ~= "Image" then fail("INPUT", "Only Mesh and Image uploads are supported.") end
	local creator = record(value.creator, CREATOR_FIELDS, true)
	if (creator.kind ~= "user" and creator.kind ~= "group") or not validId(creator.id) then fail("INPUT", "Invalid upload creator metadata.") end
	local source = record(value.source, SOURCE_FIELDS, true)
	local uploader = record(value.uploader, UPLOADER_FIELDS, true)
	if uploader.status ~= "available" or uploader.provenance ~= "StudioService:GetUserId" or not validId(uploader.id) then
		fail("INPUT", "An available separate uploader observation is required as metadata.")
	end
	local continuity = record(value.continuity, CONTINUITY_FIELDS, true)
	return table.freeze({attemptId = id, assetType = value.assetType,
		creator = table.freeze({kind = creator.kind, id = creator.id}),
		source = table.freeze({jobId = identifier(source.jobId), resourceId = identifier(source.resourceId), sha256 = digest(source.sha256)}),
		uploader = table.freeze({status = "available", id = uploader.id, provenance = "StudioService:GetUserId"}),
		continuity = table.freeze({sessionId = identifier(continuity.sessionId), clientLifetimeId = identifier(continuity.clientLifetimeId),
			pluginArtifactHash = digest(continuity.pluginArtifactHash), playEpoch = natural(continuity.playEpoch),
			placeId = natural(continuity.placeId), universeId = natural(continuity.universeId)}),
		name = text(value.name, true), description = text(value.description, false)})
end

local function enumItem(category: any, family: string, name: string): any
	local ok, item = pcall(function(): any return category[name] end)
	if not ok or typeof(item) ~= "EnumItem" or item.Name ~= name or item.EnumType ~= category
		or tostring(item.EnumType) ~= "Enum." .. family then fail("INPUT", "Expected the exact injected engine enum item.") end
	return item
end

local function resourceMatches(resource: any, assetType: string): boolean
	local class = if assetType == "Mesh" then "EditableMesh" else "EditableImage"
	local ok, matches = pcall(function(): boolean return resource.ClassName == class and resource:IsA(class) == true end)
	return ok and matches == true
end

local function acknowledge(value: any, ticket: Ticket, phase: string, assetId: number?): boolean
	if type(value) ~= "table" or getmetatable(value) ~= nil or not table.isfrozen(value) then return false end
	for key in pairs(value) do if key ~= "ticket" and key ~= "phase" and not (phase == "result" and key == "assetId") then return false end end
	if value.phase ~= phase or (phase == "result" and value.assetId ~= assetId) then return false end
	local ok, copy = pcall(snapshot, value.ticket)
	if not ok then return false end
	return copy.attemptId == ticket.attemptId and copy.assetType == ticket.assetType and copy.name == ticket.name and copy.description == ticket.description
		and copy.creator.kind == ticket.creator.kind and copy.creator.id == ticket.creator.id
		and copy.source.jobId == ticket.source.jobId and copy.source.resourceId == ticket.source.resourceId and copy.source.sha256 == ticket.source.sha256
		and copy.uploader.status == ticket.uploader.status and copy.uploader.id == ticket.uploader.id and copy.uploader.provenance == ticket.uploader.provenance
		and copy.continuity.sessionId == ticket.continuity.sessionId and copy.continuity.clientLifetimeId == ticket.continuity.clientLifetimeId
		and copy.continuity.pluginArtifactHash == ticket.continuity.pluginArtifactHash and copy.continuity.playEpoch == ticket.continuity.playEpoch
		and copy.continuity.placeId == ticket.continuity.placeId and copy.continuity.universeId == ticket.continuity.universeId
end

local function outcome(entry: any): Outcome
	return table.freeze({attemptId = entry.attemptId, state = entry.state, phase = entry.phase, reason = entry.reason,
		assetId = entry.assetId, uploadStarted = entry.uploadStarted, intentAcknowledged = entry.intentAcknowledged,
		resultAcknowledged = entry.resultAcknowledged, intentJournalState = entry.intentJournalState,
		resultJournalState = entry.resultJournalState, scopeLost = entry.scopeLost, retryable = false})
end

local function finish(entry: any, state: string, reason: string?): Outcome
	entry.state, entry.reason = state, reason
	if state == "succeeded" then entry.phase = "complete" end
	return outcome(entry)
end

local function assertion(callback: any, ticket: Ticket, resource: any): boolean
	local ok, result = pcall(callback, ticket, resource)
	return ok and result == nil
end

function AssetUpload.new(assetService: any, enums: EngineEnums, callbacks: Callbacks): Uploader
	enums = record(enums, ENUM_FIELDS, false)
	callbacks = record(callbacks, CALLBACK_FIELDS, false)
	for name in pairs(CALLBACK_FIELDS) do
		if type((callbacks :: any)[name]) ~= "function" then fail("INPUT", "Trusted host callbacks are required.") end
	end
	local meshes = enumItem(enums.AssetType, "AssetType", "Mesh")
	local images = enumItem(enums.AssetType, "AssetType", "Image")
	local users = enumItem(enums.AssetCreatorType, "AssetCreatorType", "User")
	local groups = enumItem(enums.AssetCreatorType, "AssetCreatorType", "Group")
	local success = enumItem(enums.CreateAssetResult, "CreateAssetResult", "Success")
	local ok, create = pcall(function(): any return assetService.CreateAssetAsync end)
	if not ok or type(create) ~= "function" then fail("INPUT", "An injected CreateAssetAsync service is required.") end
	local admit, guard, intentJournal, resultJournal = callbacks.assertAdmission, callbacks.liveGuard, callbacks.recordIntent, callbacks.recordResult
	local uploader = {}
	function uploader:status(attemptId: string): Outcome?
		local entry = attempts[attemptId]
		return if entry then outcome(entry) else nil
	end
	function uploader:upload(input: Ticket, resource: EditableMesh | EditableImage): Outcome
		local ticket = snapshot(input) -- No callback or engine call before this copy.
		if attempts[ticket.attemptId] then fail("ATTEMPT", "Attempt already consumed; inspect its journal and status. Never retry its upload.") end
		if attemptCount >= LIMITS.attempts then fail("CAPACITY", "Upload attempt capacity reached; no latch may be evicted or replayed.") end
		local entry: any = {attemptId = ticket.attemptId, state = "running", phase = "admission", uploadStarted = false,
			intentAcknowledged = false, resultAcknowledged = false, scopeLost = false,
			intentJournalState = "not_started", resultJournalState = "not_started"}
		attempts[ticket.attemptId] = entry
		attemptCount += 1
		if not resourceMatches(resource, ticket.assetType) then
			finish(entry, "failed", "INVALID_RESOURCE")
			fail("INPUT", "Expected the matching caller-owned editable resource.")
		end
		if not assertion(admit, ticket, resource) then return finish(entry, "reconciliation", "ADMISSION_FAILED") end
		entry.phase = "guard"
		if not assertion(guard, ticket, resource) then entry.scopeLost = true; return finish(entry, "reconciliation", "SCOPE_CHANGED") end
		entry.phase, entry.intentJournalState = "intent", "unknown"
		local saved, ack = pcall(intentJournal, ticket)
		if not saved or not acknowledge(ack, ticket, "intent", nil) then return finish(entry, "reconciliation", "INTENT_ACK_LOST") end
		entry.intentAcknowledged = true
		entry.intentJournalState = "acknowledged"
		-- A yielding durable write cannot preserve authority by itself.
		entry.phase = "admission"
		if not assertion(admit, ticket, resource) then return finish(entry, "reconciliation", "ADMISSION_CHANGED") end
		entry.phase = "guard"
		if not assertion(guard, ticket, resource) then entry.scopeLost = true; return finish(entry, "reconciliation", "SCOPE_CHANGED") end
		if not resourceMatches(resource, ticket.assetType) then return finish(entry, "reconciliation", "RESOURCE_CHANGED") end
		local parameters = {CreatorId = ticket.creator.id, CreatorType = if ticket.creator.kind == "user" then users else groups,
			Name = ticket.name, Description = ticket.description}
		entry.phase, entry.uploadStarted = "upload", true
		local called, result, idOrError = pcall(create, assetService, resource, if ticket.assetType == "Mesh" then meshes else images, parameters)
		if not called then return finish(entry, "reconciliation", "ENGINE_OUTCOME_UNKNOWN") end
		if typeof(result) ~= "EnumItem" or result.EnumType ~= success.EnumType then return finish(entry, "reconciliation", "INVALID_ENGINE_RESULT") end
		if result == success and not validId(idOrError) then return finish(entry, "reconciliation", "INVALID_ASSET_ID") end
		if result == success then entry.assetId = idOrError end
		if result ~= success then
			local stillLive = assertion(guard, ticket, resource)
			if not stillLive then entry.scopeLost = true end
			return finish(entry, if stillLive then "failed" else "reconciliation", if stillLive then "ENGINE_REJECTED" else "LATE_SCOPE_CHANGED")
		end
		entry.phase, entry.resultJournalState = "result", "unknown"
		local observation = table.freeze({attemptId = ticket.attemptId, assetId = entry.assetId})
		local journaled, resultAck = pcall(resultJournal, ticket, observation)
		entry.resultAcknowledged = journaled and acknowledge(resultAck, ticket, "result", entry.assetId)
		if entry.resultAcknowledged then entry.resultJournalState = "acknowledged" end
		if not assertion(guard, ticket, resource) then entry.scopeLost = true end
		if not entry.resultAcknowledged then return finish(entry, "reconciliation", "RESULT_ACK_LOST") end
		if entry.scopeLost then return finish(entry, "reconciliation", "LATE_SCOPE_CHANGED") end
		return finish(entry, "succeeded", nil)
	end
	return table.freeze(uploader)
end

return table.freeze(AssetUpload)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane14">
<Properties>
<string name="Name">Diagnostics</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Bounded Studio output diagnostics for the paired workspace. Only error and
-- warning output is kept, deduplicated by kind/source/text, and reported on
-- the existing authenticated poll. Nothing here can queue or execute work.
local Diagnostics = {}
Diagnostics.__index = Diagnostics
Diagnostics.CAPABILITY = "studio.diagnostics"
Diagnostics.MAX_ENTRIES = 100
Diagnostics.MAX_PER_REPORT = 10
Diagnostics.MAX_REPORT_BYTES = 64 * 1024
Diagnostics.MESSAGE_BYTES = 2048
Diagnostics.STACK_BYTES = 2048
Diagnostics.SOURCE_BYTES = 512
-- Repeats inside this window count against one entry; a later repeat opens a new one.
Diagnostics.WINDOW_SECONDS = 60
-- LogService and ScriptContext both describe one script error; pair them once.
Diagnostics.PAIR_SECONDS = 1
type Diagnostics = any

-- Truncate on a UTF-8 boundary; invalid UTF-8 is replaced, never forwarded.
function Diagnostics.clip(value: any, maximum: number): string?
	if type(value) ~= "string" then return nil end
	local text = value
	if utf8.len(text) == nil then text = string.gsub(text, "[\128-\255]", "?") end
	text = string.gsub(text, "%z", "")
	if #text > maximum then
		local cut = maximum
		while cut > 0 and utf8.len(string.sub(text, 1, cut)) == nil do cut -= 1 end
		text = string.sub(text, 1, cut)
	end
	return if #text > 0 then text else nil
end

function Diagnostics.new(gameModel: any, isActive: (() -> boolean)?, clock: (() -> number)?): Diagnostics
	return setmetatable({gameModel = gameModel, isActive = isActive, clock = clock or os.clock,
		entries = {}, order = {}, byKey = {}, nextId = 0, connections = {}, stopped = false}, Diagnostics)
end

-- "Path.To.Script:12: text" is the engine's error prefix for script errors.
function Diagnostics.parse(message: string): (string?, number?, string)
	local source, line, text = string.match(message, "^([%w_%.%s%-]+):(%d+): (.*)$")
	if source and line and text then return source, tonumber(line), text end
	return nil, nil, message
end

function Diagnostics:evict(): ()
	while #self.order > Diagnostics.MAX_ENTRIES do
		local oldest = table.remove(self.order, 1)
		local entry = self.entries[oldest]
		self.entries[oldest] = nil
		if entry and self.byKey[entry.key] == oldest then self.byKey[entry.key] = nil end
	end
end

function Diagnostics:record(kind: string, message: any, origin: string, scriptPath: any?, stack: any?): ()
	if self.stopped or (kind ~= "error" and kind ~= "warning") then return end
	if self.isActive and not self.isActive() then return end
	local raw = Diagnostics.clip(message, Diagnostics.MESSAGE_BYTES * 2)
	if not raw then return end
	local parsedSource, line, text = Diagnostics.parse(raw)
	local source = Diagnostics.clip(scriptPath, Diagnostics.SOURCE_BYTES) or Diagnostics.clip(parsedSource, Diagnostics.SOURCE_BYTES)
	if not line and type(stack) == "string" then
		local stackLine = string.match(stack, ":(%d+)")
		line = if stackLine then tonumber(stackLine) else nil
	end
	text = Diagnostics.clip(text, Diagnostics.MESSAGE_BYTES) or "(empty message)"
	local now = self.clock()
	local key = kind .. "\0" .. (source or "") .. "\0" .. text
	local id = self.byKey[key]
	local entry = if id then self.entries[id] else nil
	if entry and now - entry.lastClock <= Diagnostics.WINDOW_SECONDS then
		local paired = entry.pairOrigin and entry.pairOrigin ~= origin and now - entry.pairClock <= Diagnostics.PAIR_SECONDS
		if paired then entry.pairOrigin = nil
		else entry.count += 1; entry.pairOrigin, entry.pairClock = origin, now end
		entry.stack = entry.stack or Diagnostics.clip(stack, Diagnostics.STACK_BYTES)
		entry.line = entry.line or line
		entry.lastClock = now
		entry.version += 1
		local index = table.find(self.order, id)
		if index then table.remove(self.order, index) end
		table.insert(self.order, id)
		return
	end
	self.nextId += 1
	id = "d" .. tostring(self.nextId)
	self.entries[id] = {id = id, key = key, kind = kind, message = text, source = source, line = line,
		stack = Diagnostics.clip(stack, Diagnostics.STACK_BYTES), count = 1, lastClock = now,
		pairOrigin = origin, pairClock = now, version = 1, reported = 0}
	self.byKey[key] = id
	table.insert(self.order, id)
	self:evict()
end

-- Snapshot of changed entries for one poll, bounded by count and encoded bytes.
function Diagnostics:take(encode: (any) -> string): any
	local batch = {entries = {}, versions = {}}
	local bytes = 0
	for _, id in ipairs(self.order) do
		local entry = self.entries[id]
		if entry and entry.version > entry.reported then
			local wire: any = {id = entry.id, kind = entry.kind, message = entry.message, count = entry.count}
			if entry.source then wire.source = entry.source end
			if entry.line and entry.line >= 1 and entry.line <= 1000000 then wire.line = math.floor(entry.line) end
			if entry.stack then wire.stack = entry.stack end
			local size = #encode(wire) + 1
			if bytes + size > Diagnostics.MAX_REPORT_BYTES then break end
			bytes += size
			table.insert(batch.entries, wire)
			batch.versions[id] = entry.version
			if #batch.entries >= Diagnostics.MAX_PER_REPORT then break end
		end
	end
	return batch
end

-- Only an authenticated, accepted poll marks entries reported; a lost poll resends them.
function Diagnostics:ack(batch: any): ()
	for id, version in pairs(batch.versions) do
		local entry = self.entries[id]
		if entry and version > entry.reported then entry.reported = version end
	end
end

function Diagnostics:start(): boolean
	if self.stopped or #self.connections > 0 then return #self.connections > 0 end
	local ok = pcall(function()
		local log = self.gameModel:GetService("LogService")
		local errorType, warningType = Enum.MessageType.MessageError, Enum.MessageType.MessageWarning
		table.insert(self.connections, log.MessageOut:Connect(function(message: string, messageType: any)
			if messageType == errorType then self:record("error", message, "log")
			elseif messageType == warningType then self:record("warning", message, "log") end
		end))
	end)
	pcall(function()
		local context = self.gameModel:GetService("ScriptContext")
		table.insert(self.connections, context.Error:Connect(function(message: string, stack: string, origin: any)
			local path = nil
			if typeof(origin) == "Instance" then
				local named, value = pcall(function(): string return origin:GetFullName() end)
				if named then path = value end
			end
			self:record("error", message, "script", path, stack)
		end))
	end)
	return ok or #self.connections > 0
end

function Diagnostics:stop(): ()
	self.stopped = true
	for _, connection in ipairs(self.connections) do pcall(function() connection:Disconnect() end) end
	self.connections = {}
	self.entries, self.order, self.byKey = {}, {}, {}
end

return Diagnostics
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane15">
<Properties>
<string name="Name">AssetPlacement</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Native asset adoption: the built-in Studio tools insert or generate an instance; this module
-- adopts exactly that one instance (strip scripts by default, fit, ground, pivot, anchor, parent)
-- under one undo recording and receipt, and clones script-free templates for scene.build.
local V = require(script.Parent.Validation)
local AssetPlacement = {}

AssetPlacement.LIMITS = table.freeze({descendants = 5000, templateDescendants = 2000, templates = 16, watches = 4,
	watchSeconds = 600, additions = 64, arrivalSeconds = 10, materialTargets = 64, removedNames = 20})
AssetPlacement.GENERATED_MATERIALS = table.freeze({"Plastic", "SmoothPlastic", "Wood", "WoodPlanks", "Marble", "Basalt", "Slate", "CrackedLava",
	"Concrete", "Limestone", "Granite", "Pavement", "Brick", "Pebble", "Cobblestone", "Rock", "Sandstone", "CorrodedMetal", "DiamondPlate", "Foil",
	"Metal", "Grass", "LeafyGrass", "Sand", "Fabric", "Snow", "Mud", "Ground", "Asphalt", "Salt", "Ice", "Glacier", "Cardboard", "Carpet",
	"CeramicTiles", "ClayRoofTiles", "RoofShingles", "Leather", "Plaster", "Rubber"})
local L = AssetPlacement.LIMITS

local function triple(value: any, low: number, high: number, label: string): {number}
	local list = V.list(value, 3, label)
	if #list ~= 3 then V.fail("INPUT", label .. " needs three numbers.") end
	for _, item in ipairs(list) do V.number(item, low, high, label) end
	return {list[1], list[2], list[3]}
end

-- Pure placement math (also exercised directly by the standalone tests).
-- components are CFrame:GetComponents(): x, y, z, R00, R01, R02, R10, R11, R12, R20, R21, R22.
function AssetPlacement.worldExtents(c: {number}, size: any): {number}
	local sx, sy, sz = size.X, size.Y, size.Z
	return {math.abs(c[4]) * sx + math.abs(c[5]) * sy + math.abs(c[6]) * sz,
		math.abs(c[7]) * sx + math.abs(c[8]) * sy + math.abs(c[9]) * sz,
		math.abs(c[10]) * sx + math.abs(c[11]) * sy + math.abs(c[12]) * sz}
end
-- Uniform scale that fits the world extents inside maxSize (the tightest axis wins).
function AssetPlacement.fitScale(extents: {number}, maxSize: {number}?): number
	if not maxSize then return 1 end
	local scale = math.huge
	for axis = 1, 3 do
		if extents[axis] > 1e-6 then scale = math.min(scale, maxSize[axis] / extents[axis]) end
	end
	if scale == math.huge then V.fail("ASSET", "The asset has no measurable size; nothing was adopted.") end
	if scale < 0.01 or scale > 100 then V.fail("ASSET", "Fitting the asset to maxSize needs a scale outside 0.01..100; choose a closer size or another asset.") end
	return scale
end
function AssetPlacement.bottomCenter(c: {number}, extents: {number}): {number}
	return {c[1], c[2] - extents[2] / 2, c[3]}
end

-- Exact extents of the same oriented box after the requested world Y rotation.
function AssetPlacement.worldExtentsAtYaw(c: {number}, size: any, yaw: number): {number}
	local angle = math.rad(yaw)
	local cosine, sine = math.cos(angle), math.sin(angle)
	return AssetPlacement.worldExtents({c[1], c[2], c[3],
		cosine * c[4] + sine * c[10], cosine * c[5] + sine * c[11], cosine * c[6] + sine * c[12],
		c[7], c[8], c[9],
		-sine * c[4] + cosine * c[10], -sine * c[5] + cosine * c[11], -sine * c[6] + cosine * c[12]}, size)
end

local function boxOf(root: any, yaw: number): ({number}, {number}, {number})
	local cframe, size = root:GetBoundingBox()
	local components = {cframe:GetComponents()}
	return components, AssetPlacement.worldExtents(components, size), AssetPlacement.worldExtentsAtYaw(components, size, yaw)
end

-- One-shot watch: records top-level instances added under Workspace after it is armed.
function AssetPlacement.watch(ops: any): any
	local workspace = ops.registry:root("Workspace")
	local watches = ops.assetWatches
	if not watches then watches = {}; ops.assetWatches = watches end
	local now = os.clock()
	local count, oldestId, oldestAt = 0, nil, math.huge
	for id, entry in pairs(watches) do
		if entry.expires <= now then entry.connection:Disconnect(); watches[id] = nil
		else
			count += 1
			if entry.started < oldestAt then oldestId, oldestAt = id, entry.started end
		end
	end
	if count >= L.watches and oldestId then watches[oldestId].connection:Disconnect(); watches[oldestId] = nil end
	local id = (string.gsub(ops.http:GenerateGUID(false), "[^%w_%-]", ""))
	local entry: any = {additions = {}, seen = {}, overflow = false, started = now, expires = now + L.watchSeconds}
	entry.connection = workspace.DescendantAdded:Connect(function(instance: any)
		local cursor = instance.Parent
		while cursor and cursor ~= workspace do
			if entry.seen[cursor] then return end
			cursor = cursor.Parent
		end
		if #entry.additions >= L.additions then entry.overflow = true; return end
		entry.seen[instance] = true
		table.insert(entry.additions, instance)
	end)
	watches[id] = entry
	return {watch = id, expiresInSeconds = L.watchSeconds}
end

local function release(ops: any, id: string): ()
	local entry = ops.assetWatches and ops.assetWatches[id]
	if entry then entry.connection:Disconnect(); ops.assetWatches[id] = nil end
end

local function candidates(ops: any, entry: any, workspace: any): {any}
	local tops: {any} = {}
	for _, instance in ipairs(entry.additions) do
		if instance.Parent ~= nil and instance:IsDescendantOf(workspace) and not ops.registry.owned[instance]
			and (instance:IsA("Model") or instance:IsA("BasePart") or instance:IsA("Folder")) then
			local nested, cursor = false, instance.Parent
			while cursor and cursor ~= workspace do
				if entry.seen[cursor] then nested = true; break end
				cursor = cursor.Parent
			end
			if not nested then table.insert(tops, instance) end
		end
	end
	return tops
end

-- Waits up to arrivalSeconds for exactly one inserted instance. Never adopts on ambiguity.
function AssetPlacement.arrival(ops: any, id: string, expectName: string?, workspace: any): any
	local entry = ops.assetWatches and ops.assetWatches[id]
	if not entry or entry.expires <= os.clock() then V.fail("WATCH", "The insertion watch is unknown or expired; start the insert again.") end
	local polls = L.arrivalSeconds * 4
	for attempt = 0, polls do
		if entry.overflow then V.fail("AMBIGUOUS", "Too many instances appeared in Workspace during the insertion; nothing was adopted. Inspect Workspace before trying again.") end
		local tops = candidates(ops, entry, workspace)
		local chosen: any = nil
		if expectName then
			local named: {any} = {}
			for _, instance in ipairs(tops) do if instance.Name == expectName then table.insert(named, instance) end end
			if #named > 1 then V.fail("AMBIGUOUS", "Several instances share the inserted asset name; nothing was adopted.") end
			chosen = named[1]
		end
		if not chosen and #tops > 1 then V.fail("AMBIGUOUS", "Several new instances appeared in Workspace during the insertion; nothing was adopted. Inspect Workspace and remove any unwanted insert.") end
		chosen = chosen or tops[1]
		if chosen then
			-- A script dropped next to the asset (not inside it) would escape the strip below: refuse instead.
			for _, instance in ipairs(entry.additions) do
				if instance ~= chosen and instance.Parent ~= nil and instance:IsDescendantOf(workspace) and not ops.registry.owned[instance]
					and not instance:IsDescendantOf(chosen) and not chosen:IsDescendantOf(instance) then
					local scripted = instance:IsA("LuaSourceContainer")
					if not scripted then for _, item in ipairs(instance:GetDescendants()) do if item:IsA("LuaSourceContainer") then scripted = true; break end end end
					if scripted then V.fail("AMBIGUOUS", "Scripts appeared in Workspace next to the inserted asset; nothing was adopted.") end
				end
			end
			return chosen
		end
		if attempt < polls then task.wait(0.25) end
	end
	V.fail("NOT_FOUND", "No inserted instance appeared in Workspace within " .. L.arrivalSeconds .. " seconds; nothing was adopted.")
	return nil
end

function AssetPlacement.place(ops: any, command: any, args: any, guard: () -> ()): any
	V.fields(args, {"watch", "expectName", "parent", "name", "maxSize", "position", "yaw", "ground", "anchor", "allowScripts"}, "asset placement")
	local id = V.string(args.watch, "insertion watch", 128)
	local expectName = if args.expectName == nil then nil else V.string(args.expectName, "expected asset name", 100)
	local container = ops.registry:resolve(args.parent)
	local name = V.string(args.name, "asset name", 100)
	local maxSize = if args.maxSize == nil then nil else triple(args.maxSize, 0.2, 2048, "asset maxSize")
	local position = triple(args.position, -100000, 100000, "asset position")
	local yaw = V.number(args.yaw, -360, 360, "asset yaw")
	local ground, anchor, allowScripts = V.boolean(args.ground, "ground"), V.boolean(args.anchor, "anchor"), V.boolean(args.allowScripts, "allowScripts")
	local workspace = ops.registry:root("Workspace")
	if ops.registry.count >= V.MAX_REFS then V.fail("CAPACITY", "Reference capacity reached; pair a new session.") end
	-- "editable-<digest>" adopts this plugin's retained reconstruction (procedural/Blender
	-- meshes) as new MeshParts instead of waiting for a native insertion.
	local editable = string.match(id, "^editable%-([0-9a-f]+)$")
	local placed: (() -> ())? = nil
	local asset: any
	local watched = if editable then nil else ops.assetWatches and ops.assetWatches[id]
	-- A refused native insert stays in Workspace for the person to inspect, but never with its scripts or package links.
	local function scrub(): ()
		if allowScripts or not watched then return end
		for _, instance in ipairs(watched.additions) do
			if instance.Parent ~= nil and instance:IsDescendantOf(workspace) and not ops.registry.owned[instance] then
				local items = instance:GetDescendants()
				table.insert(items, instance)
				for _, item in ipairs(items) do
					if item.Parent ~= nil and (item:IsA("LuaSourceContainer") or item.ClassName == "PackageLink") then pcall(function() item:Destroy() end) end
				end
			end
		end
	end
	if editable then
		if type(ops.materializeReconstruction) ~= "function" then V.fail("WATCH", "This plugin cannot place reconstructed meshes.") end
		asset, placed = ops:materializeReconstruction(editable, guard)
	else
		local arrived, value = pcall(AssetPlacement.arrival, ops, id, expectName, workspace)
		if not arrived then scrub(); error(value, 0) end
		asset = value
	end
	local ok, result = pcall(AssetPlacement.adopt, ops, command, args, guard, asset, container, name, maxSize, position, yaw, ground, anchor, allowScripts, editable ~= nil, id)
	if not ok then
		-- A detached materialized model never reached the scene: release it, no receipt.
		if editable and asset.Parent == nil then pcall(function() asset:Destroy() end) end
		scrub()
		error(result, 0)
	end
	if placed then placed() end
	return result
end

function AssetPlacement.adopt(ops: any, command: any, args: any, guard: () -> (), asset: any, container: any, name: string, maxSize: {number}?,
	position: {number}, yaw: number, ground: boolean, anchor: boolean, allowScripts: boolean, detached: boolean, id: string): any
	local workspace = ops.registry:root("Workspace")
	local descendants = asset:GetDescendants()
	if #descendants + 1 > L.descendants then V.fail("BODY_LIMIT", "The inserted asset has more than " .. L.descendants .. " instances; nothing was adopted. Remove it or choose a lighter asset.") end
	local physical = asset:IsA("BasePart")
	for _, item in ipairs(descendants) do if item:IsA("BasePart") then physical = true; break end end
	if not physical then V.fail("ASSET", "The inserted asset has no 3D parts; nothing was adopted. Remove it from Workspace if unwanted.") end
	return ops:record(command, guard, function(progress: any): any
		guard()
		ops.registry:resolve(args.parent)
		if asset.Parent == nil and not detached then V.fail("ASSET", "The inserted asset disappeared before adoption.") end
		progress.touched = true
		-- Free models can carry hostile scripts: remove every script unless explicitly allowed.
		local removed: number, kept: number, classes: {[string]: number}, names: any = 0, 0, {}, V.array({})
		for _, item in ipairs(asset:GetDescendants()) do
			if item.Parent ~= nil and item.ClassName == "PackageLink" then
				-- An auto-updating package could bring scripts back after adoption.
				item:Destroy()
			elseif item.Parent ~= nil and item:IsA("LuaSourceContainer") then
				if allowScripts then
					kept += 1
					-- Kept scripts land disabled; turning one on is a separate, reviewed script.set_enabled.
					if item:IsA("BaseScript") then item.Disabled = true end
				else
					removed += 1
					classes[item.ClassName] = (classes[item.ClassName] or 0) + 1
					if #names < L.removedNames then table.insert(names, string.sub(item.Name, 1, 100)) end
					item:Destroy()
				end
			end
		end
		local root = asset
		if asset:IsA("Model") then asset.Parent = nil
		else
			root = Instance.new("Model")
			asset.Parent = root
		end
		local anchored: number = 0
		if anchor then
			for _, item in ipairs(root:GetDescendants()) do
				if item:IsA("BasePart") then item.Anchored = true; anchored += 1 end
			end
		end
		local components, extents, placedExtents = boxOf(root, yaw)
		local scale = AssetPlacement.fitScale(placedExtents, maxSize)
		if scale ~= 1 then
			root:ScaleTo(root:GetScale() * scale)
			components, extents, placedExtents = boxOf(root, yaw)
		end
		local bottom = AssetPlacement.bottomCenter(components, extents)
		root.WorldPivot = CFrame.new(bottom[1], bottom[2], bottom[3])
		local y, grounded = position[2], false
		if ground then
			-- The asset is detached, so the probe only sees existing terrain and parts.
			local hit = workspace:Raycast(Vector3.new(position[1], position[2] + 500, position[3]), Vector3.new(0, -1000, 0))
			if hit then y, grounded = hit.Position.Y, true end
		end
		root:PivotTo(CFrame.new(position[1], y, position[3]) * CFrame.Angles(0, math.rad(yaw), 0))
		root.Name = name
		root.Parent = container
		local ref = ops.registry:ref(root)
		progress.ref = ref
		local count = #root:GetDescendants()
		ops.registry.owned[root] = {parent = container, placed = {count = count, pivot = {root.WorldPivot:GetComponents()}}}
		release(ops, id)
		local rounded = math.floor(scale * 10000 + 0.5) / 10000
		return {ref = ref, adopted = {name = string.sub(asset.Name, 1, 100), className = asset.ClassName},
			removedScripts = {count = removed, classes = classes, names = names}, keptScripts = kept, anchored = anchored,
			scale = rounded, size = V.array({placedExtents[1], placedExtents[2], placedExtents[3]}), grounded = grounded,
			mutation = {kind = "scene.place_asset", ref = ref, before = V.NULL,
				after = {descendants = count, removedScripts = removed, keptScripts = kept, scale = rounded}}}
	end)
end

-- Applies a generated MaterialVariant (under MaterialService) to bounded parts with a receipt.
function AssetPlacement.applyMaterial(ops: any, command: any, args: any, guard: () -> ()): any
	V.fields(args, {"refs", "material", "variant"}, "material arguments")
	local list = V.list(args.refs, L.materialTargets, "material targets")
	if #list == 0 then V.fail("INPUT", "Choose at least one part.") end
	local materialName = V.string(args.material, "material", 32)
	if not table.find(AssetPlacement.GENERATED_MATERIALS, materialName) then V.fail("PROPERTY", "Unsupported generated base material.") end
	local found, material = pcall(function(): any return (Enum.Material :: any)[materialName] end)
	if not found or material == nil then V.fail("PROPERTY", "This Studio build lacks the requested base material.") end
	local variantName = V.string(args.variant, "material variant", 100)
	if not string.match(variantName, "^[%w_]+$") then V.fail("INPUT", "Material variant names are [A-Za-z0-9_].") end
	local service = ops.registry.gameModel:GetService("MaterialService")
	local variant = service:FindFirstChild(variantName, true)
	if not variant or variant.ClassName ~= "MaterialVariant" then V.fail("MATERIAL", "The generated material variant was not found under MaterialService.") end
	if variant.BaseMaterial ~= material then V.fail("MATERIAL", "The generated variant's base material differs from the requested material.") end
	local parts: {any}, seen: {[any]: boolean} = {}, {}
	for _, raw in ipairs(list) do
		local part = ops.registry:resolve(raw)
		if not part:IsA("BasePart") then V.fail("CLASS", "Materials apply to BaseParts only.") end
		if seen[part] then V.fail("INPUT", "Material targets must be distinct.") end
		seen[part] = true
		table.insert(parts, part)
	end
	return ops:record(command, guard, function(progress: any): any
		guard()
		local items: any = V.array({})
		for _, part in ipairs(parts) do
			table.insert(items, {ref = ops.registry:ref(part), Material = part.Material.Name, MaterialVariant = part.MaterialVariant})
		end
		progress.touched = true
		for _, part in ipairs(parts) do
			part.Material = material
			part.MaterialVariant = variantName
			if part.Material ~= material or part.MaterialVariant ~= variantName then V.fail("VERIFY", "A part did not take the generated material.") end
		end
		local ref = items[1].ref
		progress.ref = ref
		return {ref = ref, applied = #parts, mutation = {kind = "scene.apply_material", ref = ref, before = {items = items},
			after = {material = materialName, variant = variantName, count = #parts}}}
	end)
end

local function samePivot(current: any, recorded: {number}): boolean
	local now = {current:GetComponents()}
	for index, value in ipairs(recorded) do if math.abs(now[index] - value) > 1e-3 then return false end end
	return true
end

function AssetPlacement.restore(ops: any, command: any, original: any, instance: any, guard: () -> ()): ()
	if original.kind == "scene.place_asset" then
		local owned = ops.registry.owned[instance]
		local placed = owned and owned.placed
		local function matches(): boolean
			return placed ~= nil and instance.Parent == owned.parent and #instance:GetDescendants() == placed.count and samePivot(instance.WorldPivot, placed.pivot)
		end
		if not matches() then V.fail("CONFLICT", "The placed asset changed, moved, or gained/lost instances; restoration refused.") end
		ops:record(command, guard, function(progress: any): any
			guard()
			ops.registry:resolve(original.ref)
			if not matches() then V.fail("CONFLICT", "The placed asset changed before restoration.") end
			progress.ref = original.ref
			progress.touched = true
			instance:Destroy()
			return {restored = true, ref = original.ref}
		end)
		return
	end
	local parts: {any} = {}
	for _, item in ipairs(original.before.items) do
		local part = ops.registry:resolve(item.ref)
		if part.Material.Name ~= original.after.material or part.MaterialVariant ~= original.after.variant then
			V.fail("CONFLICT", "A part's material changed after the generated material was applied; restoration refused.")
		end
		local ok, prior = pcall(function(): any return (Enum.Material :: any)[item.Material] end)
		if not ok or prior == nil then V.fail("RECEIPT", "The recorded prior material is unavailable.") end
		table.insert(parts, {part = part, material = prior, variant = item.MaterialVariant})
	end
	ops:record(command, guard, function(progress: any): any
		guard()
		progress.ref = original.ref
		progress.touched = true
		for _, entry in ipairs(parts) do
			entry.part.Material = entry.material
			entry.part.MaterialVariant = entry.variant
		end
		return {restored = true, ref = original.ref}
	end)
end

-- scene.build clone templates: script-free Model/BasePart instances inside the granted roots.
function AssetPlacement.buildTemplates(ops: any, raw: any): {any}
	local templates: {any} = {}
	for _, value in ipairs(V.list(raw, L.templates, "clone templates")) do
		local template = ops.registry:resolve(value)
		if not (template:IsA("Model") or template:IsA("BasePart")) then V.fail("CLASS", "Clone templates must be a Model or BasePart.") end
		local descendants = template:GetDescendants()
		if #descendants > L.templateDescendants then V.fail("BODY_LIMIT", "A clone template may hold at most " .. L.templateDescendants .. " instances.") end
		for _, item in ipairs(descendants) do
			if item:IsA("LuaSourceContainer") or item.ClassName == "PackageLink" then V.fail("SCRIPT", "Clone templates must be script-free; adopt them with scripts stripped.") end
		end
		table.insert(templates, {instance = template, extra = #descendants})
	end
	return templates
end

function AssetPlacement.planClone(ops: any, item: any, name: string, into: number, templates: {any}): any
	V.fields(item, {"kind", "template", "name", "parent", "at", "yaw", "scale", "ground", "key"}, "clone item")
	local template = templates[V.integer(item.template, 1, math.max(1, #templates), "template index")]
	if not template then V.fail("INPUT", "Clone item names an unknown template.") end
	local at = triple(item.at, -100000, 100000, "clone position")
	if item.ground ~= nil and V.boolean(item.ground, "clone ground") then
		-- Read-only probe of existing terrain/parts; nothing from this build is parented yet.
		local hit = ops.registry:root("Workspace"):Raycast(Vector3.new(at[1], at[2] + 500, at[3]), Vector3.new(0, -1000, 0))
		if hit then at[2] = hit.Position.Y end
	end
	return {clone = template.instance, extra = template.extra, className = template.instance.ClassName, name = name, parent = into,
		at = at, yaw = V.number(item.yaw, -360, 360, "clone yaw"), scale = V.number(item.scale, 0.1, 20, "clone scale")}
end

function AssetPlacement.instantiate(entry: any): any
	local copy = entry.clone:Clone()
	if not copy then V.fail("VERIFY", "The clone template is not archivable.") end
	-- The template was checked when the build was planned; it may have changed since, so check the copy itself.
	for _, item in ipairs(copy:GetDescendants()) do
		if item:IsA("LuaSourceContainer") or item.ClassName == "PackageLink" then
			copy:Destroy()
			V.fail("SCRIPT", "Clone templates must be script-free; adopt them with scripts stripped.")
		end
	end
	if entry.scale ~= 1 then
		if copy:IsA("Model") then copy:ScaleTo(copy:GetScale() * entry.scale)
		else copy.Size = Vector3.new(copy.Size.X * entry.scale, copy.Size.Y * entry.scale, copy.Size.Z * entry.scale) end
	end
	copy:PivotTo(CFrame.new(entry.at[1], entry.at[2], entry.at[3]) * CFrame.Angles(0, math.rad(entry.yaw), 0))
	return copy
end

-- "Keep this mesh" (docs/build/MESH_KEEP.md). Uploads each retained EditableMesh of ONE placed procedural reconstruction to
-- the signed-in Studio user's own Roblox account through AssetUpload (AssetService.CreateAssetAsync), then swaps every
-- session MeshPart for a persistent MeshPart made from its new asset ID (AssetService.CreateMeshPartAsync) in one undo
-- recording. Only the host mesh-keep service can queue it, after the person confirmed the Arcane dialog; the host records
-- the intent durably before queueing, which is what recordIntent acknowledges. Nothing is retried. Asset IDs are always
-- returned, even when a later upload or the swap fails, so an upload is never lost from the receipt.
-- APIs (create.roblox.com, checked 2026-10-18): AssetService.CreateAssetAsync(object, Enum.AssetType, {CreatorId,
-- CreatorType, Name, Description}) -> (Enum.CreateAssetResult, assetId or error); AssetService.CreateMeshPartAsync(Content,
-- options) -> MeshPart; Content.fromAssetId(id), with Content.fromUri("rbxassetid://" .. id) as the fallback.
-- keepSupported probes every one of them; when any is missing the capability is not advertised (fails closed).
AssetPlacement.KEEP_LIMITS = table.freeze({meshes = 16, nameCodepoints = 50})
local KL = AssetPlacement.KEEP_LIMITS

function AssetPlacement.keepSupported(gameModel: any): boolean
	local ok, supported = pcall(function(): boolean
		local service = gameModel:GetService("AssetService")
		local enums: any, content: any = Enum, Content
		return type(service.CreateAssetAsync) == "function" and type(service.CreateMeshPartAsync) == "function"
			and typeof(enums.AssetType.Mesh) == "EnumItem" and typeof(enums.AssetCreatorType.User) == "EnumItem"
			and typeof(enums.CreateAssetResult.Success) == "EnumItem"
			and (type(content.fromAssetId) == "function" or type(content.fromUri) == "function")
	end)
	return ok and supported == true
end

-- Production engine bindings; the standalone tests inject doubles with the same shape.
function AssetPlacement.keepEngine(ops: any, assetUpload: any): any
	local content: any = Content
	return {service = ops.gameModel:GetService("AssetService"), AssetUpload = assetUpload,
		enums = {AssetType = Enum.AssetType, AssetCreatorType = Enum.AssetCreatorType, CreateAssetResult = Enum.CreateAssetResult},
		content = function(id: number): any
			if type(content.fromAssetId) == "function" then return content.fromAssetId(id) end
			return content.fromUri("rbxassetid://" .. string.format("%d", id))
		end,
		userId = function(): number return ops.gameModel:GetService("StudioService"):GetUserId() end}
end

local function clipName(name: string, suffix: string): string
	local room = KL.nameCodepoints - utf8.len(suffix)
	if (utf8.len(name) or 0) > room then name = string.sub(name, 1, (utf8.offset(name, room + 1) or (#name + 1)) - 1) end
	return name .. suffix
end

local SWAP_FIELDS = table.freeze({"Name", "Size", "CFrame", "Anchored", "CanCollide", "CanQuery", "CanTouch", "CastShadow", "Transparency", "Material", "Color", "DoubleSided"})

function AssetPlacement.keep(ops: any, owner: any, digest: string, args: any, guard: () -> (), engine: any): any
	V.fields(args, {"source", "attemptId", "name", "description", "creatorId", "continuity", "finish", "assetIds"}, "keep-mesh arguments")
	local attemptId = V.string(args.attemptId, "attempt ID", 36)
	if not string.match(attemptId, "^%x+%-%x+%-%x+%-%x+%-%x+$") then V.fail("INPUT", "Expected a host upload attempt ID.") end
	local name = V.string(args.name, "asset name", 200)
	if (utf8.len(name) or 0) > KL.nameCodepoints or not string.find(name, "%S") then V.fail("INPUT", "Invalid asset name.") end
	local description = V.string(args.description, "asset description", 4096, true)
	local creatorId = V.integer(args.creatorId, 1, 9007199254740991, "creator ID")
	local continuity = V.fields(args.continuity, {"clientLifetimeId", "pluginArtifactHash", "playEpoch"}, "keep-mesh continuity")
	local finish = V.boolean(args.finish, "finish")
	local reuse: {number}? = nil
	if finish then
		reuse = {}
		for index, value in ipairs(V.list(args.assetIds, KL.meshes, "asset IDs")) do (reuse :: any)[index] = V.integer(value, 1, 9007199254740991, "asset ID") end
	elseif args.assetIds ~= nil then V.fail("INPUT", "A new keep never carries asset IDs.") end
	local meshes = owner.meshes
	if #meshes == 0 or #meshes > KL.meshes then V.fail("CAPACITY", "Keep this mesh supports 1.." .. KL.meshes .. " meshes per model; nothing was uploaded.") end
	if reuse and #reuse ~= #meshes then V.fail("SCOPE", "The recorded asset IDs do not match this model's meshes.") end
	local model = owner.placed
	if model == nil or model.Parent == nil then V.fail("STATE", "The placed model was removed or undone; nothing was uploaded. Place it again first.") end
	for _, resource in ipairs(meshes) do
		if resource.disposed or resource.mesh == nil then V.fail("STATE", "The session meshes were released; nothing was uploaded.") end
	end
	-- The account the person confirmed in Arcane must still be the signed-in Studio user, right before any upload.
	local function signedIn(): boolean
		local ok, id = pcall(engine.userId)
		return ok and id == creatorId
	end
	if not signedIn() then V.fail("ACCOUNT", "The Roblox account signed in to Studio changed since you confirmed. Nothing was uploaded.") end
	guard()
	local entries: {any} = {}
	local started = 0
	if reuse then
		for index, resource in ipairs(meshes) do
			local object = resource.object
			entries[index] = {index = index, name = if type(object) == "table" and type(object.name) == "string" then string.sub(object.name, 1, 100) else "Mesh" .. index,
				assetId = reuse[index], upload = "reused", reason = V.NULL, swapped = false}
		end
	else
		local lastResult: string? = nil
		-- Pass-through that only remembers the engine's own CreateAssetResult name for the receipt (quota, moderation...).
		local recorder = {CreateAssetAsync = function(_self: any, resource: any, assetType: any, parameters: any): (any, any)
			local result, idOrError = engine.service:CreateAssetAsync(resource, assetType, parameters)
			lastResult = if typeof(result) == "EnumItem" and type(result.Name) == "string" and string.match(result.Name, "^%a+$") then string.sub(result.Name, 1, 40) else nil
			return result, idOrError
		end}
		local function current(resource: any): boolean
			for _, item in ipairs(meshes) do if item.mesh == resource and not item.disposed then return true end end
			return false
		end
		local uploader = engine.AssetUpload.new(recorder, engine.enums, {
			assertAdmission = function(_ticket: any, resource: any): ()
				if owner.retired or not current(resource) or not signedIn() then error("admission", 0) end
			end,
			liveGuard = function(_ticket: any, _resource: any): () guard() end,
			-- The host wrote this attempt's intent receipt before the command existed; the command is that acknowledgement.
			recordIntent = function(ticket: any): any return table.freeze({phase = "intent", ticket = ticket}) end,
			recordResult = function(ticket: any, observation: any): any
				return table.freeze({phase = "result", ticket = ticket, assetId = observation.assetId})
			end,
		})
		local identity = {sessionId = ops.registry.sessionId, clientLifetimeId = V.string(continuity.clientLifetimeId, "client lifetime", 128),
			pluginArtifactHash = V.string(continuity.pluginArtifactHash, "plugin artifact hash", 64), playEpoch = V.integer(continuity.playEpoch, 0, 9007199254740991, "play epoch"),
			placeId = ops.gameModel.PlaceId, universeId = ops.gameModel.GameId}
		local stop: string? = nil
		for index, resource in ipairs(meshes) do
			local object = resource.object
			local label = if type(object) == "table" and type(object.name) == "string" then string.sub(object.name, 1, 100) else "Mesh" .. index
			local entry: any = {index = index, name = label, assetId = V.NULL, upload = "skipped", reason = V.NULL, swapped = false}
			entries[index] = entry
			if stop then entry.reason = stop; continue end
			local sha = if type(object) == "table" then object.meshExportSha256 else nil
			if type(sha) ~= "string" or not string.match(sha, "^[0-9a-f]+$") or #sha ~= 64 then entry.upload, entry.reason, stop = "failed", "SOURCE_METADATA", "STOPPED"; continue end
			lastResult = nil
			local ticket = table.freeze({attemptId = attemptId .. "." .. index, assetType = "Mesh",
				creator = table.freeze({kind = "user", id = creatorId}),
				source = table.freeze({jobId = "transfer-" .. string.sub(digest, 1, 32), resourceId = "mesh-" .. index, sha256 = sha}),
				uploader = table.freeze({status = "available", id = creatorId, provenance = "StudioService:GetUserId"}),
				continuity = table.freeze(table.clone(identity)),
				name = if #meshes == 1 then name else clipName(name, " " .. index), description = description})
			local called, outcome = pcall(uploader.upload, uploader, ticket, resource.mesh)
			if not called then
				entry.upload, entry.reason, stop = "failed", if type(outcome) == "table" and type(outcome.code) == "string" and string.match(outcome.code, "^[%u_]+$") then outcome.code else "INPUT", "STOPPED"
				continue
			end
			if outcome.uploadStarted then started += 1 end
			if outcome.state == "succeeded" then entry.assetId, entry.upload = outcome.assetId, "succeeded"
			elseif outcome.assetId ~= nil then
				-- Roblox created the asset but continuing scope was lost: keep the ID, stop further uploads.
				entry.assetId, entry.upload, entry.reason, stop = outcome.assetId, "succeeded", outcome.reason, "STOPPED"
			elseif outcome.state == "failed" then
				entry.upload, entry.reason, stop = "failed", "ENGINE_REJECTED" .. (if lastResult then ":" .. lastResult else ""), "STOPPED"
			else
				entry.upload, entry.reason, stop = if outcome.uploadStarted then "reconciliation" else "failed", outcome.reason or "UNKNOWN", "STOPPED"
			end
		end
	end
	-- Swap only when every mesh has an asset ID: a model is never left half persistent by a partial upload.
	local complete = true
	for _, entry in ipairs(entries) do if entry.assetId == V.NULL then complete = false end end
	local swapped = 0
	if complete then
		local fresh: {any}, copies: {any} = {}, {}
		pcall(function()
			guard()
			if model.Parent == nil then V.fail("STATE", "The placed model was removed.") end
			for index, resource in ipairs(meshes) do
				local old, id = resource.part, entries[index].assetId
				if resource.keptAssetId == id and old ~= nil and old.Parent ~= nil then fresh[index] = false -- already persistent (earlier finish)
				else
					if old == nil or old.Parent == nil or not old:IsDescendantOf(model) then V.fail("STATE", "A session part was removed from the model.") end
					local part = engine.service:CreateMeshPartAsync(engine.content(id), {CollisionFidelity = old.CollisionFidelity, RenderFidelity = old.RenderFidelity})
					if part ~= nil then fresh[index] = part end -- Own late allocations before the guard.
					guard()
					if part == nil or not part:IsA("MeshPart") then V.fail("ENGINE", "CreateMeshPartAsync did not return a MeshPart.") end
					fresh[index] = part
				end
			end
			local recording = ops.history:TryBeginRecording("Arcane.keep." .. attemptId, "Arcane keep mesh")
			if not recording then V.fail("HISTORY", "Cannot begin an undo recording.") end
			local done = pcall(function()
				for index, resource in ipairs(meshes) do
					local part = fresh[index]
					if part then
						local old = resource.part
						for _, field in ipairs(SWAP_FIELDS) do (part :: any)[field] = old[field] end
						local appearance = resource.appearance
						if appearance ~= nil and appearance.Parent == old then
							local copy = appearance:Clone()
							if copy == nil then V.fail("ENGINE", "SurfaceAppearance could not be copied to the kept mesh.") end
							copies[index] = copy
							copy.Parent = part
						end
						part.Parent = old.Parent
						old.Parent = nil
						resource.part, resource.keptAssetId = part, entries[index].assetId
						if copies[index] then resource.appearance = copies[index] end
					end
					entries[index].swapped = true
				end
			end)
			pcall(function() ops.history:FinishRecording(recording, Enum.FinishRecordingOperation.Commit) end)
			if not done then V.fail("ENGINE", "The part swap stopped part-way.") end
		end)
		-- Preserve uploaded IDs while retiring only unswapped detached replacements.
		for index, part in pairs(fresh) do
			if part and meshes[index].part ~= part and part.Parent == nil then
				if not pcall(function() part:Destroy() end) then ops.assetCleanupFailed = true end
			end
		end
		for index, copy in pairs(copies) do
			if meshes[index].appearance ~= copy and copy.Parent == nil then
				if not pcall(function() copy:Destroy() end) then ops.assetCleanupFailed = true end
			end
		end
		for _, entry in ipairs(entries) do if entry.swapped then swapped += 1 end end
		-- The placement receipt stays restorable: same model, same instance count after a 1:1 swap.
		local owned = if swapped == #entries then ops.registry.owned[model] else nil
		if owned and owned.placed then owned.placed.count = #model:GetDescendants() end
	end
	local ids = 0
	for _, entry in ipairs(entries) do if entry.assetId ~= V.NULL then ids += 1 end end
	local state = if ids == 0 then "failed" elseif ids < #entries then "partial" elseif swapped == #entries then "kept" else "uploaded"
	local refOk, ref = pcall(function(): any return ops.registry:ref(model) end)
	return {state = state, meshes = V.array(entries), uploadsStarted = started, swapped = swapped,
		persistence = if state == "kept" then "saved-asset" else "studio-session-only", creatorId = creatorId, ref = if refOk then ref else V.NULL}
end

return table.freeze(AssetPlacement)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane16">
<Properties>
<string name="Name">TerrainGen</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Pure, deterministic terrain.generate computation: wire validation, heightfield, water,
-- surface materials and chunked voxel arrays. No engine globals are touched here; Operations
-- injects the Terrain writer, the material resolver and the between-chunk yield.
local V = require(script.Parent.Validation)
local TerrainGen = {}

TerrainGen.LIMITS = table.freeze({extent = 2048, minExtent = 16, height = 512, minHeight = 8, coordinate = 100000, floor = 10000,
	features = 32, points = 32, rules = 16, octaves = 8, voxel = 4, chunkColumns = 64, voxels = 33554432, chunkVoxels = 524288})
-- Surface materials (never Air or Water); the daemon policy carries the same list.
TerrainGen.MATERIALS = table.freeze({"Grass", "LeafyGrass", "Ground", "Mud", "Rock", "Slate", "Sand", "Sandstone", "Limestone", "Basalt", "Granite", "Pebble", "Snow", "Ice", "Glacier", "Salt", "Cobblestone", "Asphalt", "Concrete", "Brick", "WoodPlanks", "CrackedLava"})
TerrainGen.FEATURES = table.freeze({"hill", "mountain", "valley", "crater", "plateau", "flatten", "lake", "river", "path"})
local VOXEL = 4
local DEEP_BELOW = 12
local WATER_REACH = 64

local function clamp(value: number, low: number, high: number): number
	return if value < low then low elseif value > high then high else value
end
local function lerp(a: number, b: number, t: number): number return a + (b - a) * t end
local function smoothstep(t: number): number
	t = clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end
local function round(value: number): number return math.floor(value + 0.5) end

-- Integer LCG mixing (exact in doubles); offsets are fractional so math.noise never samples lattice zeros.
local function hash(seed: number, salt: number): number
	local s = (seed * 48271 + salt * 69621 + 12345) % 2147483647
	s = (s * 48271) % 2147483647
	s = (s * 48271) % 2147483647
	return s / 2147483647
end

local function pair(value: any, low: number, high: number, label: string): {number}
	local list = V.list(value, 2, label)
	if #list ~= 2 then V.fail("INPUT", label .. " needs two numbers.") end
	return {V.number(list[1], low, high, label), V.number(list[2], low, high, label)}
end
local function optional(value: any, low: number, high: number, label: string, fallback: number?): number?
	if value == nil then return fallback end
	return V.number(value, low, high, label)
end
local function material(value: any, label: string, fallback: string?): string?
	if value == nil then return fallback end
	if type(value) ~= "string" or not table.find(TerrainGen.MATERIALS, value) then V.fail("PROPERTY", "Unsupported " .. label .. ".") end
	return value
end

local function feature(raw: any, L: any): any
	local f = V.object(raw, "terrain feature")
	local kind = f.kind
	if type(kind) ~= "string" or not table.find(TerrainGen.FEATURES, kind) then V.fail("INPUT", "Unsupported terrain feature kind.") end
	local out: any = {kind = kind}
	if kind == "river" or kind == "path" then
		V.fields(f, {"kind", "points", "width", "depth", "bank", "material"}, kind)
		local points = V.list(f.points, L.points, kind .. " points")
		if #points < 2 then V.fail("INPUT", "A " .. kind .. " needs 2.." .. L.points .. " points.") end
		out.points = {}
		for _, point in ipairs(points) do table.insert(out.points, pair(point, -L.coordinate, L.coordinate, kind .. " point")) end
		out.width = V.number(f.width, 2, 256, kind .. " width")
		out.depth = optional(f.depth, 0, 64, kind .. " depth", if kind == "river" then 8 else 0.5)
		out.bank = optional(f.bank, 0, 256, kind .. " bank", out.width)
		out.material = material(f.material, kind .. " material", if kind == "river" then "Pebble" else "Ground")
		return out
	end
	out.center = pair(f.center, -L.coordinate, L.coordinate, kind .. " center")
	if kind == "lake" then
		V.fields(f, {"kind", "center", "radius", "level", "depth", "material"}, kind)
		out.radius = V.number(f.radius, 8, 1024, "lake radius")
		out.level = V.number(f.level, 0, L.height, "lake level")
		out.depth = optional(f.depth, 1, 256, "lake depth", 12)
		out.material = material(f.material, "lake material", "Mud")
	elseif kind == "plateau" or kind == "flatten" then
		V.fields(f, {"kind", "center", "radius", "level", "blend", "material"}, kind)
		out.radius = V.number(f.radius, 4, L.extent, kind .. " radius")
		if kind == "plateau" and f.level == nil then V.fail("INPUT", "A plateau needs level.") end
		out.level = optional(f.level, 0, L.height, kind .. " level")
		out.blend = optional(f.blend, 0, 512, kind .. " blend", if kind == "plateau" then out.radius * 0.2 else 16)
		out.material = material(f.material, kind .. " material")
	else
		V.fields(f, {"kind", "center", "radius", "height", "roughness"}, kind)
		out.radius = V.number(f.radius, 4, L.extent, kind .. " radius")
		out.height = V.number(f.height, 0, L.height, kind .. " height")
		out.roughness = optional(f.roughness, 0, 1, kind .. " roughness", if kind == "mountain" then 0.4 else 0)
	end
	return out
end

local RULE_FIELDS = {"material", "minHeight", "maxHeight", "minSlope", "maxSlope", "minNoise", "maxNoise", "nearWater"}
local function rule(raw: any, L: any): any
	local r = V.fields(raw, RULE_FIELDS, "material rule")
	return {material = material(r.material, "rule material") or V.fail("INPUT", "A material rule needs material."),
		minHeight = optional(r.minHeight, 0, L.height, "minHeight"), maxHeight = optional(r.maxHeight, 0, L.height, "maxHeight"),
		minSlope = optional(r.minSlope, 0, 90, "minSlope"), maxSlope = optional(r.maxSlope, 0, 90, "maxSlope"),
		minNoise = optional(r.minNoise, -1, 1, "minNoise"), maxNoise = optional(r.maxNoise, -1, 1, "maxNoise"),
		nearWater = optional(r.nearWater, 0, WATER_REACH, "nearWater")}
end

-- Default look: shores, wet banks, steep rock, ground on mid slopes, patchy grass; snow above snowLine.
local function defaultRules(snowLine: number?): {any}
	local rules: {any} = {}
	if snowLine then table.insert(rules, {material = "Snow", minHeight = snowLine, maxSlope = 42}) end
	table.insert(rules, {material = "Sand", nearWater = 6})
	table.insert(rules, {material = "Mud", nearWater = 14, maxSlope = 30})
	table.insert(rules, {material = "Rock", minSlope = 40})
	table.insert(rules, {material = "Slate", minSlope = 32})
	table.insert(rules, {material = "Ground", minSlope = 22})
	table.insert(rules, {material = "LeafyGrass", minNoise = 0.2})
	return rules
end

-- Validates wire arguments and snaps the region to the 4-stud voxel grid. The daemon policy mirrors this.
function TerrainGen.plan(args: any): any
	local L = TerrainGen.LIMITS
	V.fields(args, {"center", "size", "floor", "height", "baseHeight", "seed", "noise", "edge", "snowLine", "features", "materials"}, "terrain arguments")
	local center = pair(args.center, -L.coordinate, L.coordinate, "terrain center")
	local size = pair(args.size, L.minExtent, L.extent, "terrain size")
	local plan: any = {}
	plan.nx, plan.nz = round(size[1] / VOXEL), round(size[2] / VOXEL)
	plan.ny = round(V.number(args.height, L.minHeight, L.height, "terrain height") / VOXEL)
	plan.height = plan.ny * VOXEL
	plan.x0 = round((center[1] - plan.nx * VOXEL / 2) / VOXEL) * VOXEL
	plan.z0 = round((center[2] - plan.nz * VOXEL / 2) / VOXEL) * VOXEL
	plan.y0 = round(V.number(if args.floor == nil then 0 else args.floor, -L.floor, L.floor, "terrain floor") / VOXEL) * VOXEL
	plan.baseHeight = V.number(args.baseHeight, 0, plan.height, "baseHeight")
	plan.seed = V.integer(args.seed, 0, 2147483647, "seed")
	plan.voxels = plan.nx * plan.ny * plan.nz
	if plan.voxels > L.voxels then V.fail("BODY_LIMIT", "Terrain region exceeds the voxel budget.") end
	plan.ox, plan.oz, plan.oy = hash(plan.seed, 1) * 4096 + 0.37, hash(plan.seed, 2) * 4096 + 0.61, hash(plan.seed, 3) * 64 + 0.13
	plan.mx, plan.mz = hash(plan.seed, 4) * 4096 + 0.29, hash(plan.seed, 5) * 4096 + 0.83
	if args.noise ~= nil then
		local n = V.fields(args.noise, {"type", "octaves", "frequency", "amplitude", "persistence"}, "terrain noise")
		local kind = if n.type == nil then "fbm" else n.type
		if kind ~= "fbm" and kind ~= "ridged" then V.fail("INPUT", "Noise type must be fbm or ridged.") end
		plan.noise = {type = kind, octaves = V.integer(if n.octaves == nil then 5 else n.octaves, 1, L.octaves, "octaves"),
			frequency = V.number(if n.frequency == nil then 4 else n.frequency, 0.1, 100, "frequency"),
			amplitude = V.number(if n.amplitude == nil then 24 else n.amplitude, 0, L.height, "amplitude"),
			persistence = optional(n.persistence, 0.2, 0.8, "persistence", 0.5)}
	end
	plan.edge = optional(args.edge, 0, 1024, "edge", 0)
	plan.snowLine = optional(args.snowLine, 0, L.height, "snowLine")
	plan.features = {}
	if args.features ~= nil then
		for _, raw in ipairs(V.list(args.features, L.features, "terrain features")) do table.insert(plan.features, feature(raw, L)) end
	end
	local rules, fallback, deep = nil, "Grass", "Rock"
	if args.materials ~= nil then
		local m = V.fields(args.materials, {"rules", "fallback", "deep"}, "terrain materials")
		if m.rules ~= nil then
			rules = {}
			for _, raw in ipairs(V.list(m.rules, L.rules, "material rules")) do table.insert(rules, rule(raw, L)) end
		end
		fallback = material(m.fallback, "fallback material", fallback) :: string
		deep = material(m.deep, "deep material", deep) :: string
	end
	plan.rules, plan.fallback, plan.deep = rules or defaultRules(plan.snowLine), fallback, deep
	return plan
end

-- Fractal noise in [-1, 1]: fBm sums octaves, ridged folds each octave into sharp crests.
function TerrainGen.noise(plan: any, x: number, z: number): number
	local n = plan.noise
	local frequency, amplitude, sum, total = n.frequency / 1000, 1, 0, 0
	for octave = 1, n.octaves do
		local value = math.noise(x * frequency + plan.ox + octave * 31.71, z * frequency + plan.oz - octave * 17.29, plan.oy + octave * 0.618)
		if n.type == "ridged" then
			local crest = 1 - math.min(1, math.abs(value) * 2)
			value = crest * crest * 2 - 1
		else
			value = clamp(value * 2, -1, 1)
		end
		sum += value * amplitude
		total += amplitude
		amplitude *= n.persistence
		frequency *= 2
	end
	return sum / total
end

local function detail(plan: any, x: number, z: number, scale: number, salt: number): number
	return clamp(math.noise(x / scale + plan.mx + salt * 7.13, z / scale + plan.mz - salt * 3.71, plan.oy + salt) * 2, -1, 1)
end

-- Column grid helpers: column i covers [x0 + ix*4, x0 + ix*4 + 4] with its centre sample.
local function columnRange(plan: any, low: number, high: number, origin: number, count: number): (number, number)
	return math.max(0, math.ceil((low - origin) / VOXEL - 0.5)), math.min(count - 1, math.floor((high - origin) / VOXEL - 0.5))
end
local function each(plan: any, cx: number, cz: number, reach: number, fn: (number, number, number) -> ()): ()
	local ix0, ix1 = columnRange(plan, cx - reach, cx + reach, plan.x0, plan.nx)
	local iz0, iz1 = columnRange(plan, cz - reach, cz + reach, plan.z0, plan.nz)
	for iz = iz0, iz1 do
		local z = plan.z0 + (iz + 0.5) * VOXEL
		for ix = ix0, ix1 do fn(iz * plan.nx + ix + 1, plan.x0 + (ix + 0.5) * VOXEL, z) end
	end
end
local function sample(plan: any, grid: {number}, x: number, z: number): number
	local fx = clamp((x - plan.x0) / VOXEL - 0.5, 0, plan.nx - 1)
	local fz = clamp((z - plan.z0) / VOXEL - 0.5, 0, plan.nz - 1)
	local ix, iz = math.floor(fx), math.floor(fz)
	local ix1, iz1 = math.min(ix + 1, plan.nx - 1), math.min(iz + 1, plan.nz - 1)
	local tx, tz = fx - ix, fz - iz
	local a = lerp(grid[iz * plan.nx + ix + 1], grid[iz * plan.nx + ix1 + 1], tx)
	local b = lerp(grid[iz1 * plan.nx + ix + 1], grid[iz1 * plan.nx + ix1 + 1], tx)
	return lerp(a, b, tz)
end
local function nearest(points: {{number}}, x: number, z: number): (number, number, number)
	local best, bx, bz = math.huge, points[1][1], points[1][2]
	for index = 1, #points - 1 do
		local a, b = points[index], points[index + 1]
		local dx, dz = b[1] - a[1], b[2] - a[2]
		local length = dx * dx + dz * dz
		local t = if length > 0 then clamp(((x - a[1]) * dx + (z - a[2]) * dz) / length, 0, 1) else 0
		local px, pz = a[1] + dx * t, a[2] + dz * t
		local d = (x - px) ^ 2 + (z - pz) ^ 2
		if d < best then best, bx, bz = d, px, pz end
	end
	return math.sqrt(best), bx, bz
end

local function applyFeature(plan: any, f: any, h: {number}, water: {number}, bed: {[number]: string}, override: {[number]: string}): ()
	local kind = f.kind
	if kind == "river" or kind == "path" then
		local before = table.clone(h)
		local core = f.width / 2
		local reach = core + f.bank
		local lowX, highX, lowZ, highZ = math.huge, -math.huge, math.huge, -math.huge
		for _, p in ipairs(f.points) do
			lowX, highX, lowZ, highZ = math.min(lowX, p[1]), math.max(highX, p[1]), math.min(lowZ, p[2]), math.max(highZ, p[2])
		end
		local cx, cz = (lowX + highX) / 2, (lowZ + highZ) / 2
		each(plan, cx, cz, math.max(highX - lowX, highZ - lowZ) / 2 + reach, function(i: number, x: number, z: number)
			local d, px, pz = nearest(f.points, x, z)
			if d > reach then return end
			-- Level cross-sections: carve toward the centreline ground, minus depth.
			local ground = sample(plan, before, px, pz)
			local weight = if d <= core then 1 else 1 - smoothstep((d - core) / math.max(f.bank, 1e-6))
			h[i] = lerp(h[i], ground - f.depth, weight)
			if d <= core then override[i] = f.material end
			if kind == "river" then
				local level = ground - f.depth * 0.3
				if h[i] < level and level > water[i] then water[i] = level; bed[i] = f.material end
			end
		end)
		return
	end
	local cx, cz, r = f.center[1], f.center[2], f.radius
	if kind == "lake" then
		local rim = f.level + 1
		each(plan, cx, cz, r * 1.5, function(i: number, x: number, z: number)
			local t = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) / r
			if t < 1 then
				h[i] = math.min(h[i], f.level - f.depth * (1 - t * t))
				if h[i] < f.level and f.level > water[i] then water[i] = f.level; bed[i] = f.material end
			elseif t < 1.5 then
				h[i] = math.max(h[i], lerp(rim, h[i], smoothstep((t - 1) / 0.5)))
			end
		end)
	elseif kind == "plateau" or kind == "flatten" then
		local level = f.level or sample(plan, h, cx, cz)
		local blend = math.max(f.blend, 1e-6)
		local before = h
		if kind == "plateau" then before = table.clone(h) end
		each(plan, cx, cz, r * 1.2 + blend, function(i: number, x: number, z: number)
			local d = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2)
			-- Plateaus get an irregular, natural outline; flatten circles stay exact for focal pads.
			local edge = if kind == "plateau" then r * (1 + 0.12 * detail(plan, x, z, 40, 11)) else r
			local weight = if d <= edge then 1 else 1 - smoothstep((d - edge) / blend)
			if weight <= 0 then return end
			h[i] = lerp(before[i], level, weight)
			if f.material and d <= edge then override[i] = f.material end
			if kind == "flatten" and d <= edge then water[i] = -1 end
		end)
	else
		each(plan, cx, cz, r * 2 + 8, function(i: number, x: number, z: number)
			local d = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2)
			local t = d / (r * (1 + 0.1 * detail(plan, x, z, 48, 5)))
			if kind == "crater" then
				if t < 1 then h[i] -= f.height * (1 - t * t) end
				h[i] += f.height * 0.3 * math.exp(-((t - 1) / 0.25) ^ 2)
			elseif t < 1 then
				if kind == "hill" then h[i] += f.height * (1 - t * t) ^ 2
				elseif kind == "valley" then h[i] -= f.height * (1 - t * t) ^ 2
				else
					local ridge = (1 - math.abs(detail(plan, x, z, 36, 9))) ^ 2
					h[i] += f.height * (1 - t) ^ 1.6 * (1 - f.roughness * 0.5 + f.roughness * ridge)
				end
			end
		end)
	end
end

-- Chamfer distance (studs) from every column to the nearest water column, capped at WATER_REACH.
local function waterDistance(plan: any, water: {number}, h: {number}): {number}
	local nx, nz = plan.nx, plan.nz
	local d = table.create(nx * nz, WATER_REACH)
	for i = 1, nx * nz do if water[i] > h[i] then d[i] = 0 end end
	local diagonal = VOXEL * math.sqrt(2)
	for iz = 0, nz - 1 do
		for ix = 0, nx - 1 do
			local i = iz * nx + ix + 1
			local best = d[i]
			if ix > 0 then best = math.min(best, d[i - 1] + VOXEL) end
			if iz > 0 then
				best = math.min(best, d[i - nx] + VOXEL)
				if ix > 0 then best = math.min(best, d[i - nx - 1] + diagonal) end
				if ix < nx - 1 then best = math.min(best, d[i - nx + 1] + diagonal) end
			end
			d[i] = best
		end
	end
	for iz = nz - 1, 0, -1 do
		for ix = nx - 1, 0, -1 do
			local i = iz * nx + ix + 1
			local best = d[i]
			if ix < nx - 1 then best = math.min(best, d[i + 1] + VOXEL) end
			if iz < nz - 1 then
				best = math.min(best, d[i + nx] + VOXEL)
				if ix < nx - 1 then best = math.min(best, d[i + nx + 1] + diagonal) end
				if ix > 0 then best = math.min(best, d[i + nx - 1] + diagonal) end
			end
			d[i] = best
		end
	end
	return d
end

function TerrainGen.matches(r: any, height: number, slope: number, noise: number, near: number): boolean
	return (r.minHeight == nil or height >= r.minHeight) and (r.maxHeight == nil or height <= r.maxHeight)
		and (r.minSlope == nil or slope >= r.minSlope) and (r.maxSlope == nil or slope <= r.maxSlope)
		and (r.minNoise == nil or noise >= r.minNoise) and (r.maxNoise == nil or noise <= r.maxNoise)
		and (r.nearWater == nil or (near > 0 and near < WATER_REACH and near <= r.nearWater))
end

-- Heightfield (studs above floor), water surface levels (-1 = dry), slopes (degrees) and surface materials.
-- slice (optional) is called once per row with that row's column count: the caller may yield there.
function TerrainGen.field(plan: any, slice: ((number?) -> ())?): any
	local nx, nz = plan.nx, plan.nz
	local count = nx * nz
	local h = table.create(count, plan.baseHeight)
	local water = table.create(count, -1)
	local bed: {[number]: string} = {}
	local override: {[number]: string} = {}
	if plan.noise and plan.noise.amplitude > 0 then
		local width, depth = nx * VOXEL, nz * VOXEL
		for iz = 0, nz - 1 do
			if slice then slice(1 + nx) end
			local z = plan.z0 + (iz + 0.5) * VOXEL
			for ix = 0, nx - 1 do
				local x = plan.x0 + (ix + 0.5) * VOXEL
				local weight = 1
				if plan.edge > 0 then
					local border = math.min((ix + 0.5) * VOXEL, width - (ix + 0.5) * VOXEL, (iz + 0.5) * VOXEL, depth - (iz + 0.5) * VOXEL)
					weight = smoothstep(border / plan.edge)
				end
				h[iz * nx + ix + 1] += TerrainGen.noise(plan, x, z) * plan.noise.amplitude * weight
			end
		end
	end
	for _, f in ipairs(plan.features) do applyFeature(plan, f, h, water, bed, override) end
	local low, high, wet = math.huge, -math.huge, 0
	for i = 1, count do
		h[i] = clamp(h[i], 0, plan.height)
		if water[i] > plan.height then water[i] = plan.height end
		if water[i] <= h[i] then water[i] = -1 else wet += 1 end
		low, high = math.min(low, h[i]), math.max(high, h[i])
	end
	local slope = table.create(count, 0)
	for iz = 0, nz - 1 do
		if slice then slice(1 + nx) end
		for ix = 0, nx - 1 do
			local i = iz * nx + ix + 1
			local left, right = if ix > 0 then i - 1 else i, if ix < nx - 1 then i + 1 else i
			local up, down = if iz > 0 then i - nx else i, if iz < nz - 1 then i + nx else i
			local gx = (h[right] - h[left]) / (math.max(1, (if ix > 0 then 1 else 0) + (if ix < nx - 1 then 1 else 0)) * VOXEL)
			local gz = (h[down] - h[up]) / (math.max(1, (if iz > 0 then 1 else 0) + (if iz < nz - 1 then 1 else 0)) * VOXEL)
			slope[i] = math.deg(math.atan(math.sqrt(gx * gx + gz * gz)))
		end
	end
	local near = waterDistance(plan, water, h)
	local materials = table.create(count, plan.fallback)
	for iz = 0, nz - 1 do
		if slice then slice(1 + nx) end
		local z = plan.z0 + (iz + 0.5) * VOXEL
		for ix = 0, nx - 1 do
			local i = iz * nx + ix + 1
			if water[i] > h[i] then
				materials[i] = override[i] or bed[i] or "Mud"
			elseif override[i] then
				materials[i] = override[i]
			else
				local noise = detail(plan, plan.x0 + (ix + 0.5) * VOXEL, z, 48, 1)
				for _, r in ipairs(plan.rules) do
					if TerrainGen.matches(r, h[i], slope[i], noise, near[i]) then materials[i] = r.material; break end
				end
			end
		end
	end
	return {heights = h, water = water, slope = slope, near = near, materials = materials, low = low, high = high, wet = wet}
end

-- One chunk's [x][y][z] material/occupancy arrays. Solid voxels more than DEEP_BELOW studs under
-- the surface use the deep material so cliff faces read as rock.
-- slice (optional) is the cooperative yield point between x-slices of a large chunk.
function TerrainGen.chunk(plan: any, field: any, ix0: number, iz0: number, width: number, depth: number, resolve: (string) -> any, slice: ((number?) -> ())?): (any, any)
	local ny, nx = plan.ny, plan.nx
	local air, waterMaterial, deep = resolve("Air"), resolve("Water"), resolve(plan.deep)
	local cache: {[string]: any} = {}
	local materials, occupancies = table.create(width), table.create(width)
	for x = 1, width do
		local mx, ox = table.create(ny), table.create(ny)
		for y = 1, ny do mx[y] = table.create(depth, air); ox[y] = table.create(depth, 0) end
		for z = 1, depth do
			local i = (iz0 + z - 1) * nx + ix0 + x
			local surface, level = field.heights[i], field.water[i]
			local name = field.materials[i]
			local top = cache[name]
			if top == nil then top = resolve(name); cache[name] = top end
			for y = 1, ny do
				local bottom = (y - 1) * VOXEL
				local fill = (surface - bottom) / VOXEL
				if fill >= 1 then
					mx[y][z] = if surface - bottom - VOXEL > DEEP_BELOW then deep else top
					ox[y][z] = 1
				elseif fill > 0 then
					mx[y][z] = top
					ox[y][z] = fill
				elseif level > bottom then
					mx[y][z] = waterMaterial
					ox[y][z] = math.min(1, (level - bottom) / VOXEL)
				else
					break
				end
			end
		end
		materials[x], occupancies[x] = mx, ox
		if slice then slice(1 + depth * ny // 1024) end
	end
	return materials, occupancies
end

-- Writes the whole region in bounded chunks (each <= LIMITS.chunkVoxels), yielding between chunks.
-- engine.write(min {x,y,z}, max {x,y,z}, materials, occupancies); engine.resolve(name); engine.yield().
function TerrainGen.write(plan: any, field: any, engine: any): number
	local C = TerrainGen.LIMITS.chunkColumns
	local chunks = 0
	for iz = 0, plan.nz - 1, C do
		for ix = 0, plan.nx - 1, C do
			local width, depth = math.min(C, plan.nx - ix), math.min(C, plan.nz - iz)
			if width * depth * plan.ny > TerrainGen.LIMITS.chunkVoxels then V.fail("BODY_LIMIT", "Terrain chunk exceeds the voxel budget.") end
			local materials, occupancies = TerrainGen.chunk(plan, field, ix, iz, width, depth, engine.resolve, engine.slice)
			local low = {plan.x0 + ix * VOXEL, plan.y0, plan.z0 + iz * VOXEL}
			engine.write(low, {low[1] + width * VOXEL, plan.y0 + plan.ny * VOXEL, low[3] + depth * VOXEL}, materials, occupancies)
			chunks += 1
			engine.yield()
		end
	end
	return chunks
end

-- Compact receipt summary: snapped region, counts and the surface material histogram.
function TerrainGen.summary(plan: any, field: any, chunks: number): any
	local surface: {[string]: number} = {}
	for i = 1, plan.nx * plan.nz do
		if field.water[i] <= field.heights[i] then surface[field.materials[i]] = (surface[field.materials[i]] or 0) + 1 end
	end
	local function hundredth(value: number): number return round(value * 100) / 100 end
	return {region = {origin = V.array({plan.x0, plan.y0, plan.z0}), size = V.array({plan.nx * VOXEL, plan.ny * VOXEL, plan.nz * VOXEL})},
		voxels = plan.voxels, chunks = chunks, seed = plan.seed, features = #plan.features, waterColumns = field.wet,
		surfaceRange = V.array({hundredth(field.low), hundredth(field.high)}), surface = surface}
end

return table.freeze(TerrainGen)
]]></ProtectedString>
</Properties>
</Item>
</Item>
</roblox>
