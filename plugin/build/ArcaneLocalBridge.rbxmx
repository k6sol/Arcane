<Properties>
<string name="Name">Properties</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local V = require(script.Parent.Validation)
local Properties = {}
Properties.PART_FIELDS = table.freeze({"Size", "Position", "Color", "Anchored", "CanCollide", "Transparency", "Material"})
Properties.CLASSES = table.freeze({"Folder", "Model", "Part", "Script", "LocalScript", "ModuleScript"})
Properties.MATERIALS = table.freeze({"Plastic", "SmoothPlastic", "Metal", "Wood", "WoodPlanks", "Concrete", "Brick", "Glass", "Neon", "Slate", "Sand", "Fabric", "Grass", "Ground", "Rock", "Cobblestone", "Asphalt", "Marble", "Granite", "Limestone", "Sandstone", "Basalt", "Pebble", "LeafyGrass", "Mud", "Snow", "Ice", "Pavement", "Plaster", "DiamondPlate", "CorrodedMetal", "Foil"})

function Properties.decode(name: string, value: any, isPart: boolean): any
	if name == "Name" then return V.string(value, "Name", 100) end
	if not isPart or not table.find(Properties.PART_FIELDS, name) then V.fail("PROPERTY", "Property is not writable for this class.") end
	if name == "Anchored" or name == "CanCollide" then return V.boolean(value, name) end
	if name == "Transparency" then return V.number(value, 0, 1, name) end
	if name == "Material" then
		if type(value) ~= "string" or not table.find(Properties.MATERIALS, value) then V.fail("PROPERTY", "Unsupported Material.") end
		return Enum.Material[value]
	end
	local tag = V.fields(value, {"type", "value"}, "tagged property")
	local expectedType = if name == "Color" then "Color3" else "Vector3"
	if tag.type ~= expectedType then V.fail("PROPERTY", "Incorrect property type tag.") end
	local components = V.list(tag.value, 3, "components")
	if #components ~= 3 then V.fail("PROPERTY", "Property needs three components.") end
	for _, component in ipairs(components) do
		local low = if name == "Size" then 0.05 elseif name == "Color" then 0 else -100000
		local high = if name == "Size" then 2048 elseif name == "Color" then 1 else 100000
		V.number(component, low, high, name)
	end
	if name == "Color" then return Color3.new(components[1], components[2], components[3]) end
	return Vector3.new(components[1], components[2], components[3])
end

function Properties.encode(name: string, value: any): any
	if name == "Size" or name == "Position" then return {type = "Vector3", value = V.array({value.X, value.Y, value.Z})} end
	if name == "Color" then return {type = "Color3", value = V.array({value.R, value.G, value.B})} end
	if name == "Material" then return value.Name end
	return value
end

function Properties.validate(instance: any, values: any, service: boolean): ({[string]: any}, {string})
	V.object(values, "properties")
	local decoded: {[string]: any} = {}
	local names: {string} = {}
	for name, value in pairs(values) do
		if service and name == "Name" then V.fail("SERVICE", "Services cannot be renamed.") end
		decoded[name] = Properties.decode(name, value, instance:IsA("BasePart"))
		table.insert(names, name)
	end
	table.sort(names)
	return decoded, names
end

function Properties.snapshot(instance: any, names: {string}?): {[string]: any}
	local fields: {string} = names or {"Name"}
	if not names and instance:IsA("BasePart") then
		fields = table.clone(Properties.PART_FIELDS)
		table.insert(fields, "Name")
	end
	local result: {[string]: any} = {}
	for _, name in ipairs(fields) do result[name] = Properties.encode(name, instance[name]) end
	if not names and instance:IsA("BaseScript") then result.Disabled = instance.Disabled end
	return result
end

function Properties.compare(instance: any, expected: any, names: {string}): boolean
	-- Compare engine values (float32 Vector3/Color3 round-trip) after validation.
	local decoded = Properties.validate(instance, expected, false)
	for _, name in ipairs(names) do
		if expected[name] == nil or instance[name] ~= decoded[name] then return false end
	end
	return true
end

-- Post-assignment verification only. Baseline comparison above stays exact.
-- Native BasePart.Color stores RGB8: the engine multiplies float32 channels
-- by 255 in float32, then truncates. Double arithmetic would corrupt some
-- already-canonical byte values (for example 7/255).
local colorProduct = buffer.create(4) -- One shared scratch word; never yields between write and read.
local function colorChannel(value: number): number
	buffer.writef32(colorProduct, 0, value * 255)
	return math.floor(buffer.readf32(colorProduct, 0))
end
-- Same comparison as assignedMatches, against a value the caller already read back once.
function Properties.readMatches(name: string, requested: any, actual: any): boolean
	if name == "Color" then
		return actual == Color3.fromRGB(colorChannel(requested.R), colorChannel(requested.G), colorChannel(requested.B))
	end
	return actual == requested
end

function Properties.assignedMatches(instance: any, name: string, requested: any): boolean
	return Properties.readMatches(name, requested, instance[name])
end

-- Effects classes. Fixed allowlist mirrored from packages/core/src/studio-policy.ts EFFECT_PROPERTIES;
-- the daemon validates first, this module re-validates, assigns and verifies every value read back.
local NORMAL_IDS = {"Top", "Bottom", "Left", "Right", "Front", "Back"}
local function merge(...: any): any
	local result = {}
	for _, source in ipairs({...}) do for key, value in pairs(source) do result[key] = value end end
	return result
end
local LIGHT = {Brightness = {"number", 0, 40}, Range = {"number", 0, 60}, Color = {"color"}, Shadows = {"boolean"}, Enabled = {"boolean"}}
local FACED_LIGHT = merge(LIGHT, {Angle = {"number", 0, 180}, Face = {"enum", "NormalId", NORMAL_IDS}})
local GLOW = {LightEmission = {"number", 0, 1}, LightInfluence = {"number", 0, 1}, Brightness = {"number", 0, 20}}
local TEXTURE_MODE = {"enum", "TextureMode", {"Stretch", "Wrap", "Static"}}
local DECAL = {Texture = {"content"}, Face = {"enum", "NormalId", NORMAL_IDS}, Color3 = {"color"}, Transparency = {"number", 0, 1}}
Properties.EFFECT_SPECS = table.freeze({
	Attachment = {Position = {"vector3", -2048, 2048}, Orientation = {"vector3", -360, 360}},
	ParticleEmitter = merge(GLOW, {Enabled = {"boolean"}, Rate = {"number", 0, 500}, Lifetime = {"range", 0, 20}, Speed = {"range", 0, 500},
		SpreadAngle = {"vector2", -360, 360}, Acceleration = {"vector3", -500, 500}, Drag = {"number", 0, 50}, Size = {"sequence", 0, 100},
		Transparency = {"sequence", 0, 1}, Squash = {"sequence", -3, 3}, Color = {"colorSequence"}, Rotation = {"range", -360, 360}, RotSpeed = {"range", -1000, 1000},
		Orientation = {"enum", "ParticleOrientation", {"FacingCamera", "FacingCameraWorldUp", "VelocityParallel", "VelocityPerpendicular"}},
		EmissionDirection = {"enum", "NormalId", NORMAL_IDS}, Shape = {"enum", "ParticleEmitterShape", {"Box", "Sphere", "Cylinder", "Disc"}},
		ShapeStyle = {"enum", "ParticleEmitterShapeStyle", {"Volume", "Surface"}}, ShapeInOut = {"enum", "ParticleEmitterShapeInOut", {"Outward", "Inward", "InAndOut"}},
		LockedToPart = {"boolean"}, ZOffset = {"number", -50, 50}, TimeScale = {"number", 0, 1}, Texture = {"content"}}),
	Beam = merge(GLOW, {Attachment0 = {"attachment"}, Attachment1 = {"attachment"}, Color = {"colorSequence"}, Transparency = {"sequence", 0, 1},
		Width0 = {"number", 0, 100}, Width1 = {"number", 0, 100}, CurveSize0 = {"number", -100, 100}, CurveSize1 = {"number", -100, 100}, Segments = {"integer", 1, 100},
		FaceCamera = {"boolean"}, Enabled = {"boolean"}, Texture = {"content"}, TextureMode = TEXTURE_MODE, TextureLength = {"number", 0.01, 100},
		TextureSpeed = {"number", -100, 100}, ZOffset = {"number", -50, 50}}),
	Trail = merge(GLOW, {Attachment0 = {"attachment"}, Attachment1 = {"attachment"}, Color = {"colorSequence"}, Transparency = {"sequence", 0, 1},
		WidthScale = {"sequence", 0, 10}, Lifetime = {"number", 0.01, 20}, MinLength = {"number", 0, 100}, MaxLength = {"number", 0, 1000},
		FaceCamera = {"boolean"}, Enabled = {"boolean"}, Texture = {"content"}, TextureMode = TEXTURE_MODE, TextureLength = {"number", 0.01, 100}}),
	PointLight = LIGHT, SpotLight = FACED_LIGHT, SurfaceLight = FACED_LIGHT,
	Highlight = {FillColor = {"color"}, OutlineColor = {"color"}, FillTransparency = {"number", 0, 1}, OutlineTransparency = {"number", 0, 1},
		DepthMode = {"enum", "HighlightDepthMode", {"AlwaysOnTop", "Occluded"}}, Enabled = {"boolean"}},
	Fire = {Size = {"number", 2, 30}, Heat = {"number", -25, 25}, Color = {"color"}, SecondaryColor = {"color"}, Enabled = {"boolean"}, TimeScale = {"number", 0, 1}},
	Smoke = {Size = {"number", 0.1, 100}, Opacity = {"number", 0, 1}, RiseVelocity = {"number", -25, 25}, Color = {"color"}, Enabled = {"boolean"}, TimeScale = {"number", 0, 1}},
	Sparkles = {SparkleColor = {"color"}, Enabled = {"boolean"}, TimeScale = {"number", 0, 1}},
	Decal = DECAL,
	Texture = merge(DECAL, {StudsPerTileU = {"number", 0.01, 1000}, StudsPerTileV = {"number", 0.01, 1000}, OffsetStudsU = {"number", -1000, 1000}, OffsetStudsV = {"number", -1000, 1000}}),
	-- Audio. SoundId is rbxassetid://<digits> only; SoundGroup is a Ref to a SoundGroup of the same build/session.
	Sound = {SoundId = {"audio"}, Volume = {"number", 0, 10}, PlaybackSpeed = {"number", 0.1, 4}, Looped = {"boolean"}, Playing = {"boolean"},
		RollOffMode = {"enum", "RollOffMode", {"Inverse", "Linear", "LinearSquare", "InverseTapered"}}, RollOffMinDistance = {"number", 0, 10000},
		RollOffMaxDistance = {"number", 0, 10000}, SoundGroup = {"soundGroup"}, TimePosition = {"number", 0, 3600}},
	SoundGroup = {Volume = {"number", 0, 10}},
	ReverbSoundEffect = {Enabled = {"boolean"}, DecayTime = {"number", 0.1, 20}, Density = {"number", 0, 1}, Diffusion = {"number", 0, 1},
		DryLevel = {"number", -80, 20}, WetLevel = {"number", -80, 20}},
	EqualizerSoundEffect = {Enabled = {"boolean"}, HighGain = {"number", -80, 10}, MidGain = {"number", -80, 10}, LowGain = {"number", -80, 10}},
	EchoSoundEffect = {Enabled = {"boolean"}, Delay = {"number", 0.01, 5}, Feedback = {"number", 0, 1}, DryLevel = {"number", -80, 10}, WetLevel = {"number", -80, 10}},
	ChorusSoundEffect = {Enabled = {"boolean"}, Depth = {"number", 0, 1}, Mix = {"number", 0, 1}, Rate = {"number", 0, 20}},
	CompressorSoundEffect = {Enabled = {"boolean"}, Threshold = {"number", -60, 0}, Ratio = {"number", 1, 50}, Attack = {"number", 0.001, 1},
		Release = {"number", 0.01, 5}, GainMakeup = {"number", 0, 30}},
	DistortionSoundEffect = {Enabled = {"boolean"}, Level = {"number", 0, 1}},
	-- Characters (scene.characters). Data and containers only: no rig parts, joints, animation ids or code. MaxHealth is assigned before Health.
	Humanoid = {WalkSpeed = {"number", 0, 100}, JumpPower = {"number", 0, 200}, UseJumpPower = {"boolean"}, DisplayName = {"text"}, MaxHealth = {"number", 1, 100000},
		Health = {"number", 0, 100000}, HipHeight = {"number", 0, 50}, AutoRotate = {"boolean"}, RigType = {"enum", "HumanoidRigType", {"R6", "R15"}},
		DisplayDistanceType = {"enum", "HumanoidDisplayDistanceType", {"Viewer", "Subject", "None"}}},
	HumanoidDescription = {HeadColor = {"color"}, TorsoColor = {"color"}, LeftArmColor = {"color"}, RightArmColor = {"color"}, LeftLegColor = {"color"},
		RightLegColor = {"color"}, HeightScale = {"number", 0.5, 2}, WidthScale = {"number", 0.5, 2}, DepthScale = {"number", 0.5, 2}, HeadScale = {"number", 0.5, 2},
		BodyTypeScale = {"number", 0, 1}, ProportionScale = {"number", 0, 1}},
	AnimationController = {},
	Animator = {},
})
-- Host kind each effect class provides to effect items inside it (nil: it hosts nothing).
Properties.EFFECT_HOST_CLASSES = table.freeze({Attachment = "attachment", Sound = "sound", SoundGroup = "soundGroup", Humanoid = "humanoid",
	AnimationController = "animationController"})
Properties.EFFECT_HOSTS = table.freeze({Attachment = {"part"}, ParticleEmitter = {"part", "attachment"}, PointLight = {"part", "attachment"},
	SpotLight = {"part", "attachment"}, SurfaceLight = {"part"}, Fire = {"part", "attachment"}, Smoke = {"part", "attachment"}, Sparkles = {"part", "attachment"},
	Decal = {"part"}, Texture = {"part"}, Beam = {"part", "group"}, Trail = {"part", "group"}, Highlight = {"part", "group"},
	Sound = {"part", "attachment", "group"}, SoundGroup = {"group"}, ReverbSoundEffect = {"sound", "soundGroup"}, EqualizerSoundEffect = {"sound", "soundGroup"},
	EchoSoundEffect = {"sound", "soundGroup"}, ChorusSoundEffect = {"sound", "soundGroup"}, CompressorSoundEffect = {"sound", "soundGroup"},
	DistortionSoundEffect = {"sound", "soundGroup"}, Humanoid = {"group"}, HumanoidDescription = {"humanoid", "group"}, AnimationController = {"group"},
	Animator = {"humanoid", "animationController"}})
-- GUI classes. Fixed allowlist mirrored from packages/core/src/studio-policy.ts GUI_PROPERTIES; same decode/assign/verify path.
-- udim2 = [xScale, xOffset, yScale, yOffset], udim = [scale, offset] (offsets whole pixels); text is bounded, no control characters;
-- font is a built-in family only; Image ids reuse the content rule (rbxassetid digits or rbxasset://textures).
Properties.FONT_FAMILIES = table.freeze({"BuilderSans", "SourceSansPro", "GothamSSm", "Montserrat", "Roboto", "RobotoMono", "RobotoCondensed", "Arial", "Oswald", "FredokaOne",
	"Bangers", "Creepster", "DenkOne", "Fondamento", "GrenzeGotisch", "IndieFlower", "JosefinSans", "Jura", "Kalam", "LuckiestGuy", "Merriweather", "Michroma",
	"Nunito", "PatrickHand", "PermanentMarker", "PressStart2P", "Sarpanch", "SpecialElite", "TitilliumWeb", "Ubuntu", "AmaticSC"})
Properties.FONT_WEIGHTS = table.freeze({"Thin", "ExtraLight", "Light", "Regular", "Medium", "SemiBold", "Bold", "ExtraBold", "Heavy"})
local FONT_NAMES = {"SourceSans", "SourceSansBold", "SourceSansSemibold", "SourceSansLight", "SourceSansItalic", "Gotham", "GothamMedium", "GothamBold", "GothamBlack",
	"BuilderSans", "BuilderSansMedium", "BuilderSansBold", "BuilderSansExtraBold", "Arial", "ArialBold", "Roboto", "RobotoMono", "RobotoCondensed",
	"Oswald", "FredokaOne", "Bangers", "Creepster", "DenkOne", "Fondamento", "GrenzeGotisch", "IndieFlower", "JosefinSans", "Jura", "Kalam", "LuckiestGuy", "Merriweather",
	"Michroma", "Nunito", "PatrickHand", "PermanentMarker", "Sarpanch", "SpecialElite", "TitilliumWeb", "Ubuntu", "AmaticSC", "Code", "Arcade", "SciFi", "Cartoon", "Fantasy", "Antique"}
Properties.GUI_LIMITS = table.freeze({textBytes = 2000, udimScale = 10, udimOffset = 10000})
local UNIT = {"number", 0, 1}
local AUTOMATIC_SIZE = {"enum", "AutomaticSize", {"None", "X", "Y", "XY"}}
local GUI_OBJECT = {Size = {"udim2"}, Position = {"udim2"}, AnchorPoint = {"vector2", 0, 1}, BackgroundColor3 = {"color"}, BackgroundTransparency = UNIT,
	BorderSizePixel = {"integer", 0, 100}, Visible = {"boolean"}, ZIndex = {"integer", -1000, 1000}, LayoutOrder = {"integer", -1000000, 1000000},
	AutomaticSize = AUTOMATIC_SIZE, ClipsDescendants = {"boolean"}, Rotation = {"number", -360, 360}, Active = {"boolean"}, Selectable = {"boolean"}}
local GUI_TEXT = {Text = {"text"}, TextColor3 = {"color"}, TextSize = {"integer", 1, 100}, TextScaled = {"boolean"}, TextWrapped = {"boolean"},
	TextXAlignment = {"enum", "TextXAlignment", {"Left", "Center", "Right"}}, TextYAlignment = {"enum", "TextYAlignment", {"Top", "Center", "Bottom"}},
	TextTransparency = UNIT, TextStrokeColor3 = {"color"}, TextStrokeTransparency = UNIT, Font = {"enum", "Font", FONT_NAMES}, FontFace = {"font"},
	TextTruncate = {"enum", "TextTruncate", {"None", "AtEnd"}}, LineHeight = {"number", 0.5, 3}}
local GUI_IMAGE = {Image = {"content"}, ImageColor3 = {"color"}, ImageTransparency = UNIT, ScaleType = {"enum", "ScaleType", {"Stretch", "Slice", "Tile", "Fit", "Crop"}}, TileSize = {"udim2"}}
local GUI_LAYER = {Enabled = {"boolean"}, ResetOnSpawn = {"boolean"}, ZIndexBehavior = {"enum", "ZIndexBehavior", {"Global", "Sibling"}}}
local GUI_WORLD = {AlwaysOnTop = {"boolean"}, MaxDistance = {"number", 0, 100000}, LightInfluence = UNIT, Brightness = {"number", 0, 20}, ClipsDescendants = {"boolean"}}
local GUI_LAYOUT = {FillDirection = {"enum", "FillDirection", {"Horizontal", "Vertical"}}, HorizontalAlignment = {"enum", "HorizontalAlignment", {"Left", "Center", "Right"}},
	VerticalAlignment = {"enum", "VerticalAlignment", {"Top", "Center", "Bottom"}}, SortOrder = {"enum", "SortOrder", {"LayoutOrder", "Name"}}}
local FLEX_ALIGNMENT = {"enum", "UIFlexAlignment", {"None", "Fill", "SpaceAround", "SpaceBetween", "SpaceEvenly"}}
local ITEM_LINE_ALIGNMENT = {"enum", "ItemLineAlignment", {"Automatic", "Start", "Center", "End", "Stretch"}}
Properties.GUI_SPECS = table.freeze({
	ScreenGui = merge(GUI_LAYER, {IgnoreGuiInset = {"boolean"}, DisplayOrder = {"integer", -1000, 1000},
		ScreenInsets = {"enum", "ScreenInsets", {"None", "DeviceSafeInsets", "CoreUISafeInsets", "TopbarSafeInsets"}}}),
	SurfaceGui = merge(GUI_LAYER, GUI_WORLD, {Face = {"enum", "NormalId", NORMAL_IDS}, SizingMode = {"enum", "SurfaceGuiSizingMode", {"FixedSize", "PixelsPerStud"}},
		PixelsPerStud = {"number", 1, 500}, CanvasSize = {"vector2", 1, 8192}}),
	BillboardGui = merge(GUI_LAYER, GUI_WORLD, {Size = {"udim2"}, StudsOffset = {"vector3", -1000, 1000}, StudsOffsetWorldSpace = {"vector3", -1000, 1000}}),
	Frame = GUI_OBJECT,
	CanvasGroup = merge(GUI_OBJECT, {GroupTransparency = UNIT, GroupColor3 = {"color"}}),
	ScrollingFrame = merge(GUI_OBJECT, {CanvasSize = {"udim2"}, ScrollBarThickness = {"integer", 0, 50}, ScrollingDirection = {"enum", "ScrollingDirection", {"X", "Y", "XY"}},
		AutomaticCanvasSize = AUTOMATIC_SIZE, ScrollBarImageColor3 = {"color"}, ScrollBarImageTransparency = UNIT, ScrollingEnabled = {"boolean"},
		VerticalScrollBarInset = {"enum", "ScrollBarInset", {"None", "ScrollBar", "Always"}}}),
	TextLabel = merge(GUI_OBJECT, GUI_TEXT),
	TextButton = merge(GUI_OBJECT, GUI_TEXT, {AutoButtonColor = {"boolean"}}),
	TextBox = merge(GUI_OBJECT, GUI_TEXT, {PlaceholderText = {"text"}, PlaceholderColor3 = {"color"}, ClearTextOnFocus = {"boolean"}, TextEditable = {"boolean"}, MultiLine = {"boolean"}}),
	ImageLabel = merge(GUI_OBJECT, GUI_IMAGE),
	ImageButton = merge(GUI_OBJECT, GUI_IMAGE, {AutoButtonColor = {"boolean"}, HoverImage = {"content"}, PressedImage = {"content"}}),
	ViewportFrame = merge(GUI_OBJECT, {Ambient = {"color"}, LightColor = {"color"}, ImageColor3 = {"color"}, ImageTransparency = UNIT}),
	UICorner = {CornerRadius = {"udim"}},
	UIStroke = {Color = {"color"}, Thickness = {"number", 0, 50}, Transparency = UNIT, ApplyStrokeMode = {"enum", "ApplyStrokeMode", {"Contextual", "Border"}},
		LineJoinMode = {"enum", "LineJoinMode", {"Round", "Bevel", "Miter"}}, Enabled = {"boolean"}},
	UIGradient = {Color = {"colorSequence"}, Transparency = {"sequence", 0, 1}, Rotation = {"number", -360, 360}, Offset = {"vector2", -1, 1}, Enabled = {"boolean"}},
	UIPadding = {PaddingTop = {"udim"}, PaddingBottom = {"udim"}, PaddingLeft = {"udim"}, PaddingRight = {"udim"}},
	UIListLayout = merge(GUI_LAYOUT, {Padding = {"udim"}, Wraps = {"boolean"}, HorizontalFlex = FLEX_ALIGNMENT, VerticalFlex = FLEX_ALIGNMENT, ItemLineAlignment = ITEM_LINE_ALIGNMENT}),
	UIGridLayout = merge(GUI_LAYOUT, {CellSize = {"udim2"}, CellPadding = {"udim2"}, StartCorner = {"enum", "StartCorner", {"TopLeft", "TopRight", "BottomLeft", "BottomRight"}},
		FillDirectionMaxCells = {"integer", 0, 100}}),
	UIAspectRatioConstraint = {AspectRatio = {"number", 0.01, 100}, AspectType = {"enum", "AspectType", {"FitWithinMaxSize", "ScaleWithParentSize"}},
		DominantAxis = {"enum", "DominantAxis", {"Width", "Height"}}},
	UISizeConstraint = {MinSize = {"vector2", 0, 100000}, MaxSize = {"vector2", 0, 100000}},
	UITextSizeConstraint = {MinTextSize = {"integer", 1, 100}, MaxTextSize = {"integer", 1, 100}},
	UIScale = {Scale = {"number", 0.01, 20}},
	UIFlexItem = {FlexMode = {"enum", "UIFlexMode", {"None", "Grow", "Shrink", "Fill", "Custom"}}, GrowRatio = {"number", 0, 100}, ShrinkRatio = {"number", 0, 100},
		ItemLineAlignment = ITEM_LINE_ALIGNMENT},
})
local ELEMENT_HOSTS, MODIFIER_HOSTS = {"layer", "guiObject"}, {"guiObject"}
Properties.GUI_HOSTS = table.freeze({ScreenGui = {"starterGui", "group"}, SurfaceGui = {"part"}, BillboardGui = {"part", "attachment"},
	Frame = ELEMENT_HOSTS, CanvasGroup = ELEMENT_HOSTS, ScrollingFrame = ELEMENT_HOSTS, TextLabel = ELEMENT_HOSTS, TextButton = ELEMENT_HOSTS, TextBox = ELEMENT_HOSTS,
	ImageLabel = ELEMENT_HOSTS, ImageButton = ELEMENT_HOSTS, ViewportFrame = ELEMENT_HOSTS, UIListLayout = ELEMENT_HOSTS, UIGridLayout = ELEMENT_HOSTS, UIScale = ELEMENT_HOSTS,
	UICorner = MODIFIER_HOSTS, UIStroke = MODIFIER_HOSTS, UIGradient = MODIFIER_HOSTS, UIPadding = MODIFIER_HOSTS,
	UIAspectRatioConstraint = MODIFIER_HOSTS, UISizeConstraint = MODIFIER_HOSTS, UITextSizeConstraint = MODIFIER_HOSTS, UIFlexItem = MODIFIER_HOSTS})
-- Host kind each GUI class provides to its children (nil: it hosts nothing).
Properties.GUI_HOST_CLASSES = table.freeze({ScreenGui = "layer", SurfaceGui = "layer", BillboardGui = "layer", Frame = "guiObject", CanvasGroup = "guiObject",
	ScrollingFrame = "guiObject", TextLabel = "guiObject", TextButton = "guiObject", TextBox = "guiObject", ImageLabel = "guiObject", ImageButton = "guiObject", ViewportFrame = "guiObject"})

-- Spec table and allowed host kinds of one effect or GUI class (nil when the class is neither).
function Properties.specsOf(className: any): any
	if type(className) ~= "string" then return nil end
	return Properties.EFFECT_SPECS[className] or Properties.GUI_SPECS[className]
end
function Properties.hostsOf(className: string): {string}
	return Properties.EFFECT_HOSTS[className] or Properties.GUI_HOSTS[className]
end

-- Ref-valued spec kinds and the class each Ref must name.
Properties.REF_CLASSES = table.freeze({attachment = "Attachment", soundGroup = "SoundGroup"})
Properties.EFFECT_LIMITS = table.freeze({properties = 32, keypoints = 20})
local CONTENT_EXTENSIONS = {"png", "jpg", "jpeg", "dds", "tga"}
local TAGS = {color = "Color3", vector3 = "Vector3", vector2 = "Vector2", range = "NumberRange", sequence = "NumberSequence", colorSequence = "ColorSequence"}

-- Only numeric rbxassetid or built-in rbxasset://textures paths. Never URLs or other schemes.
function Properties.contentId(value: any, label: string): string
	if type(value) == "string" and #value <= 200 then
		local digits = string.match(value, "^rbxassetid://([1-9]%d*)$")
		if digits and #digits <= 19 then return value end
		local path = string.match(value, "^rbxasset://textures/([%w_%-/%.]+)$")
		local stem, extension = string.match(path or "", "^(.+)%.(%a+)$")
		if stem and #stem <= 160 and table.find(CONTENT_EXTENSIONS, extension) and not string.find(path, "..", 1, true) then return value end
	end
	return V.fail("PROPERTY", label .. " must be rbxassetid://<digits> or a built-in rbxasset://textures/... path.")
end

-- Audio ids: numeric rbxassetid only. Never URLs, rbxasset:// paths or other schemes.
function Properties.audioId(value: any, label: string): string
	if type(value) == "string" and #value <= 40 then
		local digits = string.match(value, "^rbxassetid://([1-9]%d*)$")
		if digits and #digits <= 19 then return value end
	end
	return V.fail("PROPERTY", label .. " must be rbxassetid://<digits> (an id the user gave or asset search returned).")
end

function Properties.hostKind(instance: any): string?
	if instance:IsA("Sound") then return "sound" end
	if instance:IsA("SoundGroup") then return "soundGroup" end
	if instance:IsA("Humanoid") then return "humanoid" end
	if instance:IsA("AnimationController") then return "animationController" end
	if instance:IsA("BasePart") then return "part" end
	if instance:IsA("Attachment") then return "attachment" end
	if instance:IsA("Model") or instance:IsA("Folder") or instance.ClassName == "Workspace" then return "group" end
	if instance.ClassName == "StarterGui" then return "starterGui" end
	if instance:IsA("LayerCollector") then return "layer" end
	if instance:IsA("GuiObject") then return "guiObject" end
	return nil
end

-- Bounded display text: valid UTF-8, no control characters (C0, DEL or C1).
function Properties.guiText(value: any, label: string): string
	if type(value) ~= "string" or #value > Properties.GUI_LIMITS.textBytes or utf8.len(value) == nil or string.find(value, "%c")
		or string.find(value, "\194[\128-\159]") then
		V.fail("PROPERTY", label .. " must be text of at most " .. Properties.GUI_LIMITS.textBytes .. " UTF-8 bytes without control characters.")
	end
	return value
end

local function udims(value: any, count: number, label: string): {number}
	local list = V.list(value, count, label)
	if #list ~= count then V.fail("PROPERTY", label .. " needs " .. count .. " numbers.") end
	local limits = Properties.GUI_LIMITS
	for index, item in ipairs(list) do
		if index % 2 == 1 then V.number(item, -limits.udimScale, limits.udimScale, label .. " scale")
		else V.integer(item, -limits.udimOffset, limits.udimOffset, label .. " offset") end
	end
	return list
end

local function fontFace(value: any, label: string): any
	local face = V.fields(value, {"type", "family", "weight", "style"}, label)
	if face.type ~= "Font" or type(face.family) ~= "string" or not table.find(Properties.FONT_FAMILIES, face.family) then
		V.fail("PROPERTY", label .. " must be a built-in font family.")
	end
	local weight = V.enum(if face.weight == nil then "Regular" else face.weight, Properties.FONT_WEIGHTS, Enum.FontWeight, label .. " weight")
	local style = V.enum(if face.style == nil then "Normal" else face.style, {"Normal", "Italic"}, Enum.FontStyle, label .. " style")
	return Font.new("rbxasset://fonts/families/" .. face.family .. ".json", weight, style)
end

local function numbers(value: any, count: number, low: number, high: number, label: string): {number}
	local list = V.list(value, count, label)
	if #list ~= count then V.fail("PROPERTY", label .. " needs " .. count .. " numbers.") end
	for _, item in ipairs(list) do V.number(item, low, high, label) end
	return list
end

local function keypoints(value: any, width: number, label: string): {any}
	local list = V.list(value, Properties.EFFECT_LIMITS.keypoints, label)
	if #list < 2 then V.fail("PROPERTY", label .. " needs at least two keypoints.") end
	local last = -1
	for index, point in ipairs(list) do
		local items = V.list(point, width, label .. " keypoint")
		if #items < 2 then V.fail("PROPERTY", label .. " keypoints need time and value.") end
		local time = V.number(items[1], 0, 1, label .. " time")
		if time <= last or (index == 1 and time ~= 0) or (index == #list and time ~= 1) then V.fail("PROPERTY", label .. " keypoint times must rise from 0 to 1.") end
		last = time
	end
	return list
end

-- resolve(tag, label) maps a {type="Ref"} value to what is assigned (an Attachment or a build marker).
function Properties.decodeEffect(className: string, name: string, value: any, resolve: (any, string, string) -> any): any
	local specs = Properties.specsOf(className)
	local spec = if specs then specs[name] else nil
	local label = className .. "." .. name
	if not spec then V.fail("PROPERTY", label .. " is not writable by the safe bridge.") end
	local kind = spec[1]
	if kind == "boolean" then return V.boolean(value, label) end
	if kind == "content" then return Properties.contentId(value, label) end
	if kind == "audio" then return Properties.audioId(value, label) end
	if kind == "number" then return V.number(value, spec[2], spec[3], label) end
	if kind == "integer" then return V.integer(value, spec[2], spec[3], label) end
	if kind == "enum" then return V.enum(value, spec[3], Enum[spec[2]], label) end
	if kind == "text" then return Properties.guiText(value, label) end
	if kind == "font" then return fontFace(value, label) end
	if kind == "udim2" or kind == "udim" then
		local tag = V.fields(value, {"type", "value"}, label)
		if tag.type ~= (if kind == "udim2" then "UDim2" else "UDim") then V.fail("PROPERTY", "Incorrect property type tag for " .. label .. ".") end
		local c = udims(tag.value, if kind == "udim2" then 4 else 2, label)
		if kind == "udim" then return UDim.new(c[1], c[2]) end
		return UDim2.new(c[1], c[2], c[3], c[4])
	end
	if Properties.REF_CLASSES[kind] then
		local tag = V.object(value, label)
		if tag.type ~= "Ref" then V.fail("PROPERTY", label .. " must be a Ref to a " .. Properties.REF_CLASSES[kind] .. ".") end
		return resolve(tag, label, kind)
	end
	local tag = V.fields(value, {"type", "value"}, label)
	if tag.type ~= TAGS[kind] then V.fail("PROPERTY", "Incorrect property type tag for " .. label .. ".") end
	if kind == "color" then
		local c = numbers(tag.value, 3, 0, 1, label)
		return Color3.new(c[1], c[2], c[3])
	elseif kind == "vector3" then
		local c = numbers(tag.value, 3, spec[2], spec[3], label)
		return Vector3.new(c[1], c[2], c[3])
	elseif kind == "vector2" then
		local c = numbers(tag.value, 2, spec[2], spec[3], label)
		return Vector2.new(c[1], c[2])
	elseif kind == "range" then
		local c = numbers(tag.value, 2, spec[2], spec[3], label)
		if c[1] > c[2] then V.fail("PROPERTY", label .. " min must not exceed max.") end
		return NumberRange.new(c[1], c[2])
	elseif kind == "sequence" then
		local points = {}
		for _, point in ipairs(keypoints(tag.value, 3, label)) do
			local envelope = if point[3] == nil then 0 else V.number(point[3], 0, (spec[3] - spec[2]) / 2, label .. " envelope")
			table.insert(points, NumberSequenceKeypoint.new(point[1], V.number(point[2], spec[2], spec[3], label), envelope))
		end
		return NumberSequence.new(points)
	end
	local points = {}
	for _, point in ipairs(keypoints(tag.value, 4, label)) do
		if #point ~= 4 then V.fail("PROPERTY", label .. " keypoints are [time,r,g,b].") end
		for channel = 2, 4 do V.number(point[channel], 0, 1, label) end
		table.insert(points, ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4])))
	end
	return ColorSequence.new(points)
end

function Properties.decodeEffects(className: string, values: any, resolve: (any, string, string) -> any): {[string]: any}
	if not Properties.specsOf(className) then V.fail("CLASS", "Unsupported effect or GUI class.") end
	V.object(values, "effect properties")
	local decoded, count = {}, 0
	for name, value in pairs(values) do
		count += 1
		if count > Properties.EFFECT_LIMITS.properties then V.fail("INPUT", "Too many effect properties.") end
		if name == "Name" then V.fail("PROPERTY", "Use the name field.") end
		decoded[name] = Properties.decodeEffect(className, name, value, resolve)
	end
	if decoded.RollOffMinDistance and decoded.RollOffMaxDistance and decoded.RollOffMinDistance > decoded.RollOffMaxDistance then
		V.fail("PROPERTY", className .. ".RollOffMinDistance must not exceed RollOffMaxDistance.")
	end
	if decoded.Health and decoded.MaxHealth and decoded.Health > decoded.MaxHealth then V.fail("PROPERTY", className .. ".Health must not exceed MaxHealth.") end
	Properties.crossCheck(className, decoded)
	return decoded
end

-- GUI cross-field rules (mirrored in studio-policy.ts): one font source; minimums never above maximums.
-- Also run on a stamp's merged prototype-root and override properties.
function Properties.crossCheck(className: string, decoded: {[string]: any}): ()
	if decoded.Font ~= nil and decoded.FontFace ~= nil then V.fail("PROPERTY", className .. ": set Font or FontFace, not both.") end
	if decoded.MinTextSize and decoded.MaxTextSize and decoded.MinTextSize > decoded.MaxTextSize then
		V.fail("PROPERTY", className .. ".MinTextSize must not exceed MaxTextSize.")
	end
	local low, high = decoded.MinSize, decoded.MaxSize
	if low and high and (low.X > high.X or low.Y > high.Y) then V.fail("PROPERTY", className .. ".MinSize must not exceed MaxSize.") end
end

local function near(actual: any, expected: number): boolean
	return type(actual) == "number" and math.abs(actual - expected) <= 0.0005 * math.max(1, math.abs(expected))
end
local function sameColor(actual: any, expected: any): boolean
	return typeof(actual) == "Color3" and near(actual.R, expected.R) and near(actual.G, expected.G) and near(actual.B, expected.B)
end
-- Euler triples (YXZ, degrees) are compared as rotations: the engine may normalize angles.
local function rotation(v: any): {number}
	local x, y, z = math.rad(v.X), math.rad(v.Y), math.rad(v.Z)
	local sx, cx, sy, cy, sz, cz = math.sin(x), math.cos(x), math.sin(y), math.cos(y), math.sin(z), math.cos(z)
	return {cy * cz + sy * sx * sz, -cy * sz + sy * sx * cz, sy * cx, cx * sz, cx * cz, -sx, -sy * cz + cy * sx * sz, sy * sz + cy * sx * cz, cy * cx}
end

function Properties.effectMatches(instance: any, className: string, name: string, expected: any): boolean
	local kind = Properties.specsOf(className)[name][1]
	local ok, actual = pcall(function(): any return instance[name] end)
	if not ok then return false end
	if kind == "number" or kind == "integer" then return near(actual, expected) end
	if kind == "color" then return sameColor(actual, expected) end
	if kind == "udim" then return typeof(actual) == "UDim" and near(actual.Scale, expected.Scale) and actual.Offset == expected.Offset end
	if kind == "udim2" then
		return typeof(actual) == "UDim2" and near(actual.X.Scale, expected.X.Scale) and actual.X.Offset == expected.X.Offset
			and near(actual.Y.Scale, expected.Y.Scale) and actual.Y.Offset == expected.Y.Offset
	end
	if kind == "font" then
		return typeof(actual) == "Font" and actual.Family == expected.Family and actual.Weight == expected.Weight and actual.Style == expected.Style
	end
	if kind == "vector3" and className == "Attachment" and name == "Orientation" then
		if typeof(actual) ~= "Vector3" then return false end
		local a, b = rotation(actual), rotation(expected)
		for index = 1, 9 do if math.abs(a[index] - b[index]) > 0.0001 then return false end end
		return true
	end
	if kind == "vector3" then return typeof(actual) == "Vector3" and near(actual.X, expected.X) and near(actual.Y, expected.Y) and near(actual.Z, expected.Z) end
	if kind == "vector2" then return typeof(actual) == "Vector2" and near(actual.X, expected.X) and near(actual.Y, expected.Y) end
	if kind == "range" then return typeof(actual) == "NumberRange" and near(actual.Min, expected.Min) and near(actual.Max, expected.Max) end
	if kind == "sequence" or kind == "colorSequence" then
		local want = expected.Keypoints
		if typeof(actual) ~= (if kind == "sequence" then "NumberSequence" else "ColorSequence") or #actual.Keypoints ~= #want then return false end
		for index, point in ipairs(actual.Keypoints) do
			local target = want[index]
			if not near(point.Time, target.Time) then return false end
			if kind == "sequence" and (not near(point.Value, target.Value) or not near(point.Envelope, target.Envelope)) then return false end
			if kind == "colorSequence" and not sameColor(point.Value, target.Value) then return false end
		end
		return true
	end
	return actual == expected
end

-- Limits assigned before the values they clamp (Humanoid.Health is clamped to MaxHealth).
local ASSIGN_FIRST = table.freeze({MaxHealth = true})
-- Assign in sorted order (limits first), then verify every value read back. resolveMarker maps build markers to Instances.
function Properties.applyEffect(instance: any, className: string, decoded: {[string]: any}, resolveMarker: ((any) -> any)?): ()
	local names: {string} = {}
	for name in pairs(decoded) do table.insert(names, name) end
	table.sort(names, function(a: string, b: string): boolean
		local first, second = ASSIGN_FIRST[a] == true, ASSIGN_FIRST[b] == true
		if first ~= second then return first end
		return a < b
	end)
	local values: {[string]: any} = {}
	for _, name in ipairs(names) do
		local value = decoded[name]
		if Properties.REF_CLASSES[Properties.specsOf(className)[name][1]] and resolveMarker then value = resolveMarker(value) end
		values[name] = value
		local ok = pcall(function() instance[name] = value end)
		if not ok then V.fail("VERIFY", "Studio refused " .. className .. "." .. name .. ".") end
	end
	for _, name in ipairs(names) do
		if not Properties.effectMatches(instance, className, name, values[name]) then V.fail("VERIFY", className .. "." .. name .. " did not take the requested value.") end
	end
end


-- Observed GUI values are exact engine readbacks, not values decoded through new-write bounds.
-- Full Font family paths preserve custom faces; JSON arrays retain the protocol array marker.
function Properties.encodeGui(className: string, name: string, value: any): any
	if value == nil then return V.NULL end
	if name == "Name" then return value end
	local spec = Properties.GUI_SPECS[className][name]
	if not spec then V.fail("PROPERTY", "Unknown GUI observation property.") end
	local kind = spec[1]
	if kind == "enum" then return value.Name end
	if kind == "font" then return {type = "Font", family = value.Family, weight = value.Weight.Name, style = value.Style.Name} end
	if kind == "udim" then return {type = "UDim", value = V.array({value.Scale, value.Offset})} end
	if kind == "udim2" then return {type = "UDim2", value = V.array({value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset})} end
	if kind == "color" then return {type = "Color3", value = V.array({value.R, value.G, value.B})} end
	if kind == "vector2" then return {type = "Vector2", value = V.array({value.X, value.Y})} end
	if kind == "vector3" then return {type = "Vector3", value = V.array({value.X, value.Y, value.Z})} end
	if kind == "sequence" or kind == "colorSequence" then
		local points = {}
		for _, point in ipairs(value.Keypoints) do
			if kind == "sequence" then table.insert(points, V.array({point.Time, point.Value, point.Envelope}))
			else table.insert(points, V.array({point.Time, point.Value.R, point.Value.G, point.Value.B})) end
		end
		return {type = if kind == "sequence" then "NumberSequence" else "ColorSequence", value = V.array(points)}
	end
	return value
end

function Properties.snapshotGui(instance: any, names: {string}?): any
	local className, selected = instance.ClassName, names
	if not selected then
		selected = {"Name"}
		for name in pairs(Properties.GUI_SPECS[className]) do table.insert(selected, name) end
		table.sort(selected)
	end
	local result = {}
	for _, name in ipairs(selected) do result[name] = Properties.encodeGui(className, name, instance[name]) end
	return result
end


-- Only immutable, locally retained receipt values enter this decoder. Intake uses decodeEffects instead.
function Properties.restoreGuiValue(className: string, name: string, value: any): any
	if name == "Name" then return value end
	local spec = Properties.GUI_SPECS[className][name]
	if not spec then V.fail("PROPERTY", "Unknown retained GUI property.") end
	local kind = spec[1]
	if kind == "enum" then return Enum[spec[2]][value] end
	if kind == "font" then return Font.new(value.family, Enum.FontWeight[value.weight], Enum.FontStyle[value.style]) end
	if kind == "udim" then return UDim.new(value.value[1], value.value[2]) end
	if kind == "udim2" then return UDim2.new(value.value[1], value.value[2], value.value[3], value.value[4]) end
	if kind == "color" then return Color3.new(value.value[1], value.value[2], value.value[3]) end
	if kind == "vector2" then return Vector2.new(value.value[1], value.value[2]) end
	if kind == "vector3" then return Vector3.new(value.value[1], value.value[2], value.value[3]) end
	if kind == "sequence" or kind == "colorSequence" then
		local points = {}
		for _, point in ipairs(value.value) do
			if kind == "sequence" then table.insert(points, NumberSequenceKeypoint.new(point[1], point[2], point[3]))
			else table.insert(points, ColorSequenceKeypoint.new(point[1], Color3.new(point[2], point[3], point[4]))) end
		end
		return if kind == "sequence" then NumberSequence.new(points) else ColorSequence.new(points)
	end
	return value
end

return table.freeze(Properties)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane5">
<Properties>
<string name="Name">Operations</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local V = require(script.Parent.Validation)
local LegacyProperties = require(script.Parent.Properties)
local P = V.geometryProperties(LegacyProperties)
local Registry = require(script.Parent.Registry)
local AssetTransfer = require(script.Parent.AssetTransfer)
local AssetMaterials = require(script.Parent.AssetMaterials)
local AssetPlacement = require(script.Parent.AssetPlacement)
local TerrainGen = require(script.Parent.TerrainGen)
local AssetUpload = require(script.Parent.AssetUpload)
local Operations = {}
Operations.__index = Operations
type Operations = any
-- Engine objects never enter command data or public fields. This private owner
-- retains exact meshes until retirement; receiver ownership ends at reconstruct.
local assetOwners: {[any]: any} = setmetatable({}, {__mode = "k"})

local function cleanupFailure(): never
	error(table.freeze({code = "CLEANUP", message = "Owned editable resources may remain; reconnect cannot establish cleanup.",
		unsafe = true, recovery = table.freeze({partial = true, imported = false, engineVerification = "pending"})}), 0)
end

function Operations.new(pair: any, gameModel: any, http: any, assetProgress: (() -> ())?): Operations
	return setmetatable({registry = Registry.new(pair.sessionId, pair.allowedRoots, gameModel, http),
		gameModel = gameModel, assetTransfers = {}, assetProgress = assetProgress,
		http = http, editor = gameModel:GetService("ScriptEditorService"),
		history = gameModel:GetService("ChangeHistoryService"), selection = gameModel:GetService("Selection"),
		collection = gameModel:GetService("CollectionService"), mutations = {}, restored = {},
		sliceSeconds = Operations.SLICE_SECONDS, slices = 0}, Operations)
end

-- Cooperative slicing for long CPU/engine loops (detached scene.build construction, terrain
-- field and chunk preparation). Every SLICE_CHECK steps the clock is read; once SLICE_SECONDS of
-- work has run since the last resume (a step may weigh more, e.g. a terrain row), yield one
-- frame so Studio keeps drawing, then re-run the command guard (session, lease expiry, Edit mode) before doing anything else. Small commands
-- never yield. The guard after a yield is the only way work resumes, so a lost lease, a
-- disconnect or entering Play stops the command at the next slice boundary.
Operations.SLICE_SECONDS = 0.02
Operations.SLICE_CHECK = 32
function Operations:slicer(guard: () -> ()): (number?) -> ()
	local started, steps = os.clock(), 0
	-- weight 0 forces a yield now (a terrain chunk boundary) and restarts the budget.
	return function(weight: number?): ()
		if weight ~= 0 then
			steps += math.max(1, weight or 1)
			if steps < Operations.SLICE_CHECK then return end
			steps = 0
			if os.clock() - started < self.sliceSeconds then return end
		end
		task.wait()
		self.slices += 1
		guard()
		started = os.clock()
	end
end

-- Internal intake is also reached by the fixed host-owned asset.stage_packet
-- queue entry. Generic agent enqueue cannot mint that host admission.
-- No upload, parenting, undo record or engine baseline is created here.
function Operations:receiveAssetPacket(expected: any, packet: string, guard: () -> ()): any
	guard()
	V.fields(expected, {"digest", "payloadDigest", "manifestDigest"}, "asset transfer identity")
	local id = V.string(expected.digest, "transfer digest", 64)
	if #id ~= 64 or not string.match(id, "^[a-f0-9]+$") then V.fail("INPUT", "Expected transfer SHA-256.") end
	local owned = self.assetTransfers[id]
	if not owned then
		local count = 0
		for _ in pairs(self.assetTransfers) do count += 1 end
		if count >= 2 then V.fail("BUSY", "At most two internal asset transfers may be staged.") end
		owned = {guard = guard, expected = V.immutable(expected)}
		owned.receiver = AssetTransfer.new(owned.expected, function(json: string): any
			return self.http:JSONDecode(json)
		end, function(): () owned.guard() end, function(): ()
			task.wait()
			if self.assetProgress then self.assetProgress() end
		end)
		self.assetTransfers[id] = owned
	elseif owned.expected.payloadDigest ~= expected.payloadDigest or owned.expected.manifestDigest ~= expected.manifestDigest then
		V.fail("SCOPE", "Transfer identity changed.")
	end
	owned.guard = guard
	local ok, result = pcall(function(): any
		local output = owned.receiver:accept(packet)
		guard()
		return output
	end)
	if not ok then
		local cleaned = pcall(function() owned.receiver:cancel() end)
		self.assetTransfers[id] = nil
		if not cleaned then V.fail("CLEANUP", "Retired asset staging resources may remain.") end
		error(result, 0)
	end
	return result
end

function Operations:cancelAssetTransfers(): ()
	-- Retirement also releases the Output reader; it owns no Studio state, so this never counts as a cleanup failure.
	self:stopOutput()
	local failures = 0
	for id, owned in pairs(self.assetTransfers) do
		local ok = pcall(function() owned.receiver:cancel() end)
		self.assetTransfers[id] = nil
		if not ok then failures += 1 end
	end
	local owners = assetOwners[self]
	if owners then
		for id, owner in pairs(owners.resources) do
			owner.retired = true
			-- Templates and image objects stay alive while placed/scattered surfaces reference them.
			-- Detach each cache entry before engine callbacks can re-enter cancellation.
			local released: {[any]: boolean} = {}
			local function destroyMaterialResource(resource: any): ()
				if resource ~= nil and not released[resource] then
					released[resource] = true
					if not pcall(function() resource:Destroy() end) then failures += 1 end
				end
			end
			for key, material in pairs(owner.materials or {}) do
				owner.materials[key] = nil
				destroyMaterialResource(material.surfaceAppearance)
				for _, image in pairs(material.editableImages) do destroyMaterialResource(image) end
			end
			for _, resource in ipairs(owner.meshes) do
				if not resource.disposed then
					resource.disposed = true -- Detach BEFORE a reentrant engine callback.
					local mesh = resource.mesh
					resource.mesh = nil
					if not pcall(function() mesh:Destroy() end) then failures += 1 end
				end
			end
			if owner.finished then owners.resources[id] = nil end
		end
	end
	if failures > 0 then self.assetCleanupFailed = true end
	if self.assetCleanupFailed then cleanupFailure() end
end

function Operations:retireAssetContinuity(proof: any): ()
	local retired = false
	local function check(owned: any): ()
		local c = owned.continuity
		if c and (type(proof) ~= "table" or proof.sessionId ~= owned.target.sessionId or proof.mode ~= "Edit"
			or proof.placeId ~= owned.target.placeId or proof.universeId ~= owned.target.universeId
			or proof.connected ~= true or proof.continuitySupported ~= true or proof.clientLifetimeId ~= c.clientLifetimeId
			or proof.pluginArtifactHash ~= c.pluginArtifactHash or proof.playEpoch ~= c.playEpoch) then retired = true end
	end
	for _, owned in pairs(self.assetTransfers) do check(owned) end
	-- Reconstructed meshes no longer hold a staging slot but keep their epoch.
	local owners = assetOwners[self]
	if owners then for _, owner in pairs(owners.resources) do if not owner.retired then check(owner) end end end
	if retired then self:cancelAssetTransfers() end
end

function Operations:assetTargetGuard(target: any, guard: () -> ()): () -> ()
	return function(): ()
		guard()
		if self.assetCleanupFailed then cleanupFailure() end
		local context = self:importContext({})
		local creator: any
		if context.creator.status == "available" then creator = {kind = context.creator.kind, id = tostring(context.creator.id)}
		elseif context.placeId == 0 and context.universeId == 0 and context.creator.id == 0 and context.studioUser.status == "available" then
			creator = {kind = "user", id = tostring(context.studioUser.id)}
		else V.fail("SCOPE", "Observed import creator is unavailable.") end
		local observed = {sessionId = context.sessionId, placeId = context.placeId, universeId = context.universeId,
			root = "Workspace", parentRef = context.parentRef.instanceId, creator = creator}
		if context.mode ~= "Edit" or not V.equal(observed, target) then V.fail("SCOPE", "Import target, creator or Workspace changed.") end
		guard()
	end
end

function Operations:stageAssetPacket(args: any, guard: () -> ()): any
	V.fields(args, {"expected", "packet", "target", "continuity"}, "asset staging arguments")
	local target = V.fields(args.target, {"sessionId", "placeId", "universeId", "root", "parentRef", "creator"}, "asset staging target")
	local current = self:assetTargetGuard(target, guard)
	current()
	local packet = V.string(args.packet, "asset packet", V.ARGUMENT_BYTES)
	local identity = V.fields(args.expected, {"digest", "payloadDigest", "manifestDigest"}, "asset transfer identity")
	local owned = self.assetTransfers[identity.digest]
	if owned then
		if not owned.target or not V.equal(owned.target, target) or not V.equal(owned.continuity, args.continuity) then V.fail("SCOPE", "Staging target or lifetime changed.") end
	else
		local prior = assetOwners[self]
		if prior and prior.resources[identity.digest] then V.fail("STATE", "Transfer was already reconstructed; inspect its original receipt.") end
		local first = V.object(self.http:JSONDecode(packet), "first asset packet")
		if first.kind ~= "begin" or first.ordinal ~= 0 or not V.equal(first.target, target) then V.fail("SCOPE", "Initial packet does not name the observed target.") end
	end
	local result = self:receiveAssetPacket(identity, packet, current)
	self.assetTransfers[identity.digest].target = V.immutable(target)
	self.assetTransfers[identity.digest].continuity = V.immutable(args.continuity)
	return {transferDigest = identity.digest, packetCount = result.packetCount, byteLength = result.byteLength,
		state = result.state, engineVerification = "pending"}
end

-- Fixed host-owned queue operation. It resolves the actual retained receiver;
-- neither the digest, source summary nor JSON runId grants engine ownership.
function Operations:reconstructAsset(args: any, guard: () -> ()): any
	V.fields(args, {"runId", "expected", "packetCount", "byteLength", "objects", "target", "continuity"}, "asset reconstruction")
	local runId = V.string(args.runId, "original stage run", 36)
	local identity = V.fields(args.expected, {"digest", "payloadDigest", "manifestDigest"}, "asset transfer identity")
	local owned = self.assetTransfers[identity.digest]
	local current = self:assetTargetGuard(args.target, guard)
	current()
	local prior = assetOwners[self]
	if not owned and prior and prior.resources[identity.digest] then V.fail("STATE", "Reconstruction was already consumed; inspect its original receipt.") end
	if not owned or not V.equal(owned.expected, identity) or not V.equal(owned.target, args.target)
		or not V.equal(owned.continuity, args.continuity) then V.fail("SCOPE", "Original staged buffers are absent or changed.") end
	local owners = assetOwners[self]
	if not owners then owners = {resources = {}, consumed = {}, count = 0}; assetOwners[self] = owners end
	if owners.consumed[runId] or owners.resources[identity.digest] then V.fail("STATE", "Reconstruction was already consumed; inspect its original receipt.") end
	if owners.count >= 64 then V.fail("CAPACITY", "Reconstruction history is full; no consumed attempt is evicted.") end
	owned.guard = current
	local status = owned.receiver:status()
	if status.state ~= "sealed" or status.packetCount ~= args.packetCount or status.byteLength ~= args.byteLength then V.fail("STATE", "Original sealed packet accounting changed.") end
	local plan = owned.receiver:reconstructionPlan()
	local expectedObjects = V.list(args.objects, 128, "reconstructed sources")
	if #expectedObjects ~= #plan then V.fail("SCOPE", "Reconstruction source count differs from the sealed transfer.") end
	for index, source in ipairs(plan) do
		if not V.equal(source, expectedObjects[index]) then V.fail("SCOPE", "Reconstruction sources differ from the sealed transfer.") end
	end
	current()
	owners.consumed[runId] = true; owners.count += 1 -- BEFORE resolving/allocating an engine service.
	local owner: any = {runId = runId, meshes = {}, retired = false, finished = false, materials = {}, target = owned.target, continuity = owned.continuity, service = nil}
	owners.resources[identity.digest] = owner
	owned.guard = function(): ()
		current()
		if owner.retired or self.assetTransfers[identity.digest] ~= owned then V.fail("SCOPE", "Reconstruction owner was retired.") end
	end
	local ok, output = pcall(function(): any
		if self.assetProgress then self.assetProgress() end -- Fresh authenticated progress BEFORE allocation.
		local service = self.gameModel:GetService("AssetService")
		owned.guard()
		local entries = owned.receiver:reconstruct(service, AssetMaterials.admitTextures)
		-- No guard/yield between receiving ownership and registering EVERY mesh.
		for _, entry in ipairs(entries) do owner.meshes[#owner.meshes + 1] = {mesh = entry.mesh.editableMesh, disposed = false, object = entry.object, material = entry.material, textures = entry.textures} end
		owner.service = service -- Retained for materialization; never re-acquired elsewhere.
		owned.guard()
		local summary = {}
		for _, entry in ipairs(entries) do
			summary[#summary + 1] = {sourceObjectId = entry.object.sourceObjectId, meshExportSha256 = entry.object.meshExportSha256,
				vertexCount = entry.mesh.vertexCount, triangleCount = entry.mesh.triangleCount}
		end
		if owner.retired or not V.equal(summary, plan) then V.fail("SCOPE", "Reconstructed ownership or source accounting changed.") end
		owned.guard()
		owner.finished = true
		local receipt = {runId = runId, transferDigest = identity.digest, state = "reconstructed", objects = V.array(summary), imported = false, engineVerification = "pending"}
		if #V.encode(receipt, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Reconstruction receipt exceeds its bound.") end
		local frozen = V.immutable(receipt)
		owned.guard()
		return frozen
	end)
	if not ok then
		owner.finished = true
		if type(output) == "table" and (output.code == "CLEANUP" or output.cleanupFailed == true) then self.assetCleanupFailed = true end
		self:cancelAssetTransfers()
		error(output, 0)
	end
	-- The emptied receiver no longer owns buffers; release its staging slot so
	-- only in-progress transfers count toward the two-transfer bound.
	if self.assetTransfers[identity.digest] == owned then self.assetTransfers[identity.digest] = nil end
	return output
end

-- Materialization of ONE retained reconstruction into a detached Model of MeshParts.
-- Reached only through scene.place_asset with an "editable-<transfer digest>" source,
-- so the result is adopted by AssetPlacement (fit, ground, pivot, anchor, parent) under
-- one undo recording and receipt. No upload, publication or asset ID is created: the
-- MeshParts reference the in-memory EditableMeshes owned by this plugin lifetime.
-- API (create.roblox.com AssetService.CreateMeshPartAsync, checked 2026-10-18): meshContent = Content.fromObject(editableMesh).
local STUDS_PER_METER = 1 / 0.28
local function srgb(linear: number): number
	local c = math.clamp(if linear == linear then linear else 0, 0, 1)
	return if c <= 0.0031308 then c * 12.92 else 1.055 * c ^ (1 / 2.4) - 0.055
end
function Operations:materializeReconstruction(digest: string, guard: () -> ()): (any, () -> ())
	if #digest ~= 64 or not string.match(digest, "^[0-9a-f]+$") then V.fail("WATCH", "Expected an editable-<transfer digest> source.") end
	local owners = assetOwners[self]
	local owner = owners and owners.resources[digest]
	if not owner or not owner.finished or owner.retired or owner.service == nil or #owner.meshes == 0 then
		V.fail("WATCH", "No reconstructed meshes are retained for this transfer in this plugin session; run assets_reconstruct_studio_import first (same Studio session).")
	end
	if owner.materializing or (owner.placed and owner.placed.Parent ~= nil) then
		V.fail("STATE", "This reconstruction is already placed; clone it with scene_build templates or restore its receipt first.")
	end
	local targetCurrent = self:assetTargetGuard(owner.target, guard)
	local function current(): ()
		targetCurrent()
		if owner.retired then V.fail("SCOPE", "Materialization owner was retired.") end
	end
	current()
	-- Validate every material before allocating parts or image resources.
	for _, resource in ipairs(owner.meshes) do
		if resource.object.role ~= "collision" then
			local plan = AssetMaterials.plan(resource.material, resource.textures)
			if not plan.supported then V.fail("UNSUPPORTED_MATERIAL", "Nonzero emission cannot be mapped faithfully.") end
		end
	end
	current()
	owner.materializing = true
	local model: any = nil
	local parts, appearances = {}, {}
	local ok, err = pcall(function()
		model = Instance.new("Model")
		for index, resource in ipairs(owner.meshes) do
			current()
			if owner.retired or resource.disposed or resource.mesh == nil then V.fail("STATE", "Retained meshes were released before placement.") end
			local object = resource.object
			if type(object) ~= "table" or type(object.worldBounds) ~= "table" then V.fail("STATE", "Retained mesh metadata is incomplete.") end
			local collision = object.role == "collision"
			local part = owner.service:CreateMeshPartAsync(Content.fromObject(resource.mesh), {
				CollisionFidelity = if collision then Enum.CollisionFidelity.Hull else Enum.CollisionFidelity.Box,
				RenderFidelity = Enum.RenderFidelity.Precise})
			-- Own the returned part before a post-yield guard can refuse it.
			if part ~= nil then parts[index] = part end
			current()
			if part == nil or not part:IsA("MeshPart") then V.fail("ENGINE", "CreateMeshPartAsync did not return a MeshPart.") end
			part.Parent = model
			-- Keep this mesh swaps exactly these session parts (AssetPlacement.keep).
			local low, high = object.worldBounds.min, object.worldBounds.max
			local size = {}
			for axis = 1, 3 do size[axis] = math.max(0.05, (high[axis] - low[axis]) * STUDS_PER_METER) end
			part.Size = Vector3.new(size[1], size[2], size[3])
			part.CFrame = CFrame.new((low[1] + high[1]) / 2 * STUDS_PER_METER, (low[2] + high[2]) / 2 * STUDS_PER_METER, (low[3] + high[3]) / 2 * STUDS_PER_METER)
			local name = if type(object.name) == "string" then string.sub(object.name, 1, 100) else "Part" .. index
			part.Name = name
			if collision then
				part.Transparency, part.CanCollide, part.CastShadow, part.CanQuery = 1, true, false, false
			else
				part.CanCollide = false
				local key = if resource.material == nil then "default" else resource.material.sha256
				local material = owner.materials[key]
				if material == nil then
					material = AssetMaterials.create(resource.material, {
						createEditableImage = function(options: any): any return owner.service:CreateEditableImage(options) end,
						createSurfaceAppearanceAsync = function(maps: any): any return owner.service:CreateSurfaceAppearanceAsync(maps) end,
						contentFromObject = function(image: any): any return Content.fromObject(image) end,
						vector2 = function(x: number, y: number): any return Vector2.new(x, y) end,
						colorFromLinear = function(r: number, g: number, b: number): any return Color3.new(srgb(r), srgb(g), srgb(b)) end,
					}, current, resource.textures)
					owner.materials[key] = material -- Ownership before any further guard or engine call.
				end
				current()
				-- Neutral substrate: preserve authored PBR instead of guessing from filenames.
				part.Material = Enum.Material.SmoothPlastic
				part.Color, part.Transparency, part.DoubleSided = material.meshPartProperties.Color, material.meshPartProperties.Transparency, material.meshPartProperties.DoubleSided
				local appearance = material.surfaceAppearance:Clone()
				if appearance == nil then V.fail("ENGINE", "SurfaceAppearance could not be cloned.") end
				appearances[index] = appearance
				current()
				if not appearance:IsA("SurfaceAppearance") or appearance.Parent ~= nil then V.fail("ENGINE", "Expected a detached SurfaceAppearance clone.") end
				appearance.Parent = part
				current()
			end
		end
		current()
	end)
	owner.materializing = false
	if not ok then
		local failed = type(err) == "table" and err.field == "cleanup"
		if model ~= nil and not pcall(function() model:Destroy() end) then failed = true end
		for _, appearance in pairs(appearances) do if not pcall(function() appearance:Destroy() end) then failed = true end end
		for _, part in pairs(parts) do if not pcall(function() part:Destroy() end) then failed = true end end
		if failed then self.assetCleanupFailed = true; cleanupFailure() end
		error(err, 0)
	end
	-- No yielding callbacks between final validation and the part ownership update.
	for index, resource in ipairs(owner.meshes) do resource.part, resource.appearance, resource.keptAssetId = parts[index], appearances[index], nil end
	model.Name = "ArcaneProcedural"
	-- AssetPlacement calls this once the adopted Model is parented.
	return model, function() owner.placed = model end
end

-- asset.keep_mesh: host-only (the daemon admits it solely after the person's trusted-dialog consent). Resolves the
-- retained owner of ONE placed reconstruction in THIS plugin session and hands it to AssetPlacement.keep.
-- No final guard after uploads: a lease or scope change must never discard the asset IDs Roblox already returned.
function Operations:keepReconstruction(args: any, guard: () -> ()): any
	V.fields(args, {"source", "attemptId", "name", "description", "creatorId", "continuity", "finish", "assetIds"}, "keep-mesh arguments")
	local digest = string.match(V.string(args.source, "keep source", 80), "^editable%-([0-9a-f]+)$")
	if not digest or #digest ~= 64 then V.fail("INPUT", "Expected an editable-<transfer digest> source.") end
	local owners = assetOwners[self]
	local owner = owners and owners.resources[digest]
	if not owner or not owner.finished or owner.retired or owner.service == nil or #owner.meshes == 0 then
		V.fail("STATE", "This mesh is no longer held by this Studio session (reconnected, Play or reopened). Nothing was uploaded; generate and place it again.")
	end
	if owner.keeping then V.fail("STATE", "This mesh is already being kept.") end
	-- keepEngineDouble is set only by the standalone VM tests; production always probes and binds the real engine.
	local double = self.keepEngineDouble
	if not double and not AssetPlacement.keepSupported(self.gameModel) then V.fail("CAPABILITY", "This Studio does not let plugins upload meshes. Nothing was uploaded.") end
	owner.keeping = true
	local ok, result = pcall(AssetPlacement.keep, self, owner, digest, args, guard, double or AssetPlacement.keepEngine(self, AssetUpload))
	owner.keeping = false
	if not ok then error(result, 0) end
	if #V.encode(result, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Keep receipt exceeds its bound.") end
	return V.immutable(result)
end
function Operations.meshKeepSupported(gameModel: any): boolean return AssetPlacement.keepSupported(gameModel) end

function Operations:source(instance: any): string
	if not instance:IsA("LuaSourceContainer") then V.fail("CLASS", "Reference is not a script.") end
	return V.string(self.editor:GetEditorSource(instance), "script source", V.SOURCE_BYTES, true)
end

function Operations:record(command: any, guard: () -> (), action: (any) -> any): any
	guard()
	local recording = self.history:TryBeginRecording("Arcane." .. command.id, "Arcane " .. command.method)
	if not recording then V.fail("HISTORY", "Cannot begin an undo recording; no change was attempted.") end
	local progress: any = {touched = false}
	local ok, result = pcall(function()
		guard()
		local output = action(progress)
		guard()
		if #V.encode(output, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Mutation receipt exceeds 512 KiB.") end
		return output
	end)
	if ok then
		local committed = pcall(function() self.history:FinishRecording(recording, Enum.FinishRecordingOperation.Commit) end)
		if committed then return result end
		progress.touched = true
		result = {code = "HISTORY", message = "Change applied but its undo recording could not be committed."}
	else
		-- Cancel only an untouched recording. A yielding editor write or partial
		-- property assignment is ambiguous; a broad undo could erase a later edit.
		local finish = if progress.touched then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel
		local finished = pcall(function() self.history:FinishRecording(recording, finish) end)
		if not finished then progress.touched = true end
	end
	if progress.touched then
		local recovery: any = {partial = true, needsReconciliation = true, rollbackVerified = false, commandId = command.id}
		if progress.ref then recovery.ref = progress.ref end
		error({code = "PARTIAL", message = V.safeError(result), recovery = recovery, unsafe = true}, 0)
	end
	error(result, 0)
end

function Operations:children(args: any): any
	V.fields(args, {"root", "ref", "limit"}, "children arguments")
	local root = self.registry:root(args.root)
	local parent = if args.ref then self.registry:resolve(args.ref) else root
	if self.registry:rootOf(parent) ~= args.root then V.fail("GRANT", "Parent is outside the requested root.") end
	local limit = if args.limit == nil then 100 else V.integer(args.limit, 1, 200, "limit")
	local children = parent:GetChildren()
	local items = V.array({})
	for index = 1, math.min(limit, #children) do table.insert(items, self.registry:node(children[index])) end
	return {parentRef = self.registry:ref(parent), items = items, truncated = #children > limit}
end

-- Primary API docs verified 2026-10-14:
-- https://create.roblox.com/docs/reference/engine/classes/DataModel (CreatorType/CreatorId/PlaceId/GameId)
-- https://create.roblox.com/docs/reference/engine/enums/CreatorType
-- https://create.roblox.com/docs/reference/engine/classes/StudioService#GetUserId (anonymous = 0)
-- https://create.roblox.com/docs/reference/engine/classes/StudioTestService#EditModeActive
-- Registry owns the actual granted service and GUID; no caller path or inferred ID.
function Operations:importContext(args: any): any
	V.fields(args, {}, "import-context arguments")
	local workspace = self.registry:root("Workspace")
	local gameModel = self.registry.gameModel
	local function snapshot(): any
		local ok, value = pcall(function(): any
			local creatorType = gameModel.CreatorType
			return {placeId = V.integer(gameModel.PlaceId, 0, 9007199254740991, "place ID"),
				universeId = V.integer(gameModel.GameId, 0, 9007199254740991, "universe ID"),
				creatorId = V.integer(gameModel.CreatorId, 0, 9007199254740991, "creator ID"),
				creatorKind = if creatorType == Enum.CreatorType.User then "user"
					else if creatorType == Enum.CreatorType.Group then "group" else V.NULL,
				edit = V.boolean(gameModel:GetService("StudioTestService").EditModeActive, "Studio edit state")}
		end)
		if not ok then V.fail("CONTEXT_UNAVAILABLE", "Studio import identity or mode could not be observed exactly.") end
		return value
	end
	local before = snapshot()
	local creator: any = {status = "unavailable", kind = V.NULL, id = before.creatorId, provenance = "game.CreatorType/CreatorId"}
	if before.creatorId > 0 and before.creatorKind ~= V.NULL then
		creator.status, creator.kind = "available", before.creatorKind
	end
	local studioUser: any = {status = "not_applicable", id = V.NULL, provenance = "StudioService:GetUserId"}
	-- Even a template/nonzero partial identity must never use the Studio user.
	if before.placeId == 0 and before.universeId == 0 and before.creatorId == 0 then
		studioUser.status = "unavailable"
		local ok, userId = pcall(function(): number
			return V.integer(gameModel:GetService("StudioService"):GetUserId(), 1, 9007199254740991, "Studio user ID")
		end)
		if ok then studioUser.status, studioUser.id = "available", userId end
	end
	local after = snapshot()
	if not V.equal(before, after) then V.fail("CONTEXT_CHANGED", "Studio identity or mode changed during observation; request fresh context.") end
	if workspace.Parent ~= gameModel or workspace.ClassName ~= "Workspace" then V.fail("REF", "The granted Workspace is unavailable.") end
	return {sessionId = self.registry.sessionId, root = "Workspace", parentRef = self.registry:ref(workspace),
		placeId = after.placeId, universeId = after.universeId, mode = if after.edit then "Edit" else "Play",
		modeProvenance = "StudioTestService.EditModeActive", creator = creator, studioUser = studioUser}
end

-- Separate uploader read: published place owner/group is NOT the active Studio
-- account. This observes identity only and never certifies upload permissions.
function Operations:uploadContext(args: any): any
	V.fields(args, {}, "upload-context arguments")
	local before = self:importContext({})
	local function uploader(): any
		local ok, userId = pcall(function(): number
			return V.integer(self.gameModel:GetService("StudioService"):GetUserId(), 1, 9007199254740991, "Studio uploader ID")
		end)
		return if ok then {status = "available", id = userId, provenance = "StudioService:GetUserId"}
			else {status = "unavailable", id = V.NULL, provenance = "StudioService:GetUserId"}
	end
	local first = uploader()
	local after = self:importContext({})
	local second = uploader()
	if not V.equal(before, after) or not V.equal(first, second) then V.fail("CONTEXT_CHANGED", "Place or uploader changed during upload context observation.") end
	after.uploader = second
	return after
end

function Operations:search(args: any): any
	V.fields(args, {"root", "query", "className", "limit"}, "search arguments")
	local root = self.registry:root(args.root)
	-- className is one engine class name matched with IsA; a name query is optional only alongside it.
	local className = if args.className == nil then nil else V.string(args.className, "class name", 64)
	if className and not string.match(className, "^%u[%w]*$") then V.fail("INPUT", "Invalid class name.") end
	local query = if args.query == nil and className then nil else string.lower(V.string(args.query, "query", 100))
	local limit = if args.limit == nil then 100 else V.integer(args.limit, 1, 200, "limit")
	local function matches(instance: any): boolean
		if query and not string.find(string.lower(instance.Name), query, 1, true) then return false end
		if className then
			local ok, isA = pcall(function(): boolean return instance:IsA(className) end)
			return ok and isA == true
		end
		return true
	end
	local queue: {any} = {root}
	local items = V.array({})
	local head, visited, omitted = 1, 0, false
	while head <= #queue and visited < 5000 do
		local instance = queue[head]
		head += 1
		visited += 1
		if matches(instance) then
			if #items == limit then return {items = items, truncated = true} end
			table.insert(items, self.registry:node(instance))
		end
		for _, child in ipairs(instance:GetChildren()) do
			if #queue < 5000 then table.insert(queue, child) else omitted = true; break end
		end
	end
	return {items = items, truncated = omitted or head <= #queue}
end

-- Studio Output reader. A bounded ring per pairing, seeded from LogService history on first read and then fed by
-- MessageOut. Every line gets a sequence number, so `after` is an exact cursor; `gap` reports lines evicted past it.
-- Output text is place-wide, untrusted data: it is clipped and returned, never interpreted.
Operations.OUTPUT_LIMITS = table.freeze({buffer = 500, entries = 100, messageBytes = 1024, queryBytes = 100, cursor = 2147483647})
local OUTPUT_LEVELS: any = table.freeze({MessageOutput = "output", MessageInfo = "info", MessageWarning = "warning", MessageError = "error"})
local OUTPUT_LEVEL_NAMES = table.freeze({"output", "info", "warning", "error"})

local function outputLevel(messageType: any): string?
	local ok, name = pcall(function(): any return messageType.Name end)
	return if ok and type(name) == "string" then OUTPUT_LEVELS[name] else nil
end

-- Clip on a UTF-8 boundary; invalid bytes and NULs are replaced, never forwarded.
local function clipOutput(value: any, maximum: number): (string, boolean)
	local text = if type(value) == "string" then value else ""
	if utf8.len(text) == nil then text = string.gsub(text, "[\128-\255]", "?") end
	text = string.gsub(text, "%z", "?")
	if #text <= maximum then return text, false end
	local cut = maximum
	while cut > 0 and utf8.len(string.sub(text, 1, cut)) == nil do cut -= 1 end
	return string.sub(text, 1, cut), true
end

function Operations:outputLog(): any
	if self.output then return self.output end
	local limits = Operations.OUTPUT_LIMITS
	local log: any = {entries = {}, nextSeq = 1, evicted = 0, connection = nil}
	local function push(message: any, messageType: any): ()
		local level = outputLevel(messageType)
		if not level then return end
		local text, truncated = clipOutput(message, limits.messageBytes)
		table.insert(log.entries, {seq = log.nextSeq, level = level, message = text, truncated = truncated})
		log.nextSeq += 1
		if #log.entries > limits.buffer then log.evicted = table.remove(log.entries, 1).seq end
	end
	local service = self.gameModel:GetService("LogService")
	local ok, history = pcall(function(): any return service:GetLogHistory() end)
	if ok and type(history) == "table" then
		-- Only the newest buffer-full is kept; older history still consumes sequence numbers so gap is exact.
		local skip = math.max(0, #history - limits.buffer)
		log.nextSeq += skip
		log.evicted = skip
		for index = skip + 1, #history do
			local item = history[index]
			if type(item) == "table" then push(item.message, item.messageType) end
		end
	end
	pcall(function() log.connection = service.MessageOut:Connect(push) end)
	self.output = log
	return log
end

function Operations:stopOutput(): ()
	local log: any = self.output
	self.output = nil
	if log and log.connection then pcall(function() log.connection:Disconnect() end) end
end

function Operations:readOutput(args: any): any
	V.fields(args, {"levels", "query", "after", "limit"}, "output arguments")
	local limits = Operations.OUTPUT_LIMITS
	local levels: {[string]: boolean}? = nil
	if args.levels ~= nil then
		if type(args.levels) ~= "table" or #args.levels < 1 or #args.levels > #OUTPUT_LEVEL_NAMES then V.fail("INPUT", "Invalid output levels.") end
		local seen: {[string]: boolean} = {}
		for _, level: any in ipairs(args.levels) do
			if type(level) ~= "string" or not table.find(OUTPUT_LEVEL_NAMES, level) or seen[level] then V.fail("INPUT", "Invalid output levels.") end
			seen[level] = true
		end
		levels = seen
	end
	local query = if args.query == nil then nil else string.lower(V.string(args.query, "output query", limits.queryBytes))
	if query and string.find(query, "[%c]") then V.fail("INPUT", "Output query must be one line.") end
	local after = if args.after == nil then 0 else V.integer(args.after, 0, limits.cursor, "output cursor")
	local limit = if args.limit == nil then 50 else V.integer(args.limit, 1, limits.entries, "limit")
	local log: any = self:outputLog()
	local matched: {any} = {}
	for _, entry: any in ipairs(log.entries) do
		if entry.seq > after and (not levels or levels[entry.level])
			and (not query or string.find(string.lower(entry.message), query, 1, true)) then
			table.insert(matched, entry)
		end
	end
	-- Newest lines win: an agent checks what just happened; omitted counts older matches left out.
	local first = math.max(1, #matched - limit + 1)
	local entries = V.array({})
	for index = first, #matched do
		local entry: any = matched[index]
		local line: any = {seq = entry.seq, level = entry.level, message = entry.message}
		if entry.truncated then line.truncated = true end
		table.insert(entries, line)
	end
	return {entries = entries, latest = log.nextSeq - 1, omitted = first - 1, gap = after < log.evicted}
end

-- Content discovery reads editor text. Matches never authorize an update:
-- script.read must supply its exact current baseline before editing.
function Operations:searchScripts(args: any, guard: () -> ()): any
	V.fields(args, {"root", "ref", "query", "limit", "caseSensitive"}, "script search arguments")
	local root = self.registry:root(args.root)
	local parent = if args.ref ~= nil then self.registry:resolve(args.ref) else root
	local function scope(instance: any): ()
		guard()
		if self.registry:rootOf(parent) ~= args.root or self.registry:rootOf(instance) ~= args.root
			or (instance ~= parent and not instance:IsDescendantOf(parent)) then V.fail("GRANT", "Search scope changed.") end
	end
	scope(parent)
	local query = V.string(args.query, "query", 256)
	if string.find(query, "[%c]") then V.fail("INPUT", "Use a literal single-line query.") end
	if args.caseSensitive ~= nil and type(args.caseSensitive) ~= "boolean" then V.fail("INPUT", "caseSensitive must be a boolean.") end
	local sensitive = args.caseSensitive ~= false
	local needle = if sensitive then query else string.lower(query)
	local limit = if args.limit == nil then 50 else V.integer(args.limit, 1, 100, "limit")
	local items, reasons = V.array({}), V.array({})
	local queue: {any} = {parent}
	local head, nodes, scripts, sourceBytes, skipped, resultBytes = 1, 0, 0, 0, 0, 0
	local function incomplete(reason: string): ()
		if not table.find(reasons, reason) then table.insert(reasons, reason) end
	end
	local stopped = false
	while head <= #queue and not stopped do
		local instance = queue[head]
		head += 1
		scope(instance)
		if nodes == 5000 then incomplete("nodes"); break end
		nodes += 1
		if instance:IsA("LuaSourceContainer") then
			if scripts == 128 then incomplete("scripts"); break end
			scripts += 1
			local ok, source = pcall(function(): string return self:source(instance) end)
			scope(instance) -- Grant loss or reparenting is not an unreadable-source skip.
			if not ok then skipped += 1; incomplete("unreadable-source")
			elseif sourceBytes + #source > 2 * 1024 * 1024 then incomplete("source-bytes"); break
			else
				sourceBytes += #source
				local start, lineNumber = 1, 1
				while start <= #source do
					local newline = string.find(source, "\n", start, true)
					local last = if newline then newline - 1 else #source
					if string.sub(source, last, last) == "\r" then last -= 1 end
					local line = string.sub(source, start, last)
					local column = string.find(if sensitive then line else string.lower(line), needle, 1, true)
					if column then
						if #items == limit then incomplete("matches"); stopped = true; break end
						local first = utf8.offset(line, 0, math.max(1, column - 64)) :: number
						local finish = utf8.offset(line, 0, math.min(#line + 1, first + 512)) :: number
						local item = self.registry:node(instance)
						item.line, item.column = lineNumber, column
						item.excerpt, item.excerptStartColumn = string.sub(line, first, finish - 1), first
						item.excerptTruncated = first > 1 or finish <= #line
						local size = #V.encode(item, self.http)
						if resultBytes + size > 256 * 1024 then incomplete("result-bytes"); stopped = true; break end
						resultBytes += size
						table.insert(items, item)
					end
					if not newline then break end
					start, lineNumber = newline + 1, lineNumber + 1
				end
			end
		end
		if not stopped then
			for _, child in ipairs(instance:GetChildren()) do
				if #queue < 5000 then table.insert(queue, child) else incomplete("nodes"); break end
			end
		end
	end
	scope(parent)
	return {parentRef = self.registry:ref(parent), items = items, truncated = #reasons > 0, reasons = reasons,
		nodesVisited = nodes, scriptsRead = scripts - skipped, skippedScripts = skipped, sourceBytes = sourceBytes,
		literal = true, caseSensitive = sensitive, sourceKind = "editor", columnEncoding = "utf8-bytes", atomicSnapshot = false}
end


-- Expand a constraint's maximum before moving its minimum, then contract to the requested maximum.
-- This also handles mixed-axis changes that neither simple min-first nor max-first ordering permits.
local function assignGui(instance: any, decoded: any): ()
	local vectorBounds = instance.ClassName == "UISizeConstraint" and decoded.MinSize ~= nil
	local textBounds = instance.ClassName == "UITextSizeConstraint" and decoded.MinTextSize ~= nil
	if vectorBounds then
		instance.MaxSize = Vector2.new(math.max(instance.MaxSize.X, decoded.MaxSize.X), math.max(instance.MaxSize.Y, decoded.MaxSize.Y))
		instance.MinSize, instance.MaxSize = decoded.MinSize, decoded.MaxSize
	elseif textBounds then
		instance.MaxTextSize = math.max(instance.MaxTextSize, decoded.MaxTextSize)
		instance.MinTextSize, instance.MaxTextSize = decoded.MinTextSize, decoded.MaxTextSize
	end
	local names = {}; for name in pairs(decoded) do table.insert(names, name) end; table.sort(names)
	for _, name in ipairs(names) do
		if not (vectorBounds and (name == "MinSize" or name == "MaxSize")) and not (textBounds and (name == "MinTextSize" or name == "MaxTextSize")) then instance[name] = decoded[name] end
	end
end

function Operations:updateGuiProperties(command: any, args: any, instance: any, guard: () -> (), restoring: boolean?): any
	local className = instance.ClassName
	V.object(args.properties, "GUI properties"); V.object(args.expected, "GUI baseline")
	local names, gui, decoded = {}, {}, {}
	for name, value in pairs(args.properties) do
		if #names >= V.MAX_PROPERTIES then V.fail("INPUT", "Too many GUI properties.") end
		if name ~= "Name" and LegacyProperties.GUI_SPECS[className][name] == nil then V.fail("PROPERTY", "Property is not writable for this GUI class.") end
		table.insert(names, name)
		if restoring then
			if name ~= "Font" or args.properties.FontFace == nil then decoded[name] = LegacyProperties.restoreGuiValue(className, name, value) end
		elseif name == "Name" then decoded.Name = V.string(value, "name", 100)
		else gui[name] = value end
	end
	if #names == 0 then V.fail("INPUT", "Choose at least one GUI property to update.") end
	table.sort(names)
	if not restoring then
		for name, value in pairs(LegacyProperties.decodeEffects(className, gui, function(): any return V.fail("PROPERTY", "GUI properties take no references.") end)) do decoded[name] = value end
	end
	local baselineSet = {}; for _, name in ipairs(names) do baselineSet[name] = true end
	if args.properties.Font ~= nil or args.properties.FontFace ~= nil then baselineSet.Font, baselineSet.FontFace = true, true end
	if className == "UISizeConstraint" and (args.properties.MinSize ~= nil or args.properties.MaxSize ~= nil) then baselineSet.MinSize, baselineSet.MaxSize = true, true end
	if className == "UITextSizeConstraint" and (args.properties.MinTextSize ~= nil or args.properties.MaxTextSize ~= nil) then baselineSet.MinTextSize, baselineSet.MaxTextSize = true, true end
	local baselineNames = {}; for name in pairs(baselineSet) do table.insert(baselineNames, name) end; table.sort(baselineNames)
	local count = 0
	for name in pairs(args.expected) do
		if not baselineSet[name] then V.fail("INPUT", "Expected properties must cover changed and linked GUI values.") end
		count += 1
	end
	if count ~= #baselineNames then V.fail("INPUT", "Expected properties must cover changed and linked GUI values.") end
	if not V.equal(LegacyProperties.snapshotGui(instance, baselineNames), args.expected) then V.fail("CONFLICT", "GUI properties differ from the observed baseline.") end
	local retained, allowed = {}, {}
	for _, name in ipairs(names) do
		allowed[name] = true
		retained[name] = true
	end
	if decoded.Font ~= nil or decoded.FontFace ~= nil then retained.Font, retained.FontFace, allowed.Font, allowed.FontFace = true, true, true, true end
	if className == "UISizeConstraint" and (decoded.MinSize ~= nil or decoded.MaxSize ~= nil) then
		decoded.MinSize, decoded.MaxSize = decoded.MinSize or instance.MinSize, decoded.MaxSize or instance.MaxSize
		retained.MinSize, retained.MaxSize, allowed.MinSize, allowed.MaxSize = true, true, true, true
	elseif className == "UITextSizeConstraint" and (decoded.MinTextSize ~= nil or decoded.MaxTextSize ~= nil) then
		decoded.MinTextSize, decoded.MaxTextSize = decoded.MinTextSize or instance.MinTextSize, decoded.MaxTextSize or instance.MaxTextSize
		retained.MinTextSize, retained.MaxTextSize, allowed.MinTextSize, allowed.MaxTextSize = true, true, true, true
	end
	LegacyProperties.crossCheck(className, decoded)
	local receiptNames = {}; for name in pairs(retained) do table.insert(receiptNames, name) end; table.sort(receiptNames)
	local ref, ownership = self.registry:ref(instance), P.captureOwnership(instance, self.collection)
	local before = V.immutable(LegacyProperties.snapshotGui(instance, receiptNames))
	local unchanged = {}; for name, value in pairs(ownership.properties) do if not allowed[name] then unchanged[name] = value end end
	local collateral = {properties = unchanged, attributes = ownership.attributes, tags = ownership.tags}
	return self:record(command, guard, function(progress: any): any
		guard(); self.registry:resolve(ref)
		if not P.ownershipMatches(instance, self.collection, ownership) then V.fail("CONFLICT", "GUI properties changed before the write.") end
		progress.ref = ref
		local applied, applyError = pcall(function()
			progress.touched = true
			assignGui(instance, decoded)
			for name, value in pairs(decoded) do
				if name == "Name" then
					if instance.Name ~= value then V.fail("VERIFY", "GUI name differs after assignment.") end
				elseif not LegacyProperties.effectMatches(instance, className, name, value) then V.fail("VERIFY", "GUI property differs after assignment.") end
			end
			if not P.ownershipMatches(instance, self.collection, collateral) then V.fail("VERIFY", "An unrelated managed GUI value changed during assignment.") end
		end)
		if not applied then
			local original = {}; for name, value in pairs(before) do
				if name ~= "Font" or before.FontFace == nil then original[name] = LegacyProperties.restoreGuiValue(className, name, value) end
			end
			pcall(function() assignGui(instance, original) end)
			if P.ownershipMatches(instance, self.collection, ownership) then progress.touched = false end
			V.fail("VERIFY", "GUI assignment could not be verified: " .. V.safeError(applyError))
		end
		return {ref = self.registry:ref(instance), mutation = {kind = "scene.update", ref = ref,
			before = {properties = before}, after = {properties = LegacyProperties.snapshotGui(instance, receiptNames)}}}
	end)
end

function Operations:updateProperties(command: any, args: any, guard: () -> (), restoring: boolean?): any
	V.fields(args, {"ref", "expected", "properties"}, "update arguments")
	local instance = self.registry:resolve(args.ref)
	if LegacyProperties.GUI_SPECS[instance.ClassName] then return self:updateGuiProperties(command, args, instance, guard, restoring) end
	local decoded, names = P.validate(instance, args.properties, self.registry:isService(instance))
	if #names == 0 then V.fail("INPUT", "Choose at least one property to update.") end
	P.validate(instance, args.expected, self.registry:isService(instance))
	for key in pairs(args.expected) do if not table.find(names, key) then V.fail("INPUT", "Expected properties must exactly cover the changed properties.") end end
	if not P.compare(instance, args.expected, names) then V.fail("CONFLICT", "Properties differ from the expected baseline.") end
	local ref = self.registry:ref(instance)
	local before = V.immutable(P.snapshot(instance, names))
	return self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(ref)
		if not P.compare(instance, args.expected, names) then V.fail("CONFLICT", "Properties changed before the write.") end
		progress.ref = ref
		local original, observable = {}, P.snapshot(instance)
		for _, name in ipairs(names) do original[name] = instance[name] end
		for _, name in ipairs(names) do
			progress.touched = true
			instance[name] = decoded[name]
		end
		for _, name in ipairs(names) do
			if not P.assignedMatches(instance, name, decoded[name]) then
				-- The engine coerced a value. Synchronously restore the exact engine
				-- baseline; only a fully verified revert is a clean, untouched failure.
				local reverted = pcall(function()
					for _, restoring in ipairs(names) do instance[restoring] = original[restoring] end
				end)
				if reverted then
					local matches = true
					for _, restoring in ipairs(names) do if instance[restoring] ~= original[restoring] then matches = false end end
					if matches and V.equal(P.snapshot(instance), observable) then progress.touched = false end
				end
				V.fail("VERIFY", "Property write did not match the requested value.")
			end
		end
		return {ref = self.registry:ref(instance), mutation = {kind = "scene.update", ref = ref,
			before = {properties = before}, after = {properties = P.snapshot(instance, names)}}}
	end)
end

function Operations:updateSource(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"ref", "expectedSource", "source"}, "source arguments")
	local instance = self.registry:resolve(args.ref)
	local expected = V.string(args.expectedSource, "expected source", V.SOURCE_BYTES, true)
	local source = V.string(args.source, "source", V.SOURCE_BYTES, true)
	if self:source(instance) ~= expected then V.fail("CONFLICT", "Editor source differs from the expected baseline.") end
	local ref = self.registry:ref(instance)
	local proposed = {ref = ref, mutation = {kind = "script.update", ref = ref, before = {source = expected}, after = {source = source}}}
	if #V.encode(proposed, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Source receipt would exceed 512 KiB; no change attempted.") end
	return self:record(command, guard, function(progress: any): any
		local conflict = false
		self.editor:UpdateSourceAsync(instance, function(current: string): string?
			-- Roblox may invoke this callback again. Every invocation fences the
			-- session and compares the exact editor baseline; never yield here.
			guard()
			self.registry:resolve(ref)
			if current ~= expected then conflict = true end
			if conflict then return nil end
			progress.ref = ref
			progress.touched = true
			return source
		end)
		local observed = self:source(instance)
		if conflict then
			-- Once a callback proposed a write, keep the uncertainty flag sticky.
			V.fail("CONFLICT", "Editor changed during the source update.")
		end
		if observed ~= source then V.fail("VERIFY", "Editor source did not match after the update.") end
		return {ref = self.registry:ref(instance), mutation = {kind = "script.update", ref = ref,
			before = {source = expected}, after = {source = observed}}}
	end)
end

function Operations:setEnabled(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"ref", "expectedSource", "expectedEnabled", "enabled"}, "execution-state arguments")
	local instance = self.registry:resolve(args.ref)
	if not instance:IsA("BaseScript") then V.fail("CLASS", "Only Script and LocalScript have an execution state.") end
	local expected = V.string(args.expectedSource, "expected source", V.SOURCE_BYTES, true)
	if type(args.expectedEnabled) ~= "boolean" or type(args.enabled) ~= "boolean" then V.fail("INPUT", "Execution state and baseline must be booleans.") end
	if args.enabled and not string.find(expected, "%S") then V.fail("SOURCE_EMPTY", "An empty placeholder cannot be activated.") end
	local ref = self.registry:ref(instance)
	local function matches(): boolean
		return self:source(instance) == expected and not instance.Disabled == args.expectedEnabled
	end
	if not matches() then V.fail("CONFLICT", "Source or execution state differs from the exact baseline.") end
	-- The host compiles this exact source before delivery. A dirty editor buffer
	-- must not activate a different persisted implementation in the engine.
	if args.enabled and instance.Source ~= expected then V.fail("UNSAVED_SOURCE", "Persisted source differs from the verified editor source. Save the script first.") end
	local proposed = {ref = ref, mutation = {kind = "script.set_enabled", ref = ref,
		before = {source = expected, enabled = args.expectedEnabled}, after = {source = expected, enabled = args.enabled}}}
	if #V.encode(proposed, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Execution-state receipt would exceed 512 KiB; no change attempted.") end
	return self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(ref)
		if not matches() then V.fail("CONFLICT", "Source or execution state changed before activation.") end
		if args.enabled and instance.Source ~= expected then V.fail("UNSAVED_SOURCE", "Persisted source changed before activation.") end
		progress.ref = ref
		progress.touched = true
		instance.Disabled = not args.enabled
		if not instance.Disabled ~= args.enabled or self:source(instance) ~= expected or (args.enabled and instance.Source ~= expected) then V.fail("VERIFY", "Script execution state/source did not match after assignment.") end
		return {ref = self.registry:ref(instance), mutation = {kind = "script.set_enabled", ref = ref,
			before = {source = expected, enabled = args.expectedEnabled}, after = {source = expected, enabled = not instance.Disabled}}}
	end)
end

-- Effects classes: decode everything (including Attachment refs resolved by the Registry), allocate
-- detached, assign and verify every value, then parent once inside one undo recording.
function Operations:createEffect(command: any, args: any, guard: () -> ()): any
	local parent = self.registry:resolve(args.parent)
	local className = args.className
	local name = V.string(args.name, "name", 100)
	local host = LegacyProperties.hostKind(parent)
	if not host or not table.find(LegacyProperties.hostsOf(className), host) then V.fail("CLASS", className .. " must be created inside a " .. table.concat(LegacyProperties.hostsOf(className), " or ") .. ".") end
	if self.registry.count >= V.MAX_REFS then V.fail("CAPACITY", "Reference capacity reached; pair a new session.") end
	local decoded = LegacyProperties.decodeEffects(className, if args.properties == nil then {} else args.properties, function(tag: any, label: string, kind: string): any
		V.fields(tag, {"type", "ref"}, label)
		local target = self.registry:resolve(tag.ref)
		local wanted = LegacyProperties.REF_CLASSES[kind]
		if not target:IsA(wanted) then V.fail("PROPERTY", label .. " must name a " .. wanted .. ".") end
		return target
	end)
	return self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(args.parent)
		local instance = Instance.new(className)
		local prepared, prepareError = pcall(function()
			instance.Name = name
			LegacyProperties.applyEffect(instance, className, decoded)
			guard()
		end)
		if not prepared then instance:Destroy(); error(prepareError, 0) end
		progress.touched = true
		instance.Parent = parent
		local ref = self.registry:ref(instance)
		progress.ref = ref
		local snapshot = P.snapshot(instance)
		self.registry.owned[instance] = {parent = parent, properties = V.immutable(snapshot),
			attributes = V.immutable(instance:GetAttributes()), tags = V.immutable(self.collection:GetTags(instance)),
			typedOwnership = P.captureOwnership(instance, self.collection)}
		return {ref = ref, mutation = {kind = "scene.create", ref = ref, before = V.NULL, after = {properties = snapshot}}}
	end)
end

function Operations:create(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"parent", "className", "name", "properties"}, "create arguments")
	if LegacyProperties.specsOf(args.className) then return self:createEffect(command, args, guard) end
	local parent = self.registry:resolve(args.parent)
	if type(args.className) ~= "string" or not table.find(P.CLASSES, args.className) then V.fail("CLASS", "Class is not creatable.") end
	local name = V.string(args.name, "name", 100)
	local properties = if args.properties == nil then {} else args.properties
	if self.registry.count >= V.MAX_REFS then V.fail("CAPACITY", "Reference capacity reached; pair a new session.") end
	-- Decode the complete payload before allocating or parenting an Instance.
	V.object(properties, "properties")
	local decoded: {[string]: any} = {}
	local propertyCount = 0
	for key, value in pairs(properties) do
		propertyCount += 1
		if propertyCount > V.MAX_PROPERTIES then V.fail("INPUT", "Too many properties.") end
		if key == "Name" then V.fail("PROPERTY", "Use the create name field.") end
		decoded[key] = P.decode(key, value, table.find(V.BASE_PART_CLASSES, args.className) ~= nil,
			table.find(V.PART_SHAPE_CLASSES, args.className) ~= nil)
	end
	local instance: any = nil
	local result = self:record(command, guard, function(progress: any): any
		guard()
		self.registry:resolve(args.parent)
		instance = Instance.new(args.className)
		local prepared, prepareError = pcall(function()
			instance.Name = name
			if instance:IsA("BaseScript") then instance.Disabled = true end
			for key, value in pairs(decoded) do instance[key] = value end
			for key, value in pairs(decoded) do if not P.assignedMatches(instance, key, value) then V.fail("VERIFY", "Created property differs from the requested value.") end end
			guard()
		end)
		if not prepared then instance:Destroy(); error(prepareError, 0) end
		progress.touched = true
		instance.Parent = parent
		local ref = self.registry:ref(instance)
		progress.ref = ref
		local snapshot = P.snapshot(instance)
		local source = if instance:IsA("LuaSourceContainer") then self:source(instance) else nil
		self.registry.owned[instance] = {parent = parent, properties = V.immutable(snapshot), source = source,
			enabled = if instance:IsA("BaseScript") then not instance.Disabled else nil,
			attributes = V.immutable(instance:GetAttributes()), tags = V.immutable(self.collection:GetTags(instance))}
		return {ref = ref, mutation = {kind = "scene.create", ref = ref, before = V.NULL, after = {properties = snapshot}}}
	end)
	return result
end

-- Fixed assignment order: Shape before Size (a Ball constrains Size), rotation before position.
local BUILD_ORDER = table.freeze({"Shape", "Material", "Size", "Orientation", "Position", "Color", "Transparency", "Reflectance", "Anchored", "CanCollide", "CastShadow"})

function Operations:buildProperties(className: string, properties: any): {[string]: any}
	local values = if properties == nil then {} else properties
	V.object(values, "properties")
	local decoded: {[string]: any} = {}
	local count = 0
	for key, value in pairs(values) do
		count += 1
		if count > V.MAX_PROPERTIES then V.fail("INPUT", "Too many properties.") end
		if key == "Name" then V.fail("PROPERTY", "Use the item name field.") end
		decoded[key] = P.decode(key, value, true, table.find(V.PART_SHAPE_CLASSES, className) ~= nil)
	end
	return decoded
end

-- One scene.build effect item. Attachment refs become plan markers that must name an EARLIER
-- Attachment item of this build; they bind to the detached Instances before the root is parented.
function Operations:planEffect(item: any, index: number, name: string, into: number, host: string, effectHosts: {[number]: any}): any
	V.fields(item, {"kind", "className", "name", "parent", "properties", "key"}, "effect item")
	local className = item.className
	if type(className) ~= "string" or not LegacyProperties.EFFECT_SPECS[className] then V.fail("CLASS", "Unsupported effect class.") end
	if not table.find(LegacyProperties.EFFECT_HOSTS[className], host) then V.fail("INPUT", className .. " must be inside a " .. table.concat(LegacyProperties.EFFECT_HOSTS[className], " or ") .. " item.") end
	local decoded = LegacyProperties.decodeEffects(className, if item.properties == nil then {} else item.properties, function(tag: any, label: string, kind: string): any
		V.fields(tag, {"type", "item"}, label)
		local target = effectHosts[V.integer(tag.item, 1, math.max(1, index - 1), label)]
		if not target or target.kind ~= kind then V.fail("INPUT", LegacyProperties.REF_CLASSES[kind] .. " refs must name an earlier " .. LegacyProperties.REF_CLASSES[kind] .. " item of this build.") end
		return table.freeze({planIndex = target.plan})
	end)
	return {className = className, name = name, parent = into, effect = decoded}
end

local function buildTriple(value: any, low: number, high: number, label: string): {number}
	local list = V.list(value, 3, label)
	if #list ~= 3 then V.fail("INPUT", label .. " needs three numbers.") end
	for _, item in ipairs(list) do V.number(item, low, high, label) end
	return list
end

-- One atomic hierarchy: decode and plan everything, allocate detached, verify every
-- property, then parent the root once inside a single undo recording.
function Operations:build(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"parent", "container", "prototypes", "items", "templates"}, "build arguments")
	local L = V.BUILD_LIMITS
	local parent = self.registry:resolve(args.parent)
	local templates = if args.templates == nil then {} else AssetPlacement.buildTemplates(self, args.templates)
	local cloneExtra = 0 -- template descendants copied by clone items
	local rootSpec = V.fields(args.container, {"className", "name", "properties"}, "build container")
	-- A ScreenGui root builds a whole screen UI atomically under StarterGui (or a Model/Folder template holder).
	local guiRoot = rootSpec.className == "ScreenGui"
	if not guiRoot and rootSpec.className ~= "Model" and rootSpec.className ~= "Folder" then V.fail("CLASS", "The build root must be a Model, Folder or ScreenGui.") end
	local GUI_HOSTS = LegacyProperties.GUI_HOSTS
	local function noRefs(): any return V.fail("PROPERTY", "GUI classes take no references.") end
	local function guiProperties(className: string, values: any): {[string]: any}
		return LegacyProperties.decodeEffects(className, if values == nil then {} else values, noRefs)
	end
	local rootEffect: any = nil
	if guiRoot then
		local host = LegacyProperties.hostKind(parent)
		if not host or not table.find(GUI_HOSTS.ScreenGui, host) then V.fail("CLASS", "A ScreenGui build root must be built in StarterGui or a Model/Folder.") end
		rootEffect = guiProperties("ScreenGui", rootSpec.properties)
	elseif rootSpec.properties ~= nil then
		V.fail("INPUT", "Only a ScreenGui build root takes properties.")
	end
	local plan: {any} = {{className = rootSpec.className, name = V.string(rootSpec.name, "name", 100), parent = 0, effect = rootEffect}}
	local function add(entry: any): number
		table.insert(plan, entry)
		if #plan > L.instances then V.fail("BODY_LIMIT", "A build may create at most " .. L.instances .. " instances.") end
		return #plan
	end
	local prototypes: {any} = {}
	local rawPrototypes = if args.prototypes == nil then V.array({}) else args.prototypes
	for _, raw in ipairs(V.list(rawPrototypes, L.prototypes, "prototypes")) do
		if V.object(raw, "prototype").gui ~= nil then
			-- GUI prototype: element 1 is the root (parent 0); later elements name an earlier hosting element.
			local guiProto = V.fields(raw, {"name", "gui"}, "GUI prototype")
			V.string(guiProto.name, "prototype name", 100)
			local elements: {any} = {}
			for index, rawElement in ipairs(V.list(guiProto.gui, L.prototypeParts, "GUI prototype elements")) do
				local element = V.fields(rawElement, {"className", "name", "parent", "properties"}, "prototype element")
				local className = element.className
				if type(className) ~= "string" or not LegacyProperties.GUI_SPECS[className] then V.fail("CLASS", "Unsupported GUI prototype class.") end
				local parentIndex = if element.parent == nil then 0 else V.integer(element.parent, 0, index - 1, "element parent")
				if (index == 1) ~= (parentIndex == 0) then V.fail("INPUT", "The first element is the prototype root (parent 0); later elements name an earlier element.") end
				if index > 1 then
					local host = LegacyProperties.GUI_HOST_CLASSES[elements[parentIndex].className]
					if not host or not table.find(GUI_HOSTS[className], host) then V.fail("INPUT", className .. " cannot be inside " .. elements[parentIndex].className .. ".") end
				end
				table.insert(elements, {className = className, name = V.string(element.name, "element name", 100), parent = parentIndex,
					effect = guiProperties(className, element.properties)})
			end
			if #elements == 0 then V.fail("INPUT", "A GUI prototype needs at least one element.") end
			table.insert(prototypes, {gui = elements})
			continue
		end
		local proto = V.fields(raw, {"name", "weld", "parts"}, "prototype")
		V.string(proto.name, "prototype name", 100)
		local parts: {any} = {}
		for _, rawPart in ipairs(V.list(proto.parts, L.prototypeParts, "prototype parts")) do
			local part = V.fields(rawPart, {"className", "name", "properties", "tint"}, "prototype part")
			if type(part.className) ~= "string" or not table.find(V.BUILD_PART_CLASSES, part.className) then V.fail("CLASS", "Unsupported build part class.") end
			table.insert(parts, {className = part.className, name = V.string(part.name, "part name", 100),
				properties = self:buildProperties(part.className, part.properties), tint = V.boolean(part.tint, "tint")})
		end
		if #parts == 0 then V.fail("INPUT", "A prototype needs at least one part.") end
		table.insert(prototypes, {weld = V.boolean(proto.weld, "weld"), parts = parts})
	end
	local items = V.list(args.items, L.items, "build items")
	if #items == 0 then V.fail("INPUT", "A build needs at least one item.") end
	local containers: {[number]: number} = {}
	local effectHosts: {[number]: any} = {} -- part items and Attachment effect items: {plan, kind}
	local keyed: {any} = {}
	local keys: {[string]: boolean} = {}
	for index, raw in ipairs(items) do
		local item = V.object(raw, "build item")
		local parentIndex = V.integer(item.parent, 0, index - 1, "item parent")
		local into = if parentIndex == 0 then 1 else containers[parentIndex]
		local nested = item.kind == "effect" or item.kind == "gui" or item.kind == "stamp"
		if not into and nested and effectHosts[parentIndex] then into = effectHosts[parentIndex].plan end
		if not into then V.fail("INPUT", "Only group items can contain other items.") end
		if guiRoot and parentIndex == 0 and item.kind ~= "gui" and item.kind ~= "stamp" then V.fail("INPUT", "A ScreenGui build root holds only gui and stamp items.") end
		local hostOf = if parentIndex == 0 then (if guiRoot then "layer" else "group") elseif containers[parentIndex] then "group" else effectHosts[parentIndex].kind
		local name = V.string(item.name, "item name", 100)
		local created: number
		if item.kind == "gui" then
			V.fields(item, {"kind", "className", "name", "parent", "properties", "key"}, "gui item")
			local className = item.className
			if type(className) ~= "string" or not LegacyProperties.GUI_SPECS[className] then V.fail("CLASS", "Unsupported GUI class.") end
			if not table.find(GUI_HOSTS[className], hostOf) then V.fail("INPUT", className .. " must be inside a " .. table.concat(GUI_HOSTS[className], " or ") .. " item.") end
			created = add({className = className, name = name, parent = into, effect = guiProperties(className, item.properties)})
			local provides = LegacyProperties.GUI_HOST_CLASSES[className]
			if provides then effectHosts[index] = {plan = created, kind = provides} end
		elseif item.kind == "stamp" then
			-- One copy of a GUI prototype; properties override the prototype root's own properties.
			V.fields(item, {"kind", "template", "name", "parent", "properties", "key"}, "stamp item")
			local proto = prototypes[V.integer(item.template, 1, math.max(1, #prototypes), "prototype index")]
			if not proto or not proto.gui then V.fail("INPUT", "A stamp names an unknown GUI prototype.") end
			local root = proto.gui[1]
			if not table.find(GUI_HOSTS[root.className], hostOf) then V.fail("INPUT", root.className .. " must be inside a " .. table.concat(GUI_HOSTS[root.className], " or ") .. " item.") end
			local merged, count = table.clone(root.effect), 0
			for key, value in pairs(guiProperties(root.className, item.properties)) do merged[key] = value end
			for _ in pairs(merged) do count += 1 end
			if count > LegacyProperties.EFFECT_LIMITS.properties then V.fail("INPUT", "Too many properties on the stamped prototype root.") end
			LegacyProperties.crossCheck(root.className, merged)
			local planned: {number} = {}
			for elementIndex, element in ipairs(proto.gui) do
				local first = elementIndex == 1
				planned[elementIndex] = add({className = element.className, name = if first then name else element.name,
					parent = if first then into else planned[element.parent], effect = if first then merged else element.effect})
			end
			created = planned[1]
			local provides = LegacyProperties.GUI_HOST_CLASSES[root.className]
			if provides then effectHosts[index] = {plan = created, kind = provides} end
		elseif item.kind == "group" then
			V.fields(item, {"kind", "className", "name", "parent", "key"}, "group item")
			if item.className ~= "Model" and item.className ~= "Folder" then V.fail("CLASS", "Group items must be Model or Folder.") end
			created = add({className = item.className, name = name, parent = into})
			containers[index] = created
		elseif item.kind == "part" then
			V.fields(item, {"kind", "className", "name", "parent", "properties", "key"}, "part item")
			if type(item.className) ~= "string" or not table.find(V.BUILD_PART_CLASSES, item.className) then V.fail("CLASS", "Unsupported build part class.") end
			created = add({className = item.className, name = name, parent = into, properties = self:buildProperties(item.className, item.properties)})
			effectHosts[index] = {plan = created, kind = "part"}
		elseif item.kind == "effect" then
			created = add(self:planEffect(item, index, name, into, hostOf, effectHosts))
			local provides = LegacyProperties.EFFECT_HOST_CLASSES[item.className]
			if provides then effectHosts[index] = {plan = created, kind = provides} end
		elseif item.kind == "place" then
			V.fields(item, {"kind", "template", "name", "parent", "at", "yaw", "scale", "tint", "ground", "key"}, "placement")
			local proto = prototypes[V.integer(item.template, 1, math.max(1, #prototypes), "prototype index")]
			if not proto then V.fail("INPUT", "Placement names an unknown prototype.") end
			if proto.gui then V.fail("INPUT", "GUI prototypes are stamped (kind stamp), not placed.") end
			local at = table.clone(buildTriple(item.at, -100000, 100000, "placement position"))
			if item.ground ~= nil and V.boolean(item.ground, "placement ground") then
				-- Read-only probe of existing terrain/parts; nothing from this build is parented yet.
				local hit = self.registry:root("Workspace"):Raycast(Vector3.new(at[1], at[2] + 500, at[3]), Vector3.new(0, -1000, 0))
				if hit then at[2] = hit.Position.Y end
			end
			local yaw = V.number(item.yaw, -360, 360, "placement yaw")
			local scale = V.number(item.scale, 0.1, 20, "placement scale")
			local tint = if item.tint == nil or item.tint == V.NULL then nil else buildTriple(item.tint, 0, 2, "placement tint")
			local radians = math.rad(yaw)
			local c, s = math.cos(radians), math.sin(radians)
			local single = #proto.parts == 1
			local holder = into
			if not single then created = add({className = "Model", name = name, parent = into}); holder = created end
			local first: number? = nil
			for _, part in ipairs(proto.parts) do
				local properties = table.clone(part.properties)
				local size = properties.Size
				if size then
					local x, y, z = size.X * scale, size.Y * scale, size.Z * scale
					if math.min(x, y, z) < 0.05 or math.max(x, y, z) > 2048 then V.fail("PROPERTY", "A scaled prototype part must stay 0.05..2048 studs.") end
					properties.Size = Vector3.new(x, y, z)
				end
				local rel = properties.Position or Vector3.new(0, 0, 0)
				local rx, ry, rz = rel.X * scale, rel.Y * scale, rel.Z * scale
				local px, py, pz = at[1] + rx * c + rz * s, at[2] + ry, at[3] - rx * s + rz * c
				if math.max(math.abs(px), math.abs(py), math.abs(pz)) > 100000 then V.fail("PROPERTY", "A placed part must stay within 100000 studs.") end
				properties.Position = Vector3.new(px, py, pz)
				local o = properties.Orientation or Vector3.new(0, 0, 0)
				properties.Orientation = Vector3.new(o.X, (o.Y + yaw + 180) % 360 - 180, o.Z)
				local color = properties.Color
				if tint and part.tint and color then
					properties.Color = Color3.new(math.clamp(color.R * tint[1], 0, 1), math.clamp(color.G * tint[2], 0, 1), math.clamp(color.B * tint[3], 0, 1))
				end
				local partIndex = add({className = part.className, name = if single then name else part.name, parent = holder, properties = properties})
				if single then created = partIndex end
				if not first then first = partIndex
				elseif proto.weld then add({className = "WeldConstraint", name = "Weld", parent = partIndex, part0 = first, part1 = partIndex}) end
			end
			if not single then plan[created].primary = first end
		elseif item.kind == "clone" then
			created = add(AssetPlacement.planClone(self, item, name, into, templates))
			cloneExtra += plan[created].extra
			if #plan + cloneExtra > L.instances then V.fail("BODY_LIMIT", "A build may create at most " .. L.instances .. " instances, counting cloned template contents.") end
		else
			V.fail("INPUT", "Item kind must be group, part, effect, gui, stamp, place or clone.")
		end
		if item.key ~= nil then
			local key = V.string(item.key, "item key", 64)
			if not string.match(key, "^[%w_%-]+$") or keys[key] then V.fail("INPUT", "Item keys must be unique [A-Za-z0-9_-].") end
			keys[key] = true
			table.insert(keyed, {key = key, index = created})
			if #keyed > L.keys then V.fail("INPUT", "Too many keyed items.") end
		end
	end
	if self.registry.count + #keyed + 1 > V.MAX_REFS then V.fail("CAPACITY", "Reference capacity reached; pair a new session.") end
	-- Detached construction runs BEFORE the undo recording opens: nothing here is in the place,
	-- so cooperative yields cannot leak a concurrent user edit into Arcane's undo step, and a
	-- guard after every yield re-checks session, lease and Edit mode before any further work.
	guard()
	local instances: {any} = table.create(#plan)
	local snapshots: {any} = table.create(#plan)
	local fieldsByClass: {[string]: {string}} = {}
	local slice = self:slicer(guard)
	local function resolveMarker(marker: any): any return instances[marker.planIndex] end
	local prepared, prepareError = pcall(function()
		for index, entry in ipairs(plan) do
			local instance = if entry.clone then AssetPlacement.instantiate(entry) else Instance.new(entry.className)
			instances[index] = instance
			instance.Name = entry.name
			local properties = entry.properties
			if properties then
				for _, key in ipairs(BUILD_ORDER) do
					local value = properties[key]
					if value ~= nil then instance[key] = value end
				end
			end
			if entry.effect then LegacyProperties.applyEffect(instance, entry.className, entry.effect, resolveMarker) end
			if entry.part0 then
				local part0, part1 = instances[entry.part0], instances[entry.part1]
				instance.Part0, instance.Part1 = part0, part1
				if instance.Part0 ~= part0 or instance.Part1 ~= part1 then V.fail("VERIFY", "Weld did not bind its parts.") end
			end
			if index > 1 then instance.Parent = instances[entry.parent] end
			-- One read per snapshot field. Every requested property is verified from that same
			-- read (exactly as P.assignedMatches would), and the reads become the restore snapshot.
			local fields = fieldsByClass[entry.className]
			if not fields then fields = P.snapshotFields(instance); fieldsByClass[entry.className] = fields end
			local snapshot: {[string]: any} = {}
			for _, field in ipairs(fields) do
				local value = instance[field]
				snapshot[field] = if value == nil then V.NULL else value
			end
			if properties then
				for _, key in ipairs(BUILD_ORDER) do
					local value = properties[key]
					if value ~= nil then
						local actual = snapshot[key]
						if actual == nil then actual = instance[key] end
						if not P.readMatches(instance, key, value, actual) then
							V.fail("VERIFY", "Built property differs from the requested value: " .. entry.name .. "." .. key)
						end
					end
				end
			end
			snapshots[index] = P.captureOwnership(instance, self.collection, table.freeze(snapshot))
			slice()
		end
		for index, entry in ipairs(plan) do
			if entry.primary then instances[index].PrimaryPart = instances[entry.primary] end
		end
		guard()
	end)
	local function discard(): ()
		-- Nothing was parented into the place; discard every detached allocation.
		for index = #instances, 1, -1 do pcall(function() instances[index]:Destroy() end) end
	end
	if not prepared then discard(); error(prepareError, 0) end
	local root, parented = instances[1], false
	-- The recording covers exactly one place change: parenting the verified root. No yield inside.
	local recorded, receipt = pcall(function(): any
		return self:record(command, guard, function(progress: any): any
			guard()
			if self.registry:resolve(args.parent) ~= parent then V.fail("CONFLICT", "The build parent changed during construction.") end
			progress.touched = true
			root.Parent = parent
			parented = true
			local ref = self.registry:ref(root)
			progress.ref = ref
			local parents, children, classes = table.create(#instances), table.create(#instances), {}
			for index, instance in ipairs(instances) do
				local entry = plan[index]
				parents[index] = if index == 1 then parent else instances[entry.parent]
				children[index] = #instance:GetChildren()
				classes[entry.className] = (classes[entry.className] or 0) + 1
			end
			self.registry.owned[root] = {parent = parent, build = {instances = instances, parents = parents, snapshots = snapshots, children = children}}
			local refs = {}
			for _, entry in ipairs(keyed) do refs[entry.key] = self.registry:ref(instances[entry.index]) end
			return {ref = ref, refs = refs, created = {count = #instances + cloneExtra, classes = classes},
				mutation = {kind = "scene.build", ref = ref, before = V.NULL, after = {count = #instances + cloneExtra, classes = classes}}}
		end)
	end)
	if not recorded then
		if not parented then discard() end
		error(receipt, 0)
	end
	return receipt
end

local TERRAIN_MATERIALS = table.freeze({"Air", "Grass", "LeafyGrass", "Ground", "Mud", "Rock", "Slate", "Sand", "Sandstone", "Limestone", "Basalt", "Granite", "Pebble",
	"Snow", "Ice", "Glacier", "Salt", "Cobblestone", "Asphalt", "Concrete", "Brick", "WoodPlanks", "CrackedLava", "Water"})
local ENVIRONMENT_SECTIONS = table.freeze({
	{key = "lighting", props = {ClockTime = {0, 24}, Brightness = {0, 10}, ExposureCompensation = {-3, 3}, EnvironmentDiffuseScale = {0, 1}, EnvironmentSpecularScale = {0, 1},
		ShadowSoftness = {0, 1}, FogStart = {0, 100000}, FogEnd = {0, 100000}, Ambient = "color", OutdoorAmbient = "color", ColorShift_Top = "color", FogColor = "color", GlobalShadows = "boolean"}},
	{key = "atmosphere", className = "Atmosphere", props = {Density = {0, 1}, Offset = {0, 1}, Haze = {0, 10}, Glare = {0, 10}, Color = "color", Decay = "color"}},
	{key = "bloom", className = "BloomEffect", props = {Intensity = {0, 2}, Size = {0, 56}, Threshold = {0, 4}}},
	{key = "colorCorrection", className = "ColorCorrectionEffect", props = {Brightness = {-1, 1}, Contrast = {-1, 1}, Saturation = {-1, 1}, TintColor = "color"}},
	{key = "sunRays", className = "SunRaysEffect", props = {Intensity = {0, 1}, Spread = {0, 1}}},
})

local function environmentValue(value: any, kind: any, label: string): any
	if kind == "boolean" then return V.boolean(value, label) end
	if kind == "color" then
		local rgb = buildTriple(value, 0, 1, label)
		return Color3.new(rgb[1], rgb[2], rgb[3])
	end
	return V.number(value, kind[1], kind[2], label)
end
local function environmentEncode(value: any): any
	if type(value) == "number" or type(value) == "boolean" then return value end
	return V.array({value.R, value.G, value.B})
end
local function environmentMatches(actual: any, expected: any): boolean
	if type(expected) == "boolean" then return actual == expected end
	if type(expected) == "number" then return type(actual) == "number" and math.abs(actual - expected) <= 0.001 end
	return math.abs(actual.R - expected.R) <= 0.002 and math.abs(actual.G - expected.G) <= 0.002 and math.abs(actual.B - expected.B) <= 0.002
end

-- Bounded terrain fills plus fixed Lighting/effect settings in one undo recording.
-- Lighting changes are verified and reverted on failure before any terrain write.
local TECHNOLOGIES = table.freeze({"Future", "ShadowMap", "Voxel", "Compatibility"})
local VARIANT_MAPS = table.freeze({"ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap"})
local function setVerified(target: any, property: string, value: any): boolean
	local ok, matches = pcall(function(): boolean
		target[property] = value
		local actual = target[property]
		if type(value) == "number" then return type(actual) == "number" and math.abs(actual - value) <= 0.001 end
		return actual == value
	end)
	return ok and matches
end

-- SoundService world-audio settings (environment.apply soundService); mirrored in studio-policy.ts SOUND_SERVICE_PROPERTIES.
local SOUND_SERVICE_PROPERTIES = table.freeze({
	AmbientReverb = {"enum", "ReverbType", {"NoReverb", "GenericReverb", "PaddedCell", "Room", "Bathroom", "LivingRoom", "StoneRoom", "Auditorium", "ConcertHall",
		"Cave", "Arena", "Hangar", "CarpetedHallway", "Hallway", "StoneCorridor", "Alley", "Forest", "City", "Mountains", "Quarry", "Plain", "ParkingLot", "SewerPipe", "UnderWater"}},
	DistanceFactor = {0.1, 100}, DopplerScale = {0, 10}, RolloffScale = {0, 10},
})

-- Effects-capability environment extras: Lighting.Technology, Terrain.Decoration, MaterialVariants and SoundService settings.
-- Everything is decoded before the recording; Studio settings it refuses fail with a precise manual step.
function Operations:environmentExtras(args: any): any
	local extras: any = {any = false}
	if args.technology ~= nil then
		extras.lighting = self.registry:root("Lighting")
		extras.technology = V.enum(args.technology, TECHNOLOGIES, Enum.Technology, "Lighting.Technology")
		extras.any, extras.subject = true, extras.lighting
	end
	if args.terrainDecoration ~= nil then
		local workspace = self.registry:root("Workspace")
		for _, child in ipairs(workspace:GetChildren()) do if child.ClassName == "Terrain" then extras.terrain = child end end
		if not extras.terrain then V.fail("TERRAIN", "Workspace has no Terrain object.") end
		extras.decoration = V.boolean(args.terrainDecoration, "terrainDecoration")
		extras.any, extras.subject = true, extras.subject or extras.terrain
	end
	if args.materials ~= nil then
		extras.subject = extras.subject or self.registry:root("Workspace")
		local service = self.gameModel:GetService("MaterialService")
		local names: {[string]: boolean} = {}
		extras.materialService, extras.materials, extras.any = service, {}, true
		for _, raw in ipairs(V.list(args.materials, 8, "material variants")) do
			local spec = V.fields(raw, {"name", "baseMaterial", "studsPerTile", "override", "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap"}, "material variant")
			local name = V.string(spec.name, "material variant name", 50)
			if not string.match(name, "^[%w_ %-]+$") or names[name] then V.fail("INPUT", "Material variant names are unique [A-Za-z0-9_ -].") end
			names[name] = true
			for _, child in ipairs(service:GetChildren()) do
				if child.Name == name then V.fail("CONFLICT", "MaterialService already has " .. name .. "; choose another variant name.") end
			end
			local values: {[string]: any} = {BaseMaterial = V.enum(spec.baseMaterial, LegacyProperties.MATERIALS, Enum.Material, "baseMaterial")}
			if spec.studsPerTile ~= nil then values.StudsPerTile = V.number(spec.studsPerTile, 0.1, 1000, "studsPerTile") end
			for _, map in ipairs(VARIANT_MAPS) do
				if spec[map] ~= nil then values[map] = LegacyProperties.contentId(spec[map], "MaterialVariant." .. map) end
			end
			table.insert(extras.materials, {name = name, values = values, override = spec.override ~= nil and V.boolean(spec.override, "override")})
		end
		if #extras.materials == 0 then V.fail("INPUT", "Choose at least one material variant.") end
	end
	if args.soundService ~= nil then
		extras.subject = extras.subject or self.registry:root("Workspace")
		local names: {string} = {}
		for name in pairs(SOUND_SERVICE_PROPERTIES) do table.insert(names, name) end
		local values = V.fields(args.soundService, names, "soundService")
		local decoded: {[string]: any} = {}
		local count = 0
		for name, value in pairs(values) do
			local spec = SOUND_SERVICE_PROPERTIES[name]
			decoded[name] = if spec[1] == "enum" then V.enum(value, spec[3], Enum[spec[2]], "SoundService." .. name) else V.number(value, spec[1], spec[2], "SoundService." .. name)
			count += 1
		end
		if count == 0 then V.fail("INPUT", "Set at least one soundService property.") end
		extras.soundService, extras.soundValues, extras.any = self.gameModel:GetService("SoundService"), decoded, true
	end
	return extras
end

-- Runs inside environment()'s rollback pcall: every successful write registers its revert first.
function Operations:applyEnvironmentExtras(extras: any, reverts: {any}, before: any, after: any): ()
	local function setting(target: any, property: string, value: any, manual: string): ()
		local readable, prior = pcall(function(): any return target[property] end)
		if not readable then V.fail("STUDIO_SETTING", "Studio did not let the plugin read " .. manual) end
		-- A refused write changed nothing; only a performed write registers its revert.
		if not pcall(function() target[property] = value end) then V.fail("STUDIO_SETTING", "Studio did not let the plugin set " .. manual) end
		table.insert(reverts, {target = target, name = property, value = prior})
		local readback, actual = pcall(function(): any return target[property] end)
		if not readback or actual ~= value then V.fail("STUDIO_SETTING", "Studio did not keep the plugin's value for " .. manual) end
		before[property == "Technology" and "technology" or "terrainDecoration"] = if typeof(prior) == "EnumItem" then prior.Name else prior
	end
	if extras.technology then
		setting(extras.lighting, "Technology", extras.technology, "Lighting.Technology. In Studio select Lighting in the Explorer and set Technology to "
			.. extras.technology.Name .. " in the Properties window. No environment change was kept.")
		after.technology = extras.technology.Name
	end
	if extras.decoration ~= nil then
		setting(extras.terrain, "Decoration", extras.decoration, "Terrain.Decoration. In Studio select Workspace > Terrain and set Decoration in the Properties window. No environment change was kept.")
		after.terrainDecoration = extras.decoration
	end
	if extras.materials then
		local service, names = extras.materialService, V.array({})
		for _, spec in ipairs(extras.materials) do
			local variant = Instance.new("MaterialVariant")
			table.insert(reverts, {fn = function() variant:Destroy() end})
			variant.Name = spec.name
			for _, property in ipairs({"BaseMaterial", "StudsPerTile", "ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap"}) do
				local value = spec.values[property]
				if value ~= nil and not setVerified(variant, property, value) then
					V.fail("STUDIO_SETTING", "Studio did not let the plugin set MaterialVariant." .. property .. ". Create the variant under MaterialService in Studio instead. No environment change was kept.")
				end
			end
			variant.Parent = service
			if spec.override then
				local base = spec.values.BaseMaterial
				local prior = service:GetBaseMaterialOverride(base)
				table.insert(reverts, {fn = function() service:SetBaseMaterialOverride(base, prior) end})
				service:SetBaseMaterialOverride(base, spec.name)
				if service:GetBaseMaterialOverride(base) ~= spec.name then V.fail("VERIFY", "MaterialService did not take the " .. spec.name .. " override.") end
			end
			table.insert(names, spec.name)
		end
		before.materials, after.materials = "created", names
	end
	if extras.soundValues then
		local service, prior, applied = extras.soundService, {}, {}
		local names: {string} = {}
		for name in pairs(extras.soundValues) do table.insert(names, name) end
		table.sort(names)
		for _, name in ipairs(names) do
			local value = extras.soundValues[name]
			local readable, old = pcall(function(): any return service[name] end)
			if not readable then V.fail("STUDIO_SETTING", "Studio did not let the plugin read SoundService." .. name .. ". No environment change was kept.") end
			if not pcall(function() service[name] = value end) then
				V.fail("STUDIO_SETTING", "Studio did not let the plugin set SoundService." .. name .. ". In Studio select SoundService in the Explorer and set it in the Properties window. No environment change was kept.")
			end
			table.insert(reverts, {target = service, name = name, value = old})
			local readback, actual = pcall(function(): any return service[name] end)
			local matches = readback and (if type(value) == "number" then type(actual) == "number" and math.abs(actual - value) <= 0.001 else actual == value)
			if not matches then V.fail("VERIFY", "SoundService." .. name .. " did not take the requested value.") end
			prior[name] = if typeof(old) == "EnumItem" then old.Name else old
			applied[name] = if typeof(value) == "EnumItem" then value.Name else value
		end
		before.soundService, after.soundService = prior, applied
	end
end

function Operations:environment(command: any, args: any, guard: () -> ()): any
	local allowed = {"terrain", "technology", "terrainDecoration", "materials", "soundService"}
	for _, section in ipairs(ENVIRONMENT_SECTIONS) do table.insert(allowed, section.key) end
	V.fields(args, allowed, "environment arguments")
	local fills: {any} = {}
	local terrain: any = nil
	if args.terrain ~= nil then
		local workspace = self.registry:root("Workspace")
		for _, child in ipairs(workspace:GetChildren()) do if child.ClassName == "Terrain" then terrain = child end end
		if not terrain then V.fail("TERRAIN", "Workspace has no Terrain object.") end
		local volume = 0
		for _, raw in ipairs(V.list(args.terrain, 128, "terrain shapes")) do
			local shape = V.object(raw, "terrain shape")
			local center = buildTriple(shape.center, -100000, 100000, "terrain center")
			local material = V.enum(shape.material, TERRAIN_MATERIALS, Enum.Material, "terrain material")
			local fill: any = {shape = shape.shape, material = material, center = center}
			if shape.shape == "Ball" then
				V.fields(shape, {"shape", "material", "center", "radius"}, "terrain ball")
				fill.radius = V.number(shape.radius, 1, 1024, "terrain radius")
				volume += 4 / 3 * math.pi * fill.radius ^ 3
			elseif shape.shape == "Cylinder" then
				V.fields(shape, {"shape", "material", "center", "radius", "height", "orientation"}, "terrain cylinder")
				fill.radius = V.number(shape.radius, 1, 1024, "terrain radius")
				fill.height = V.number(shape.height, 1, 2048, "terrain height")
				fill.orientation = if shape.orientation == nil then nil else buildTriple(shape.orientation, -360, 360, "terrain orientation")
				volume += math.pi * fill.radius ^ 2 * fill.height
			elseif shape.shape == "Block" or shape.shape == "Wedge" then
				V.fields(shape, {"shape", "material", "center", "size", "orientation"}, "terrain block")
				fill.size = buildTriple(shape.size, 1, 2048, "terrain size")
				fill.orientation = if shape.orientation == nil then nil else buildTriple(shape.orientation, -360, 360, "terrain orientation")
				volume += fill.size[1] * fill.size[2] * fill.size[3]
			else
				V.fail("INPUT", "Terrain shape must be Block, Ball, Cylinder or Wedge.")
			end
			table.insert(fills, fill)
		end
		if #fills == 0 then V.fail("INPUT", "Choose at least one terrain shape.") end
		if volume > 400000000 then V.fail("BODY_LIMIT", "Terrain fills exceed the bounded volume.") end
	end
	local lighting: any = nil
	local changes: {any} = {}
	for _, section in ipairs(ENVIRONMENT_SECTIONS) do
		local values = args[section.key]
		if values ~= nil then
			lighting = lighting or self.registry:root("Lighting")
			local names: {string} = {}
			for name in pairs(section.props) do table.insert(names, name) end
			V.fields(values, names, section.key)
			local decoded: {[string]: any} = {}
			local count = 0
			for name, value in pairs(values) do
				decoded[name] = environmentValue(value, section.props[name], section.key .. "." .. name)
				count += 1
			end
			if count == 0 then V.fail("INPUT", "Set at least one " .. section.key .. " property.") end
			local target: any = if section.className then nil else lighting
			if section.className then
				for _, child in ipairs(lighting:GetChildren()) do if child.ClassName == section.className then target = child; break end end
			end
			table.insert(changes, {key = section.key, className = section.className, target = target, values = decoded})
		end
	end
	local extras = self:environmentExtras(args)
	if #fills == 0 and #changes == 0 and not extras.any then V.fail("INPUT", "Choose terrain shapes or lighting/effect settings.") end
	local subject = lighting or terrain or extras.subject
	return self:record(command, guard, function(progress: any): any
		guard()
		local created: {any} = {}
		local reverts: {any} = {}
		local before: {[string]: any} = {}
		local after: {[string]: any} = {}
		local ok, failure = pcall(function()
			for _, change in ipairs(changes) do
				local snapshot: {[string]: any} = {}
				if change.target then
					for name in pairs(change.values) do snapshot[name] = environmentEncode(change.target[name]) end
					before[change.key] = snapshot
				else
					change.target = Instance.new(change.className)
					change.target.Name = change.className
					change.created = true
					table.insert(created, change.target)
					before[change.key] = "created"
				end
				local applied: {[string]: any} = {}
				for name, value in pairs(change.values) do
					if not change.created then table.insert(reverts, {target = change.target, name = name, value = change.target[name]}) end
					change.target[name] = value
					if not environmentMatches(change.target[name], value) then V.fail("VERIFY", change.key .. "." .. name .. " did not take the requested value.") end
					applied[name] = environmentEncode(value)
				end
				after[change.key] = applied
			end
			if extras.any then self:applyEnvironmentExtras(extras, reverts, before, after) end
			guard()
		end)
		if not ok then
			local reverted = pcall(function()
				for index = #reverts, 1, -1 do
					local revert = reverts[index]
					if revert.fn then revert.fn() else revert.target[revert.name] = revert.value end
				end
			end)
			for _, instance in ipairs(created) do pcall(function() instance:Destroy() end) end
			if not reverted then progress.touched = true end
			error(failure, 0)
		end
		progress.touched = true
		for _, fill in ipairs(fills) do
			local center = Vector3.new(fill.center[1], fill.center[2], fill.center[3])
			local o = fill.orientation or {0, 0, 0}
			local cframe = CFrame.new(center.X, center.Y, center.Z) * CFrame.fromOrientation(math.rad(o[1]), math.rad(o[2]), math.rad(o[3]))
			if fill.shape == "Ball" then terrain:FillBall(center, fill.radius, fill.material)
			elseif fill.shape == "Cylinder" then terrain:FillCylinder(cframe, fill.height, fill.radius, fill.material)
			elseif fill.shape == "Wedge" then terrain:FillWedge(cframe, Vector3.new(fill.size[1], fill.size[2], fill.size[3]), fill.material)
			else terrain:FillBlock(cframe, Vector3.new(fill.size[1], fill.size[2], fill.size[3]), fill.material) end
		end
		for _, instance in ipairs(created) do instance.Parent = lighting end
		local ref = self.registry:ref(subject)
		progress.ref = ref
		after.terrainShapes = #fills
		return {ref = ref, mutation = {kind = "environment.apply", ref = ref, before = before, after = after}}
	end)
end

-- terrain.generate: validate and compute the whole field before recording, then WriteVoxels in
-- bounded chunks, yielding between chunks. One undo recording; reverted with Studio Undo.
function Operations:terrainGenerate(command: any, args: any, guard: () -> ()): any
	local plan = TerrainGen.plan(args)
	local terrain: any = nil
	for _, child in ipairs(self.registry:root("Workspace"):GetChildren()) do if child.ClassName == "Terrain" then terrain = child end end
	if not terrain then V.fail("TERRAIN", "Workspace has no Terrain object.") end
	local names = table.clone(TerrainGen.MATERIALS)
	table.insert(names, "Air"); table.insert(names, "Water")
	local enums: {[string]: any} = {}
	local function resolve(name: string): any
		local item = enums[name]
		if item == nil then item = V.enum(name, names, Enum.Material, "terrain material"); enums[name] = item end
		return item
	end
	resolve("Air"); resolve("Water"); resolve(plan.deep)
	-- Field synthesis is pure CPU before the recording opens; it yields between rows when long.
	guard()
	local slice = self:slicer(guard)
	local field = TerrainGen.field(plan, slice)
	for _, name in ipairs(field.materials) do if enums[name] == nil then resolve(name) end end
	return self:record(command, guard, function(progress: any): any
		guard()
		local chunks = TerrainGen.write(plan, field, {resolve = resolve,
			write = function(low: {number}, high: {number}, materials: any, occupancies: any): ()
				progress.touched = true
				terrain:WriteVoxels(Region3.new(Vector3.new(low[1], low[2], low[3]), Vector3.new(high[1], high[2], high[3])), 4, materials, occupancies)
			end,
			yield = function(): () slice(0) end, slice = slice})
		local ref = self.registry:ref(terrain)
		progress.ref = ref
		return {ref = ref, mutation = {kind = "terrain.generate", ref = ref, before = V.NULL, after = TerrainGen.summary(plan, field, chunks)}}
	end)
end

-- Read-only world-space axis-aligned bounds for viewport framing. Oriented part boxes are
-- expanded through their rotation; folders/services visit at most 5000 descendants.
function Operations:bounds(instance: any): any
	local low, high = {math.huge, math.huge, math.huge}, {-math.huge, -math.huge, -math.huge}
	local function box(cframe: any, size: any): ()
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cframe:GetComponents()
		local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
		local center = {x, y, z}
		local extent = {math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz,
			math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz, math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz}
		for axis = 1, 3 do
			low[axis] = math.min(low[axis], center[axis] - extent[axis])
			high[axis] = math.max(high[axis], center[axis] + extent[axis])
		end
	end
	if instance:IsA("Attachment") then
		local p = instance.WorldPosition
		box(CFrame.new(p.X, p.Y, p.Z), Vector3.new(1, 1, 1))
	elseif instance:IsA("BasePart") then
		box(instance.CFrame, instance.Size)
	elseif instance:IsA("Model") then
		local ok, cframe, size = pcall(function(): (any, any) return instance:GetBoundingBox() end)
		if not ok then V.fail("BOUNDS", "The Model has no physical parts to frame.") end
		box(cframe, size)
	else
		local queue, head = {instance}, 1
		while head <= #queue and head <= 5000 do
			local item = queue[head]
			head += 1
			if item ~= instance and item:IsA("BasePart") then box(item.CFrame, item.Size) end
			for _, child in ipairs(item:GetChildren()) do if #queue < 5000 then table.insert(queue, child) end end
		end
	end
	if low[1] == math.huge then V.fail("BOUNDS", "The instance has no physical parts to frame.") end
	for axis = 1, 3 do V.number(low[axis], -100000, 100000, "bounds"); V.number(high[axis], -100000, 100000, "bounds") end
	return {center = V.array({(low[1] + high[1]) / 2, (low[2] + high[2]) / 2, (low[3] + high[3]) / 2}),
		size = V.array({high[1] - low[1], high[2] - low[2], high[3] - low[3]}), space = "world-aabb"}
end

-- Remove exact instances or reset Workspace through one Studio Undo recording.
-- No arbitrary code, root destruction, uploads or automatic broad undo.
function Operations:remove(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"mode", "refs"}, "scene removal")
	if args.mode ~= "refs" and args.mode ~= "workspace" then V.fail("INPUT", "Choose refs or workspace removal.") end
	local workspace = self.registry.services.Workspace
	if args.mode == "workspace" then workspace = self.registry:root("Workspace") end
	local camera = if workspace then workspace.CurrentCamera else nil
	local terrain: any = nil
	local targets, parents = {}, {}
	if args.mode == "workspace" then
		if args.refs ~= nil then V.fail("INPUT", "Workspace reset does not take refs.") end
		terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain == nil or type(terrain.Clear) ~= "function" then V.fail("CAPABILITY", "Workspace Terrain.Clear is unavailable.") end
		for _, instance in ipairs(workspace:GetChildren()) do
			if instance ~= terrain and instance ~= camera then targets[#targets + 1] = instance end
		end
		if #targets > V.REMOVE_LIMITS.topLevel then V.fail("BODY_LIMIT", "Workspace reset exceeds the top-level instance limit.") end
	else
		local refs = V.list(args.refs, V.REMOVE_LIMITS.targets, "removal refs")
		if #refs == 0 then V.fail("INPUT", "Choose at least one removal target.") end
		for _, ref in ipairs(refs) do targets[#targets + 1] = self.registry:resolve(ref) end
	end
	local seen, count = {}, 0
	local slice = self:slicer(guard)
	local function protected(instance: any): boolean
		local root = self.registry:rootOf(instance)
		return (workspace ~= nil and instance == workspace.CurrentCamera) or instance:IsA("Terrain") or root == nil or instance == self.registry:root(root)
			or (instance.ClassName == "Folder" and string.sub(instance.Name, 1, 16) == "ArcaneTestProof_")
	end
	for index, instance in ipairs(targets) do
		guard()
		if seen[instance] then V.fail("INPUT", "Removal targets must be distinct.") end
		seen[instance] = true
		if protected(instance) then V.fail("PROTECTED", "A removal target is an engine root, active camera, Terrain or connection witness.") end
		local children = instance:GetDescendants()
		count += #children + 1
		if count > V.REMOVE_LIMITS.descendants then V.fail("BODY_LIMIT", "Removal exceeds the instance limit.") end
		for _, child in ipairs(children) do
			if protected(child) then V.fail("PROTECTED", "A removal target contains protected connection or engine state.") end
			slice(1)
		end
		parents[index] = instance.Parent
		slice(#children + 1)
	end
	if args.mode == "refs" then for index, instance in ipairs(targets) do
		for other = index + 1, #targets do
			if instance:IsDescendantOf(targets[other]) or targets[other]:IsDescendantOf(instance) then V.fail("INPUT", "Remove an ancestor once; do not repeat its descendants.") end
		end
	end
	end
	local anchor = if args.mode == "workspace" then workspace else self.registry:root(self.registry:rootOf(targets[1]))
	local ref = self.registry:ref(anchor)
	local result = {ref = ref, removed = #targets, descendants = count, terrainCleared = terrain ~= nil, undo = "studio",
		mutation = {kind = "scene.remove", ref = ref, before = {targetCount = #targets, descendants = count},
			after = {removed = #targets, descendants = count, terrainCleared = terrain ~= nil, undo = "studio"}}}
	if #V.encode(result, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Removal receipt exceeds its bound.") end
	return self:record(command, guard, function(progress: any): any
		for index, instance in ipairs(targets) do
			guard()
			if instance.Parent ~= parents[index] or protected(instance) then V.fail("CONFLICT", "A removal target moved or became protected before the change.") end
			for _, child in ipairs(instance:GetDescendants()) do
				if protected(child) then V.fail("CONFLICT", "A removal target gained protected state before the change.") end
			end
			progress.touched = true
			instance:Destroy()
			if instance.Parent ~= nil then V.fail("VERIFY", "A removal target remained parented.") end
			slice(1)
		end
		if terrain then guard(); progress.touched = true; terrain:Clear(); guard() end
		return result
	end)
end

function Operations:restore(command: any, args: any, guard: () -> ()): any
	V.fields(args, {"receiptCommandId", "mutation"}, "restore arguments")
	local receiptId = V.string(args.receiptCommandId, "receipt command ID", 256)
	local original = self.mutations[receiptId]
	if not original or self.restored[receiptId] then V.fail("RECEIPT", "Receipt is unknown or already restored in this session.") end
	-- Do not trust a caller-supplied inverse, even on the paired daemon route.
	if not V.equal(original, args.mutation) then V.fail("RECEIPT", "Restoration payload differs from the immutable local receipt.") end
	if original.kind == "scene.remove" then V.fail("RESTORE", "Use Studio Undo to restore deleted instances and terrain.") end
	local instance = self.registry:resolve(original.ref)
	if self.registry:isService(instance) then V.fail("SERVICE", "Services cannot be restored by mutation.") end
	if original.kind == "scene.create" then
		local owned = self.registry.owned[instance]
		local function matches(): boolean
			return owned ~= nil and instance.Parent == owned.parent and #instance:GetChildren() == 0
				and V.equal(P.snapshot(instance), original.after.properties)
				and (owned.typedOwnership == nil or P.ownershipMatches(instance, self.collection, owned.typedOwnership))
				and V.equal(instance:GetAttributes(), owned.attributes)
				and V.equal(self.collection:GetTags(instance), owned.tags)
				and (owned.source == nil or self:source(instance) == owned.source)
				and (owned.enabled == nil or not instance.Disabled == owned.enabled)
		end
		if not matches() then V.fail("CONFLICT", "Created instance has changed, moved, or gained children; restoration refused.") end
		self:record(command, guard, function(progress: any): any
			guard()
			self.registry:resolve(original.ref)
			if not matches() then V.fail("CONFLICT", "Created instance changed before restoration.") end
			progress.ref = original.ref
			progress.touched = true
			instance:Destroy()
			return {restored = true, ref = original.ref}
		end)
	elseif original.kind == "scene.build" then
		local owned = self.registry.owned[instance]
		local build = owned and owned.build
		local function matches(): boolean
			if not build or instance.Parent ~= owned.parent then return false end
			for index, item in ipairs(build.instances) do
				if item.Parent ~= build.parents[index] or #item:GetChildren() ~= build.children[index] then return false end
				if not P.ownershipMatches(item, self.collection, build.snapshots[index]) then return false end
			end
			return true
		end
		if not matches() then V.fail("CONFLICT", "The built hierarchy changed, moved, or gained children; restoration refused.") end
		self:record(command, guard, function(progress: any): any
			guard()
			self.registry:resolve(original.ref)
			if not matches() then V.fail("CONFLICT", "The built hierarchy changed before restoration.") end
			progress.ref = original.ref
			progress.touched = true
			instance:Destroy()
			return {restored = true, ref = original.ref}
		end)
	elseif original.kind == "scene.update" then
		self:updateProperties(command, {ref = original.ref, expected = original.after.properties, properties = original.before.properties}, guard, true)
	elseif original.kind == "script.update" then
		self:updateSource(command, {ref = original.ref, expectedSource = original.after.source, source = original.before.source}, guard)
	elseif original.kind == "script.set_enabled" then
		self:setEnabled(command, {ref = original.ref, expectedSource = original.after.source, expectedEnabled = original.after.enabled, enabled = original.before.enabled}, guard)
	elseif original.kind == "scene.place_asset" or original.kind == "scene.apply_material" then
		AssetPlacement.restore(self, command, original, instance, guard)
	else V.fail("RECEIPT", "Unsupported mutation receipt.") end
	self.restored[receiptId] = true
	return {restored = true, ref = original.ref}
end

function Operations:execute(command: any, guard: () -> ()): any
	guard()
	local args = V.object(command.args, "arguments")
	local method = command.method
	local result: any
	if method == "scene.children" then result = self:children(args)
	elseif method == "asset.stage_packet" then result = self:stageAssetPacket(args, guard)
	elseif method == "asset.reconstruct" then return self:reconstructAsset(args, guard)
	elseif method == "asset.keep_mesh" then return self:keepReconstruction(args, guard)
	elseif method == "scene.import_context" then result = self:importContext(args)
	elseif method == "scene.upload_context" then result = self:uploadContext(args)
	elseif method == "scene.search" then result = self:search(args)
	elseif method == "script.search" then result = self:searchScripts(args, guard)
	elseif method == "output.read" then result = self:readOutput(args)
	elseif method == "scene.inspect" then
		V.fields(args, {"ref", "bounds"}, "inspect arguments")
		local instance = self.registry:resolve(args.ref)
		local node = self.registry:node(instance)
		node.properties = if LegacyProperties.GUI_SPECS[instance.ClassName] then LegacyProperties.snapshotGui(instance) else P.snapshot(instance)
		if args.bounds ~= nil then
			if args.bounds ~= true then V.fail("INPUT", "bounds must be true when present.") end
			node.bounds = self:bounds(instance)
		end
		result = node
	elseif method == "selection.read" then
		V.fields(args, {}, "selection arguments")
		local items = V.array({})
		for _, instance in ipairs(self.selection:Get()) do
			if self.registry:rootOf(instance) then
				if #items >= 200 then V.fail("BODY_LIMIT", "Selection exceeds 200 granted instances.") end
				table.insert(items, self.registry:node(instance))
			end
		end
		result = {items = items}
	elseif method == "script.read" then
		V.fields(args, {"ref"}, "read arguments")
		local instance = self.registry:resolve(args.ref)
		result = {ref = self.registry:ref(instance), source = self:source(instance)}
		if instance:IsA("BaseScript") then result.enabled = not instance.Disabled end
	elseif method == "scene.create" then result = self:create(command, args, guard)
	elseif method == "scene.remove" then result = self:remove(command, args, guard)
	elseif method == "scene.build" then result = self:build(command, args, guard)
	elseif method == "environment.apply" then result = self:environment(command, args, guard)
	elseif method == "terrain.generate" then result = self:terrainGenerate(command, args, guard)
	elseif method == "scene.update" then result = self:updateProperties(command, args, guard)
	elseif method == "script.update" then result = self:updateSource(command, args, guard)
	elseif method == "script.set_enabled" then result = self:setEnabled(command, args, guard)
	elseif method == "scene.restore" then result = self:restore(command, args, guard)
	elseif method == "scene.asset_watch" then V.fields(args, {}, "watch arguments"); result = AssetPlacement.watch(self)
	elseif method == "scene.place_asset" then result = AssetPlacement.place(self, command, args, guard)
	elseif method == "scene.apply_material" then result = AssetPlacement.applyMaterial(self, command, args, guard)
	else V.fail("METHOD", "Unsupported Studio method.") end
	if not table.find(V.WRITE_METHODS, method) then guard() end
	if #V.encode(result, self.http) > V.RESULT_BYTES then V.fail("BODY_LIMIT", "Result exceeds 512 KiB.") end
	result = V.immutable(result)
	if result.mutation then self.mutations[command.id] = result.mutation end
	return result
end

return Operations
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane6">
<Properties>
<string name="Name">Transport</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
local V = require(script.Parent.Validation)
local Operations = require(script.Parent.Operations)
local TestProof = require(script.Parent.TestProof)
local Transport = {}
Transport.__index = Transport
Transport.POLL_SECONDS = 2
Transport.MAX_BACKOFF_SECONDS = 30
Transport.MAX_RECOVERY_ATTEMPTS = 8
-- Two-sided Studio pairing (docs/studio-pairing.md): only after the user types the 6-digit code shown in Arcane
-- and clicks Connect does the single worker ask this fixed loopback port, once, for the waiting offer's ticket.
-- Nothing is requested on load, while idle or from the toolbar. The discovery answer never carries the code:
-- the daemon must first prove it knows the typed code (HMAC over a fresh plugin nonce), so a process squatting
-- this port cannot pass as Arcane; only then does the plugin prove the code, and Arcane issues the key only
-- after the user clicks Approve there for this place.
Transport.DISCOVERY_URL = "http://127.0.0.1:45870"
-- Status is a read-only POST so the exact key never enters a URL. The daemon
-- must authenticate that key and inspect this exact client/identity without
-- creating a session, renewing a lease, dispatching work or returning a bearer.
local ROUTES = table.freeze({connect = "/v1/plugin/connect", status = "/v1/plugin/status", pair = "/v1/plugin/pair", poll = "/v1/plugin/poll", result = "/v1/plugin/result", disconnect = "/v1/plugin/disconnect",
	discover = "/v1/pairing/discover", challenge = "/v1/plugin/pairing/challenge", claim = "/v1/plugin/pairing/claim"})
local PAIRING_REJECTED = "This Arcane pairing offer expired or was already used. Click Connect Studio in Arcane again."
local PAIRING_NOT_WAITING = "Arcane is not waiting for Studio. Click Connect Studio in Arcane, then enter its code here."
local PAIRING_NOT_ARCANE = "That code does not match the Arcane window that answered. Check the code shown in Arcane and try again."
local PAIRING_APPROVAL_SECONDS = 600

local function hexBytes(hex: string): string
	return (string.gsub(hex, "%x%x", function(pair: string): string return string.char(tonumber(pair, 16) :: number) end))
end
-- HMAC-SHA256 (RFC 2104) over the plugin's own bounded SHA-256 (Main attaches it as transport.sha256).
-- The key is the short code typed by the user.
local function hmac(Sha256: (string) -> string, key: string, message: string): string
	if #key > 64 then key = hexBytes(Sha256(key)) end
	key ..= string.rep("\0", 64 - #key)
	local inner, outer = table.create(64), table.create(64)
	for i = 1, 64 do
		local byte = string.byte(key, i)
		inner[i] = string.char(bit32.bxor(byte, 0x36))
		outer[i] = string.char(bit32.bxor(byte, 0x5c))
	end
	return Sha256(table.concat(outer) .. hexBytes(Sha256(table.concat(inner) .. message)))
end
local function sameText(a: string, b: string): boolean
	if #a ~= #b then return false end
	local diff = 0
	for i = 1, #a do diff = bit32.bor(diff, bit32.bxor(string.byte(a, i), string.byte(b, i))) end
	return diff == 0
end
-- Role-separated proofs; the daemon computes the same (packages/storage/src/studio-store.ts studioPairingProof).
function Transport:pairingProof(code: string, role: string, ticket: string, clientNonce: string): string
	if type(self.sha256) ~= "function" then V.fail("PAIRING", "Studio pairing is unavailable in this plugin build.") end
	return hmac(self.sha256, code, "arcane-pair-v2|" .. role .. "|" .. ticket .. "|" .. clientNonce)
end
local IDENTITY_CHANGED = "Place identity changed; this session is fenced. Inspect receipts and explicitly connect again."
local ASSET_CLEANUP_FAILED = "Owned asset staging resources could not all be released. Inspect staging resources before reloading the plugin."
type Transport = any

function Transport.new(gameModel: any, onStatus: (any) -> (), artifactHash: string?): Transport
	local http = gameModel:GetService("HttpService")
	local clientSessionId = http:GenerateGUID(false)
	local proof = if artifactHash then TestProof.new(gameModel, clientSessionId, artifactHash) else nil
	return setmetatable({gameModel = gameModel, http = http, run = gameModel:GetService("RunService"),
		clientSessionId = clientSessionId, testProof = proof, onStatus = onStatus, generation = 0,
		pair = nil, desiredPair = nil, disconnectRequested = false, stopped = false,
		inFlight = false, started = false, failures = 0, cache = {}, cacheCount = 0,
		cacheBytes = 0, highEpoch = 0, pending = nil, blocked = false, identityFence = nil,
		recovery = nil, checkInput = nil, assetCleanupFailed = false,
		codePairing = nil, onPairing = nil, onPaired = nil, onActivity = nil,
		sizedArgs = setmetatable({}, {__mode = "k"})}, Transport)
end

function Transport:isEdit(): boolean
	-- Edit RunService remains Stopped while a separate Play DataModel runs.
	-- Use the plugin-facing global lifecycle property for production admission.
	local ok, active = pcall(function(): any return self.gameModel:GetService("StudioTestService").EditModeActive end)
	if ok then return type(active) == "boolean" and active == true end
	return false
end

function Transport:status(state: string, detail: string, commandId: string?)
	if self.stopped then return end
	local changed = self.identityFence and self.identityFence.changed
	if changed and table.find({"connected", "executing", "retrying"}, state) then state, detail = "reconciliation", IDENTITY_CHANGED end
	if self.assetCleanupFailed then state, detail = "reconciliation", "CLEANUP: " .. ASSET_CLEANUP_FAILED end
	local pair = if self.pair and self.generation == self.pair.generation and not self.disconnectRequested and not changed and not self.assetCleanupFailed then self.pair else nil
	self.onStatus({state = state, detail = detail, commandId = commandId,
		sessionId = if pair then pair.sessionId else nil,
		allowedRoots = if pair then table.clone(pair.allowedRoots) else {},
		allowWrites = if pair then pair.allowWrites else false,
		clientSessionId = self.clientSessionId, editMode = self:isEdit()})
end

function Transport:dropIdentityFence(): ()
	local fence = self.identityFence
	self.identityFence = nil
	if fence then for _, connection in ipairs(fence.connections) do connection:Disconnect() end end
end

function Transport:invalidateIdentity(fence: any): ()
	fence.changed = true -- Sticky for this exchange/session, even if values revert.
	if self.identityFence == fence then
		self.blocked = true
	end
end

function Transport:observeIdentity(fence: any): boolean
	if not fence or self.identityFence ~= fence then return false end
	local identity = fence.identity
	local ok, matches = pcall(function(): boolean
		return self.gameModel.PlaceId == identity.placeId and self.gameModel.GameId == identity.universeId
			and self.gameModel.Name == identity.name
	end)
	if not fence.changed and (not ok or not matches) then self:invalidateIdentity(fence) end
	if fence.changed then self.blocked = true end
	return not fence.changed
end

function Transport:watchIdentity(identity: any): any
	self:dropIdentityFence()
	local fence: any = {identity = V.immutable(identity), changed = false, connections = {}}
	self.identityFence = fence
	-- Signals latch changes during yielding HTTP/editor calls, including a change
	-- back to the original value. Synchronous comparisons cover deferred signals.
	for _, property in ipairs({"PlaceId", "GameId", "Name"}) do
		table.insert(fence.connections, self.gameModel:GetPropertyChangedSignal(property):Connect(function()
			self:invalidateIdentity(fence)
			if self.identityFence == fence then self:status("reconciliation", IDENTITY_CHANGED) end
		end))
	end
	return fence
end

function Transport:checkIdentity(pair: any): ()
	if not pair or not self:observeIdentity(pair.identityFence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
end


function Transport:forgetDesired(): ()
	local desired = self.desiredPair
	if desired then desired.code = nil; desired.apiKey = nil; desired.ticket = nil; desired.proof = nil end
	self.desiredPair = nil
end

function Transport:forgetPairing(): ()
	local pairing = self.codePairing
	if pairing then pairing.code = nil; pairing.ticket = nil; pairing.proof = nil end
	self.codePairing = nil
end

function Transport:pairingUpdate(stage: string, detail: string): ()
	if self.onPairing and not self.stopped then pcall(self.onPairing, stage, detail) end
end

function Transport:forgetRecovery(): ()
	if self.recovery then self.recovery.apiKey = nil end
	self.recovery = nil
end

function Transport:checkAssetCleanup(): ()
	if self.assetCleanupFailed then V.fail("CLEANUP", ASSET_CLEANUP_FAILED) end
end

function Transport:disposeOperations(): ()
	local operations = self.operations
	-- Detach before synchronous cancellation so retirement cannot dispose twice.
	self.operations = nil
	if not operations then return end
	local ok = pcall(function() operations:cancelAssetTransfers() end)
	if not ok then
		-- Cancellation attempts every owned receiver, but cannot prove release on
		-- failure. An empty transfer table or fresh session is not reconciliation.
		self.assetCleanupFailed = true
		self.blocked = true
		self:forgetDesired()
		self:forgetRecovery()
	end
end

function Transport:requestConnect(apiKey: any, automatic: boolean?): ()
	if self.stopped then return end
	self:checkAssetCleanup()
	local origin = V.keyOrigin(apiKey)
	if not automatic and not self:isEdit() then V.fail("PLAY", "Stop playtesting before connecting.") end
	self.generation += 1
	self:forgetDesired()
	self:forgetRecovery()
	local intent = {url = origin, apiKey = apiKey, generation = self.generation,
		needsStatus = automatic == true, attempts = 0, sessionId = nil, fence = nil}
	self.recovery = intent
	if not automatic then self.desiredPair = {url = origin, apiKey = apiKey, generation = self.generation} end
	self:forgetPairing()
	self.disconnectRequested = true
	self:status("connecting", "Connecting to the Arcane workbench.")
end

-- Explicit user action only: the Connect click with the code typed from Arcane. The code stays in memory
-- for this one attempt and never reaches plugin settings or any request.
function Transport:requestArcaneCode(code: any): ()
	if self.stopped then return end
	self:checkAssetCleanup()
	local digits = (string.gsub(V.string(code, "Arcane code", 16), "[%s%-]", ""))
	if not string.match(digits, "^%d%d%d%d%d%d$") then V.fail("PAIRING", "Enter the 6-digit code shown in Arcane.") end
	if not self:isEdit() then V.fail("PLAY", "Stop playtesting before connecting.") end
	self.generation += 1
	self:forgetDesired()
	self:forgetRecovery()
	self:forgetPairing()
	self.codePairing = {code = digits, generation = self.generation, stage = "discover"}
	self.disconnectRequested = true
	self:status("connecting", "Looking for Arcane.")
end

-- Worker steps 1 and 2: one credential-free discovery read, then Arcane must prove the typed code over a fresh
-- nonce before the plugin reveals anything derived from it. A wrong proof ends the attempt (squatter or typo).
function Transport:advancePairing(): number
	local pairing = self.codePairing
	if not pairing or self.stopped or pairing.generation ~= self.generation then self:forgetPairing(); return Transport.POLL_SECONDS end
	local stage = pairing.stage
	local ok, err = pcall(function()
		if stage == "discover" then
			local result = self:post(Transport.DISCOVERY_URL, ROUTES.discover, {protocolVersion = V.PROTOCOL}, nil)
			local valid, parsed = pcall(function(): any
				V.fields(result, {"protocolVersion", "port", "ticket", "expiresAt"}, "pairing offer")
				if result.protocolVersion ~= V.PROTOCOL then V.fail("PROTOCOL", "Unsupported pairing offer.") end
				local port = V.integer(result.port, 1, 65535, "pairing port")
				local ticket = V.string(result.ticket, "pairing ticket", 100)
				local ticketPort, secret = string.match(ticket, "^arcane_pair_v1_([1-9][0-9]*)_([0-9a-f]+)$")
				if tonumber(ticketPort) ~= port or not secret or #secret ~= 48 then V.fail("PAIRING", "Invalid pairing ticket.") end
				V.string(result.expiresAt, "pairing expiry", 64)
				return {url = V.url("http://127.0.0.1:" .. tostring(port)), ticket = ticket}
			end)
			if not valid then V.fail("PAIRING", PAIRING_NOT_WAITING) end
			if self.codePairing ~= pairing or pairing.generation ~= self.generation then return end
			pairing.url, pairing.ticket = parsed.url, parsed.ticket
			-- A fresh 128-bit nonce for this attempt (two random GUIDs through SHA-256).
			pairing.clientNonce = string.sub(self.sha256(self.http:GenerateGUID(false) .. "|" .. self.http:GenerateGUID(false)), 1, 32)
			pairing.stage = "challenge"
		elseif stage == "challenge" then
			local result = self:post(pairing.url, ROUTES.challenge, {protocolVersion = V.PROTOCOL, ticket = pairing.ticket, clientNonce = pairing.clientNonce}, nil)
			if self.codePairing ~= pairing or pairing.generation ~= self.generation then return end
			local valid = pcall(function() V.fields(result, {"protocolVersion", "proof"}, "pairing challenge") end)
			local expected = self:pairingProof(pairing.code, "arcane", pairing.ticket, pairing.clientNonce)
			if not valid or result.protocolVersion ~= V.PROTOCOL or type(result.proof) ~= "string" or not sameText(result.proof, expected) then
				V.fail("NOT_ARCANE", PAIRING_NOT_ARCANE)
			end
			-- Arcane proved the code. Only now is a plugin proof derived; the code itself is dropped.
			local proof = self:pairingProof(pairing.code, "plugin", pairing.ticket, pairing.clientNonce)
			self.codePairing = nil
			pairing.code = nil
			self.desiredPair = {url = pairing.url, ticket = pairing.ticket, clientNonce = pairing.clientNonce, proof = proof,
				generation = pairing.generation, deadline = os.clock() + PAIRING_APPROVAL_SECONDS}
			pairing.ticket = nil
		end
	end)
	if ok then return 0 end
	if self.codePairing == pairing or (self.codePairing == nil and self.desiredPair == nil and pairing.generation == self.generation) then
		self:forgetPairing()
		local message = if type(err) == "table" and err.code == "NOT_ARCANE" then PAIRING_NOT_ARCANE
			elseif stage == "discover" then PAIRING_NOT_WAITING else V.safeError(err)
		self:pairingUpdate("failed", message)
		self:status("disconnected", message)
	end
	return Transport.POLL_SECONDS
end

-- Compatibility entry point for legacy fixtures; never exposed by Main.
function Transport:requestPair(url: any, code: any): ()
	if self.stopped then return end
	self:checkAssetCleanup()
	local origin = V.url(url)
	local pairingCode = V.string(code, "pairing code", 128)
	if not self:isEdit() then V.fail("PLAY", "Stop playtesting before pairing.") end
	self.generation += 1 -- Immediately fences callbacks already waiting on Studio.
	self:forgetDesired()
	self:forgetRecovery()
	self.desiredPair = {url = origin, code = pairingCode, generation = self.generation}
	self.disconnectRequested = true
	self:status("pairing", "Pairing requested; waiting for the current request to finish.")
end

function Transport:requestDisconnect(): ()
	if self.stopped then return end
	self.generation += 1
	self:forgetDesired()
	self:forgetRecovery()
	self:forgetPairing()
	self.disconnectRequested = true
	self:status("disconnecting", "Local writes are fenced; disconnecting from the daemon.")
end

function Transport:stop(): ()
	-- Unloading must not yield or launch a second network request. The daemon
	-- observes heartbeat loss; no token or session state is saved anywhere.
	if self.stopped then return end
	self.generation += 1
	self.stopped = true
	self:forgetDesired()
	self:forgetRecovery()
	self:forgetPairing()
	self:dropIdentityFence()
	if self.testProof then self.testProof:stop() end
	if self.pair then self.pair.token = nil end
	self.pair = nil
	self:disposeOperations()
	self.pending = nil
	self.cache = {}
	self.cacheCount, self.cacheBytes, self.highEpoch = 0, 0, 0
	-- UI callbacks are fenced on unload; report a bounded local diagnostic and
	-- allow the rest of the unloading handler to finish even when release fails.
	if self.assetCleanupFailed then warn("CLEANUP: " .. ASSET_CLEANUP_FAILED) end
end

function Transport:post(url: string, route: string, payload: any, token: string?): any
	V.url(url)
	if not table.find({ROUTES.connect, ROUTES.status, ROUTES.pair, ROUTES.poll, ROUTES.result, ROUTES.disconnect, ROUTES.discover, ROUTES.challenge, ROUTES.claim}, route) then V.fail("URL", "Unsupported plugin route.") end
	if (route == ROUTES.discover) ~= (url == Transport.DISCOVERY_URL) then V.fail("URL", "Pairing discovery uses only its fixed loopback endpoint.") end
	if self.inFlight then V.fail("FLIGHT", "Another HTTP request is in flight.") end
	if route == ROUTES.poll then self:checkIdentity(self.pair) end
	local headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" }
	if token then headers.Authorization = "Bearer " .. token end
	local body = V.encode(payload, self.http)
	if #body > V.RESULT_BYTES + 4096 then V.fail("BODY_LIMIT", "Request exceeds the transport bound.") end
	self.inFlight = true
	local ok, response = pcall(function()
		return self.http:RequestAsync({Url = url .. route, Method = "POST", Headers = headers, Body = body, Timeout = 10})
	end)
	self.inFlight = false
	if self.checkInput and not self.stopped then self.checkInput() end
	if self.identityFence then self:observeIdentity(self.identityFence) end
	if not ok then V.fail("NETWORK", "Loopback request failed or timed out.") end
	if type(response) ~= "table" or type(response.StatusCode) ~= "number" or type(response.Success) ~= "boolean" then V.fail("PROTOCOL", "Invalid HTTP response.") end
	-- Never inspect/follow Location, and never construct a URL from a response.
	-- RequestAsync documents Timeout, but no redirect-disable option. Native redirect
	-- behavior still needs a disposable-fixture check; see docs/build/PLUGIN.md.
	if response.StatusCode >= 300 and response.StatusCode < 400 then V.fail("REDIRECT", "Daemon returned a redirect; connection refused.") end
	local errorCode = nil
	if not response.Success and type(response.Body) == "string" and #response.Body <= 8192 then
		local decoded, errorBody = pcall(function() return V.decode(response.Body, self.http) end)
		if decoded and type(errorBody) == "table" then errorCode = errorBody.error end
	end
	if (route == ROUTES.claim or route == ROUTES.challenge) and not response.Success and response.StatusCode ~= 408 and response.StatusCode ~= 429 and response.StatusCode < 500 then
		V.fail("PAIRING", PAIRING_REJECTED)
	end
	if response.StatusCode == 401 or response.StatusCode == 403 then
		if route == ROUTES.status and errorCode ~= "KEY_REJECTED" then
			-- Older daemons route unknown plugin POSTs through bearer auth. Their
			-- generic AUTH is not evidence that this saved API key is invalid.
			V.fail("STATUS_UNAVAILABLE", "Daemon could not authenticate safe key status. Click Connect to connect explicitly.")
		end
		if route == ROUTES.connect or route == ROUTES.status then V.fail("KEY_REJECTED", "Arcane API key was rejected. Enter a new API key.") end
		if errorCode == "ORIGIN" or errorCode == "SCOPE" then V.fail("RECONCILE", "Daemon refused the session scope; inspect the connection.") end
		V.fail("REVOKED", "Session expired or was revoked; connect again.")
	end
	if route == ROUTES.status and (response.StatusCode == 400 or response.StatusCode == 404 or response.StatusCode == 405) then
		V.fail("STATUS_UNAVAILABLE", "Daemon does not support safe session status. Click Connect to connect explicitly.")
	end
	if (route == ROUTES.poll or route == ROUTES.result) and (response.StatusCode == 404 or response.StatusCode == 410) then
		V.fail("REVOKED", "Session no longer exists; checking fresh session status.")
	end
	-- The daemon reports restart/revocation as 409, not necessarily 401. Never
	-- mistake an unrelated receipt conflict for definitive session loss, or echo
	-- its untrusted message. Only inspect a bounded JSON error code.
	if (response.StatusCode == 400 or response.StatusCode == 409) and route ~= ROUTES.connect and route ~= ROUTES.pair and route ~= ROUTES.status then
		if table.find({"REVOKED", "EXPIRED", "SESSION"}, errorCode) then
			V.fail("REVOKED", "Session expired or was lost; checking fresh session status.")
		end
	end
	if response.StatusCode == 409 then V.fail("RECONCILE", "Daemon refused the session or receipt; inspect the command and connect again.") end
	-- Any other definitive client error on a receipt (for example RECEIPT) rejects
	-- these exact bytes; resending them is not a loopback retry. Only timeout and
	-- busy statuses remain transient.
	if route == ROUTES.result and response.StatusCode >= 400 and response.StatusCode < 500
		and response.StatusCode ~= 408 and response.StatusCode ~= 429 then
		V.fail("RECONCILE", "Daemon rejected the command receipt (HTTP " .. tostring(response.StatusCode) .. "); inspect the command and connect again.")
	end
	if not response.Success then V.fail("NETWORK", "Daemon request failed (HTTP " .. tostring(response.StatusCode) .. ").") end
	if type(response.Body) ~= "string" or #response.Body > V.RESULT_BYTES + V.ARGUMENT_BYTES + 8192 then V.fail("BODY_LIMIT", "Daemon response exceeds the transport bound.") end
	local decoded, data = pcall(function() return V.decode(response.Body, self.http) end)
	if not decoded then V.fail("PROTOCOL", "Daemon response is not valid JSON.") end
	return V.object(data, "daemon response")
end

function Transport:clearSession(keepIdentity: boolean?): ()
	if self.testProof then self.testProof:disconnect() end
	if not keepIdentity then self:dropIdentityFence() end
	if self.pair then self.pair.token = nil end
	self.pair = nil
	self:disposeOperations()
	self.pending = nil
	self.cache = {}
	self.cacheCount, self.cacheBytes, self.highEpoch = 0, 0, 0
	self.blocked = self.assetCleanupFailed
	if self.assetCleanupFailed then self:status("reconciliation", "CLEANUP: " .. ASSET_CLEANUP_FAILED) end
end

function Transport:exchange(desired: any): ()
	if self.stopped or desired.generation ~= self.generation then desired.code = nil; desired.apiKey = nil; desired.ticket = nil; desired.proof = nil; return end
	self:checkAssetCleanup()
	local capabilities = table.clone(V.READ_METHODS)
	for _, method in ipairs(V.WRITE_METHODS) do table.insert(capabilities, method) end
	for _, method in ipairs(V.ASSET_STAGE_METHODS or {}) do table.insert(capabilities, method) end
	for _, feature in ipairs(V.FEATURE_CAPABILITIES or {}) do table.insert(capabilities, feature) end
	-- Keep this mesh only when this Studio exposes the plugin mesh upload API; the probe fails closed.
	if Operations.meshKeepSupported and Operations.meshKeepSupported(self.gameModel) then
		for _, method in ipairs(V.MESH_KEEP_METHODS or {}) do table.insert(capabilities, method) end
	end
	-- Output diagnostics are advertised only when Main attached the bounded collector.
	if self.diagnostics and type(self.diagnostics.CAPABILITY) == "string" then table.insert(capabilities, self.diagnostics.CAPABILITY) end
	local isKey = desired.apiKey ~= nil
	local isTicket = not isKey and desired.ticket ~= nil
	local payload: any = {
		protocolVersion = V.PROTOCOL,
		identity = {clientSessionId = self.clientSessionId, placeId = self.gameModel.PlaceId,
			universeId = self.gameModel.GameId, name = V.string(self.gameModel.Name, "place name", 200), pluginVersion = V.VERSION},
		capabilities = V.array(capabilities),
	}
	if isKey then payload.apiKey = desired.apiKey elseif isTicket then
		payload.ticket, payload.clientNonce, payload.proof = desired.ticket, desired.clientNonce, desired.proof
	else payload.code = desired.code end
	local ticket, proof = desired.ticket, desired.proof
	if isTicket and os.clock() > (desired.deadline or 0) then V.fail("PAIRING", "Arcane approval timed out. Click Connect Studio in Arcane again.") end
	local intent = self.recovery
	-- A repeated claim keeps the identity pinned by its first attempt (the daemon compares it exactly).
	local fence = if intent and intent.fence then intent.fence
		elseif desired.fence and self.identityFence == desired.fence then desired.fence else self:watchIdentity(payload.identity)
	desired.fence = fence
	if intent then intent.fence = fence; intent.needsStatus = true end
	if not self:observeIdentity(fence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
	-- Recovery keeps the original identity pin, never recaptures another place.
	payload.identity = fence.identity
	desired.apiKey, desired.code, desired.ticket, desired.proof = nil, nil, nil, nil
	local ok, result = pcall(function() return self:post(desired.url, if isKey then ROUTES.connect elseif isTicket then ROUTES.claim else ROUTES.pair, payload, nil) end)
	payload.apiKey, payload.code, payload.ticket, payload.proof = nil, nil, nil, nil
	if not ok then ticket, proof = nil, nil; error(result, 0) end
	if isTicket and type(result) == "table" and result.state == "awaiting-approval" then
		V.fields(result, {"state", "expiresAt"}, "pairing approval")
		-- Arcane shows this place and waits for the user's Approve there. Ask again on the next idle cycle.
		if self.stopped or desired.generation ~= self.generation or self.desiredPair then ticket, proof = nil, nil; return end
		desired.ticket, desired.proof = ticket, proof
		ticket, proof = nil, nil
		self.desiredPair = desired
		self:pairingUpdate("approval", "Approve this Studio in Arcane to finish connecting.")
		self:status("connecting", "Waiting for you to click Approve in Arcane.")
		return
	end
	ticket, proof = nil, nil
	V.fields(result, if isTicket then {"sessionId", "token", "protocolVersion", "allowedRoots", "allowWrites", "apiKey"} else {"sessionId", "token", "protocolVersion", "allowedRoots", "allowWrites"}, "pair result")
	-- A claim returns this daemon's long-lived key once. It must target the exact claimed endpoint.
	local pairedKey = if isTicket then result.apiKey else nil
	result.apiKey = nil
	if isTicket and (pairedKey == nil or V.keyOrigin(pairedKey) ~= desired.url) then V.fail("PROTOCOL", "Pairing returned a key for another endpoint.") end
	if result.protocolVersion ~= V.PROTOCOL then V.fail("PROTOCOL", "Unsupported daemon protocol.") end
	V.string(result.sessionId, "session ID", 256)
	V.string(result.token, "session token", 4096)
	result.allowedRoots = V.roots(result.allowedRoots)
	V.boolean(result.allowWrites, "write grant")
	-- Keep a late pair only long enough to revoke it in the single worker loop.
	result.url = desired.url
	result.generation = desired.generation
	result.identityFence = fence -- Pinned initial payload, never an ACK or later name.
	if self.stopped then result.token = nil; return end
	self.pair = result
	self.failures = 0
	if self.generation ~= desired.generation then self.disconnectRequested = true; return end
	if intent and self.recovery == intent then intent.sessionId = result.sessionId; intent.needsStatus = false; intent.attempts = 0 end
	if pairedKey then
		-- From here the paired key behaves exactly like an entered key: Main saves it in plugin settings,
		-- and loss of this session uses the existing status-first recovery.
		self.recovery = {url = desired.url, apiKey = pairedKey, generation = desired.generation,
			needsStatus = false, attempts = 0, sessionId = result.sessionId, fence = fence}
		if self.onPaired then pcall(self.onPaired, pairedKey) end
		pairedKey = nil
	end
	self:checkIdentity(result) -- Before resolving any roots in the current engine.
	self.operations = Operations.new(result, self.gameModel, self.http, function(): () self:assetProgress() end)
	local editor = self.operations.editor
	-- Fence the yielding editor call's return before Operations can reread source.
	-- Existing operation/callback guards still own lease, baseline and recovery.
	self.operations.editor = {
		GetEditorSource = function(_self: any, instance: any): string
			self:checkIdentity(result)
			return editor:GetEditorSource(instance)
		end,
		UpdateSourceAsync = function(_self: any, instance: any, callback: any): ()
			self:checkIdentity(result)
			editor:UpdateSourceAsync(instance, callback)
			self:checkIdentity(result)
		end,
	}
	self:checkIdentity(result)
	if self.testProof then
		-- The mapping witness is editor metadata, but it is still an Instance.
		-- Read-only or narrower legacy grants must not create it outside scope.
		if result.allowWrites and table.find(result.allowedRoots, "ServerStorage") then self.testProof:bind(result.sessionId, true)
		else self.testProof:disconnect() end
	end
	self:status("connected", "Connected to this Studio window. " .. (if result.allowWrites then "Writes granted." else "Read only."))
end

function Transport:envelope(command: any): ()
	V.object(command, "command")
	local pair = self.pair
	if not pair or command.protocolVersion ~= V.PROTOCOL or command.sessionId ~= pair.sessionId
		or command.clientSessionId ~= self.clientSessionId or command.state ~= "dispatched" then
		V.fail("SESSION", "Command targets another session or has an invalid protocol/state.")
	end
	V.string(command.id, "command ID", 256)
	V.string(command.requestId, "request ID", 256)
	V.integer(command.leaseEpoch, 1, 9007199254740991, "lease epoch")
	local roots = V.roots(command.allowedRoots)
	if #roots ~= #pair.allowedRoots then V.fail("GRANT", "Command root grants differ from pairing.") end
	for _, root in ipairs(roots) do if not table.find(pair.allowedRoots, root) then V.fail("GRANT", "Command root is not granted.") end end
	if command.allowWrites ~= pair.allowWrites then V.fail("GRANT", "Command write grant differs from pairing.") end
	if not table.find(V.READ_METHODS, command.method) and not table.find(V.WRITE_METHODS, command.method)
		and not table.find(V.ASSET_STAGE_METHODS or {}, command.method) then V.fail("METHOD", "Unsupported Studio method.") end
	V.string(command.expiresAt, "command expiry", 64)
	V.object(command.args, "arguments")
	-- The 256 KiB bound is measured once per decoded args table (weakly keyed). guard() runs this
	-- envelope again before and after every engine step and slice; re-encoding up to 256 KiB of
	-- JSON there was the dominant per-guard cost. Every other envelope check still re-runs.
	if not self.sizedArgs[command.args] then
		if #V.encode(command.args, self.http) > V.ARGUMENT_BYTES then V.fail("BODY_LIMIT", "Arguments exceed 256 KiB.") end
		self.sizedArgs[command.args] = true
	end
end

function Transport:guard(command: any, pair: any): ()
	if self.stopped or self.pair ~= pair or self.generation ~= pair.generation
		or self.disconnectRequested then V.fail("SESSION", "Local session was disconnected or replaced.") end
	self:checkIdentity(pair)
	if self.blocked then V.fail("SESSION", "Local session requires reconciliation.") end
	self:envelope(command)
	if command.leaseEpoch ~= self.highEpoch then V.fail("LEASE", "Command lease is stale.") end
	-- DateTime.fromIsoDate accepts UTC RFC3339 daemon timestamps.
	if not string.match(command.expiresAt, "^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%d.*Z$") then V.fail("LEASE", "Expiry must be a UTC timestamp.") end
	local ok, expires = pcall(function() return DateTime.fromIsoDate(command.expiresAt) end)
	if not ok or not expires or expires.UnixTimestampMillis <= DateTime.now().UnixTimestampMillis then V.fail("LEASE", "Command lease has expired.") end
	local staging = table.find(V.ASSET_STAGE_METHODS or {}, command.method) ~= nil
	if not staging and not self:isEdit() then V.fail("PLAY", "Commands are only available in Studio edit mode.") end
	if (table.find(V.WRITE_METHODS, command.method) or staging or table.find(V.MESH_KEEP_METHODS or {}, command.method)) and not pair.allowWrites then V.fail("GRANT", "Session is read only.") end
	if staging then
		-- One fresh snapshot per guard binds CPU staging to this exact Edit epoch.
		-- A second snapshot could accidentally mix two play lifetimes.
		local ok, proof = pcall(function(): any return if self.testProof then self.testProof:snapshot() else nil end)
		local continuity = command.args.continuity
		local identity = pair.identityFence.identity
		if not ok or type(proof) ~= "table" or type(continuity) ~= "table"
			or proof.sessionId ~= pair.sessionId or proof.mode ~= "Edit" or proof.connected ~= true or proof.continuitySupported ~= true
			or proof.placeId ~= identity.placeId or proof.universeId ~= identity.universeId
			or proof.clientLifetimeId ~= self.clientSessionId
			or type(proof.clientLifetimeId) ~= "string" or type(proof.pluginArtifactHash) ~= "string" or type(proof.playEpoch) ~= "number"
			or continuity.clientLifetimeId ~= proof.clientLifetimeId or continuity.pluginArtifactHash ~= proof.pluginArtifactHash
			or continuity.playEpoch ~= proof.playEpoch or not self:isEdit() then V.fail("SCOPE", "Asset staging Edit continuity changed or is unavailable.") end
	end
	if command.method == "asset.reconstruct" and self.assetEngineAdmitted then
		local renewal = self.assetRenewal
		local wall, monotonic = DateTime.now().UnixTimestampMillis, os.clock()
		if not renewal or renewal.commandId ~= command.id or renewal.leaseEpoch ~= command.leaseEpoch
			or wall < renewal.observedAt or wall >= renewal.expiresAt or monotonic < renewal.monotonicStartedAt or monotonic >= renewal.monotonicExpiresAt then
			V.fail("SCOPE", "Authenticated reconstruction renewal expired; no further engine work is admitted.")
		end
	end
end

-- The same single worker refreshes only its exact dispatched reconstruction.
-- Called from existing mesh batch yields; no parallel task or lease extension.
function Transport:assetProgress(): ()
	local command, pair = self.executingCommand, self.pair
	if not command or command.method ~= "asset.reconstruct" then return end
	self:guard(command, pair)
	local started = os.clock()
	if self.assetEngineAdmitted and self.assetProgressAt and started >= self.assetProgressAt and started - self.assetProgressAt < 2 then return end
	local proof = if self.testProof then self.testProof:snapshot() else nil
	self:guard(command, pair)
	self.assetProgressAt = started
	local response = self:post(pair.url, ROUTES.poll, {sessionId = pair.sessionId, observation = proof,
		executingCommand = {commandId = command.id, leaseEpoch = command.leaseEpoch}}, pair.token)
	V.fields(response, {"commands", "progress"}, "reconstruction progress")
	if #V.list(response.commands, 1, "progress commands") ~= 0 then V.fail("RECONCILE", "Reconstruction progress cannot dispatch new work.") end
	local progress = V.fields(response.progress, {"commandId", "leaseEpoch", "observedAt", "expiresAt"}, "progress renewal")
	if progress.commandId ~= command.id or progress.leaseEpoch ~= command.leaseEpoch then V.fail("RECONCILE", "Progress renewal belongs to another command or lease.") end
	local function timestamp(value: any): number
		if type(value) ~= "string" or #value > 64 or not string.match(value, "^%d%d%d%d%-%d%d%-%d%dT%d%d:%d%d:%d%d%.%d%d%dZ$") then V.fail("SCOPE", "Progress renewal requires exact UTC timestamps.") end
		local parsed, result = pcall(function(): any return DateTime.fromIsoDate(value) end)
		if not parsed or not result or type(result.UnixTimestampMillis) ~= "number" then V.fail("SCOPE", "Progress renewal timestamp is unavailable.") end
		return result.UnixTimestampMillis
	end
	local observed, expires = timestamp(progress.observedAt), timestamp(progress.expiresAt)
	local elapsed, received = os.clock() - started, DateTime.now().UnixTimestampMillis
	if elapsed < 0 or elapsed >= 4 or observed > received or expires - observed ~= 6000 or received >= expires then
		V.fail("SCOPE", "Progress acknowledgement is stale or exceeded its bounded wait; no engine work is admitted.")
	end
	-- Candidate is checked BEFORE replacing the prior permit. Every subsequent
	-- reconstruction guard enforces both server UTC and request-start duration.
	self.assetRenewal = {commandId = command.id, leaseEpoch = command.leaseEpoch, observedAt = observed, expiresAt = expires,
		monotonicStartedAt = started, monotonicExpiresAt = started + 6}
	self.assetEngineAdmitted = true
	self:guard(command, pair)
end

function Transport:dispatch(command: any): ()
	self:checkIdentity(self.pair) -- Also fences the cached-receipt fast path.
	self:envelope(command)
	local fingerprint = V.encode(command, self.http)
	local cached = self.cache[command.id]
	if cached then
		if cached.fingerprint ~= fingerprint then V.fail("RECONCILE", "Command ID was reused with a different payload.") end
		self.pending = cached -- Resend the immutable receipt; never execute twice.
		return
	end
	if command.leaseEpoch <= self.highEpoch then V.fail("LEASE", "New command has an old lease epoch.") end
	-- Fail closed without evicting command IDs or unacknowledged receipts.
	if self.cacheCount >= V.MAX_RECEIPTS or self.cacheBytes + #fingerprint + V.RESULT_BYTES + 4096 > V.MAX_CACHE_BYTES then
		V.fail("CAPACITY", "Session receipt capacity reached; inspect receipts and connect again.")
	end
	self.highEpoch = command.leaseEpoch
	local pair = self.pair
	self.executingCommand, self.assetProgressAt, self.assetRenewal, self.assetEngineAdmitted = command, nil, nil, false
	self:status("executing", command.method, command.id)
	local ok, output = pcall(function()
		self:guard(command, pair)
		return self.operations:execute(command, function() self:guard(command, pair) end)
	end)
	self.executingCommand = nil
	if self.stopped then return end
	-- Display-only summary for Main's activity line: the method name and a created count, never a payload.
	if ok and self.onActivity and self.generation == pair.generation then
		local created = if type(output) == "table" and type(output.created) == "table" then output.created.count else nil
		pcall(self.onActivity, command.method, if type(created) == "number" then created else nil)
	end
	local unsafe = not ok and type(output) == "table" and output.unsafe == true
	local payload: any = {sessionId = pair.sessionId, commandId = command.id,
		state = if ok then "succeeded" else "failed"}
	if ok then payload.result = output
	else
		payload.error = V.safeError(output)
		if unsafe then payload.result = output.recovery end
	end
	local encoded = V.encode(payload, self.http)
	local entry = {fingerprint = fingerprint, body = V.immutable(payload), unsafe = unsafe, acknowledged = false}
	self.cache[command.id] = entry
	self.cacheCount += 1
	self.cacheBytes += #fingerprint + #encoded
	self.pending = entry
	if unsafe then self.blocked = true end
end

function Transport:recover(): number
	local intent = self.recovery
	if not intent or intent.generation ~= self.generation or self.stopped then return Transport.POLL_SECONDS end
	self:checkAssetCleanup()
	if not self:isEdit() then return Transport.MAX_BACKOFF_SECONDS end
	if intent.attempts >= Transport.MAX_RECOVERY_ATTEMPTS then
		self:forgetRecovery()
		self:status("reconciliation", "Automatic recovery paused after eight attempts. Click Connect to try again.")
		return Transport.MAX_BACKOFF_SECONDS
	end
	if not intent.fence then
		intent.fence = self:watchIdentity({clientSessionId = self.clientSessionId, placeId = self.gameModel.PlaceId,
			universeId = self.gameModel.GameId, name = V.string(self.gameModel.Name, "place name", 200), pluginVersion = V.VERSION})
	end
	if not self:observeIdentity(intent.fence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
	local payload = {protocolVersion = V.PROTOCOL, apiKey = intent.apiKey,
		identity = intent.fence.identity, sessionId = intent.sessionId}
	local ok, result = pcall(function() return self:post(intent.url, ROUTES.status, payload, nil) end)
	payload.apiKey = nil
	if self.stopped or self.recovery ~= intent or self.generation ~= intent.generation or self.disconnectRequested then return Transport.POLL_SECONDS end
	if not ok then error(result, 0) end
	-- Offline time does not consume the bounded reconciliation budget. Keep the saved key through app updates.
	intent.attempts += 1
	if not self:observeIdentity(intent.fence) then V.fail("IDENTITY", IDENTITY_CHANGED) end
	V.fields(result, {"protocolVersion", "identity", "state", "sessionId"}, "session status")
	if result.protocolVersion ~= V.PROTOCOL or not V.equal(result.identity, intent.fence.identity) then
		V.fail("PROTOCOL", "Session status does not match the exact plugin identity.")
	end
	if result.state == "active" then
		V.string(result.sessionId, "session ID", 256)
		-- A lost connect ACK may have created this session. Status must never
		-- reveal its bearer; wait for definitive loss, never supersede it blindly.
		self:status("reconciliation", "A session already exists; checking status before another connection.")
		return math.min(Transport.MAX_BACKOFF_SECONDS, Transport.POLL_SECONDS * 2 ^ intent.attempts)
	end
	if result.state == "reconciliation" then V.fail("RECONCILE", "Daemon requires command reconciliation before connecting.") end
	if result.state == "lost" then
		V.string(result.sessionId, "session ID", 256)
		if intent.sessionId and result.sessionId ~= intent.sessionId then V.fail("PROTOCOL", "Session status targets another session.") end
	elseif result.state == "absent" then
		if result.sessionId ~= nil then V.fail("PROTOCOL", "Absent session status contains a session.") end
	else V.fail("PROTOCOL", "Unsupported session status.") end
	-- This status belongs to the current exact key and epoch, and was just read
	-- by the single worker. No old command, receipt, grant or token is reused.
	self:status("connecting", "Session loss confirmed; reconnecting to Arcane.")
	if self.recovery ~= intent or self.generation ~= intent.generation or self.disconnectRequested or not self:isEdit() then return Transport.POLL_SECONDS end
	self:exchange({url = intent.url, apiKey = intent.apiKey, generation = intent.generation})
	return Transport.POLL_SECONDS
end

function Transport:tick(): number
	if self.stopped then return Transport.POLL_SECONDS end
	if self.checkInput then self.checkInput() end
	if self.assetCleanupFailed then return Transport.MAX_BACKOFF_SECONDS end
	if self.disconnectRequested then
		local old = self.pair
		if old and old.token then
			-- Best effort revoke, never retry a disconnect forever while pairing.
			pcall(function() self:post(old.url, ROUTES.disconnect, {sessionId = old.sessionId}, old.token) end)
		end
		self:clearSession()
		self.disconnectRequested = false
		if not self.desiredPair and not self.codePairing then self:status("disconnected", "Disconnected. Enter your Arcane API key and click Connect.") end
	end
	if self.codePairing then return self:advancePairing() end
	if self.assetCleanupFailed then return Transport.MAX_BACKOFF_SECONDS end
	if self.desiredPair then
		local desired = self.desiredPair
		self.desiredPair = nil
		-- An uncertain exchange can only be followed by a fresh read-only status,
		-- never by replaying this handshake.
		local ok, err = pcall(function() self:exchange(desired) end)
		desired.code, desired.apiKey = nil, nil
		if not ok and desired.clientNonce ~= nil then
			-- A claim is never repeated after an error: the attempt ends here.
			desired.ticket, desired.proof = nil, nil
			if desired.generation == self.generation then self:pairingUpdate("failed", V.safeError(err)) end
		end
		if not ok and desired.generation == self.generation then
			if type(err) == "table" and err.code == "KEY_REJECTED" then
				self:clearSession()
				self:forgetRecovery()
				self.generation += 1
				self:status("failed", "Arcane API key was rejected. Enter a new API key.")
			else
				if type(err) ~= "table" or err.code ~= "NETWORK" then self:forgetRecovery() end
				self:status(if type(err) == "table" and err.code == "IDENTITY" then "reconciliation" else "disconnected", V.safeError(err) .. " Click Connect to try again.")
			end
		end
		return if not ok then Transport.MAX_BACKOFF_SECONDS else Transport.POLL_SECONDS
	end
	local pair = self.pair
	if not pair then
		if self.recovery and self.recovery.needsStatus and not self.blocked then return self:recover() end
		return Transport.POLL_SECONDS
	end
	self:observeIdentity(pair.identityFence)
	-- Retained buffers/EditableMeshes belong to one Edit epoch, including while
	-- idle. Retirement is local and never turns a historical receipt into a retry.
	local observed, observation = pcall(function(): any return if self.testProof then self.testProof:snapshot() else nil end)
	if not observed then observation = nil end
	if self.operations and self.operations.retireAssetContinuity then
		local cleaned = pcall(function() self.operations:retireAssetContinuity(observation) end)
		if not cleaned then
			self:disposeOperations()
			self.assetCleanupFailed = true; self.blocked = true
			V.fail("CLEANUP", ASSET_CLEANUP_FAILED)
		end
	end
	if self.pending then
		local receipt = self.pending
		local response = self:post(pair.url, ROUTES.result, receipt.body, pair.token)
		if response.accepted ~= true then V.fail("RECONCILE", "Daemon did not acknowledge the receipt.") end
		receipt.acknowledged = true
		self.pending = nil
		self:status(if self.blocked then "reconciliation" else "connected",
			if self.blocked then "Partial change: inspect the command and place before pairing again." else "Receipt acknowledged.", receipt.body.commandId)
		-- Poll for the next queued command at once; only idle polls wait.
		return if self.blocked then Transport.POLL_SECONDS else 0
	end
	if self.blocked then return Transport.POLL_SECONDS end
	local body: any = {sessionId = pair.sessionId, observation = observation}
	-- Changed output diagnostics ride on the idle poll; a collector fault never blocks work.
	local diagnostics, batch = self.diagnostics, nil
	if diagnostics then
		local taken, value = pcall(function(): any return diagnostics:take(function(item: any): string return V.encode(item, self.http) end) end)
		if taken and type(value) == "table" and #value.entries > 0 then batch = value; body.diagnostics = V.array(value.entries) end
	end
	local response = self:post(pair.url, ROUTES.poll, body, pair.token)
	-- A poll that returns after disconnect/re-pair can never dispatch old work.
	if self.stopped or self.pair ~= pair or self.generation ~= pair.generation or self.disconnectRequested then return Transport.POLL_SECONDS end
	self:checkIdentity(pair)
	V.fields(response, {"commands"}, "poll response")
	local commands = V.list(response.commands, 1, "command queue")
	if batch then pcall(function() diagnostics:ack(batch) end) end
	if #commands == 1 then
		self:dispatch(commands[1])
		return 0 -- Post the receipt on the next tick without an idle sleep.
	end
	self:status("connected", if self:isEdit() then "Connected; waiting for commands." else "Connected; commands are fenced during playtesting.")
	return Transport.POLL_SECONDS
end

function Transport:cycle(): number
	local generation = self.generation
	local ok, delay = pcall(function() return self:tick() end)
	if ok then self.failures = 0; return delay end
	if self.stopped or generation ~= self.generation then return Transport.POLL_SECONDS end
	if type(delay) == "table" and delay.code == "NETWORK" then
		self.failures = math.min(self.failures + 1, 5)
		local backoff = math.min(Transport.MAX_BACKOFF_SECONDS, Transport.POLL_SECONDS * 2 ^ self.failures)
		self:status("retrying", "Loopback unavailable; checking again in " .. tostring(backoff) .. " seconds. Commands are never replayed.")
		return backoff
	end
	local wasBlocked = self.blocked
	self.blocked = true
	if type(delay) == "table" and delay.code == "REVOKED" then
		local intent = self.recovery
		local safe = intent and not wasBlocked and not (self.identityFence and self.identityFence.changed)
			and not (self.pending and self.pending.unsafe)
		-- Loss fences every old callback immediately. Pending receipts stay at the
		-- old daemon for reconciliation and are never sent under replacement auth.
		self:clearSession(safe == true)
		self.generation += 1
		if safe and not self.assetCleanupFailed then intent.generation = self.generation; intent.needsStatus = true; intent.attempts = 0
		else self:forgetRecovery(); self.blocked = wasBlocked or self.assetCleanupFailed end
		self:status(if self.blocked then "reconciliation" else "disconnected", V.safeError(delay))
	elseif type(delay) == "table" and delay.code == "KEY_REJECTED" then
		self:clearSession(); self:forgetRecovery(); self.generation += 1
		self:status("failed", "Arcane API key was rejected. Enter a new API key.")
	else
		self:forgetRecovery()
		self:status("reconciliation", V.safeError(delay))
	end
	return Transport.MAX_BACKOFF_SECONDS
end

function Transport:start(): ()
	if self.started then return end
	self.started = true
	task.spawn(function()
		while not self.stopped do
			local delay = self:cycle()
			if self.stopped then break end
			task.wait(delay)
		end
	end)
end

return Transport
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane7">
<Properties>
<string name="Name">TestProof</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- Construct against the plugin's Edit DataModel, before starting a playtest.
-- StudioTestService.EditModeActive is true while Edit is idle, false during a
-- play/Team Test session, and true again on stop (PluginSecurity read):
-- https://create.roblox.com/docs/reference/engine/classes/StudioTestService#EditModeActive
-- https://create.roblox.com/docs/reference/engine/classes/Object#GetPropertyChangedSignal
-- Each EditModeActive notification advances the epoch, including deferred ones.
-- Pause/resume within the same test does not change EditModeActive or the epoch.
-- Edit RunService.RunState stays Stopped during play; it cannot prove continuity.
-- Native notification delivery and Edit DataModel persistence need Studio QA.
-- Runtime ServerStorage receives a CLONE: its attributes are an identity witness,
-- never an authoritative epoch. Use the authenticated plugin HTTP snapshot for that.
local TestProof = {}

export type Snapshot = {
	read sessionId: string, read clientLifetimeId: string, read pluginArtifactHash: string, read markerName: string,
	read placeId: number, read universeId: number, read placeName: string,
	read playEpoch: number, read mode: "Edit" | "Play", read connected: boolean, read continuitySupported: boolean,
}
export type State = {
	bind: (self: State, sessionId: string, allowWrites: boolean) -> Snapshot?,
	snapshot: (self: State) -> Snapshot?,
	disconnect: (self: State) -> (),
	stop: (self: State) -> (),
}
type Attributes = {[string]: string | number | boolean}

local MAX_NAME_ATTEMPTS = 4
local MAX_COUNTER = 9007199254740991 -- Never wrap or lose monotonicity in a double.

local function publicId(value: any): boolean
	return type(value) == "string" and #value > 0 and #value <= 256 and not string.find(value, "%c")
end

function TestProof.new(gameModel: any, clientLifetimeId: string, pluginArtifactHash: string): State
	assert(publicId(clientLifetimeId), "TestProof requires a public client lifetime ID.")
	assert(type(pluginArtifactHash) == "string" and #pluginArtifactHash == 64
		and not string.find(pluginArtifactHash, "[^%x]"), "TestProof requires the loaded artifact SHA-256.")
	-- Keep exact Edit service references; never resolve a runtime copy by name.
	local serviceAvailable, testService = pcall(function(): any return gameModel:GetService("StudioTestService") end)
	if not serviceAvailable then testService = nil end
	local storage = gameModel:GetService("ServerStorage")
	local http = gameModel:GetService("HttpService")
	local sessionId: string? = nil
	local connected, allowWrites, stopped, fenced = false, false, false, false
	local continuitySupported = false
	local playEpoch = 0
	local mode: "Edit" | "Play" = "Edit"
	local observer: any = nil
	local marker: any = nil
	local markerName: string? = nil
	local expected: Attributes? = nil
	local state: State

	local function readMode(): "Edit" | "Play"
		assert(testService ~= nil, "StudioTestService is unavailable.")
		local editModeActive = testService.EditModeActive
		assert(type(editModeActive) == "boolean", "StudioTestService.EditModeActive must be a boolean.")
		return if editModeActive then "Edit" else "Play"
	end

	local function dropObserver(): ()
		continuitySupported, connected = false, false
		local connection = observer
		observer = nil
		if connection then pcall(function(): () connection:Disconnect() end) end
	end

	local function observeMode(): ()
		local ok, value = pcall(readMode)
		if ok then
			mode = value
		else
			dropObserver()
			-- Retain the last known mode only as unavailable metadata. RunService
			-- in the Edit model cannot provide a valid fallback during a test.
		end
		if observer then
			local live, isConnected = pcall(function(): boolean return observer.Connected == true end)
			if not live or not isConnected then dropObserver() end
		end
	end

	local function attributes(): Attributes
		return {
			SessionId = sessionId or "", ClientLifetimeId = clientLifetimeId,
			PluginArtifactHash = pluginArtifactHash, MarkerName = markerName or "", PlaceId = gameModel.PlaceId,
			UniverseId = gameModel.GameId, PlaceName = gameModel.Name,
			PlayEpoch = playEpoch, Mode = mode, Connected = connected,
			ContinuitySupported = continuitySupported,
		}
	end

	local function unchanged(): boolean
		if not marker or not expected then return false end
		local ok, matches = pcall(function(): boolean
			if marker.ClassName ~= "Folder" or marker.Name ~= markerName or marker.Parent ~= storage
				or marker.Archivable ~= true or storage.Parent ~= gameModel
				or marker:FindFirstChildWhichIsA("Instance") ~= nil or #marker:GetTags() ~= 0 then
				return false
			end
			local actual: Attributes = marker:GetAttributes()
			for key, value in pairs(expected :: Attributes) do if actual[key] ~= value then return false end end
			for key in pairs(actual) do if (expected :: Attributes)[key] == nil then return false end end
			return true
		end)
		return ok and matches
	end

	local function invalidate(): ()
		-- Sticky: retain at most one contested marker and never create replacements.
		-- Only these revocation attributes may change after a foreign edit. Everything
		-- else (including foreign children, tags, names and attributes) is preserved.
		fenced, connected, allowWrites = true, false, false
		if marker then
			pcall(function(): () marker:SetAttribute("Connected", false) end)
			pcall(function(): () marker:SetAttribute("Invalid", true) end)
		end
	end

	local function publish(): ()
		if not marker or fenced then return end
		if not unchanged() then invalidate(); return end
		local values = attributes()
		local ownedAttributes = expected :: Attributes
		local ok = pcall(function(): ()
			for key, value in pairs(values) do
				if ownedAttributes[key] ~= value then
					assert(unchanged(), "TestProof witness changed during publication.")
					marker:SetAttribute(key, value)
					ownedAttributes[key] = value
					-- Attribute listeners can edit another field synchronously. Detect
					-- that before a subsequent planned write could overwrite it.
					assert(unchanged(), "TestProof witness changed during publication.")
				end
			end
		end)
		if not ok then invalidate(); return end
		expected = values
		if not unchanged() then invalidate() end
	end

	local function retire(): ()
		if not marker then return end
		if fenced or not unchanged() then invalidate(); return end
		-- Revoke before removal. If any operation/readback fails, keep the witness
		-- invalid rather than deleting a marker whose contents are now uncertain.
		publish()
		if fenced then return end
		local ok = pcall(function(): () marker:Destroy() end)
		if not ok then invalidate(); return end
		marker, markerName, expected = nil, nil, nil
	end

	local function install(): ()
		if marker or fenced then return end
		local chosen: string? = nil
		local ok = pcall(function(): ()
			assert(storage.Parent == gameModel, "Edit ServerStorage is unavailable.")
			for _ = 1, MAX_NAME_ATTEMPTS do
				local guid = http:GenerateGUID(false)
				assert(type(guid) == "string" and #guid == 36 and not string.find(guid, "[^%x%-]"), "Invalid GUID.")
				local name = "ArcaneTestProof_" .. guid
				-- Keep a public candidate even if installation fails, so a bound
				-- unavailable proof still satisfies the host's eleven-field schema.
				markerName = name
				if not storage:FindFirstChild(name) then chosen = name; break end
			end
			assert(chosen ~= nil, "TestProof name capacity reached.")
		end)
		if not ok then invalidate(); return end
		markerName = chosen
		-- A helper loaded during play can report an unavailable witness, but cannot
		-- install into a runtime DataModel and mistake that clone for Edit ownership.
		if mode ~= "Edit" then connected = false; return end
		ok = pcall(function(): ()
			marker = Instance.new("Folder")
			marker.Name = chosen
			marker.Archivable = true -- Allow native runtime identity witnesses to clone.
			expected = attributes()
			for key, value in pairs(expected :: Attributes) do marker:SetAttribute(key, value) end
			marker.Parent = storage
		end)
		if not ok or not unchanged() then invalidate() end
	end

	state = {
		snapshot = function(_self: State): Snapshot?
			observeMode()
			-- Sampling reports the current mode; it NEVER manufactures an epoch.
			publish()
			local boundSessionId, boundMarkerName = sessionId, markerName
			if not boundSessionId or not boundMarkerName then return nil end
			local result: Snapshot = {
				sessionId = boundSessionId, clientLifetimeId = clientLifetimeId, pluginArtifactHash = pluginArtifactHash,
				markerName = boundMarkerName,
				placeId = gameModel.PlaceId, universeId = gameModel.GameId, placeName = gameModel.Name,
				playEpoch = playEpoch, mode = mode, connected = connected,
				continuitySupported = continuitySupported,
			}
			table.freeze(result)
			return result
		end,
		bind = function(_self: State, nextSessionId: string, nextAllowWrites: boolean): Snapshot?
			assert(publicId(nextSessionId), "TestProof requires a public session ID.")
			assert(type(nextAllowWrites) == "boolean", "TestProof requires a boolean write grant.")
			if stopped or fenced then return state:snapshot() end
			observeMode()
			if sessionId ~= nextSessionId or allowWrites ~= nextAllowWrites then
				connected, allowWrites = false, false
				retire()
				if fenced then return state:snapshot() end
				sessionId, connected, allowWrites = nextSessionId, continuitySupported, nextAllowWrites
			end
			-- This bounded internal witness exists for read-only sessions too.
			-- Grant changes replace it; they never authorize writes to game content.
			if not marker and mode == "Edit" then connected = continuitySupported end
			install()
			return state:snapshot()
		end,
		disconnect = function(_self: State): ()
			connected, allowWrites = false, false
			retire()
			sessionId = nil
			-- Keep the one lifetime observer across disconnect/re-pair gaps.
		end,
		stop = function(_self: State): ()
			if stopped then return end
			stopped = true -- Ignore callbacks already queued before Disconnect().
			dropObserver()
			state:disconnect()
		end,
	}

	-- Fail closed if this genuine property observer cannot be installed. One
	-- notification counts even if all deferred callbacks see the same boolean.
	local ok = pcall(function(): ()
		mode = readMode()
		observer = testService:GetPropertyChangedSignal("EditModeActive"):Connect(function(): ()
			if stopped or not continuitySupported then return end
			if playEpoch >= MAX_COUNTER then dropObserver(); invalidate(); return end
			playEpoch += 1
			observeMode()
			publish()
		end)
		assert(observer and observer.Connected == true, "EditModeActive observer is unavailable.")
	end)
	if ok then continuitySupported = true else dropObserver() end
	observeMode()
	return state
end

return TestProof
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBXArcane8">
<Properties>
<string name="Name">Sha256</string>
<bool name="Archivable">true</bool>
<ProtectedString name="Source"><![CDATA[--!strict
-- SHA-256 over raw string bytes (including UTF-8), per FIPS 180-4.
-- Synchronous and bounded: no services, dependencies, or yielding.

local MAX_BYTES = 512 * 1024
local WORD_MASK = 0xffffffff
local ROUND_CONSTANTS: {number} = table.freeze({
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
})

local band, bxor, bnot = bit32.band, bit32.bxor, bit32.bnot
local lshift, rshift, rrotate = bit32.lshift, bit32.rshift, bit32.rrotate

local function compress(state: {number}, words: {number}, bytes: string, offset: number): ()
	for index = 1, 16 do
		local first = offset + (index - 1) * 4
		local a, b, c, d = string.byte(bytes, first, first + 3)
		words[index] = lshift(a, 24) + lshift(b, 16) + lshift(c, 8) + d
	end
	for index = 17, 64 do
		local previous15, previous2 = words[index - 15], words[index - 2]
		local sigma0 = bxor(rrotate(previous15, 7), rrotate(previous15, 18), rshift(previous15, 3))
		local sigma1 = bxor(rrotate(previous2, 17), rrotate(previous2, 19), rshift(previous2, 10))
		words[index] = band(words[index - 16] + sigma0 + words[index - 7] + sigma1, WORD_MASK)
	end

	local a, b, c, d, e, f, g, h = state[1], state[2], state[3], state[4], state[5], state[6], state[7], state[8]
	for index = 1, 64 do
		local sigma1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
		local choose = bxor(band(e, f), band(bnot(e), g))
		local temporary1 = band(h + sigma1 + choose + ROUND_CONSTANTS[index] + words[index], WORD_MASK)
		local sigma0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
		local majority = bxor(band(a, b), band(a, c), band(b, c))
		local temporary2 = band(sigma0 + majority, WORD_MASK)
		h = g
		g = f
		f = e
		e = band(d + temporary1, WORD_MASK)
		d = c
		c = b
		b = a
		a = band(temporary1 + temporary2, WORD_MASK)
	end
	state[1] = band(state[1] + a, WORD_MASK)
	state[2] = band(state[2] + b, WORD_MASK)
	state[3] = band(state[3] + c, WORD_MASK)
	state[4] = band(state[4] + d, WORD_MASK)
	state[5] = band(state[5] + e, WORD_MASK)
	state[6] = band(state[6] + f, WORD_MASK)
	state[7] = band(state[7] + g, WORD_MASK)
	state[8] = band(state[8] + h, WORD_MASK)
end

local function digest(bytes: string): string
	if type(bytes) ~= "string" then
		error("SHA-256 input must be a string.", 2)
	end
	local length = #bytes
	if length > MAX_BYTES then
		error("SHA-256 input exceeds the 524288-byte limit.", 2)
	end

	-- All mutable working storage belongs to this call; module reuse cannot leak state.
	local state = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
	local words: {number} = table.create(64, 0)
	local fullBytes = length - length % 64
	for offset = 1, fullBytes, 64 do
		compress(state, words, bytes, offset)
	end

	-- Actual padding bytes: 0x80, zeroes, then the original 64-bit big-endian bit length.
	-- The input cap keeps that length below 2^32, so its high word is always zero.
	local bitLength = length * 8
	local tail = string.sub(bytes, fullBytes + 1) .. "\128" .. string.rep("\0", (55 - length) % 64)
		.. string.char(0, 0, 0, 0, rshift(bitLength, 24), band(rshift(bitLength, 16), 0xff), band(rshift(bitLength, 8), 0xff), band(bitLength, 0xff))
	for offset = 1, #tail, 64 do
		compress(state, words, tail, offset)
	end

	return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", state[1], state[2], state[3], state[4], state[5], state[6], state[7], state[8])
end

return digest
]]></ProtectedString>
