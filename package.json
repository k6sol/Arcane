{
  "name": "arcane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/unit/*.test.js && node --test tests/skills/*.test.mjs && node --test tests/release/*.test.mjs",
    "start:lab": "node dist/apps/daemon/src/main.js",
    "probe:providers": "node dist/apps/daemon/src/probe.js",
    "start:product": "node dist/apps/daemon/src/product-main.js",
    "start:mcp": "node dist/apps/mcp/src/main.js",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:plugin": "node --test tests/plugin/*.test.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "fixture:studio": "node scripts/create-studio-fixture.mjs",
    "launch:native": "node scripts/launch-native.mjs",
    "native:plan": "node scripts/launch-native.mjs --dry-run",
    "doctor": "node scripts/product-doctor.mjs",
    "start:arcane": "node scripts/start-product.mjs",
    "release:local": "npm run build && npm run build:plugin && node scripts/create-local-release.mjs",
    "test:release": "node --test tests/release/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.6"
  }
}
