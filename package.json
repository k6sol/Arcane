{
  "name": "arcane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/compile-product.mjs",
    "typecheck": "node scripts/compile-product.mjs --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/unit/*.test.js && node --test tests/skills/*.test.mjs && node --test tests/release/*.test.mjs",
    "start:lab": "node dist/apps/daemon/src/main.js",
    "probe:providers": "node dist/apps/daemon/src/probe.js",
    "start:product": "node dist/apps/daemon/src/product-main.js",
    "start:mcp": "node dist/apps/mcp/src/main.js",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:plugin": "node --test tests/plugin/*.test.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "fixture:studio": "node scripts/create-studio-fixture.mjs",
    "launch:native": "node scripts/launch-native.mjs",
    "native:plan": "node scripts/launch-native.mjs --dry-run",
    "doctor": "node scripts/product-doctor.mjs",
    "start:arcane": "node scripts/start-product.mjs",
    "open:project": "node scripts/open-project.mjs",
    "setup:arcane": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File scripts/setup-arcane.ps1",
    "release:local": "npm run build && npm run build:plugin && node scripts/create-local-release.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "start:desktop": "electron apps/desktop/electron",
    "package:windows": "npm run build && npm run build:plugin && node scripts/package-windows.mjs",
    "release:desktop": "node scripts/desktop-pipeline.mjs",
    "check:desktop": "node scripts/check-windows-executable.mjs",
    "check:memory": "node scripts/check-project-memory.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.7.0",
    "playwright-core": "1.64.0",
    "rcedit": "5.0.2",
    "three": "0.186.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.6"
  }
}
