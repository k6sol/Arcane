# Auto detect text files and perform LF normalization
* text=auto

# Skill integrity hashes are byte-exact; do not change packaged text on checkout.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.csv text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.luau text eol=lf
*.lua text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf

# This upstream notice is pinned byte-for-byte alongside the managed compiler.
# Its extensionless filename must not inherit Windows CRLF checkout conversion.
apps/desktop/host-tools/luau/LICENSE text eol=lf
